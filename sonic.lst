0000D50C                            ; ---------------------------------------------------------------------------
0000D50C                            ; Subroutine translating object	speed to update	object position
0000D50C                            ; ---------------------------------------------------------------------------
0000D50C                            
0000D50C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D50C                            
0000D50C                            
0000D50C                            SpeedToPos:
0000D50C 2428 0008                  		move.l	obX(a0),d2
0000D510 2628 000C                  		move.l	obY(a0),d3
0000D514 3028 0010                  		move.w	obVelX(a0),d0	; load horizontal speed
0000D518 48C0                       		ext.l	d0
0000D51A E180                       		asl.l	#8,d0		; multiply speed by $100
0000D51C D480                       		add.l	d0,d2		; add to x-axis	position
0000D51E 3028 0012                  		move.w	obVelY(a0),d0	; load vertical	speed
0000D522 48C0                       		ext.l	d0
0000D524 E180                       		asl.l	#8,d0		; multiply by $100
0000D526 D680                       		add.l	d0,d3		; add to y-axis	position
0000D528 2142 0008                  		move.l	d2,obX(a0)	; update x-axis	position
0000D52C 2143 000C                  		move.l	d3,obY(a0)	; update y-axis	position
0000D530 4E75                       		rts	
0000D532                            
0000D532                            ; End of function SpeedToPos
0000D532                            ; End of function SpeedToPos
