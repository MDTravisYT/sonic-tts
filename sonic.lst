00003316 1238 F604                  		move.b	(v_jpadhold1).w,d1
0000331A 0201 0003                  		andi.b	#btnUp+btnDn,d1	; is up/down pressed?
0000331E 6700                       		beq.s	LevSel_SndTest	; if not, branch
00003320 3038 FF82                  		move.w	(v_levselitem).w,d0
