000726E6 1439 00A0 4000             		move.b	(ym2612_a0).l,d2
000726EC 0802 0007                  		btst	#7,d2		; Is FM busy?
000726F0 66F4                       		bne.s	@waitloop	; Loop if so
000726F2                            
000726F2 13C1 00A0 4001             		move.b	d1,(ym2612_d0).l
000726F8 4E75                       		rts	
000726FA                            ; End of function WriteFMI
