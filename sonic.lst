00053AF6 0C03 00E0                  		cmpi.b	#$E0,d3			; Is this a noise channel:
00053AFA 6700                       		beq.s	@gotpsgpointer		; Branch if yes
00053AFC 0C03 00C0                  		cmpi.b	#$C0,d3			; Is this PSG 3?
00053B00 6700                       		beq.s	@gotpsgpointer		; Branch if yes
00053B02 E60B                       		lsr.b	#3,d3
00053B04 41FA FE78                  		lea	SFX_BGMChannelRAM(pc),a0
00053B08 2070 3000                  		movea.l	(a0,d3.w),a0
00053B0C                            ; loc_7245A:
