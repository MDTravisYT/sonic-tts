000016E6                            		include	"_inc\Enigma Decompression.asm"
000016E6                            ; ---------------------------------------------------------------------------
000016E6                            ; Enigma decompression algorithm
000016E6                            
000016E6                            ; input:
000016E6                            ;	d0 = starting art tile (added to each 8x8 before writing to destination)
000016E6                            ;	a0 = source address
000016E6                            ;	a1 = destination address
000016E6                            
000016E6                            ; usage:
000016E6                            ;	lea	(source).l,a0
000016E6                            ;	lea	(destination).l,a1
000016E6                            ;	move.w	#arttile,d0
000016E6                            ;	bsr.w	EniDec
000016E6                            
000016E6                            ; See http://www.segaretro.org/Enigma_compression for format description
000016E6                            ; ---------------------------------------------------------------------------
000016E6                            
000016E6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000016E6                            
000016E6                            
000016E6                            EniDec:
000016E6 48E7 FF7C                  		movem.l	d0-d7/a1-a5,-(sp)
000016EA 3640                       		movea.w	d0,a3		; store starting art tile
000016EC 1018                       		move.b	(a0)+,d0
000016EE 4880                       		ext.w	d0
000016F0 3A40                       		movea.w	d0,a5		; store number of bits in inline copy value
000016F2 1818                       		move.b	(a0)+,d4
000016F4 E70C                       		lsl.b	#3,d4		; store PCCVH flags bitfield
000016F6 3458                       		movea.w	(a0)+,a2
000016F8 D4CB                       		adda.w	a3,a2		; store incremental copy word
000016FA 3858                       		movea.w	(a0)+,a4
000016FC D8CB                       		adda.w	a3,a4		; store literal copy word
000016FE 1A18                       		move.b	(a0)+,d5
00001700 E145                       		asl.w	#8,d5
00001702 1A18                       		move.b	(a0)+,d5	; get first word in format list
00001704 7C10                       		moveq	#16,d6		; initial shift value
00001706                            ; loc_173E:
00001706                            Eni_Loop:
00001706 7007                       		moveq	#7,d0		; assume a format list entry is 7 bits
00001708 3E06                       		move.w	d6,d7
0000170A 9E40                       		sub.w	d0,d7
0000170C 3205                       		move.w	d5,d1
0000170E EE69                       		lsr.w	d7,d1
00001710 0241 007F                  		andi.w	#$7F,d1		; get format list entry
00001714 3401                       		move.w	d1,d2		; and copy it
00001716 0C41 0040                  		cmpi.w	#$40,d1		; is the high bit of the entry set?
0000171A 6400                       		bhs.s	@sevenbitentry
0000171C 7006                       		moveq	#6,d0		; if it isn't, the entry is actually 6 bits
0000171E E24A                       		lsr.w	#1,d2
00001720                            ; loc_1758:
00001720                            @sevenbitentry:
00001720 6100 0000                  		bsr.w	EniDec_FetchByte
00001724 0242 000F                  		andi.w	#$F,d2		; get repeat count
00001728 E849                       		lsr.w	#4,d1
0000172A D241                       		add.w	d1,d1
0000172C 4EFB 1000                  		jmp	EniDec_Index(pc,d1.w)
00001730                            ; End of function EniDec
00001730                            
00001730                            ; ===========================================================================
00001730                            ; loc_1768:
00001730                            EniDec_00:
00001730 32CA                       @loop:		move.w	a2,(a1)+	; copy incremental copy word
00001732 524A                       		addq.w	#1,a2		; increment it
00001734 51CA FFFA                  		dbf	d2,@loop	; repeat
00001738 60CC                       		bra.s	Eni_Loop
0000173A                            ; ===========================================================================
0000173A                            ; loc_1772:
0000173A                            EniDec_01:
0000173A 32CC                       @loop:		move.w	a4,(a1)+	; copy literal copy word
0000173C 51CA FFFC                  		dbf	d2,@loop	; repeat
00001740 60C4                       		bra.s	Eni_Loop
00001742                            ; ===========================================================================
00001742                            ; loc_177A:
00001742                            EniDec_100:
00001742 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001746                            ; loc_177E:
00001746 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
00001748 51CA FFFC                  		dbf	d2,@loop	; repeat
0000174C                            
0000174C 60B8                       		bra.s	Eni_Loop
0000174E                            ; ===========================================================================
0000174E                            ; loc_1786:
0000174E                            EniDec_101:
0000174E 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001752                            ; loc_178A:
00001752 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
00001754 5241                       		addq.w	#1,d1		; increment
00001756 51CA FFFA                  		dbf	d2,@loop	; repeat
0000175A                            
0000175A 60AA                       		bra.s	Eni_Loop
0000175C                            ; ===========================================================================
0000175C                            ; loc_1794:
0000175C                            EniDec_110:
0000175C 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001760                            ; loc_1798:
00001760 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
00001762 5341                       		subq.w	#1,d1		; decrement
00001764 51CA FFFA                  		dbf	d2,@loop	; repeat
00001768                            
00001768 609C                       		bra.s	Eni_Loop
0000176A                            ; ===========================================================================
0000176A                            ; loc_17A2:
0000176A                            EniDec_111:
0000176A 0C42 000F                  		cmpi.w	#$F,d2
0000176E 6700                       		beq.s	EniDec_Done
00001770                            ; loc_17A8:
00001770 6100 0000                  @loop:		bsr.w	EniDec_FetchInlineValue	; fetch new inline value
00001774 32C1                       		move.w	d1,(a1)+	; copy it
00001776 51CA FFF8                  		dbf	d2,@loop	; and repeat
0000177A                            
0000177A 608A                       		bra.s	Eni_Loop
0000177C                            ; ===========================================================================
0000177C                            ; loc_17B4:
0000177C                            EniDec_Index:
0000177C 60B2                       		bra.s	EniDec_00
0000177E 60B0                       		bra.s	EniDec_00
00001780 60B8                       		bra.s	EniDec_01
00001782 60B6                       		bra.s	EniDec_01
00001784 60BC                       		bra.s	EniDec_100
00001786 60C6                       		bra.s	EniDec_101
00001788 60D2                       		bra.s	EniDec_110
0000178A 60DE                       		bra.s	EniDec_111
0000178C                            ; ===========================================================================
0000178C                            ; loc_17C4:
0000178C                            EniDec_Done:
0000178C 5348                       		subq.w	#1,a0		; go back by one byte
0000178E 0C46 0010                  		cmpi.w	#16,d6		; were we going to start on a completely new byte?
00001792 6600                       		bne.s	@notnewbyte	; if not, branch
00001794 5348                       		subq.w	#1,a0		; and another one if needed
00001796                            ; loc_17CE:
00001796                            @notnewbyte:
00001796 3008                       		move.w	a0,d0
00001798 E248                       		lsr.w	#1,d0		; are we on an odd byte?
0000179A 6400                       		bcc.s	@evenbyte	; if not, branch
0000179C 5248                       		addq.w	#1,a0		; ensure we're on an even byte
0000179E                            ; loc_17D6:
0000179E                            @evenbyte:
0000179E 4CDF 3EFF                  		movem.l	(sp)+,d0-d7/a1-a5
000017A2 4E75                       		rts	
000017A4                            
000017A4                            ; ---------------------------------------------------------------------------
000017A4                            ; Part of the Enigma decompressor
000017A4                            ; Fetches an inline copy value and stores it in d1
000017A4                            ; ---------------------------------------------------------------------------
000017A4                            
000017A4                            ; =============== S U B R O U T I N E =======================================
000017A4                            
000017A4                            ; loc_17DC:
000017A4                            EniDec_FetchInlineValue:
000017A4 360B                       		move.w	a3,d3		; copy starting art tile
000017A6 1204                       		move.b	d4,d1		; copy PCCVH bitfield
000017A8 D201                       		add.b	d1,d1		; is the priority bit set?
000017AA 6400                       		bcc.s	@skippriority	; if not, branch
000017AC 5346                       		subq.w	#1,d6
000017AE 0D05                       		btst	d6,d5		; is the priority bit set in the inline render flags?
000017B0 6700                       		beq.s	@skippriority	; if not, branch
000017B2 0043 8000                  		ori.w	#$8000,d3	; otherwise set priority bit in art tile
000017B6                            ; loc_17EE:
000017B6                            @skippriority:
000017B6 D201                       		add.b	d1,d1		; is the high palette line bit set?
000017B8 6400                       		bcc.s	@skiphighpal	; if not, branch
000017BA 5346                       		subq.w	#1,d6
000017BC 0D05                       		btst	d6,d5
000017BE 6700                       		beq.s	@skiphighpal
000017C0 0643 4000                  		addi.w	#$4000,d3	; set second palette line bit
000017C4                            ; loc_17FC:
000017C4                            @skiphighpal:
000017C4 D201                       		add.b	d1,d1		; is the low palette line bit set?
000017C6 6400                       		bcc.s	@skiplowpal	; if not, branch
000017C8 5346                       		subq.w	#1,d6
000017CA 0D05                       		btst	d6,d5
000017CC 6700                       		beq.s	@skiplowpal
000017CE 0643 2000                  		addi.w	#$2000,d3	; set first palette line bit
000017D2                            ; loc_180A:
000017D2                            @skiplowpal:
000017D2 D201                       		add.b	d1,d1		; is the vertical flip flag set?
000017D4 6400                       		bcc.s	@skipyflip	; if not, branch
000017D6 5346                       		subq.w	#1,d6
000017D8 0D05                       		btst	d6,d5
000017DA 6700                       		beq.s	@skipyflip
000017DC 0043 1000                  		ori.w	#$1000,d3	; set Y-flip bit
000017E0                            ; loc_1818:
000017E0                            @skipyflip:
000017E0 D201                       		add.b	d1,d1		; is the horizontal flip flag set?
000017E2 6400                       		bcc.s	@skipxflip	; if not, branch
000017E4 5346                       		subq.w	#1,d6
000017E6 0D05                       		btst	d6,d5
000017E8 6700                       		beq.s	@skipxflip
000017EA 0043 0800                  		ori.w	#$800,d3	; set X-flip bit
000017EE                            ; loc_1826:
000017EE                            @skipxflip:
000017EE 3205                       		move.w	d5,d1
000017F0 3E06                       		move.w	d6,d7
000017F2 9E4D                       		sub.w	a5,d7		; subtract length in bits of inline copy value
000017F4 6400                       		bcc.s	@enoughbits	; branch if a new word doesn't need to be read
000017F6 3C07                       		move.w	d7,d6
000017F8 0646 0010                  		addi.w	#16,d6
000017FC 4447                       		neg.w	d7		; calculate bit deficit
000017FE EF69                       		lsl.w	d7,d1		; and make space for that many bits
00001800 1A10                       		move.b	(a0),d5		; get next byte
00001802 EF3D                       		rol.b	d7,d5		; and rotate the required bits into the lowest positions
00001804 DE47                       		add.w	d7,d7
00001806 CA7B 7000                  		and.w	EniDec_Masks-2(pc,d7.w),d5
0000180A D245                       		add.w	d5,d1		; combine upper bits with lower bits
0000180C                            ; loc_1844:
0000180C                            @maskvalue:
0000180C 300D                       		move.w	a5,d0		; get length in bits of inline copy value
0000180E D040                       		add.w	d0,d0
00001810 C27B 0000                  		and.w	EniDec_Masks-2(pc,d0.w),d1	; mask value appropriately
00001814 D243                       		add.w	d3,d1		; add starting art tile
00001816 1A18                       		move.b	(a0)+,d5
00001818 E14D                       		lsl.w	#8,d5
0000181A 1A18                       		move.b	(a0)+,d5	; get next word
0000181C 4E75                       		rts	
0000181E                            ; ===========================================================================
0000181E                            ; loc_1856:
0000181E                            @enoughbits:
0000181E 6700                       		beq.s	@justenough	; if the word has been exactly exhausted, branch
00001820 EE69                       		lsr.w	d7,d1	; get inline copy value
00001822 300D                       		move.w	a5,d0
00001824 D040                       		add.w	d0,d0
00001826 C27B 0000                  		and.w	EniDec_Masks-2(pc,d0.w),d1	; and mask it appropriately
0000182A D243                       		add.w	d3,d1	; add starting art tile
0000182C 300D                       		move.w	a5,d0
0000182E 6000                       		bra.s	EniDec_FetchByte
00001830                            ; ===========================================================================
00001830                            ; loc_1868:
00001830                            @justenough:
00001830 7C10                       		moveq	#16,d6	; reset shift value
00001832 60D8                       		bra.s	@maskvalue
00001834                            ; ===========================================================================
00001834                            ; word_186C:
00001834                            EniDec_Masks:
00001834 0001 0003 0007 000F        		dc.w	 1,    3,    7,   $F
0000183C 001F 003F 007F 00FF        		dc.w   $1F,  $3F,  $7F,  $FF
00001844 01FF 03FF 07FF 0FFF        		dc.w  $1FF, $3FF, $7FF, $FFF
0000184C 1FFF 3FFF 7FFF FFFF        		dc.w $1FFF,$3FFF,$7FFF,$FFFF
00001854                            
00001854                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001854                            
00001854                            ; sub_188C:
00001854                            EniDec_FetchByte:
00001854 9C40                       		sub.w	d0,d6	; subtract length of current entry from shift value so that next entry is read next time around
00001856 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
0000185A 6400                       		bhs.s	@locret	; if not, branch
0000185C 5046                       		addq.w	#8,d6
0000185E E145                       		asl.w	#8,d5
00001860 1A18                       		move.b	(a0)+,d5
00001862                            @locret:
00001862 4E75                       		rts	
00001864                            ; End of function EniDec_FetchByte
