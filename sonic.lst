0001AD74                            AniArt_GHZ:
0001AD74                            
0001AD74                            AniArt_GHZ_Waterfall:
0001AD74                            
0001AD74 =00000008                  @size:		equ 8	; number of tiles per frame
0001AD74                            
0001AD74 5338 F7B1                  		subq.b	#1,(v_lani0_time).w ; decrement timer
0001AD78 6A00                       		bpl.s	AniArt_GHZ_Bigflower ; branch if not 0
0001AD7A                            
0001AD7A 11FC 0005 F7B1             		move.b	#5,(v_lani0_time).w ; time to display each frame
0001AD80 43F9 0000 0000             		lea	(Art_GhzWater).l,a1 ; load waterfall patterns
0001AD86 1038 F7B0                  		move.b	(v_lani0_frame).w,d0
0001AD8A 5238 F7B0                  		addq.b	#1,(v_lani0_frame).w ; increment frame counter
0001AD8E 0240 0001                  		andi.w	#1,d0		; there are only 2 frames
0001AD92 6700                       		beq.s	@isframe0	; branch if frame 0
0001AD94 43E9 0100                  		lea	@size*$20(a1),a1 ; use graphics for frame 1
0001AD98                            
0001AD98                            	@isframe0:
0001ADA2 323C 0007                  		move.w	#@size-1,d1	; number of 8x8	tiles
0001ADA6 6000 0000                  		bra.w	LoadTiles
0001ADAA                            ; ===========================================================================
0001ADAA                            
0001ADAA                            AniArt_GHZ_Bigflower:
0001ADAA                            
0001ADAA =00000010                  @size:		equ 16	; number of tiles per frame
0001ADAA                            
