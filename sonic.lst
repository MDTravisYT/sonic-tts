00071A34                            ; ---------------------------------------------------------------------------
00071A34                            ; New tempos for songs during speed shoes
00071A34                            ; ---------------------------------------------------------------------------
00071A34                            ; DANGER! several songs will use the first few bytes of MusicIndex as their main
00071A34                            ; tempos while speed shoes are active. If you don't want that, you should add
00071A34                            ; their "correct" sped-up main tempos to the list.
00071A34                            ; byte_71A94:
00071A34                            SpeedUpIndex:
00071A34 07                         		dc.b 7		; GHZ
00071A35 72                         		dc.b $72	; LZ
00071A36 73                         		dc.b $73	; MZ
00071A37 26                         		dc.b $26	; SLZ
00071A38 15                         		dc.b $15	; SYZ
00071A39 08                         		dc.b 8		; SBZ
00071A3A FF                         		dc.b $FF	; Invincibility
00071A3B 05                         		dc.b 5		; Extra Life
00071A3C                            		;dc.b ?		; Special Stage
00071A3C                            		;dc.b ?		; Title Screen
00071A3C                            		;dc.b ?		; Ending
00071A3C                            		;dc.b ?		; Boss
00071A3C                            		;dc.b ?		; FZ
00071A3C                            		;dc.b ?		; Sonic Got Through
00071A3C                            		;dc.b ?		; Game Over
00071A3C                            		;dc.b ?		; Continue Screen
00071A3C                            		;dc.b ?		; Credits
00071A3C                            		;dc.b ?		; Drowning
00071A3C                            		;dc.b ?		; Get Emerald
