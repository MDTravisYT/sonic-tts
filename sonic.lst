0000620E 4844                       		swap	d4		; Swap the tiles around
00006210 2C84                       		move.l	d4,(a6)		; Write top two tiles
00006212 D087                       		add.l	d7,d0		; Next row
00006214 2A80                       		move.l	d0,(a5)
00006216 2819                       		move.l	(a1)+,d4
00006218 0A84 0800 0800             		eori.l	#$8000800,d4
0000621E 4844                       		swap	d4
00006220 2C84                       		move.l	d4,(a6)		; Write bottom two tiles
00006222 4E75                       		rts	
