00012C0E                            ; Subroutine to	animate	Sonic's sprites
00012C0E                            ; ---------------------------------------------------------------------------
00012C0E                            
00012C0E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00012C0E                            
00012C0E                            
00012C0E                            Sonic_Animate:
00012C0E 43F9 0000 0000             		lea	(Ani_Sonic).l,a1
00012C14 7000                       		moveq	#0,d0
00012C16 1028 001C                  		move.b	obAnim(a0),d0
00012C1A B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
00012C1E 6700                       		beq.s	@do		; if not, branch
00012C20 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
00012C24 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
00012C2A 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
00012C30                            
00012C30                            	@do:
00012C30 D040                       		add.w	d0,d0
00012C32 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00012C36 1011                       		move.b	(a1),d0
00012C38 6B00                       		bmi.s	@walkrunroll	; if animation is walk/run/roll/jump, branch
00012C3A 1228 0022                  		move.b	obStatus(a0),d1
00012C3E 0201 0001                  		andi.b	#1,d1
00012C42 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012C48 8328 0001                  		or.b	d1,obRender(a0)
00012C4C 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00012C50 6A00                       		bpl.s	@delay		; if time remains, branch
00012C52 1140 001E                  		move.b	d0,obTimeFrame(a0) ; load frame duration
00012C56                            
00012C56                            @loadframe:
00012C56 7200                       		moveq	#0,d1
00012C58 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
00012C5C 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00012C60 6B00                       		bmi.s	@end_FF		; if animation is complete, branch
00012C62                            
00012C62                            	@next:
00012C62 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
00012C66 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
00012C6A                            
00012C6A                            	@delay:
00012C6A 4E75                       		rts	
00012C6C                            ; ===========================================================================
00012C6C                            
00012C6C                            @end_FF:
00012C6C 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00012C6E 6600                       		bne.s	@end_FE		; if not, branch
00012C70 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; restart the animation
00012C76 1029 0001                  		move.b	1(a1),d0	; read sprite number
00012C7A 60E6                       		bra.s	@next
00012C7C                            ; ===========================================================================
00012C7C                            
00012C7C                            @end_FE:
00012C7C 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00012C7E 6600                       		bne.s	@end_FD		; if not, branch
00012C80 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00012C84 9128 001B                  		sub.b	d0,obAniFrame(a0) ; jump back d0 bytes in the script
00012C88 9200                       		sub.b	d0,d1
00012C8A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00012C8E 60D2                       		bra.s	@next
00012C90                            ; ===========================================================================
00012C90                            
00012C90                            @end_FD:
00012C90 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00012C92 6600                       		bne.s	@end		; if not, branch
00012C94 1171 1002 001C             		move.b	2(a1,d1.w),obAnim(a0) ; read next byte, run that animation
00012C9A                            
00012C9A                            	@end:
00012C9A 4E75                       		rts	
00012C9C                            ; ===========================================================================
00012C9C                            
00012C9C                            @walkrunroll:
00012C9C 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00012CA0 6AC8                       		bpl.s	@delay		; if time remains, branch
00012CA2 5200                       		addq.b	#1,d0		; is animation walking/running?
00012CA4 6600 0000                  		bne.w	@rolljump	; if not, branch
00012CA8 7200                       		moveq	#0,d1
00012CAA 1028 0026                  		move.b	obAngle(a0),d0	; get Sonic's angle
00012CAE 1428 0022                  		move.b	obStatus(a0),d2
00012CB2 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00012CB6 6600                       		bne.s	@flip		; if yes, branch
00012CB8 4600                       		not.b	d0		; reverse angle
00012CBA                            
00012CBA                            	@flip:
00012CBA 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00012CBE 6A00                       		bpl.s	@noinvert	; if angle is $0-$7F, branch
00012CC0 7203                       		moveq	#3,d1
00012CC2                            
00012CC2                            	@noinvert:
00012CC2 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012CC8 B302                       		eor.b	d1,d2
00012CCA 8528 0001                  		or.b	d2,obRender(a0)
00012CCE 0828 0005 0022             		btst	#5,obStatus(a0)	; is Sonic pushing something?
00012CD4 6600 0000                  		bne.w	@push		; if yes, branch
00012CD8                            
00012CD8 E808                       		lsr.b	#4,d0		; divide angle by $10
00012CDA 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00012CDE 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012CE2 6A00                       		bpl.s	@nomodspeed
00012CE4 4442                       		neg.w	d2		; modulus speed
00012CE6                            
00012CE6                            	@nomodspeed:
00012CE6 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00012CEC 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00012CF0 6400                       		bcc.s	@running	; if yes, branch
00012CF2                            
00012CF2 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00012CF8 1200                       		move.b	d0,d1
00012CFA E209                       		lsr.b	#1,d1
00012CFC D001                       		add.b	d1,d0
00012CFE                            
00012CFE                            	@running:
00012CFE D000                       		add.b	d0,d0
00012D00 1600                       		move.b	d0,d3
00012D02 4442                       		neg.w	d2
00012D04 0642 0800                  		addi.w	#$800,d2
00012D08 6A00                       		bpl.s	@belowmax
00012D0A 7400                       		moveq	#0,d2		; max animation speed
00012D0C                            
00012D0C                            	@belowmax:
00012D0C E04A                       		lsr.w	#8,d2
00012D0E 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D12 6100 FF42                  		bsr.w	@loadframe
00012D16 D728 001A                  		add.b	d3,obFrame(a0)	; modify frame number
00012D1A 4E75                       		rts	
00012D1C                            ; ===========================================================================
00012D1C                            
00012D1C                            @rolljump:
00012D1C 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00012D1E 6600                       		bne.s	@push		; if not, branch
00012D20 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012D24 6A00                       		bpl.s	@nomodspeed2
00012D26 4442                       		neg.w	d2
00012D28                            
00012D28                            	@nomodspeed2:
00012D28 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00012D2E 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00012D32 6400                       		bcc.s	@rollfast	; if yes, branch
00012D34 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00012D3A                            
00012D3A                            	@rollfast:
00012D3A 4442                       		neg.w	d2
00012D3C 0642 0400                  		addi.w	#$400,d2
00012D40 6A00                       		bpl.s	@belowmax2
00012D42 7400                       		moveq	#0,d2
00012D44                            
00012D44                            	@belowmax2:
00012D44 E04A                       		lsr.w	#8,d2
00012D46 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D4A 1228 0022                  		move.b	obStatus(a0),d1
00012D4E 0201 0001                  		andi.b	#1,d1
00012D52 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012D58 8328 0001                  		or.b	d1,obRender(a0)
00012D5C 6000 FEF8                  		bra.w	@loadframe
00012D60                            ; ===========================================================================
00012D60                            
00012D60                            @push:
