0001D554                            lhead:	macro plc1,lvlgfx,plc2,sixteen,twofivesix,music,pal
0001D554                            	dc.l (plc1<<24)+lvlgfx
0001D554                            	dc.l (plc2<<24)+sixteen
0001D554                            	dc.l twofivesix
0001D554                            	dc.b 0, music, pal, pal
0001D554                            	endm
