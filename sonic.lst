00006C82                            
00006C82                            	@loop:
00006C82 48E7 0E00                  		movem.l	d4-d6,-(sp)
00006C86 7A00                       		moveq	#0,d5
00006C88 3204                       		move.w	d4,d1
00006C8A 6100 FF94                  		bsr.w	Calc_VRAM_Pos
00006C8E 3801                       		move.w	d1,d4
