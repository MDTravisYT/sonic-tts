00012B3C 0C38 0003 FE10             		cmpi.b	#id_SLZ,(v_zone).w ; is level SLZ ?
00012B42 6700                       		beq.s	@isstarlight	; if yes, branch
00012B44 4A38 FE10                  		tst.b	(v_zone).w	; is level GHZ ?
00012B48 6600 0000                  		bne.w	@noloops	; if not, branch
00012B4C                            
00012B4C                            	@isstarlight:
00012B4C 3028 000C                  		move.w	obY(a0),d0
00012B50 E248                       		lsr.w	#1,d0
00012B52 0240 0380                  		andi.w	#$380,d0
00012B56 1228 0008                  		move.b	obX(a0),d1
00012B5A 0241 007F                  		andi.w	#$7F,d1
00012B5E D041                       		add.w	d1,d0
00012B60 43F8 A400                  		lea	(v_lvllayout).w,a1
00012B64 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00012B68                            
00012B68 B238 F7AE                  		cmp.b	(v_256roll1).w,d1 ; is Sonic on a "roll tunnel" tile?
00012B6C 6700 FA7C                  		beq.w	Sonic_ChkRoll	; if yes, branch
00012B70 B238 F7AF                  		cmp.b	(v_256roll2).w,d1
00012B74 6700 FA74                  		beq.w	Sonic_ChkRoll
00012B78                            
00012B78 B238 F7AC                  		cmp.b	(v_256loop1).w,d1 ; is Sonic on a loop tile?
00012B7C 6700                       		beq.s	@chkifleft	; if yes, branch
00012B7E B238 F7AD                  		cmp.b	(v_256loop2).w,d1
00012B82 6700                       		beq.s	@chkifinair
00012B84 08A8 0006 0001             		bclr	#6,obRender(a0) ; return Sonic to high plane
00012B8A 4E75                       		rts	
00012B8C                            ; ===========================================================================
00012B8C                            
00012B8C                            @chkifinair:
00012B8C 0828 0001 0022             		btst	#1,obStatus(a0)	; is Sonic in the air?
00012B92 6700                       		beq.s	@chkifleft	; if not, branch
00012B94                            
00012B94 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00012B9A 4E75                       		rts	
00012B9C                            ; ===========================================================================
00012B9C                            
00012B9C                            @chkifleft:
00012B9C 3428 0008                  		move.w	obX(a0),d2
00012BA0 0C02 002C                  		cmpi.b	#$2C,d2
00012BA4 6400                       		bcc.s	@chkifright
00012BA6                            
00012BA6 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00012BAC 4E75                       		rts	
00012BAE                            ; ===========================================================================
00012BAE                            
00012BAE                            @chkifright:
00012BAE 0C02 00E0                  		cmpi.b	#$E0,d2
00012BB2 6500                       		bcs.s	@chkangle1
00012BB4                            
00012BB4 08E8 0006 0001             		bset	#6,obRender(a0)	; send Sonic to	low plane
00012BBA 4E75                       		rts	
00012BBC                            ; ===========================================================================
00012BBC                            
00012BBC                            @chkangle1:
00012BBC 0828 0006 0001             		btst	#6,obRender(a0) ; is Sonic on low plane?
00012BC2 6600                       		bne.s	@chkangle2	; if yes, branch
00012BC4                            
00012BC4 1228 0026                  		move.b	obAngle(a0),d1
00012BC8 6700                       		beq.s	@done
00012BCA 0C01 0080                  		cmpi.b	#$80,d1		; is Sonic upside-down?
00012BCE 6200                       		bhi.s	@done		; if yes, branch
00012BD0 08E8 0006 0001             		bset	#6,obRender(a0)	; send Sonic to	low plane
00012BD6 4E75                       		rts	
00012BD8                            ; ===========================================================================
00012BD8                            
00012BD8                            @chkangle2:
00012BD8 1228 0026                  		move.b	obAngle(a0),d1
00012BDC 0C01 0080                  		cmpi.b	#$80,d1		; is Sonic upright?
00012BE0 6300                       		bls.s	@done		; if yes, branch
00012BE2 08A8 0006 0001             		bclr	#6,obRender(a0)	; send Sonic to	high plane
00012BE8                            
00012BE8                            @noloops:
00012BE8                            @done:
00012BE8 4E75                       		rts	
00012BEA                            ; End of function Sonic_Loops
00012BEA                            ; End of function Sonic_Loops
00012BEA                            		include	"_incObj\Sonic Animate.asm"
00012BEA                            ; ---------------------------------------------------------------------------
00012BEA                            ; Subroutine to	animate	Sonic's sprites
00012BEA                            ; ---------------------------------------------------------------------------
00012BEA                            
00012BEA                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00012BEA                            
00012BEA                            
00012BEA                            Sonic_Animate:
00012BEA 43F9 0000 0000             		lea	(Ani_Sonic).l,a1
00012BF0 7000                       		moveq	#0,d0
00012BF2 1028 001C                  		move.b	obAnim(a0),d0
00012BF6 B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
00012BFA 6700                       		beq.s	@do		; if not, branch
00012BFC 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
00012C00 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
00012C06 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
00012C0C                            
00012C0C                            	@do:
00012C0C D040                       		add.w	d0,d0
00012C0E D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00012C12 1011                       		move.b	(a1),d0
00012C14 6B00                       		bmi.s	@walkrunroll	; if animation is walk/run/roll/jump, branch
00012C16 1228 0022                  		move.b	obStatus(a0),d1
00012C1A 0201 0001                  		andi.b	#1,d1
00012C1E 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012C24 8328 0001                  		or.b	d1,obRender(a0)
00012C28 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00012C2C 6A00                       		bpl.s	@delay		; if time remains, branch
00012C2E 1140 001E                  		move.b	d0,obTimeFrame(a0) ; load frame duration
00012C32                            
00012C32                            @loadframe:
00012C32 7200                       		moveq	#0,d1
00012C34 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
00012C38 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00012C3C 6B00                       		bmi.s	@end_FF		; if animation is complete, branch
00012C3E                            
00012C3E                            	@next:
00012C3E 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
00012C42 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
00012C46                            
00012C46                            	@delay:
00012C46 4E75                       		rts	
00012C48                            ; ===========================================================================
00012C48                            
00012C48                            @end_FF:
00012C48 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00012C4A 6600                       		bne.s	@end_FE		; if not, branch
00012C4C 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; restart the animation
00012C52 1029 0001                  		move.b	1(a1),d0	; read sprite number
00012C56 60E6                       		bra.s	@next
00012C58                            ; ===========================================================================
00012C58                            
00012C58                            @end_FE:
00012C58 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00012C5A 6600                       		bne.s	@end_FD		; if not, branch
00012C5C 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00012C60 9128 001B                  		sub.b	d0,obAniFrame(a0) ; jump back d0 bytes in the script
00012C64 9200                       		sub.b	d0,d1
00012C66 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00012C6A 60D2                       		bra.s	@next
00012C6C                            ; ===========================================================================
00012C6C                            
00012C6C                            @end_FD:
00012C6C 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00012C6E 6600                       		bne.s	@end		; if not, branch
00012C70 1171 1002 001C             		move.b	2(a1,d1.w),obAnim(a0) ; read next byte, run that animation
00012C76                            
00012C76                            	@end:
00012C76 4E75                       		rts	
00012C78                            ; ===========================================================================
00012C78                            
00012C78                            @walkrunroll:
00012C78 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00012C7C 6AC8                       		bpl.s	@delay		; if time remains, branch
00012C7E 5200                       		addq.b	#1,d0		; is animation walking/running?
00012C80 6600 0000                  		bne.w	@rolljump	; if not, branch
00012C84 7200                       		moveq	#0,d1
00012C86 1028 0026                  		move.b	obAngle(a0),d0	; get Sonic's angle
00012C8A 1428 0022                  		move.b	obStatus(a0),d2
00012C8E 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00012C92 6600                       		bne.s	@flip		; if yes, branch
00012C94 4600                       		not.b	d0		; reverse angle
00012C96                            
00012C96                            	@flip:
00012C96 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00012C9A 6A00                       		bpl.s	@noinvert	; if angle is $0-$7F, branch
00012C9C 7203                       		moveq	#3,d1
00012C9E                            
00012C9E                            	@noinvert:
00012C9E 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012CA4 B302                       		eor.b	d1,d2
00012CA6 8528 0001                  		or.b	d2,obRender(a0)
00012CAA 0828 0005 0022             		btst	#5,obStatus(a0)	; is Sonic pushing something?
00012CB0 6600 0000                  		bne.w	@push		; if yes, branch
00012CB4                            
00012CB4 E808                       		lsr.b	#4,d0		; divide angle by $10
00012CB6 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00012CBA 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012CBE 6A00                       		bpl.s	@nomodspeed
00012CC0 4442                       		neg.w	d2		; modulus speed
00012CC2                            
00012CC2                            	@nomodspeed:
00012CC2 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00012CC8 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00012CCC 6400                       		bcc.s	@running	; if yes, branch
00012CCE                            
00012CCE 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00012CD4 1200                       		move.b	d0,d1
00012CD6 E209                       		lsr.b	#1,d1
00012CD8 D001                       		add.b	d1,d0
00012CDA                            
00012CDA                            	@running:
00012CDA D000                       		add.b	d0,d0
00012CDC 1600                       		move.b	d0,d3
00012CDE 4442                       		neg.w	d2
00012CE0 0642 0800                  		addi.w	#$800,d2
00012CE4 6A00                       		bpl.s	@belowmax
00012CE6 7400                       		moveq	#0,d2		; max animation speed
00012CE8                            
00012CE8                            	@belowmax:
00012CE8 E04A                       		lsr.w	#8,d2
00012CEA 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012CEE 6100 FF42                  		bsr.w	@loadframe
00012CF2 D728 001A                  		add.b	d3,obFrame(a0)	; modify frame number
00012CF6 4E75                       		rts	
00012CF8                            ; ===========================================================================
00012CF8                            
00012CF8                            @rolljump:
00012CF8 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00012CFA 6600                       		bne.s	@push		; if not, branch
00012CFC 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012D00 6A00                       		bpl.s	@nomodspeed2
00012D02 4442                       		neg.w	d2
00012D04                            
00012D04                            	@nomodspeed2:
00012D04 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00012D0A 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00012D0E 6400                       		bcc.s	@rollfast	; if yes, branch
00012D10 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00012D16                            
00012D16                            	@rollfast:
00012D16 4442                       		neg.w	d2
00012D18 0642 0400                  		addi.w	#$400,d2
00012D1C 6A00                       		bpl.s	@belowmax2
00012D1E 7400                       		moveq	#0,d2
00012D20                            
00012D20                            	@belowmax2:
00012D20 E04A                       		lsr.w	#8,d2
00012D22 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D26 1228 0022                  		move.b	obStatus(a0),d1
00012D2A 0201 0001                  		andi.b	#1,d1
00012D2E 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012D34 8328 0001                  		or.b	d1,obRender(a0)
00012D38 6000 FEF8                  		bra.w	@loadframe
00012D3C                            ; ===========================================================================
00012D3C                            
00012D3C                            @push:
00012D3C 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012D40 6B00                       		bmi.s	@negspeed
00012D42 4442                       		neg.w	d2
00012D44                            
00012D44                            	@negspeed:
00012D44 0642 0800                  		addi.w	#$800,d2
00012D48 6A00                       		bpl.s	@belowmax3	
00012D4A 7400                       		moveq	#0,d2
00012D4C                            
00012D4C                            	@belowmax3:
00012D4C EC4A                       		lsr.w	#6,d2
00012D4E 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D52 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00012D58 1228 0022                  		move.b	obStatus(a0),d1
00012D5C 0201 0001                  		andi.b	#1,d1
00012D60 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012D66 8328 0001                  		or.b	d1,obRender(a0)
00012D6A 6000 FEC6                  		bra.w	@loadframe
00012D6E                            
00012D6E                            ; End of function Sonic_Animate
00012D6E                            ; End of function Sonic_Animate
00012D6E                            		include	"_anim\Sonic.asm"
