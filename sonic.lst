0000D532                            ; ---------------------------------------------------------------------------
0000D532                            ; Subroutine to	display	a sprite/object, when a0 is the	object RAM
0000D532                            ; ---------------------------------------------------------------------------
0000D532                            
0000D532                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D532                            
0000D532                            
0000D532                            DisplaySprite:
0000D532 43F8 AC00                  		lea	(v_spritequeue).w,a1
0000D536 3028 0018                  		move.w	obPriority(a0),d0 ; get sprite priority
0000D53A E248                       		lsr.w	#1,d0
0000D53C 0240 0380                  		andi.w	#$380,d0
0000D540 D2C0                       		adda.w	d0,a1		; jump to position in queue
0000D542 0C51 007E                  		cmpi.w	#$7E,(a1)	; is this part of the queue full?
0000D546 6400                       		bcc.s	DSpr_Full	; if yes, branch
0000D548 5451                       		addq.w	#2,(a1)		; increment sprite count
0000D54A D2D1                       		adda.w	(a1),a1		; jump to empty position
0000D54C 3288                       		move.w	a0,(a1)		; insert RAM address for object
0000D54E                            
0000D54E                            	DSpr_Full:
0000D54E 4E75                       		rts	
0000D550                            
0000D550                            ; End of function DisplaySprite
0000D550                            
