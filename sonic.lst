0000F9DE 3401                       		move.w	d1,d2
0000F9E0 D442                       		add.w	d2,d2
0000F9E2 43F8 D000                  		lea	(v_player).w,a1
0000F9E6 0829 0001 0022             		btst	#1,obStatus(a1)	; is Sonic in the air?
