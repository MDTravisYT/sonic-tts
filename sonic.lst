00053C22 4EBA 0000                  		jsr	WriteFMI(pc)
00053C26 5801                       		addq.b	#4,d1		; Move to YM2612 part 1
00053C28 4EBA 0000                  		jsr	WriteFMI(pc)
00053C2C 51CB FFF2                  		dbf	d3,@noteoffloop
00053C30                            
