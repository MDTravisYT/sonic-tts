0001491E                            		include	"_incObj\sub FindNearestTile.asm"
0001491E                            ; ---------------------------------------------------------------------------
0001491E                            ; Subroutine to	find which tile	the object is standing on
0001491E                            
0001491E                            ; input:
0001491E                            ;	d2 = y-position of object's bottom edge
0001491E                            ;	d3 = x-position of object
0001491E                            
0001491E                            ; output:
0001491E                            ;	a1 = address within 256x256 mappings where object is standing
0001491E                            ;	     (refers to a 16x16 tile number)
0001491E                            ; ---------------------------------------------------------------------------
0001491E                            
0001491E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001491E                            
0001491E                            
0001491E                            FindNearestTile:
0001491E 3002                       		move.w	d2,d0		; get y-pos. of bottom edge of object
00014920 E248                       		lsr.w	#1,d0
00014922 0240 0380                  		andi.w	#$380,d0
00014926 3203                       		move.w	d3,d1		; get x-pos. of object
