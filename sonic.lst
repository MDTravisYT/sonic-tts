000504EC                            ; ---------------------------------------------------------------------------
000504EC                            ; Priority of sound. New music or SFX must have a priority higher than or equal
000504EC                            ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
000504EC                            ; set ($80 and up), the new music or SFX will not set its priority -- meaning
000504EC                            ; any music or SFX can override it (as long as it can override whatever was
000504EC                            ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
000504EC                            ; will only override special SFX and music will only override music.
000504EC                            ; ---------------------------------------------------------------------------
000504EC                            ; SoundTypes:
000504EC                            SoundPriorities:
000504EC 9090 9090 9090 9090 9090+  		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
000504FB 9090 9090 9090 9090 9090+  		dc.b $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $90
0005050B 8070 7070 7070 7070 7070+  		dc.b $80,$70,$70,$70,$70,$70,$70,$70,$70,$70,$68,$70,$70,$70,$60,$70	; $A0
0005051B 7060 7060 7070 7070 7070+  		dc.b $70,$60,$70,$60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$7F	; $B0
0005052B 6070 7070 7070 7070 7070+  		dc.b $60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70	; $C0
0005053B 8080 8080 8080 8080 8080+  		dc.b $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80	; $D0
0005054B 9090 9090 90               		dc.b $90,$90,$90,$90,$90                                            	; $E0
00050550                            
