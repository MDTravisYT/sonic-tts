00006CDA 301A                       		move.w	(a2)+,d0
00006CDC 3012                       		move.w	(a2),d0
00006CDE 0240 00FF                  		andi.w	#$FF,d0
00006CE2 0C78 0103 FE10             		cmpi.w	#(id_LZ<<8)+3,(v_zone).w ; is level SBZ3 (LZ4) ?
00006CE8 6600                       		bne.s	@notSBZ3	; if not, branch
00006CEA 700C                       		moveq	#palid_SBZ3,d0	; use SB3 palette
00006CEC                            
00006CEC                            	@notSBZ3:
00006CEC 0C78 0501 FE10             		cmpi.w	#(id_SBZ<<8)+1,(v_zone).w ; is level SBZ2?
00006CF2 6700                       		beq.s	@isSBZorFZ	; if yes, branch
