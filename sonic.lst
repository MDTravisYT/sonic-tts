000061EE                            ; Draws a block's worth of tiles
000061EE                            ; Parameters:
000061EE                            ; a0 = Pointer to block metadata (block index and X/Y flip)
000061EE                            ; a1 = Pointer to block
000061EE                            ; a5 = Pointer to VDP command port
000061EE                            ; a6 = Pointer to VDP data port
000061EE                            ; d0 = VRAM command to access plane
000061EE                            ; d2 = VRAM plane A/B specifier
000061EE                            ; d7 = Plane row delta
