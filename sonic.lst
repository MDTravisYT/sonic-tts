0000C7CC                            ; ---------------------------------------------------------------------------
0000C7CC                            ; Subroutine to	make an	object fall downwards, increasingly fast
0000C7CC                            ; ---------------------------------------------------------------------------
0000C7CC                            
0000C7CC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000C7CC                            
0000C7CC                            
0000C7CC                            ObjectFall:
0000C7CC 2428 0008                  		move.l	obX(a0),d2
0000C7D0 2628 000C                  		move.l	obY(a0),d3
0000C7D4 3028 0010                  		move.w	obVelX(a0),d0
0000C7D8 48C0                       		ext.l	d0
0000C7DA E180                       		asl.l	#8,d0
0000C7DC D480                       		add.l	d0,d2
0000C7DE 3028 0012                  		move.w	obVelY(a0),d0
0000C7E2 0668 0038 0012             		addi.w	#$38,obVelY(a0)	; increase vertical speed
0000C7E8 48C0                       		ext.l	d0
0000C7EA E180                       		asl.l	#8,d0
0000C7EC D680                       		add.l	d0,d3
0000C7EE 2142 0008                  		move.l	d2,obX(a0)
0000C7F2 2143 000C                  		move.l	d3,obY(a0)
0000C7F6 4E75                       		rts	
0000C7F8                            
0000C7F8                            ; End of function ObjectFall
