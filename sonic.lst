00072DB6                            ; ---------------------------------------------------------------------------
00072DB6                            ; Priority of sound. New music or SFX must have a priority higher than or equal
00072DB6                            ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
00072DB6                            ; set ($80 and up), the new music or SFX will not set its priority -- meaning
00072DB6                            ; any music or SFX can override it (as long as it can override whatever was
00072DB6                            ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
00072DB6                            ; will only override special SFX and music will only override music.
00072DB6                            ; ---------------------------------------------------------------------------
00072DB6                            ; SoundTypes:
00072DB6                            SoundPriorities:
00072DB6 9090 9090 9090 9090 9090+  		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
00072DC5 9090 9090 9090 9090 9090+  		dc.b $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $90
00072DD5 8070 7070 7070 7070 7070+  		dc.b $80,$70,$70,$70,$70,$70,$70,$70,$70,$70,$68,$70,$70,$70,$60,$70	; $A0
00072DE5 7060 7060 7070 7070 7070+  		dc.b $70,$60,$70,$60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$7F	; $B0
00072DF5 6070 7070 7070 7070 7070+  		dc.b $60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70	; $C0
00072E05 8080 8080 8080 8080 8080+  		dc.b $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80	; $D0
00072E15 9090 9090 90               		dc.b $90,$90,$90,$90,$90                                            	; $E0
00072E1A                            
00072E1A                            ; ---------------------------------------------------------------------------
00072E1A                            ; Subroutine to update music more than once per frame
00072E1A                            ; (Called by horizontal & vert. interrupts)
00072E1A                            ; ---------------------------------------------------------------------------
00072E1A                            
00072E1A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00072E1A                            
00072E1A                            ; sub_71B4C:
00072E1A                            UpdateMusic:
00072E1A 33FC 0100 00A1 1100        		stopZ80
00072E22 4E71                       		nop	
00072E24 4E71                       		nop	
00072E26 4E71                       		nop	
00072E28                            ; loc_71B5A:
00072E28                            @updateloop:
00072E28 0839 0000 00A1 1100        		btst	#0,(z80_bus_request).l		; Is the z80 busy?
00072E30 66F6                       		bne.s	@updateloop			; If so, wait
00072E32                            
00072E32 0839 0007 00A0 1FFD        		btst	#7,(z80_dac_status).l		; Is DAC accepting new samples?
00072E3A 6700                       		beq.s	@driverinput			; Branch if yes
00072E3C 33FC 0000 00A1 1100        		startZ80
00072E44 4E71                       		nop	
00072E46 4E71                       		nop	
00072E48 4E71                       		nop	
00072E4A 4E71                       		nop	
00072E4C 4E71                       		nop	
00072E4E 60CA                       		bra.s	UpdateMusic
00072E50                            ; ===========================================================================
00072E50                            ; loc_71B82:
00072E50                            @driverinput:
00072E50 4DF9 00FF F000             		lea	(v_snddriver_ram&$FFFFFF).l,a6
00072E56 422E 000E                  		clr.b	f_voice_selector(a6)
00072E5A 4A2E 0003                  		tst.b	f_pausemusic(a6)		; is music paused?
00072E5E 6600 0000                  		bne.w	PauseMusic			; if yes, branch
00072E62 532E 0001                  		subq.b	#1,v_main_tempo_timeout(a6)	; Has main tempo timer expired?
00072E66 6600                       		bne.s	@skipdelay
00072E68 4EBA 0000                  		jsr	TempoWait(pc)
00072E6C                            ; loc_71B9E:
00072E6C                            @skipdelay:
00072E6C 102E 0004                  		move.b	v_fadeout_counter(a6),d0
00072E70 6700                       		beq.s	@skipfadeout
00072E72 4EBA 0000                  		jsr	DoFadeOut(pc)
00072E76                            ; loc_71BA8:
00072E76                            @skipfadeout:
00072E76 4A2E 0024                  		tst.b	f_fadein_flag(a6)
00072E7A 6700                       		beq.s	@skipfadein
00072E7C 4EBA 0000                  		jsr	DoFadeIn(pc)
00072E80                            ; loc_71BB2:
00072E80                            @skipfadein:
00072E80                            		; DANGER! The following line only checks v_soundqueue0 and v_soundqueue1, breaking v_soundqueue2.
00072E80 4A6E 000A                  		tst.w	v_soundqueue0(a6)	; is a music or sound queued for played?
00072E84 6700                       		beq.s	@nosndinput		; if not, branch
00072E86 4EBA 0000                  		jsr	CycleSoundQueue(pc)
00072E8A                            ; loc_71BBC:
00072E8A                            @nosndinput:
00072E8A 0C2E 0080 0009             		cmpi.b	#$80,v_sound_id(a6)	; is song queue set for silence (empty)?
00072E90 6700                       		beq.s	@nonewsound		; If yes, branch
00072E92 4EBA 0000                  		jsr	PlaySoundID(pc)
00072E96                            ; loc_71BC8:
00072E96                            @nonewsound:
00072E96 4BEE 0040                  		lea	v_music_dac_track(a6),a5
00072E9A 4A15                       		tst.b	(a5)			; Is DAC track playing? (TrackPlaybackControl)
00072E9C 6A00                       		bpl.s	@dacdone		; Branch if not
00072E9E 4EBA 0000                  		jsr	DACUpdateTrack(pc)
00072EA2                            ; loc_71BD4:
00072EA2                            @dacdone:
00072EA2 422E 0008                  		clr.b	f_updating_dac(a6)
00072EA6 7E05                       		moveq	#((v_music_fm_tracks_end-v_music_fm_tracks)/TrackSz)-1,d7	; 6 FM tracks
00072EA8                            ; loc_71BDA:
00072EA8                            @bgmfmloop:
00072EA8 DAFC 0030                  		adda.w	#TrackSz,a5
00072EAC 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00072EAE 6A00                       		bpl.s	@bgmfmnext		; Branch if not
00072EB0 4EBA 0000                  		jsr	FMUpdateTrack(pc)
00072EB4                            ; loc_71BE6:
00072EB4                            @bgmfmnext:
00072EB4 51CF FFF2                  		dbf	d7,@bgmfmloop
00072EB8                            
00072EB8 7E02                       		moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d7 ; 3 PSG tracks
00072EBA                            ; loc_71BEC:
00072EBA                            @bgmpsgloop:
00072EBA DAFC 0030                  		adda.w	#TrackSz,a5
00072EBE 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00072EC0 6A00                       		bpl.s	@bgmpsgnext		; Branch if not
00072EC2 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
00072EC6                            ; loc_71BF8:
00072EC6                            @bgmpsgnext:
00072EC6 51CF FFF2                  		dbf	d7,@bgmpsgloop
00072ECA                            
00072ECA 1D7C 0080 000E             		move.b	#$80,f_voice_selector(a6)			; Now at SFX tracks
00072ED0 7E02                       		moveq	#((v_sfx_fm_tracks_end-v_sfx_fm_tracks)/TrackSz)-1,d7	; 3 FM tracks (SFX)
00072ED2                            ; loc_71C04:
00072ED2                            @sfxfmloop:
00072ED2 DAFC 0030                  		adda.w	#TrackSz,a5
00072ED6 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00072ED8 6A00                       		bpl.s	@sfxfmnext		; Branch if not
00072EDA 4EBA 0000                  		jsr	FMUpdateTrack(pc)
00072EDE                            ; loc_71C10:
00072EDE                            @sfxfmnext:
00072EDE 51CF FFF2                  		dbf	d7,@sfxfmloop
00072EE2                            
00072EE2 7E02                       		moveq	#((v_sfx_psg_tracks_end-v_sfx_psg_tracks)/TrackSz)-1,d7 ; 3 PSG tracks (SFX)
00072EE4                            ; loc_71C16:
00072EE4                            @sfxpsgloop:
00072EE4 DAFC 0030                  		adda.w	#TrackSz,a5
00072EE8 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00072EEA 6A00                       		bpl.s	@sfxpsgnext		; Branch of not
00072EEC 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
00072EF0                            ; loc_71C22:
00072EF0                            @sfxpsgnext:
00072EF0 51CF FFF2                  		dbf	d7,@sfxpsgloop
00072EF4                            		
00072EF4 1D7C 0040 000E             		move.b	#$40,f_voice_selector(a6) ; Now at special SFX tracks
00072EFA DAFC 0030                  		adda.w	#TrackSz,a5
00072EFE 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00072F00 6A00                       		bpl.s	@specfmdone		; Branch if not
00072F02 4EBA 0000                  		jsr	FMUpdateTrack(pc)
