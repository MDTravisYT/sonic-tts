00053A92                            StopSFX:
00053A92 422E 0000                  		clr.b	v_sndprio(a6)		; Clear priority
00053A96 4BEE 0220                  		lea	v_sfx_track_ram(a6),a5
00053A9A 7E05                       		moveq	#((v_sfx_track_ram_end-v_sfx_track_ram)/TrackSz)-1,d7	; 3 FM + 3 PSG tracks (SFX)
00053A9C                            ; loc_723EA:
00053A9C                            @trackloop:
00053A9C 4A15                       		tst.b	(a5)		; Is track playing? (TrackPlaybackControl)
00053A9E 6A00 0000                  		bpl.w	@nexttrack	; Branch if not
00053AA2 0895 0007                  		bclr	#7,(a5)		; Stop track (TrackPlaybackControl)
00053AA6 7600                       		moveq	#0,d3
00053AA8 162D 0001                  		move.b	TrackVoiceControl(a5),d3	; Get voice control bits
00053AAC 6B00                       		bmi.s	@trackpsg			; Branch if PSG
00053AAE 4EBA 0000                  		jsr	FMNoteOff(pc)
00053AB2 0C03 0004                  		cmpi.b	#4,d3						; Is this FM4?
00053AB6 6600                       		bne.s	@getfmpointer					; Branch if not
00053AB8 4A2E 0340                  		tst.b	v_spcsfx_fm4_track+TrackPlaybackControl(a6)	; Is special SFX playing?
00053ABC 6A00                       		bpl.s	@getfmpointer					; Branch if not
00053ABE                            		; DANGER! there is a missing 'movea.l	a5,a3' here, without which the
00053ABE                            		; code is broken. It is dangerous to do a fade out when a GHZ waterfall
00053ABE                            		; is playing its sound!
00053ABE 4BEE 0340                  		lea	v_spcsfx_fm4_track(a6),a5
00053AC2 226E 0020                  		movea.l	v_special_voice_ptr(a6),a1	; Get special voice pointer
00053AC6 6000                       		bra.s	@gotfmpointer
