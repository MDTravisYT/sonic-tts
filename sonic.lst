00019B5A                            ReactToItem:
00019B5A 4E71                       		nop	
00019B5C 3428 0008                  		move.w	obX(a0),d2	; load Sonic's x-axis position
00019B60 3628 000C                  		move.w	obY(a0),d3	; load Sonic's y-axis position
