00006D02 245F                       		movea.l	(sp)+,a2
00006D04 584A                       		addq.w	#4,a2		; read number for 2nd PLC
00006D06 7000                       		moveq	#0,d0
00006D08 1012                       		move.b	(a2),d0
00006D0A 6700                       		beq.s	@skipPLC	; if 2nd PLC is 0 (i.e. the ending sequence), branch
00006D0C 6100 A872                  		bsr.w	AddPLC		; load pattern load cues
00006D10                            
00006D10                            	@skipPLC:
00006D10 4E75                       		rts	
