000062C2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000062C2                            
000062C2                            ; Produces a VRAM plane access command from coordinates
000062C2                            ; Parameters:
000062C2                            ; d4 = Relative Y coordinate
000062C2                            ; d5 = Relative X coordinate
000062C2                            ; Returns VDP command in d0
000062C2                            Calc_VRAM_Pos:
000062C2 D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate
000062C6 DA53                       		add.w	(a3),d5		; Add camera X coordinate
000062C8                            		; Floor the coordinates to the nearest pair of tiles (the size of a block).
000062C8                            		; Also note that this wraps the value to the size of the plane:
000062C8                            		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
000062C8 0244 00F0                  		andi.w	#$F0,d4
000062CC 0245 01F0                  		andi.w	#$1F0,d5
000062D0                            		; Transform the adjusted coordinates into a VDP command
000062D0 E94C                       		lsl.w	#4,d4
000062D2 E44D                       		lsr.w	#2,d5
000062D4 D845                       		add.w	d5,d4
000062D6 7003                       		moveq	#3,d0	; Highest bits of plane VRAM address
000062D8 4840                       		swap	d0
000062DA 3004                       		move.w	d4,d0
000062DC 4E75                       		rts	
000062DE                            ; End of function Calc_VRAM_Pos
000062DE                            
000062DE                            
000062DE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000062DE                            ; not used
000062DE                            
000062DE                            ; This is just like Calc_VRAM_Pos, but seemingly for an earlier
000062DE                            ; VRAM layout: the only difference is the high bits of the
000062DE                            ; plane's VRAM address, which are 10 instead of 11.
000062DE                            ; Both the foreground and background are at $C000 and $E000
000062DE                            ; respectively, so this one starting at $8000 makes no sense.
000062DE                            ; sub_6C3C:
000062DE                            Calc_VRAM_Pos_Unknown:
000062DE D86B 0004                  		add.w	4(a3),d4
000062E2 DA53                       		add.w	(a3),d5
000062E4 0244 00F0                  		andi.w	#$F0,d4
000062E8 0245 01F0                  		andi.w	#$1F0,d5
000062EC E94C                       		lsl.w	#4,d4
000062EE E44D                       		lsr.w	#2,d5
000062F0 D845                       		add.w	d5,d4
000062F2 7002                       		moveq	#2,d0
000062F4 4840                       		swap	d0
000062F6 3004                       		move.w	d4,d0
000062F8 4E75                       		rts	
000062FA                            ; End of function Calc_VRAM_Pos_Unknown
