000061D4                            ; Draws a block's worth of tiles
000061D4                            ; Parameters:
000061D4                            ; a0 = Pointer to block metadata (block index and X/Y flip)
000061D4                            ; a1 = Pointer to block
000061D4                            ; a5 = Pointer to VDP command port
000061D4                            ; a6 = Pointer to VDP data port
000061D4                            ; d0 = VRAM command to access plane
000061D4                            ; d2 = VRAM plane A/B specifier
000061D4                            ; d7 = Plane row delta
