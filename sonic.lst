000013E8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000013E8                            ; Queue pattern load requests, but clear the PLQ first
000013E8                            
000013E8                            ; ARGUMENTS
000013E8                            ; d0 = index of PLC list (see ArtLoadCues)
000013E8                            
000013E8                            ; NOTICE: This subroutine does not check for buffer overruns. The programmer
000013E8                            ;	  (or hacker) is responsible for making sure that no more than
000013E8                            ;	  16 load requests are copied into the buffer.
000013E8                            ;	  _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
000013E8                            ;         (or if you change the size of Plc_Buffer, the limit becomes (Plc_Buffer_Only_End-Plc_Buffer)/6)
000013E8                            
000013E8                            ; LoadPLC2:
000013E8                            NewPLC:
000013E8 48E7 0060                  		movem.l	a1-a2,-(sp)
000013EC 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
000013F2 D040                       		add.w	d0,d0
000013F4 3031 0000                  		move.w	(a1,d0.w),d0
000013F8 43F1 0000                  		lea	(a1,d0.w),a1	; jump to relevant PLC
000013FC 6100                       		bsr.s	ClearPLC	; erase any data in PLC buffer space
000013FE 45F8 F680                  		lea	(v_plc_buffer).w,a2
00001402 3019                       		move.w	(a1)+,d0	; get length of PLC
00001404 6B00                       		bmi.s	@skip		; if it's negative, skip the next loop
00001406                            
00001406                            	@loop:
00001406 24D9                       		move.l	(a1)+,(a2)+
00001408 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
0000140A 51C8 FFFA                  		dbf	d0,@loop		; repeat for length of PLC
0000140E                            
0000140E                            	@skip:
0000140E 4CDF 0600                  		movem.l	(sp)+,a1-a2
00001412 4E75                       		rts	
00001414                            ; End of function NewPLC
00001414                            
