00001370                            		include	"_inc\PauseGame.asm"
00001370                            ; ---------------------------------------------------------------------------
00001370                            ; Subroutine to	pause the game
00001370                            ; ---------------------------------------------------------------------------
00001370                            
00001370                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001370                            
00001370                            
00001370                            PauseGame:
00001370 4E71                       		nop	
00001372 4A38 FE12                  		tst.b	(v_lives).w	; do you have any lives	left?
00001376 6700                       		beq.s	Unpause		; if not, branch
00001378 4A78 F63A                  		tst.w	(f_pause).w	; is game already paused?
0000137C 6600                       		bne.s	Pause_StopGame	; if yes, branch
0000137E 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
00001384 6700                       		beq.s	Pause_DoNothing	; if not, branch
00001386                            
00001386                            Pause_StopGame:
00001386 31FC 0001 F63A             		move.w	#1,(f_pause).w	; freeze time
0000138C 11FC 0001 F003             		move.b	#1,(v_snddriver_ram+f_pausemusic).w ; pause music
00001392                            
00001392                            Pause_Loop:
00001392 11FC 0010 F62A             		move.b	#$10,(v_vbla_routine).w
00001398 6100 0000                  		bsr.w	WaitForVBla
0000139C 4A38 FFE1                  		tst.b	(f_slomocheat).w ; is slow-motion cheat on?
000013A0 6700                       		beq.s	Pause_ChkStart	; if not, branch
000013A2 0838 0006 F605             		btst	#bitA,(v_jpadpress1).w ; is button A pressed?
000013A8 6700                       		beq.s	Pause_ChkBC	; if not, branch
000013AA 11FC 0000 F600             		move.b	#id_Title,(v_gamemode).w ; set game mode to 4 (title screen)
000013B0 4E71                       		nop	
000013B2 6000                       		bra.s	Pause_EndMusic
000013B4                            ; ===========================================================================
000013B4                            
000013B4                            Pause_ChkBC:
000013B4 0838 0004 F604             		btst	#bitB,(v_jpadhold1).w ; is button B pressed?
000013BA 6600                       		bne.s	Pause_SlowMo	; if yes, branch
000013BC 0838 0005 F605             		btst	#bitC,(v_jpadpress1).w ; is button C pressed?
000013C2 6600                       		bne.s	Pause_SlowMo	; if yes, branch
000013C4                            
000013C4                            Pause_ChkStart:
000013C4 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
000013CA 67C6                       		beq.s	Pause_Loop	; if not, branch
000013CC                            
000013CC                            Pause_EndMusic:
000013CC 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; unpause the music
000013D2                            
000013D2                            Unpause:
000013D2 31FC 0000 F63A             		move.w	#0,(f_pause).w	; unpause the game
000013D8                            
000013D8                            Pause_DoNothing:
000013D8 4E75                       		rts	
000013DA                            ; ===========================================================================
000013DA                            
000013DA                            Pause_SlowMo:
000013DA 31FC 0001 F63A             		move.w	#1,(f_pause).w
000013E0 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; Unpause the music
000013E6 4E75                       		rts	
000013E8                            ; End of function PauseGame
000013E8                            ; End of function PauseGame
