0000D55A 0240 0380                  		andi.w	#$380,d0
0000D55E D4C0                       		adda.w	d0,a2
0000D560 0C52 007E                  		cmpi.w	#$7E,(a2)
0000D564 6400                       		bcc.s	DSpr1_Full
0000D566 5452                       		addq.w	#2,(a2)
0000D568 D4D2                       		adda.w	(a2),a2
0000D56A 3489                       		move.w	a1,(a2)
0000D56C                            
0000D56C                            	DSpr1_Full:
0000D56C 4E75                       		rts	
0000D56E                            
0000D56E                            ; End of function DisplaySprite1
