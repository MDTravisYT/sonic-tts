00051002 1D7C 0080 0009             		move.b	#$80,v_sound_id(a6)	; set music to $80 (silence)
00051008                            		; DANGER! This silences ALL channels, even the ones being used
00051008                            		; by SFX, and not music! @sendfmnoteoff does this already, and
00051008                            		; doesn't affect SFX channels, either.
00051008                            		; This should be replaced with an 'rts'.
00051008 4EBA FF64                  		jsr	FMSilenceAll(pc)
0005100C 6000 0000                  		bra.w	PSGSilenceAll
00051010                            		; DANGER! InitMusicPlayback, and Sound_PlayBGM for that matter,
00051010                            		; don't do a very good job of setting up the music tracks.
00051010                            		; Tracks that aren't defined in a music file's header don't have
00051010                            		; their channels defined, meaning @sendfmnoteoff won't silence
00051010                            		; hardware properly. In combination with removing the above
00051010                            		; calls to FMSilenceAll/PSGSilenceAll, this will cause hanging
00051010                            		; notes.
00051010                            		; To fix this, I suggest using this code, instead of an 'rts':
00051010                            		;lea	v_music_track_ram+TrackVoiceControl(a6),a1
00051010                            		;lea	FMDACInitBytes(pc),a2
00051010                            		;moveq	#((v_music_fmdac_tracks_end-v_music_fmdac_tracks)/TrackSz)-1,d1		; 7 DAC/FM tracks
00051010                            		;bsr.s	@writeloop
00051010                            		;lea	PSGInitBytes(pc),a2
00051010                            		;moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d1	; 3 PSG tracks
00051010                            
00051010                            ;@writeloop:
00051010                            		;move.b	(a2)+,(a1)		; Write track's channel byte
00051010                            		;lea	TrackSz(a1),a1		; Next track
00051010                            		;dbf	d1,@writeloop		; Loop for all DAC/FM/PSG tracks
00051010                            
00051010                            		;rts
00051010                            	
00051010                            ; End of function InitMusicPlayback
