0005319A                            ; ---------------------------------------------------------------------------
0005319A                            ; Priority of sound. New music or SFX must have a priority higher than or equal
0005319A                            ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
0005319A                            ; set ($80 and up), the new music or SFX will not set its priority -- meaning
0005319A                            ; any music or SFX can override it (as long as it can override whatever was
0005319A                            ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
0005319A                            ; will only override special SFX and music will only override music.
0005319A                            ; ---------------------------------------------------------------------------
0005319A                            ; SoundTypes:
0005319A                            SoundPriorities:
0005319A 9090 9090 9090 9090 9090+  		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
