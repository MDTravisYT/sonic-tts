0000C7BC                            ; ---------------------------------------------------------------------------
0000C7BC                            ; Subroutine to	make an	object fall downwards, increasingly fast
0000C7BC                            ; ---------------------------------------------------------------------------
0000C7BC                            
0000C7BC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000C7BC                            
0000C7BC                            
0000C7BC                            ObjectFall:
0000C7BC 2428 0008                  		move.l	obX(a0),d2
0000C7C0 2628 000C                  		move.l	obY(a0),d3
0000C7C4 3028 0010                  		move.w	obVelX(a0),d0
0000C7C8 48C0                       		ext.l	d0
0000C7CA E180                       		asl.l	#8,d0
0000C7CC D480                       		add.l	d0,d2
0000C7CE 3028 0012                  		move.w	obVelY(a0),d0
0000C7D2 0668 0038 0012             		addi.w	#$38,obVelY(a0)	; increase vertical speed
0000C7D8 48C0                       		ext.l	d0
0000C7DA E180                       		asl.l	#8,d0
0000C7DC D680                       		add.l	d0,d3
0000C7DE 2142 0008                  		move.l	d2,obX(a0)
0000C7E2 2143 000C                  		move.l	d3,obY(a0)
0000C7E6 4E75                       		rts	
0000C7E8                            
0000C7E8                            ; End of function ObjectFall
0000C7E8                            ; End of function ObjectFall
0000C7E8                            		include	"_incObj\sub SpeedToPos.asm"
0000C7E8                            ; ---------------------------------------------------------------------------
0000C7E8                            ; Subroutine translating object	speed to update	object position
0000C7E8                            ; ---------------------------------------------------------------------------
0000C7E8                            
0000C7E8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000C7E8                            
0000C7E8                            
0000C7E8                            SpeedToPos:
0000C7E8 2428 0008                  		move.l	obX(a0),d2
0000C7EC 2628 000C                  		move.l	obY(a0),d3
0000C7F0 3028 0010                  		move.w	obVelX(a0),d0	; load horizontal speed
0000C7F4 48C0                       		ext.l	d0
0000C7F6 E180                       		asl.l	#8,d0		; multiply speed by $100
0000C7F8 D480                       		add.l	d0,d2		; add to x-axis	position
0000C7FA 3028 0012                  		move.w	obVelY(a0),d0	; load vertical	speed
