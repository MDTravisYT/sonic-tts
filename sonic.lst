00006ACC                            LoadTilesFromStart:
00006ACC 4BF9 00C0 0004             		lea	(vdp_control_port).l,a5
00006AD2 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
00006AD8 47F8 F700                  		lea	(v_screenposx).w,a3
00006ADC 49F8 A400                  		lea	(v_lvllayout).w,a4
00006AE0 343C 4000                  		move.w	#$4000,d2
00006AE4 6100                       		bsr.s	DrawChunks
00006AE6 47F8 F708                  		lea	(v_bgscreenposx).w,a3
