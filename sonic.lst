000019DA D040                       		add.w	d0,d0
000019DC D041                       		add.w	d1,d0
000019DE 41F9 0000 0000             		lea	(Pal_LZCyc2).l,a0
000019E4 43F8 FB76                  		lea	(v_pal_dry+$76).w,a1
000019E8 22F0 0000                  		move.l	(a0,d0.w),(a1)+
