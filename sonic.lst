000061E8                            
000061E8                            ; Draws a block's worth of tiles
000061E8                            ; Parameters:
000061E8                            ; a0 = Pointer to block metadata (block index and X/Y flip)
000061E8                            ; a1 = Pointer to block
000061E8                            ; a5 = Pointer to VDP command port
000061E8                            ; a6 = Pointer to VDP data port
000061E8                            ; d0 = VRAM command to access plane
000061E8                            ; d2 = VRAM plane A/B specifier
000061E8                            ; d7 = Plane row delta
000061E8                            ; DrawTiles:
000061E8                            DrawBlock:
000061E8 8042                       		or.w	d2,d0	; OR in that plane A/B specifier to the VRAM command
000061EA 4840                       		swap	d0
000061EC 0810 0004                  		btst	#4,(a0)	; Check Y-flip bit
000061F0 6600                       		bne.s	DrawFlipY
000061F2 0810 0003                  		btst	#3,(a0)	; Check X-flip bit
000061F6 6600                       		bne.s	DrawFlipX
000061F8 2A80                       		move.l	d0,(a5)
000061FA 2C99                       		move.l	(a1)+,(a6)	; Write top two tiles
000061FC D087                       		add.l	d7,d0		; Next row
000061FE 2A80                       		move.l	d0,(a5)
00006200 2C99                       		move.l	(a1)+,(a6)	; Write bottom two tiles
00006202 4E75                       		rts	
