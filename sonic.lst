000069A6                            ; Draws a block's worth of tiles
000069A6                            ; Parameters:
000069A6                            ; a0 = Pointer to block metadata (block index and X/Y flip)
000069A6                            ; a1 = Pointer to block
000069A6                            ; a5 = Pointer to VDP command port
000069A6                            ; a6 = Pointer to VDP data port
000069A6                            ; d0 = VRAM command to access plane
000069A6                            ; d2 = VRAM plane A/B specifier
000069A6                            ; d7 = Plane row delta
000069A6                            ; DrawTiles:
000069A6                            DrawBlock:
000069A6 8042                       		or.w	d2,d0	; OR in that plane A/B specifier to the VRAM command
000069A8 4840                       		swap	d0
000069AA 0810 0004                  		btst	#4,(a0)	; Check Y-flip bit
000069AE 6600                       		bne.s	DrawFlipY
000069B0 0810 0003                  		btst	#3,(a0)	; Check X-flip bit
000069B4 6600                       		bne.s	DrawFlipX
000069B6 2A80                       		move.l	d0,(a5)
000069B8 2C99                       		move.l	(a1)+,(a6)	; Write top two tiles
000069BA D087                       		add.l	d7,d0		; Next row
000069BC 2A80                       		move.l	d0,(a5)
000069BE 2C99                       		move.l	(a1)+,(a6)	; Write bottom two tiles
000069C0 4E75                       		rts	
000069C2                            ; ===========================================================================
000069C2                            
000069C2                            DrawFlipX:
000069C2 2A80                       		move.l	d0,(a5)
000069C4 2819                       		move.l	(a1)+,d4
000069C6 0A84 0800 0800             		eori.l	#$8000800,d4	; Invert X-flip bits of each tile
000069CC 4844                       		swap	d4		; Swap the tiles around
000069CE 2C84                       		move.l	d4,(a6)		; Write top two tiles
000069D0 D087                       		add.l	d7,d0		; Next row
000069D2 2A80                       		move.l	d0,(a5)
000069D4 2819                       		move.l	(a1)+,d4
000069D6 0A84 0800 0800             		eori.l	#$8000800,d4
000069DC 4844                       		swap	d4
000069DE 2C84                       		move.l	d4,(a6)		; Write bottom two tiles
000069E0 4E75                       		rts	
000069E2                            ; ===========================================================================
000069E2                            
000069E2                            DrawFlipY:
000069E2 0810 0003                  		btst	#3,(a0)
000069E6 6600                       		bne.s	DrawFlipXY
000069E8 2A80                       		move.l	d0,(a5)
000069EA 2A19                       		move.l	(a1)+,d5
000069EC 2819                       		move.l	(a1)+,d4
000069EE 0A84 1000 1000             		eori.l	#$10001000,d4
000069F4 2C84                       		move.l	d4,(a6)
000069F6 D087                       		add.l	d7,d0
000069F8 2A80                       		move.l	d0,(a5)
000069FA 0A85 1000 1000             		eori.l	#$10001000,d5
00006A00 2C85                       		move.l	d5,(a6)
00006A02 4E75                       		rts	
00006A04                            ; ===========================================================================
00006A04                            
00006A04                            DrawFlipXY:
00006A04 2A80                       		move.l	d0,(a5)
00006A06 2A19                       		move.l	(a1)+,d5
00006A08 2819                       		move.l	(a1)+,d4
00006A0A 0A84 1800 1800             		eori.l	#$18001800,d4
00006A10 4844                       		swap	d4
00006A12 2C84                       		move.l	d4,(a6)
00006A14 D087                       		add.l	d7,d0
00006A16 2A80                       		move.l	d0,(a5)
00006A18 0A85 1800 1800             		eori.l	#$18001800,d5
00006A1E 4845                       		swap	d5
00006A20 2C85                       		move.l	d5,(a6)
00006A22 4E75                       		rts	
00006A24                            ; End of function DrawBlocks
