00006B20 E948                       		lsl.w	#4,d0
00006B22 45F9 0000 0000             		lea	(LevelHeaders).l,a2
00006B28 45F2 0000                  		lea	(a2,d0.w),a2
00006B2C 2F0A                       		move.l	a2,-(sp)
00006B2E 588A                       		addq.l	#4,a2
00006B30 205A                       		movea.l	(a2)+,a0
00006B32 43F8 B000                  		lea	(v_16x16).w,a1	; RAM address for 16x16 mappings
00006B36 303C 0000                  		move.w	#0,d0
