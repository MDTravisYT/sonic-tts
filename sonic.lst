00050DCC                            ; ===========================================================================
00050DCC                            ; ---------------------------------------------------------------------------
00050DCC                            ; Unused RAM addresses for FM and PSG channel variables used by the Special SFX
00050DCC                            ; ---------------------------------------------------------------------------
00050DCC                            ; The first block would have been used for overriding the music tracks
00050DCC                            ; as they have a lower priority, just as they are in Sound_PlaySFX
00050DCC                            ; The third block would be used to set up the Special SFX
00050DCC                            ; The second block, however, is for the SFX tracks, which have a higher priority
00050DCC                            ; and would be checked for if they're currently playing
00050DCC                            ; If they are, then the third block would be used again, this time to mark
00050DCC                            ; the new tracks as 'currently playing'
00050DCC                            
00050DCC                            ; These were actually used in Moonwalker's driver (and other SMPS 68k Type 1a drivers)
00050DCC                            
00050DCC                            ; BGMFM4PSG3RAM:
00050DCC                            ;SpecSFX_BGMChannelRAM:
00050DCC 00FF F100                  		dc.l (v_snddriver_ram+v_music_fm4_track)&$FFFFFF
00050DD0 00FF F1F0                  		dc.l (v_snddriver_ram+v_music_psg3_track)&$FFFFFF
00050DD4                            ; SFXFM4PSG3RAM:
00050DD4                            ;SpecSFX_SFXChannelRAM:
00050DD4 00FF F250                  		dc.l (v_snddriver_ram+v_sfx_fm4_track)&$FFFFFF
00050DD8 00FF F310                  		dc.l (v_snddriver_ram+v_sfx_psg3_track)&$FFFFFF
00050DDC                            ; SpecialSFXFM4PSG3RAM:
00050DDC                            ;SpecSFX_SpecSFXChannelRAM:
00050DDC 00FF F340                  		dc.l (v_snddriver_ram+v_spcsfx_fm4_track)&$FFFFFF
00050DE0 00FF F370                  		dc.l (v_snddriver_ram+v_spcsfx_psg3_track)&$FFFFFF
