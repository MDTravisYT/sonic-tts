000061D4 8042                       		or.w	d2,d0	; OR in that plane A/B specifier to the VRAM command
000061D6 4840                       		swap	d0
000061D8 0810 0004                  		btst	#4,(a0)	; Check Y-flip bit
000061DC 6600                       		bne.s	DrawFlipY
000061DE 0810 0003                  		btst	#3,(a0)	; Check X-flip bit
000061E2 6600                       		bne.s	DrawFlipX
000061E4 2A80                       		move.l	d0,(a5)
000061E6 2C99                       		move.l	(a1)+,(a6)	; Write top two tiles
000061E8 D087                       		add.l	d7,d0		; Next row
000061EA 2A80                       		move.l	d0,(a5)
000061EC 2C99                       		move.l	(a1)+,(a6)	; Write bottom two tiles
000061EE 4E75                       		rts	
