00006B32                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00006B32                            
00006B32                            ; Draws a block's worth of tiles
00006B32                            ; Parameters:
00006B32                            ; a0 = Pointer to block metadata (block index and X/Y flip)
00006B32                            ; a1 = Pointer to block
00006B32                            ; a5 = Pointer to VDP command port
00006B32                            ; a6 = Pointer to VDP data port
00006B32                            ; d0 = VRAM command to access plane
00006B32                            ; d2 = VRAM plane A/B specifier
00006B32                            ; d7 = Plane row delta
00006B32                            ; DrawTiles:
00006B32                            DrawBlock:
00006B32 8042                       		or.w	d2,d0	; OR in that plane A/B specifier to the VRAM command
00006B34 4840                       		swap	d0
00006B36 0810 0004                  		btst	#4,(a0)	; Check Y-flip bit
00006B3A 6600                       		bne.s	DrawFlipY
00006B3C 0810 0003                  		btst	#3,(a0)	; Check X-flip bit
00006B40 6600                       		bne.s	DrawFlipX
00006B42 2A80                       		move.l	d0,(a5)
00006B44 2C99                       		move.l	(a1)+,(a6)	; Write top two tiles
00006B46 D087                       		add.l	d7,d0		; Next row
00006B48 2A80                       		move.l	d0,(a5)
00006B4A 2C99                       		move.l	(a1)+,(a6)	; Write bottom two tiles
00006B4C 4E75                       		rts	
00006B4E                            ; ===========================================================================
00006B4E                            
00006B4E                            DrawFlipX:
00006B4E 2A80                       		move.l	d0,(a5)
00006B50 2819                       		move.l	(a1)+,d4
00006B52 0A84 0800 0800             		eori.l	#$8000800,d4	; Invert X-flip bits of each tile
00006B58 4844                       		swap	d4		; Swap the tiles around
00006B5A 2C84                       		move.l	d4,(a6)		; Write top two tiles
00006B5C D087                       		add.l	d7,d0		; Next row
00006B5E 2A80                       		move.l	d0,(a5)
00006B60 2819                       		move.l	(a1)+,d4
00006B62 0A84 0800 0800             		eori.l	#$8000800,d4
00006B68 4844                       		swap	d4
00006B6A 2C84                       		move.l	d4,(a6)		; Write bottom two tiles
00006B6C 4E75                       		rts	
00006B6E                            ; ===========================================================================
00006B6E                            
00006B6E                            DrawFlipY:
00006B6E 0810 0003                  		btst	#3,(a0)
00006B72 6600                       		bne.s	DrawFlipXY
00006B74 2A80                       		move.l	d0,(a5)
00006B76 2A19                       		move.l	(a1)+,d5
00006B78 2819                       		move.l	(a1)+,d4
00006B7A 0A84 1000 1000             		eori.l	#$10001000,d4
00006B80 2C84                       		move.l	d4,(a6)
00006B82 D087                       		add.l	d7,d0
00006B84 2A80                       		move.l	d0,(a5)
00006B86 0A85 1000 1000             		eori.l	#$10001000,d5
00006B8C 2C85                       		move.l	d5,(a6)
00006B8E 4E75                       		rts	
00006B90                            ; ===========================================================================
00006B90                            
00006B90                            DrawFlipXY:
00006B90 2A80                       		move.l	d0,(a5)
00006B92 2A19                       		move.l	(a1)+,d5
00006B94 2819                       		move.l	(a1)+,d4
00006B96 0A84 1800 1800             		eori.l	#$18001800,d4
00006B9C 4844                       		swap	d4
00006B9E 2C84                       		move.l	d4,(a6)
00006BA0 D087                       		add.l	d7,d0
00006BA2 2A80                       		move.l	d0,(a5)
00006BA4 0A85 1800 1800             		eori.l	#$18001800,d5
00006BAA 4845                       		swap	d5
00006BAC 2C85                       		move.l	d5,(a6)
00006BAE 4E75                       		rts	
00006BB0                            ; End of function DrawBlocks
