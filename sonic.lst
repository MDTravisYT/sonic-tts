000031B8                            LevSelControls:
000031B8 1238 F605                  		move.b	(v_jpadpress1).w,d1
000031BC 0201 0003                  		andi.b	#btnUp+btnDn,d1	; is up/down pressed and held?
000031C0 6600                       		bne.s	LevSel_UpDown	; if yes, branch
000031C2 5378 FF80                  		subq.w	#1,(v_levseldelay).w ; subtract 1 from time to next move
000031C6 6A00                       		bpl.s	LevSel_SndTest	; if time remains, branch
