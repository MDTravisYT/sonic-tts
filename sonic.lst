00001444 1A18                       		move.b	(a0)+,d5
00001446 E145                       		asl.w	#8,d5
00001448 1A18                       		move.b	(a0)+,d5
0000144A 7C10                       		moveq	#$10,d6
0000144C 7000                       		moveq	#0,d0
0000144E 21C8 F680                  		move.l	a0,(v_plc_buffer).w
00001452 21CB F6E0                  		move.l	a3,(v_ptrnemcode).w
00001456 21C0 F6E4                  		move.l	d0,($FFFFF6E4).w
0000145A 21C0 F6E8                  		move.l	d0,($FFFFF6E8).w
