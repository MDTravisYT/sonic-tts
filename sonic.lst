00005F58                            LoadTilesAsYouMove:
00005F58 4BF9 00C0 0004             		lea	(vdp_control_port).l,a5
00005F5E 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
00005F64                            		; First, update the background
00005F64 45F8 FF32                  		lea	(v_bg1_scroll_flags_dup).w,a2	; Scroll block 1 scroll flags
00005F68 47F8 FF18                  		lea	(v_bgscreenposx_dup).w,a3	; Scroll block 1 X coordinate
00005F6C 49F8 A440                  		lea	(v_lvllayout+$40).w,a4
00005F70 343C 6000                  		move.w	#$6000,d2			; VRAM thing for selecting Plane B
00005F74 6100 0000                  		bsr.w	DrawBGScrollBlock1
00005F78 45F8 FF34                  		lea	(v_bg2_scroll_flags_dup).w,a2	; Scroll block 2 scroll flags
00005F7C 47F8 FF20                  		lea	(v_bg2screenposx_dup).w,a3	; Scroll block 2 X coordinate
00005F80 6100 0000                  		bsr.w	DrawBGScrollBlock2
00005F84                            		; Then, update the foreground
00005F84 45F8 FF30                  		lea	(v_fg_scroll_flags_dup).w,a2	; Foreground scroll flags
00005F88 47F8 FF10                  		lea	(v_screenposx_dup).w,a3		; Foreground X coordinate
00005F8C 49F8 A400                  		lea	(v_lvllayout).w,a4
00005F90 343C 4000                  		move.w	#$4000,d2			; VRAM thing for selecting Plane A
00005F94                            		; The FG's update function is inlined here
00005F94 4A12                       		tst.b	(a2)
00005F96 6700                       		beq.s	locret_6952	; If there are no flags set, nothing needs updating
00005F98 0892 0000                  		bclr	#0,(a2)
00005F9C 6700                       		beq.s	loc_6908
00005F9E                            		; Draw new tiles at the top
00005F9E 78F0                       		moveq	#-16,d4	; Y coordinate. Note that 16 is the size of a block in pixels
00005FA0 7AF0                       		moveq	#-16,d5 ; X coordinate
00005FA2 6100 0000                  		bsr.w	Calc_VRAM_Pos
00005FA6 78F0                       		moveq	#-16,d4 ; Y coordinate
00005FA8 7AF0                       		moveq	#-16,d5 ; X coordinate
00005FAA 6100 0000                  		bsr.w	DrawBlocks_LR
