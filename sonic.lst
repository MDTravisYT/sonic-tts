000019F0 41F9 0000 0000             		lea	(Pal_LZCyc3).l,a0
000019F6 43F8 FAF6                  		lea	(v_pal_water+$76).w,a1
000019FA 22F0 0000                  		move.l	(a0,d0.w),(a1)+
000019FE 32B0 0004                  		move.w	4(a0,d0.w),(a1)
