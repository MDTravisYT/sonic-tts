00019CC8 E0E8 0012                  		asr	obVelY(a0)
00019CCC 137C 0000 0020             		move.b	#0,obColType(a1)
00019CD2 5329 0021                  		subq.b	#1,obColProp(a1)
00019CD6 6600                       		bne.s	@flagnotclear
