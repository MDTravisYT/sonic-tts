00001256                            ; ---------------------------------------------------------------------------
00001256                            ; Subroutine to	copy a tile map from RAM to VRAM namespace
00001256                            
00001256                            ; input:
00001256                            ;	a1 = tile map address
00001256                            ;	d0 = VRAM address
00001256                            ;	d1 = width (cells)
00001256                            ;	d2 = height (cells)
00001256                            ; ---------------------------------------------------------------------------
00001256                            
00001256                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001256                            
00001256                            
00001256                            TilemapToVRAM:
00001256 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
0000125C 283C 0080 0000             		move.l	#$800000,d4
00001262                            
00001262                            	Tilemap_Line:
00001262 2D40 0004                  		move.l	d0,4(a6)	; move d0 to VDP_control_port
00001266 3601                       		move.w	d1,d3
00001268                            
00001268                            	Tilemap_Cell:
00001268 3C99                       		move.w	(a1)+,(a6)	; write value to namespace
0000126A 51CB FFFC                  		dbf	d3,Tilemap_Cell	; next tile
0000126E D084                       		add.l	d4,d0		; goto next line
00001270 51CA FFF0                  		dbf	d2,Tilemap_Line	; next line
00001274 4E75                       		rts	
00001276                            ; End of function TilemapToVRAM
00001276                            
00001276                            		include	"_inc\Nemesis Decompression.asm"
00001276                            ; ---------------------------------------------------------------------------
00001276                            ; Nemesis decompression	subroutine, decompresses art directly to VRAM
00001276                            ; Inputs:
00001276                            ; a0 = art address
00001276                            
00001276                            ; For format explanation see http://info.sonicretro.org/Nemesis_compression
00001276                            ; ---------------------------------------------------------------------------
00001276                            
00001276                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001276                            
00001276                            ; Nemesis decompression to VRAM
00001276                            NemDec:
00001276 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
0000127A 47F9 0000 0000             		lea	(NemPCD_WriteRowToVDP).l,a3	; write all data to the same location
00001280 49F9 00C0 0000             		lea	(vdp_data_port).l,a4	; specifically, to the VDP data port
00001286 6000                       		bra.s	NemDecMain
00001288                            
00001288                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001288                            
00001288                            ; Nemesis decompression subroutine, decompresses art to RAM
00001288                            ; Inputs:
00001288                            ; a0 = art address
00001288                            ; a4 = destination RAM address
00001288                            NemDecToRAM:
00001288 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
0000128C 47F9 0000 0000             		lea	(NemPCD_WriteRowToRAM).l,a3 ; advance to the next location after each write
00001292                            
00001292                            NemDecMain:
00001292 43F8 AA00                  		lea	(v_ngfx_buffer).w,a1
00001296 3418                       		move.w	(a0)+,d2	; get number of patterns
00001298 E34A                       		lsl.w	#1,d2
0000129A 6400                       		bcc.s	loc_146A	; branch if the sign bit isn't set
0000129C D6FC 0000                  		adda.w	#NemPCD_WriteRowToVDP_XOR-NemPCD_WriteRowToVDP,a3	; otherwise the file uses XOR mode
000012A0                            
000012A0                            loc_146A:
000012A0 E54A                       		lsl.w	#2,d2	; get number of 8-pixel rows in the uncompressed data
000012A2 3A42                       		movea.w	d2,a5	; and store it in a5 because there aren't any spare data registers
000012A4 7608                       		moveq	#8,d3	; 8 pixels in a pattern row
000012A6 7400                       		moveq	#0,d2
000012A8 7800                       		moveq	#0,d4
000012AA 6100 0000                  		bsr.w	NemDec_BuildCodeTable
000012AE 1A18                       		move.b	(a0)+,d5	; get first byte of compressed data
000012B0 E145                       		asl.w	#8,d5	; shift up by a byte
000012B2 1A18                       		move.b	(a0)+,d5	; get second byte of compressed data
000012B4 3C3C 0010                  		move.w	#$10,d6	; set initial shift value
000012B8 6100                       		bsr.s	NemDec_ProcessCompressedData
000012BA 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
000012BE 4E75                       		rts	
000012C0                            ; End of function NemDec
000012C0                            
000012C0                            ; ---------------------------------------------------------------------------
000012C0                            ; Part of the Nemesis decompressor, processes the actual compressed data
000012C0                            ; ---------------------------------------------------------------------------
000012C0                            
000012C0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000012C0                            
000012C0                            
000012C0                            NemDec_ProcessCompressedData:
000012C0 3E06                       		move.w	d6,d7
000012C2 5147                       		subq.w	#8,d7	; get shift value
000012C4 3205                       		move.w	d5,d1
000012C6 EE69                       		lsr.w	d7,d1	; shift so that high bit of the code is in bit position 7
000012C8 0C01 00FC                  		cmpi.b	#%11111100,d1	; are the high 6 bits set?
000012CC 6400                       		bcc.s	NemPCD_InlineData	; if they are, it signifies inline data
000012CE 0241 00FF                  		andi.w	#$FF,d1
000012D2 D241                       		add.w	d1,d1
000012D4 1031 1000                  		move.b	(a1,d1.w),d0	; get the length of the code in bits
000012D8 4880                       		ext.w	d0
000012DA 9C40                       		sub.w	d0,d6	; subtract from shift value so that the next code is read next time around
000012DC 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
000012E0 6400                       		bcc.s	loc_14B2	; if not, branch
000012E2 5046                       		addq.w	#8,d6
000012E4 E145                       		asl.w	#8,d5
000012E6 1A18                       		move.b	(a0)+,d5	; read next byte
000012E8                            
000012E8                            loc_14B2:
000012E8 1231 1001                  		move.b	1(a1,d1.w),d1
000012EC 3001                       		move.w	d1,d0
000012EE 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000012F2 0240 00F0                  		andi.w	#$F0,d0
000012F6                            
000012F6                            NemPCD_ProcessCompressedData:
000012F6 E848                       		lsr.w	#4,d0	; get repeat count
000012F8                            
000012F8                            NemPCD_WritePixel:
000012F8 E98C                       		lsl.l	#4,d4	; shift up by a nybble
000012FA 8801                       		or.b	d1,d4	; write pixel
000012FC 5343                       		subq.w	#1,d3	; has an entire 8-pixel row been written?
000012FE 6600                       		bne.s	NemPCD_WritePixel_Loop	; if not, loop
00001300 4ED3                       		jmp	(a3)	; otherwise, write the row to its destination, by doing a dynamic jump to NemPCD_WriteRowToVDP, NemDec_WriteAndAdvance, NemPCD_WriteRowToVDP_XOR, or NemDec_WriteAndAdvance_XOR
00001302                            ; End of function NemDec_ProcessCompressedData
00001302                            
00001302                            
00001302                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001302                            
00001302                            
00001302                            NemPCD_NewRow:
00001302 7800                       		moveq	#0,d4	; reset row
00001304 7608                       		moveq	#8,d3	; reset nybble counter
00001306                            
00001306                            NemPCD_WritePixel_Loop:
00001306 51C8 FFF0                  		dbf	d0,NemPCD_WritePixel
0000130A 60B4                       		bra.s	NemDec_ProcessCompressedData
0000130C                            ; ===========================================================================
0000130C                            
0000130C                            NemPCD_InlineData:
0000130C 5D46                       		subq.w	#6,d6	; 6 bits needed to signal inline data
0000130E 0C46 0009                  		cmpi.w	#9,d6
00001312 6400                       		bcc.s	loc_14E4
00001314 5046                       		addq.w	#8,d6
00001316 E145                       		asl.w	#8,d5
00001318 1A18                       		move.b	(a0)+,d5
0000131A                            
0000131A                            loc_14E4:
0000131A 5F46                       		subq.w	#7,d6	; and 7 bits needed for the inline data itself
0000131C 3205                       		move.w	d5,d1
0000131E EC69                       		lsr.w	d6,d1	; shift so that low bit of the code is in bit position 0
00001320 3001                       		move.w	d1,d0
00001322 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
00001326 0240 0070                  		andi.w	#$70,d0	; high nybble is repeat count for pixel
0000132A 0C46 0009                  		cmpi.w	#9,d6
0000132E 64C6                       		bcc.s	NemPCD_ProcessCompressedData
00001330 5046                       		addq.w	#8,d6
00001332 E145                       		asl.w	#8,d5
00001334 1A18                       		move.b	(a0)+,d5
00001336 60BE                       		bra.s	NemPCD_ProcessCompressedData
00001338                            ; End of function NemPCD_NewRow
00001338                            
00001338                            ; ===========================================================================
00001338                            
00001338                            NemPCD_WriteRowToVDP:
00001338 2884                       		move.l	d4,(a4)	; write 8-pixel row
0000133A 534D                       		subq.w	#1,a5
0000133C 380D                       		move.w	a5,d4	; have all the 8-pixel rows been written?
0000133E 66C2                       		bne.s	NemPCD_NewRow	; if not, branch
00001340 4E75                       		rts		; otherwise the decompression is finished
00001342                            ; ===========================================================================
00001342                            NemPCD_WriteRowToVDP_XOR:
00001342 B982                       		eor.l	d4,d2	; XOR the previous row by the current row
00001344 2882                       		move.l	d2,(a4)	; and write the result
00001346 534D                       		subq.w	#1,a5
00001348 380D                       		move.w	a5,d4
0000134A 66B6                       		bne.s	NemPCD_NewRow
0000134C 4E75                       		rts	
0000134E                            ; ===========================================================================
0000134E                            
0000134E                            NemPCD_WriteRowToRAM:
0000134E 28C4                       		move.l	d4,(a4)+
00001350 534D                       		subq.w	#1,a5
00001352 380D                       		move.w	a5,d4
00001354 66AC                       		bne.s	NemPCD_NewRow
00001356 4E75                       		rts	
00001358                            ; ===========================================================================
00001358                            NemPCD_WriteRowToRAM_XOR:
00001358 B982                       		eor.l	d4,d2
0000135A 28C2                       		move.l	d2,(a4)+
0000135C 534D                       		subq.w	#1,a5
0000135E 380D                       		move.w	a5,d4
00001360 66A0                       		bne.s	NemPCD_NewRow
00001362 4E75                       		rts	
00001364                            
00001364                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001364                            ; ---------------------------------------------------------------------------
00001364                            ; Part of the Nemesis decompressor, builds the code table (in RAM)
00001364                            ; ---------------------------------------------------------------------------
00001364                            
00001364                            
00001364                            NemDec_BuildCodeTable:
00001364 1018                       		move.b	(a0)+,d0	; read first byte
00001366                            
00001366                            NemBCT_ChkEnd:
00001366 0C00 00FF                  		cmpi.b	#$FF,d0	; has the end of the code table description been reached?
0000136A 6600                       		bne.s	NemBCT_NewPALIndex	; if not, branch
0000136C 4E75                       		rts	; otherwise, this subroutine's work is done
0000136E                            ; ===========================================================================
0000136E                            
0000136E                            NemBCT_NewPALIndex:
0000136E 3E00                       		move.w	d0,d7
00001370                            
00001370                            NemBCT_Loop:
00001370 1018                       		move.b	(a0)+,d0	; read next byte
00001372 0C00 0080                  		cmpi.b	#$80,d0	; sign bit being set signifies a new palette index
00001376 64EE                       		bcc.s	NemBCT_ChkEnd	; a bmi could have been used instead of a compare and bcc
00001378                            		
00001378 1200                       		move.b	d0,d1
0000137A 0247 000F                  		andi.w	#$F,d7	; get palette index
0000137E 0241 0070                  		andi.w	#$70,d1	; get repeat count for palette index
00001382 8E41                       		or.w	d1,d7	; combine the two
00001384 0240 000F                  		andi.w	#$F,d0	; get the length of the code in bits
00001388 1200                       		move.b	d0,d1
0000138A E149                       		lsl.w	#8,d1
0000138C 8E41                       		or.w	d1,d7	; combine with palette index and repeat count to form code table entry
0000138E 7208                       		moveq	#8,d1
00001390 9240                       		sub.w	d0,d1	; is the code 8 bits long?
00001392 6600                       		bne.s	NemBCT_ShortCode	; if not, a bit of extra processing is needed
00001394 1018                       		move.b	(a0)+,d0	; get code
00001396 D040                       		add.w	d0,d0	; each code gets a word-sized entry in the table
00001398 3387 0000                  		move.w	d7,(a1,d0.w)	; store the entry for the code
0000139C 60D2                       		bra.s	NemBCT_Loop	; repeat
0000139E                            ; ===========================================================================
0000139E                            
0000139E                            ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
0000139E                            ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
0000139E                            ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
0000139E                            ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
0000139E                            ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
0000139E                            ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
0000139E                            NemBCT_ShortCode:
0000139E 1018                       		move.b	(a0)+,d0	; get code
000013A0 D040                       		add.w	d0,d0	; shift so that high bit is in bit position 7
000013A2 E368                       		lsl.w	d1,d0	; get index into code table
000013A4 7A01                       		moveq	#1,d5
000013A6 E36D                       		lsl.w	d1,d5
000013A8 5345                       		subq.w	#1,d5	; d5 = 2^d1 - 1
000013AA                            
000013AA                            NemBCT_ShortCode_Loop:
000013AA 3387 0000                  		move.w	d7,(a1,d0.w)	; store entry
000013AE 5440                       		addq.w	#2,d0	; increment index
000013B0 51CD FFF8                  		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
000013B4 60BA                       		bra.s	NemBCT_Loop
000013B6                            ; End of function NemDec_BuildCodeTable
000013B6                            ; End of function NemDec_BuildCodeTable
000013B6                            
000013B6                            
000013B6                            ; ---------------------------------------------------------------------------
000013B6                            ; Subroutine to load pattern load cues (aka to queue pattern load requests)
000013B6                            ; ---------------------------------------------------------------------------
000013B6                            
000013B6                            ; ARGUMENTS
000013B6                            ; d0 = index of PLC list
000013B6                            ; ---------------------------------------------------------------------------
000013B6                            
000013B6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000013B6                            
000013B6                            ; LoadPLC:
000013B6                            AddPLC:
000013B6 48E7 0060                  		movem.l	a1-a2,-(sp)
000013BA 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
000013C0 D040                       		add.w	d0,d0
000013C2 3031 0000                  		move.w	(a1,d0.w),d0
000013C6 43F1 0000                  		lea	(a1,d0.w),a1		; jump to relevant PLC
000013CA 45F8 F680                  		lea	(v_plc_buffer).w,a2 ; PLC buffer space
000013CE                            
000013CE                            	@findspace:
000013CE 4A92                       		tst.l	(a2)		; is space available in RAM?
000013D0 6700                       		beq.s	@copytoRAM	; if yes, branch
000013D2 5C4A                       		addq.w	#6,a2		; if not, try next space
000013D4 60F8                       		bra.s	@findspace
000013D6                            ; ===========================================================================
000013D6                            
000013D6                            @copytoRAM:
000013D6 3019                       		move.w	(a1)+,d0	; get length of PLC
000013D8 6B00                       		bmi.s	@skip
000013DA                            
000013DA                            	@loop:
000013DA 24D9                       		move.l	(a1)+,(a2)+
000013DC 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
000013DE 51C8 FFFA                  		dbf	d0,@loop	; repeat for length of PLC
000013E2                            
000013E2                            	@skip:
000013E2 4CDF 0600                  		movem.l	(sp)+,a1-a2 ; a1=object
000013E6 4E75                       		rts	
000013E8                            ; End of function AddPLC
