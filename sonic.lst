000138DE 6700                       		beq.s	@isstarlight	; if yes, branch
000138E0 4A38 FE10                  		tst.b	(v_zone).w	; is level GHZ ?
000138E4 6600 0000                  		bne.w	@noloops	; if not, branch
000138E8                            
