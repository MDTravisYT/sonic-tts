00019C70                            
00019C70 3028 000C                  		move.w	obY(a0),d0
00019C74 0440 0010                  		subi.w	#$10,d0
00019C78 B069 000C                  		cmp.w	obY(a1),d0
00019C7C 6500                       		bcs.s	@donothing
00019C7E 4468 0012                  		neg.w	obVelY(a0)	; reverse Sonic's vertical speed
00019C82 337C FE80 0012             		move.w	#-$180,obVelY(a1)
00019C88 4A29 0025                  		tst.b	ob2ndRout(a1)
00019C8C 6600                       		bne.s	@donothing
00019C8E 5829 0025                  		addq.b	#4,ob2ndRout(a1) ; advance the monitor's routine counter
00019C92 4E75                       		rts	
