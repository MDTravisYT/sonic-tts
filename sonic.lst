0001158E 6400                       		bcc.s	@animate	; branch if Sonic is too high
00011590 0440 0050                  		subi.w	#$50,d0		; is Sonic more than $50 pixels from the fan?
00011594 6400                       		bcc.s	@faraway	; if yes, branch
