0005339A                            ; ---------------------------------------------------------------------------
0005339A                            ; Priority of sound. New music or SFX must have a priority higher than or equal
0005339A                            ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
0005339A                            ; set ($80 and up), the new music or SFX will not set its priority -- meaning
0005339A                            ; any music or SFX can override it (as long as it can override whatever was
0005339A                            ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
0005339A                            ; will only override special SFX and music will only override music.
0005339A                            ; ---------------------------------------------------------------------------
0005339A                            ; SoundTypes:
0005339A                            SoundPriorities:
0005339A 9090 9090 9090 9090 9090+  		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
000533A9 9090 9090 9090 9090 9090+  		dc.b $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $90
000533B9 8070 7070 7070 7070 7070+  		dc.b $80,$70,$70,$70,$70,$70,$70,$70,$70,$70,$68,$70,$70,$70,$60,$70	; $A0
