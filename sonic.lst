0000121E 10C1                       		move.b	d1,(a0)+
00001220 4E75                       		rts	
00001222                            ; End of function ReadJoypads
00001222                            
00001222                            
00001222                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001222                            
00001222                            
00001222                            VDPSetupGame:
00001222 41F9 00C0 0004             		lea	(vdp_control_port).l,a0
00001228 43F9 00C0 0000             		lea	(vdp_data_port).l,a1
0000122E 45F9 0000 0000             		lea	(VDPSetupArray).l,a2
00001234 7E12                       		moveq	#$12,d7
00001236                            
00001236                            	@setreg:
00001236 309A                       		move.w	(a2)+,(a0)
00001238 51CF FFFC                  		dbf	d7,@setreg	; set the VDP registers
0000123C                            
0000123C 3039 0000 0000             		move.w	(VDPSetupArray+2).l,d0
00001242 31C0 F60C                  		move.w	d0,(v_vdp_buffer1).w
00001246 31FC 8ADF F624             		move.w	#$8A00+223,(v_hbla_hreg).w	; H-INT every 224th scanline
0000124C 7000                       		moveq	#0,d0
0000124E 23FC C000 0000 00C0 0004   		move.l	#$C0000000,(vdp_control_port).l ; set VDP to CRAM write
00001258 3E3C 003F                  		move.w	#$3F,d7
0000125C                            
0000125C                            	@clrCRAM:
0000125C 3280                       		move.w	d0,(a1)
0000125E 51CF FFFC                  		dbf	d7,@clrCRAM	; clear	the CRAM
00001262                            
00001262 42B8 F616                  		clr.l	(v_scrposy_dup).w
00001266 42B8 F61A                  		clr.l	(v_scrposx_dup).w
0000126A 2F01                       		move.l	d1,-(sp)
0000126C 4BF9 00C0 0004 3ABC 8F01+  		fillVRAM	0,$FFFF,0
0000128E                            
0000128E                            	@waitforDMA:
0000128E 3215                       		move.w	(a5),d1
00001290 0801 0001                  		btst	#1,d1		; is DMA (fillVRAM) still running?
00001294 66F8                       		bne.s	@waitforDMA	; if yes, branch
00001296                            
00001296 3ABC 8F02                  		move.w	#$8F02,(a5)	; set VDP increment size
0000129A 221F                       		move.l	(sp)+,d1
0000129C 4E75                       		rts	
0000129E                            ; End of function VDPSetupGame
0000129E                            
0000129E                            ; ===========================================================================
0000129E 8004                       VDPSetupArray:	dc.w $8004		; 8-colour mode
000012A0 8134                       		dc.w $8134		; enable V.interrupts, enable DMA
000012A2 8230                       		dc.w $8200+(vram_fg>>10) ; set foreground nametable address
000012A4 8328                       		dc.w $8300+($A000>>10)	; set window nametable address
000012A6 8407                       		dc.w $8400+(vram_bg>>13) ; set background nametable address
000012A8 857C                       		dc.w $8500+(vram_sprites>>9) ; set sprite table address
000012AA 8600                       		dc.w $8600		; unused
000012AC 8700                       		dc.w $8700		; set background colour (palette entry 0)
000012AE 8800                       		dc.w $8800		; unused
000012B0 8900                       		dc.w $8900		; unused
000012B2 8A00                       		dc.w $8A00		; default H.interrupt register
000012B4 8B00                       		dc.w $8B00		; full-screen vertical scrolling
000012B6 8C81                       		dc.w $8C81		; 40-cell display mode
000012B8 8D3F                       		dc.w $8D00+(vram_hscroll>>10) ; set background hscroll address
000012BA 8E00                       		dc.w $8E00		; unused
000012BC 8F02                       		dc.w $8F02		; set VDP increment size
000012BE 9001                       		dc.w $9001		; 64-cell hscroll size
000012C0 9100                       		dc.w $9100		; window horizontal position
000012C2 9200                       		dc.w $9200		; window vertical position
000012C4                            
