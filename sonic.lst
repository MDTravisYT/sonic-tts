00006CA6                            
00006CA6                            
00006CA6                            LevelDataLoad:
00006CA6 7000                       		moveq	#0,d0
00006CA8 1038 FE10                  		move.b	(v_zone).w,d0
00006CAC E948                       		lsl.w	#4,d0
00006CAE 45F9 0000 0000             		lea	(LevelHeaders).l,a2
00006CB4 45F2 0000                  		lea	(a2,d0.w),a2
00006CB8 2F0A                       		move.l	a2,-(sp)
00006CBA 588A                       		addq.l	#4,a2
00006CBC 205A                       		movea.l	(a2)+,a0
00006CBE 43F8 B000                  		lea	(v_16x16).w,a1	; RAM address for 16x16 mappings
00006CC2 303C 0000                  		move.w	#0,d0
00006CC6 6100 AA56                  		bsr.w	EniDec
00006CCA 205A                       		movea.l	(a2)+,a0
00006CCC 43F9 00FF 0000             		lea	(v_256x256).l,a1 ; RAM address for 256x256 mappings
00006CD2 6100 ABC8                  		bsr.w	KosDec
