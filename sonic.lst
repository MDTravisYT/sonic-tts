000138E8 3028 000C                  		move.w	obY(a0),d0
000138EC E248                       		lsr.w	#1,d0
000138EE 0240 0380                  		andi.w	#$380,d0
000138F2 1228 0008                  		move.b	obX(a0),d1
000138F6 0241 007F                  		andi.w	#$7F,d1
000138FA D041                       		add.w	d1,d0
000138FC 43F8 A400                  		lea	(v_lvllayout).w,a1
00013900 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00013904                            
00013904 B238 F7AE                  		cmp.b	(v_256roll1).w,d1 ; is Sonic on a "roll tunnel" tile?
00013908 6700 FA96                  		beq.w	Sonic_ChkRoll	; if yes, branch
0001390C B238 F7AF                  		cmp.b	(v_256roll2).w,d1
00013910 6700 FA8E                  		beq.w	Sonic_ChkRoll
00013914                            
00013914 B238 F7AC                  		cmp.b	(v_256loop1).w,d1 ; is Sonic on a loop tile?
00013918 6700                       		beq.s	@chkifleft	; if yes, branch
0001391A B238 F7AD                  		cmp.b	(v_256loop2).w,d1
0001391E 6700                       		beq.s	@chkifinair
00013920 08A8 0006 0001             		bclr	#6,obRender(a0) ; return Sonic to high plane
00013926 4E75                       		rts	
00013928                            ; ===========================================================================
00013928                            
00013928                            @chkifinair:
00013928 0828 0001 0022             		btst	#1,obStatus(a0)	; is Sonic in the air?
0001392E 6700                       		beq.s	@chkifleft	; if not, branch
00013930                            
00013930 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00013936 4E75                       		rts	
