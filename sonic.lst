00014A22 D041                       		add.w	d1,d0
00014A24 6A00 FF7A                  		bpl.w	@isblank
00014A28                            
00014A28                            @maxfloor:
00014A28 944B                       		sub.w	a3,d2
00014A2A 6100 0000                  		bsr.w	FindFloor2	; try tile above the nearest
00014A2E D44B                       		add.w	a3,d2
00014A30 0441 0010                  		subi.w	#$10,d1		; return distance to floor
00014A34 4E75                       		rts	
00014A36                            ; End of function FindFloor
