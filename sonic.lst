000062D6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000062D6                            
000062D6                            ; Produces a VRAM plane access command from coordinates
000062D6                            ; Parameters:
000062D6                            ; d4 = Relative Y coordinate
000062D6                            ; d5 = Relative X coordinate
000062D6                            ; Returns VDP command in d0
000062D6                            Calc_VRAM_Pos:
000062D6 D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate
000062DA DA53                       		add.w	(a3),d5		; Add camera X coordinate
000062DC                            		; Floor the coordinates to the nearest pair of tiles (the size of a block).
000062DC                            		; Also note that this wraps the value to the size of the plane:
000062DC                            		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
000062DC 0244 00F0                  		andi.w	#$F0,d4
000062E0 0245 01F0                  		andi.w	#$1F0,d5
000062E4                            		; Transform the adjusted coordinates into a VDP command
000062E4 E94C                       		lsl.w	#4,d4
000062E6 E44D                       		lsr.w	#2,d5
000062E8 D845                       		add.w	d5,d4
000062EA 7003                       		moveq	#3,d0	; Highest bits of plane VRAM address
000062EC 4840                       		swap	d0
000062EE 3004                       		move.w	d4,d0
000062F0 4E75                       		rts	
000062F2                            ; End of function Calc_VRAM_Pos
000062F2                            
000062F2                            
000062F2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000062F2                            ; not used
000062F2                            
000062F2                            ; This is just like Calc_VRAM_Pos, but seemingly for an earlier
000062F2                            ; VRAM layout: the only difference is the high bits of the
000062F2                            ; plane's VRAM address, which are 10 instead of 11.
000062F2                            ; Both the foreground and background are at $C000 and $E000
000062F2                            ; respectively, so this one starting at $8000 makes no sense.
000062F2                            ; sub_6C3C:
000062F2                            Calc_VRAM_Pos_Unknown:
000062F2 D86B 0004                  		add.w	4(a3),d4
000062F6 DA53                       		add.w	(a3),d5
000062F8 0244 00F0                  		andi.w	#$F0,d4
000062FC 0245 01F0                  		andi.w	#$1F0,d5
00006300 E94C                       		lsl.w	#4,d4
00006302 E44D                       		lsr.w	#2,d5
00006304 D845                       		add.w	d5,d4
00006306 7002                       		moveq	#2,d0
00006308 4840                       		swap	d0
0000630A 3004                       		move.w	d4,d0
0000630C 4E75                       		rts	
0000630E                            ; End of function Calc_VRAM_Pos_Unknown
