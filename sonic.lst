00053C96 4BEE 0220                  		lea	v_sfx_track_ram(a6),a5
00053C9A 7E05                       		moveq	#((v_sfx_track_ram_end-v_sfx_track_ram)/TrackSz)-1,d7	; 3 FM + 3 PSG tracks (SFX)
