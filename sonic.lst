00005FD2 7AF0                       		moveq	#-16,d5
00005FD4 6100 0000                  		bsr.w	Calc_VRAM_Pos
00005FD8 383C 00E0                  		move.w	#224,d4
00005FDC 7AF0                       		moveq	#-16,d5
00005FDE 6100 0000                  		bsr.w	DrawBlocks_LR
