00072584 4298                       		clr.l	(a0)+
00072586 51C8 FFFC                  		dbf	d0,@clearramloop
0007258A                            
0007258A                            		; Restore the values saved above
0007258A 1D41 0000                  		move.b	d1,v_sndprio(a6)
0007258E 1D42 0027                  		move.b	d2,f_1up_playing(a6)
00072592 1D43 002A                  		move.b	d3,f_speedup(a6)
00072596 1D44 0026                  		move.b	d4,v_fadein_counter(a6)
0007259A 3D45 000A                  		move.w	d5,v_soundqueue0(a6)
0007259E 1D7C 0080 0009             		move.b	#$80,v_sound_id(a6)	; set music to $80 (silence)
000725A4                            		; DANGER! This silences ALL channels, even the ones being used
000725A4                            		; by SFX, and not music! @sendfmnoteoff does this already, and
000725A4                            		; doesn't affect SFX channels, either.
000725A4                            		; This should be replaced with an 'rts'.
000725A4 4EBA FF64                  		jsr	FMSilenceAll(pc)
000725A8 6000 0000                  		bra.w	PSGSilenceAll
000725AC                            		; DANGER! InitMusicPlayback, and Sound_PlayBGM for that matter,
000725AC                            		; don't do a very good job of setting up the music tracks.
000725AC                            		; Tracks that aren't defined in a music file's header don't have
000725AC                            		; their channels defined, meaning @sendfmnoteoff won't silence
000725AC                            		; hardware properly. In combination with removing the above
000725AC                            		; calls to FMSilenceAll/PSGSilenceAll, this will cause hanging
000725AC                            		; notes.
000725AC                            		; To fix this, I suggest using this code, instead of an 'rts':
000725AC                            		;lea	v_music_track_ram+TrackVoiceControl(a6),a1
000725AC                            		;lea	FMDACInitBytes(pc),a2
000725AC                            		;moveq	#((v_music_fmdac_tracks_end-v_music_fmdac_tracks)/TrackSz)-1,d1		; 7 DAC/FM tracks
000725AC                            		;bsr.s	@writeloop
000725AC                            		;lea	PSGInitBytes(pc),a2
000725AC                            		;moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d1	; 3 PSG tracks
000725AC                            
000725AC                            ;@writeloop:
000725AC                            		;move.b	(a2)+,(a1)		; Write track's channel byte
000725AC                            		;lea	TrackSz(a1),a1		; Next track
000725AC                            		;dbf	d1,@writeloop		; Loop for all DAC/FM/PSG tracks
000725AC                            
000725AC                            		;rts
000725AC                            	
000725AC                            ; End of function InitMusicPlayback
