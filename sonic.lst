00013BC2                            ; End of function FindNearestTile
00013BC2                            		include	"_incObj\sub FindFloor.asm"
00013BC2                            ; ---------------------------------------------------------------------------
00013BC2                            ; Subroutine to	find the floor
00013BC2                            
00013BC2                            ; input:
00013BC2                            ;	d2 = y-position of object's bottom edge
00013BC2                            ;	d3 = x-position of object
00013BC2                            ;	d5 = bit to test for solidness
00013BC2                            
00013BC2                            ; output:
00013BC2                            ;	d1 = distance to the floor
00013BC2                            ;	a1 = address within 256x256 mappings where object is standing
00013BC2                            ;	     (refers to a 16x16 tile number)
00013BC2                            ;	(a4) = floor angle
00013BC2                            ; ---------------------------------------------------------------------------
00013BC2                            
00013BC2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013BC2                            
00013BC2                            
00013BC2                            FindFloor:
00013BC2 618C                       		bsr.s	FindNearestTile
00013BC4 3011                       		move.w	(a1),d0		; get value for solidness, orientation and 16x16 tile number
00013BC6 3800                       		move.w	d0,d4
00013BC8 0240 07FF                  		andi.w	#$7FF,d0
00013BCC 6700                       		beq.s	@isblank	; branch if tile is blank
00013BCE 0B04                       		btst	d5,d4		; is the tile solid?
00013BD0 6600                       		bne.s	@issolid	; if yes, branch
00013BD2                            
00013BD2                            @isblank:
00013BD2 D44B                       		add.w	a3,d2
00013BD4 6100 0000                  		bsr.w	FindFloor2	; try tile below the nearest
00013BD8 944B                       		sub.w	a3,d2
00013BDA 0641 0010                  		addi.w	#$10,d1		; return distance to floor
00013BDE 4E75                       		rts	
00013BE0                            ; ===========================================================================
00013BE0                            
00013BE0                            @issolid:
00013BE0 2478 F796                  		movea.l	(v_collindex).w,a2
00013BE4 1032 0000                  		move.b	(a2,d0.w),d0	; get collision block number
00013BE8 0240 00FF                  		andi.w	#$FF,d0
00013BEC 67E4                       		beq.s	@isblank	; branch if 0
00013BEE 45F9 0000 0000             		lea	(AngleMap).l,a2
00013BF4 18B2 0000                  		move.b	(a2,d0.w),(a4)	; get collision angle value
00013BF8 E948                       		lsl.w	#4,d0
00013BFA 3203                       		move.w	d3,d1		; get x-pos. of object
00013BFC 0804 000B                  		btst	#$B,d4		; is block flipped horizontally?
00013C00 6700                       		beq.s	@noflip		; if not, branch
00013C02 4641                       		not.w	d1
00013C04 4414                       		neg.b	(a4)
00013C06                            
00013C06                            	@noflip:
00013C06 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
00013C0A 6700                       		beq.s	@noflip2	; if not, branch
00013C0C 0614 0040                  		addi.b	#$40,(a4)
00013C10 4414                       		neg.b	(a4)
00013C12 0414 0040                  		subi.b	#$40,(a4)
00013C16                            
00013C16                            	@noflip2:
00013C16 0241 000F                  		andi.w	#$F,d1
00013C1A D240                       		add.w	d0,d1		; (block num. * $10) + x-pos. = place in array
00013C1C 45F9 0000 0000             		lea	(CollArray1).l,a2
00013C22 1032 1000                  		move.b	(a2,d1.w),d0	; get collision height
00013C26 4880                       		ext.w	d0
00013C28 BD44                       		eor.w	d6,d4
00013C2A 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
00013C2E 6700                       		beq.s	@noflip3	; if not, branch
00013C30 4440                       		neg.w	d0
00013C32                            
00013C32                            	@noflip3:
00013C32 4A40                       		tst.w	d0
00013C34 679C                       		beq.s	@isblank	; branch if height is 0
00013C36 6B00                       		bmi.s	@negfloor	; branch if height is negative
00013C38 0C00 0010                  		cmpi.b	#$10,d0
00013C3C 6700                       		beq.s	@maxfloor	; branch if height is $10 (max)
00013C3E 3202                       		move.w	d2,d1		; get y-pos. of object
00013C40 0241 000F                  		andi.w	#$F,d1
00013C44 D041                       		add.w	d1,d0
00013C46 323C 000F                  		move.w	#$F,d1
00013C4A 9240                       		sub.w	d0,d1		; return distance to floor
00013C4C 4E75                       		rts	
00013C4E                            ; ===========================================================================
00013C4E                            
00013C4E                            @negfloor:
00013C4E 3202                       		move.w	d2,d1
00013C50 0241 000F                  		andi.w	#$F,d1
00013C54 D041                       		add.w	d1,d0
00013C56 6A00 FF7A                  		bpl.w	@isblank
00013C5A                            
00013C5A                            @maxfloor:
00013C5A 944B                       		sub.w	a3,d2
00013C5C 6100 0000                  		bsr.w	FindFloor2	; try tile above the nearest
00013C60 D44B                       		add.w	a3,d2
00013C62 0441 0010                  		subi.w	#$10,d1		; return distance to floor
00013C66 4E75                       		rts	
00013C68                            ; End of function FindFloor
00013C68                            
00013C68                            
00013C68                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
