00050E0E 6A00                       		bpl.s	@getfmpointer					; Branch if not
00050E10                            		; DANGER! there is a missing 'movea.l	a5,a3' here, without which the
00050E10                            		; code is broken. It is dangerous to do a fade out when a GHZ waterfall
