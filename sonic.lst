00001188                            ; Subroutine to	load the sound driver
00001188                            ; ---------------------------------------------------------------------------
00001188                            
00001188                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001188                            
00001188                            
00001188                            SoundDriverLoad:
00001188 4E71                       		nop	
0000118A 33FC 0100 00A1 1100        		stopZ80
00001192 33FC 0100 00A1 1200        		resetZ80
0000119A 41F9 0000 0000             		lea	(Kos_Z80).l,a0	; load sound driver
000011A0 43F9 00A0 0000             		lea	(z80_ram).l,a1	; target Z80 RAM
000011A6 6100 0000                  		bsr.w	KosDec		; decompress
000011AA 33FC 0000 00A1 1200        		resetZ80a
000011B2 4E71                       		nop	
000011B4 4E71                       		nop	
000011B6 4E71                       		nop	
000011B8 4E71                       		nop	
000011BA 33FC 0100 00A1 1200        		resetZ80
000011C2 33FC 0000 00A1 1100        		startZ80
000011CA 4E75                       		rts	
000011CC                            ; End of function SoundDriverLoad
000011CC                            
000011CC                            		include	"_incObj\sub PlaySound.asm"
