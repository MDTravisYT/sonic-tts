00003262 EF48                       		lsl.w	#7,d0
00003264 4840                       		swap	d0
00003266 D880                       		add.l	d0,d4
00003268 43F9 0000 0000             		lea	(LevelMenuText).l,a1
0000326E E749                       		lsl.w	#3,d1
00003270 3001                       		move.w	d1,d0
00003272 D241                       		add.w	d1,d1
00003274 D240                       		add.w	d0,d1
00003276 D2C1                       		adda.w	d1,a1
00003278 363C C680                  		move.w	#$C680,d3	; VRAM setting (3rd palette, $680th tile)
0000327C 2D44 0004                  		move.l	d4,4(a6)
