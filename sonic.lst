000738D2                            		; DANGER! This silences ALL channels, even the ones being used
000738D2                            		; by SFX, and not music! @sendfmnoteoff does this already, and
000738D2                            		; doesn't affect SFX channels, either.
000738D2                            		; This should be replaced with an 'rts'.
000738D2 4EBA FF64                  		jsr	FMSilenceAll(pc)
000738D6 6000 0000                  		bra.w	PSGSilenceAll
000738DA                            		; DANGER! InitMusicPlayback, and Sound_PlayBGM for that matter,
000738DA                            		; don't do a very good job of setting up the music tracks.
000738DA                            		; Tracks that aren't defined in a music file's header don't have
000738DA                            		; their channels defined, meaning @sendfmnoteoff won't silence
000738DA                            		; hardware properly. In combination with removing the above
000738DA                            		; calls to FMSilenceAll/PSGSilenceAll, this will cause hanging
000738DA                            		; notes.
000738DA                            		; To fix this, I suggest using this code, instead of an 'rts':
000738DA                            		;lea	v_music_track_ram+TrackVoiceControl(a6),a1
000738DA                            		;lea	FMDACInitBytes(pc),a2
000738DA                            		;moveq	#((v_music_fmdac_tracks_end-v_music_fmdac_tracks)/TrackSz)-1,d1		; 7 DAC/FM tracks
000738DA                            		;bsr.s	@writeloop
000738DA                            		;lea	PSGInitBytes(pc),a2
000738DA                            		;moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d1	; 3 PSG tracks
000738DA                            
000738DA                            ;@writeloop:
000738DA                            		;move.b	(a2)+,(a1)		; Write track's channel byte
000738DA                            		;lea	TrackSz(a1),a1		; Next track
000738DA                            		;dbf	d1,@writeloop		; Loop for all DAC/FM/PSG tracks
000738DA                            
000738DA                            		;rts
000738DA                            	
000738DA                            ; End of function InitMusicPlayback
