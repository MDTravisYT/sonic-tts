00001548                            ; ---------------------------------------------------------------------------
00001548                            ; Subroutine to load pattern load cues (aka to queue pattern load requests)
00001548                            ; ---------------------------------------------------------------------------
00001548                            
00001548                            ; ARGUMENTS
00001548                            ; d0 = index of PLC list
00001548                            ; ---------------------------------------------------------------------------
00001548                            
00001548                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001548                            
00001548                            ; LoadPLC:
00001548                            AddPLC:
00001548 48E7 0060                  		movem.l	a1-a2,-(sp)
0000154C 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
00001552 D040                       		add.w	d0,d0
00001554 3031 0000                  		move.w	(a1,d0.w),d0
00001558 43F1 0000                  		lea	(a1,d0.w),a1		; jump to relevant PLC
0000155C 45F8 F680                  		lea	(v_plc_buffer).w,a2 ; PLC buffer space
00001560                            
00001560                            	@findspace:
00001560 4A92                       		tst.l	(a2)		; is space available in RAM?
00001562 6700                       		beq.s	@copytoRAM	; if yes, branch
00001564 5C4A                       		addq.w	#6,a2		; if not, try next space
00001566 60F8                       		bra.s	@findspace
00001568                            ; ===========================================================================
00001568                            
00001568                            @copytoRAM:
00001568 3019                       		move.w	(a1)+,d0	; get length of PLC
0000156A 6B00                       		bmi.s	@skip
0000156C                            
0000156C                            	@loop:
0000156C 24D9                       		move.l	(a1)+,(a2)+
0000156E 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
00001570 51C8 FFFA                  		dbf	d0,@loop	; repeat for length of PLC
00001574                            
00001574                            	@skip:
00001574 4CDF 0600                  		movem.l	(sp)+,a1-a2 ; a1=object
00001578 4E75                       		rts	
0000157A                            ; End of function AddPLC
