00053B50 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00053B52 6A00                       		bpl.s	@fadedfm		; Branch if not
00053B54 226E 0018                  		movea.l	v_voice_ptr(a6),a1	; Voice pointer
00053B58 102D 000B                  		move.b	TrackVoiceIndex(a5),d0	; Current voice
