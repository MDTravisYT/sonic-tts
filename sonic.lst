0000125E 3ABC 8F02                  		move.w	#$8F02,(a5)	; set VDP increment size
00001262 221F                       		move.l	(sp)+,d1
00001264 4E75                       		rts	
00001266                            ; End of function VDPSetupGame
00001266                            
00001266                            ; ===========================================================================
00001266 8004                       VDPSetupArray:	dc.w $8004		; 8-colour mode
00001268 8134                       		dc.w $8134		; enable V.interrupts, enable DMA
0000126A 8230                       		dc.w $8200+(vram_fg>>10) ; set foreground nametable address
0000126C 8328                       		dc.w $8300+($A000>>10)	; set window nametable address
0000126E 8407                       		dc.w $8400+(vram_bg>>13) ; set background nametable address
00001270 857C                       		dc.w $8500+(vram_sprites>>9) ; set sprite table address
00001272 8600                       		dc.w $8600		; unused
00001274 8700                       		dc.w $8700		; set background colour (palette entry 0)
00001276 8800                       		dc.w $8800		; unused
00001278 8900                       		dc.w $8900		; unused
0000127A 8A00                       		dc.w $8A00		; default H.interrupt register
0000127C 8B00                       		dc.w $8B00		; full-screen vertical scrolling
0000127E 8C81                       		dc.w $8C81		; 40-cell display mode
00001280 8D3F                       		dc.w $8D00+(vram_hscroll>>10) ; set background hscroll address
00001282 8E00                       		dc.w $8E00		; unused
00001284 8F02                       		dc.w $8F02		; set VDP increment size
00001286 9001                       		dc.w $9001		; 64-cell hscroll size
00001288 9100                       		dc.w $9100		; window horizontal position
0000128A 9200                       		dc.w $9200		; window vertical position
0000128C                            
