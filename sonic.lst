000147FE                            		include	"_incObj\sub FindNearestTile.asm"
000147FE                            ; ---------------------------------------------------------------------------
000147FE                            ; Subroutine to	find which tile	the object is standing on
000147FE                            
000147FE                            ; input:
000147FE                            ;	d2 = y-position of object's bottom edge
000147FE                            ;	d3 = x-position of object
000147FE                            
000147FE                            ; output:
000147FE                            ;	a1 = address within 256x256 mappings where object is standing
000147FE                            ;	     (refers to a 16x16 tile number)
000147FE                            ; ---------------------------------------------------------------------------
000147FE                            
000147FE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000147FE                            
000147FE                            
000147FE                            FindNearestTile:
000147FE 3002                       		move.w	d2,d0		; get y-pos. of bottom edge of object
00014800 E248                       		lsr.w	#1,d0
00014802 0240 0380                  		andi.w	#$380,d0
00014806 3203                       		move.w	d3,d1		; get x-pos. of object
00014808 E049                       		lsr.w	#8,d1
0001480A 0241 007F                  		andi.w	#$7F,d1
0001480E D041                       		add.w	d1,d0		; combine
00014810 72FF                       		moveq	#-1,d1
00014812 43F8 A400                  		lea	(v_lvllayout).w,a1
00014816 1231 0000                  		move.b	(a1,d0.w),d1	; get 256x256 tile number
0001481A 6700                       		beq.s	@blanktile	; branch if 0
0001481C 6B00                       		bmi.s	@specialtile	; branch if >$7F
0001481E 5301                       		subq.b	#1,d1
00014820 4881                       		ext.w	d1
00014822 EE59                       		ror.w	#7,d1
00014824 3002                       		move.w	d2,d0
00014826 D040                       		add.w	d0,d0
00014828 0240 01E0                  		andi.w	#$1E0,d0
0001482C D240                       		add.w	d0,d1
0001482E 3003                       		move.w	d3,d0
00014830 E648                       		lsr.w	#3,d0
00014832 0240 001E                  		andi.w	#$1E,d0
00014836 D240                       		add.w	d0,d1
