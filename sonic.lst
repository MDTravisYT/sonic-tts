00009976                            ; ---------------------------------------------------------------------------
00009976                            ; Subroutine to	animate	a sprite using an animation script
00009976                            ; ---------------------------------------------------------------------------
00009976                            
00009976                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00009976                            
00009976                            
00009976                            AnimateSprite:
00009976 7000                       		moveq	#0,d0
00009978 1028 001C                  		move.b	obAnim(a0),d0	; move animation number	to d0
0000997C B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
00009980 6700                       		beq.s	Anim_Run	; if not, branch
00009982                            
00009982 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
00009986 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
0000998C 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
00009992                            
00009992                            Anim_Run:
00009992 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00009996 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
00009998 D040                       		add.w	d0,d0
0000999A D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000999E 1151 001E                  		move.b	(a1),obTimeFrame(a0) ; load frame duration
000099A2 7200                       		moveq	#0,d1
000099A4 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
000099A8 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000099AC 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
000099AE                            
000099AE                            Anim_Next:
000099AE 1200                       		move.b	d0,d1
000099B0 0200 001F                  		andi.b	#$1F,d0
000099B4 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
000099B8 1028 0022                  		move.b	obStatus(a0),d0
000099BC E719                       		rol.b	#3,d1
000099BE B101                       		eor.b	d0,d1
000099C0 0201 0003                  		andi.b	#3,d1
000099C4 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
000099CA 8328 0001                  		or.b	d1,obRender(a0)
000099CE 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
000099D2                            
000099D2                            Anim_Wait:
000099D2 4E75                       		rts	
000099D4                            ; ===========================================================================
000099D4                            
000099D4                            Anim_End_FF:
000099D4 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000099D6 6600                       		bne.s	Anim_End_FE	; if not, branch
