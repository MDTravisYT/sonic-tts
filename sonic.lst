000016D2                            ; ---------------------------------------------------------------------------
000016D2                            ; Kosinski decompression algorithm
000016D2                            
000016D2                            ; input:
000016D2                            ;	a0 = source address
000016D2                            ;	a1 = destination address
000016D2                            
000016D2                            ; usage:
000016D2                            ;	lea	(source).l,a0
000016D2                            ;	lea	(destination).l,a1
000016D2                            ;	bsr.w	KosDec
000016D2                            ; ---------------------------------------------------------------------------
000016D2                            
000016D2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000016D2                            
000016D2                            
000016D2                            KosDec:
000016D2                            
000016D2 558F                       		subq.l	#2,sp	; make space for 2 bytes on the stack
000016D4 1F58 0001                  		move.b	(a0)+,1(sp)
000016D8 1E98                       		move.b	(a0)+,(sp)
000016DA 3A17                       		move.w	(sp),d5	; get first description field
000016DC 780F                       		moveq	#$F,d4	; set to loop for 16 bits
000016DE                            
000016DE                            Kos_Loop:
000016DE E24D                       		lsr.w	#1,d5	; shift bit into the c flag
000016E0 40C6                       		move	sr,d6
000016E2 51CC 0000                  		dbf	d4,@chkbit
000016E6 1F58 0001                  		move.b	(a0)+,1(sp)
000016EA 1E98                       		move.b	(a0)+,(sp)
000016EC 3A17                       		move.w	(sp),d5
000016EE 780F                       		moveq	#$F,d4
000016F0                            
000016F0                            	@chkbit:
000016F0 44C6                       		move	d6,ccr	; was the bit set?
000016F2 6400                       		bcc.s	Kos_RLE	; if not, branch
000016F4                            
000016F4 12D8                       		move.b	(a0)+,(a1)+ ; copy byte as-is
000016F6 60E6                       		bra.s	Kos_Loop
000016F8                            ; ===========================================================================
000016F8                            
000016F8                            Kos_RLE:
000016F8 7600                       		moveq	#0,d3
000016FA E24D                       		lsr.w	#1,d5	; get next bit
000016FC 40C6                       		move	sr,d6
000016FE 51CC 0000                  		dbf	d4,@chkbit
00001702 1F58 0001                  		move.b	(a0)+,1(sp)
00001706 1E98                       		move.b	(a0)+,(sp)
00001708 3A17                       		move.w	(sp),d5
0000170A 780F                       		moveq	#$F,d4
0000170C                            
0000170C                            	@chkbit:
0000170C 44C6                       		move	d6,ccr	; was the bit set?
0000170E 6500                       		bcs.s	Kos_SeparateRLE ; if yes, branch
00001710                            
00001710 E24D                       		lsr.w	#1,d5	; shift bit into the x flag
00001712 51CC 0000                  		dbf	d4,@loop1
00001716 1F58 0001                  		move.b	(a0)+,1(sp)
0000171A 1E98                       		move.b	(a0)+,(sp)
0000171C 3A17                       		move.w	(sp),d5
0000171E 780F                       		moveq	#$F,d4
00001720                            
00001720                            	@loop1:
00001720 E353                       		roxl.w	#1,d3	; get high repeat count bit
00001722 E24D                       		lsr.w	#1,d5
00001724 51CC 0000                  		dbf	d4,@loop2
00001728 1F58 0001                  		move.b	(a0)+,1(sp)
0000172C 1E98                       		move.b	(a0)+,(sp)
0000172E 3A17                       		move.w	(sp),d5
00001730 780F                       		moveq	#$F,d4
00001732                            
00001732                            	@loop2:
00001732 E353                       		roxl.w	#1,d3	; get low repeat count bit
00001734 5243                       		addq.w	#1,d3	; increment repeat count
00001736 74FF                       		moveq	#-1,d2
00001738 1418                       		move.b	(a0)+,d2 ; calculate offset
0000173A 6000                       		bra.s	Kos_RLELoop
0000173C                            ; ===========================================================================
0000173C                            
0000173C                            Kos_SeparateRLE:
0000173C 1018                       		move.b	(a0)+,d0 ; get first byte
0000173E 1218                       		move.b	(a0)+,d1 ; get second byte
00001740 74FF                       		moveq	#-1,d2
00001742 1401                       		move.b	d1,d2
00001744 EB4A                       		lsl.w	#5,d2
00001746 1400                       		move.b	d0,d2	; calculate offset
00001748 0241 0007                  		andi.w	#7,d1	; does a third byte need to be read?
0000174C 6700                       		beq.s	Kos_SeparateRLE2 ; if yes, branch
0000174E 1601                       		move.b	d1,d3	; copy repeat count
00001750 5243                       		addq.w	#1,d3	; increment
00001752                            
00001752                            Kos_RLELoop:
00001752 1031 2000                  		move.b	(a1,d2.w),d0 ; copy appropriate byte
00001756 12C0                       		move.b	d0,(a1)+ ; repeat
00001758 51CB FFF8                  		dbf	d3,Kos_RLELoop
0000175C 6080                       		bra.s	Kos_Loop
0000175E                            ; ===========================================================================
0000175E                            
0000175E                            Kos_SeparateRLE2:
0000175E 1218                       		move.b	(a0)+,d1
00001760 6700                       		beq.s	Kos_Done ; 0 indicates end of compressed data
00001762 0C01 0001                  		cmpi.b	#1,d1
00001766 6700 FF76                  		beq.w	Kos_Loop ; 1 indicates new description to be read
0000176A 1601                       		move.b	d1,d3	; otherwise, copy repeat count
0000176C 60E4                       		bra.s	Kos_RLELoop
0000176E                            ; ===========================================================================
0000176E                            
0000176E                            Kos_Done:
0000176E 548F                       		addq.l	#2,sp	; restore stack pointer
00001770 4E75                       		rts	
00001772                            ; End of function KosDec
00001772                            ; End of function KosDec
