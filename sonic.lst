00001864                            		include	"_inc\Kosinski Decompression.asm"
00001864                            ; ---------------------------------------------------------------------------
00001864                            ; Kosinski decompression algorithm
00001864                            
00001864                            ; input:
00001864                            ;	a0 = source address
00001864                            ;	a1 = destination address
00001864                            
00001864                            ; usage:
00001864                            ;	lea	(source).l,a0
00001864                            ;	lea	(destination).l,a1
00001864                            ;	bsr.w	KosDec
00001864                            ; ---------------------------------------------------------------------------
00001864                            
00001864                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001864                            
00001864                            
00001864                            KosDec:
00001864                            
00001864 558F                       		subq.l	#2,sp	; make space for 2 bytes on the stack
00001866 1F58 0001                  		move.b	(a0)+,1(sp)
0000186A 1E98                       		move.b	(a0)+,(sp)
0000186C 3A17                       		move.w	(sp),d5	; get first description field
0000186E 780F                       		moveq	#$F,d4	; set to loop for 16 bits
00001870                            
00001870                            Kos_Loop:
00001870 E24D                       		lsr.w	#1,d5	; shift bit into the c flag
00001872 40C6                       		move	sr,d6
00001874 51CC 0000                  		dbf	d4,@chkbit
00001878 1F58 0001                  		move.b	(a0)+,1(sp)
0000187C 1E98                       		move.b	(a0)+,(sp)
0000187E 3A17                       		move.w	(sp),d5
00001880 780F                       		moveq	#$F,d4
00001882                            
00001882                            	@chkbit:
00001882 44C6                       		move	d6,ccr	; was the bit set?
00001884 6400                       		bcc.s	Kos_RLE	; if not, branch
00001886                            
00001886 12D8                       		move.b	(a0)+,(a1)+ ; copy byte as-is
00001888 60E6                       		bra.s	Kos_Loop
0000188A                            ; ===========================================================================
0000188A                            
0000188A                            Kos_RLE:
0000188A 7600                       		moveq	#0,d3
0000188C E24D                       		lsr.w	#1,d5	; get next bit
0000188E 40C6                       		move	sr,d6
00001890 51CC 0000                  		dbf	d4,@chkbit
00001894 1F58 0001                  		move.b	(a0)+,1(sp)
00001898 1E98                       		move.b	(a0)+,(sp)
0000189A 3A17                       		move.w	(sp),d5
0000189C 780F                       		moveq	#$F,d4
0000189E                            
0000189E                            	@chkbit:
0000189E 44C6                       		move	d6,ccr	; was the bit set?
000018A0 6500                       		bcs.s	Kos_SeparateRLE ; if yes, branch
000018A2                            
000018A2 E24D                       		lsr.w	#1,d5	; shift bit into the x flag
000018A4 51CC 0000                  		dbf	d4,@loop1
000018A8 1F58 0001                  		move.b	(a0)+,1(sp)
000018AC 1E98                       		move.b	(a0)+,(sp)
000018AE 3A17                       		move.w	(sp),d5
000018B0 780F                       		moveq	#$F,d4
000018B2                            
000018B2                            	@loop1:
000018B2 E353                       		roxl.w	#1,d3	; get high repeat count bit
000018B4 E24D                       		lsr.w	#1,d5
000018B6 51CC 0000                  		dbf	d4,@loop2
000018BA 1F58 0001                  		move.b	(a0)+,1(sp)
000018BE 1E98                       		move.b	(a0)+,(sp)
000018C0 3A17                       		move.w	(sp),d5
000018C2 780F                       		moveq	#$F,d4
000018C4                            
000018C4                            	@loop2:
000018C4 E353                       		roxl.w	#1,d3	; get low repeat count bit
000018C6 5243                       		addq.w	#1,d3	; increment repeat count
000018C8 74FF                       		moveq	#-1,d2
000018CA 1418                       		move.b	(a0)+,d2 ; calculate offset
000018CC 6000                       		bra.s	Kos_RLELoop
000018CE                            ; ===========================================================================
000018CE                            
000018CE                            Kos_SeparateRLE:
000018CE 1018                       		move.b	(a0)+,d0 ; get first byte
000018D0 1218                       		move.b	(a0)+,d1 ; get second byte
000018D2 74FF                       		moveq	#-1,d2
000018D4 1401                       		move.b	d1,d2
000018D6 EB4A                       		lsl.w	#5,d2
000018D8 1400                       		move.b	d0,d2	; calculate offset
000018DA 0241 0007                  		andi.w	#7,d1	; does a third byte need to be read?
000018DE 6700                       		beq.s	Kos_SeparateRLE2 ; if yes, branch
000018E0 1601                       		move.b	d1,d3	; copy repeat count
000018E2 5243                       		addq.w	#1,d3	; increment
000018E4                            
000018E4                            Kos_RLELoop:
000018E4 1031 2000                  		move.b	(a1,d2.w),d0 ; copy appropriate byte
000018E8 12C0                       		move.b	d0,(a1)+ ; repeat
000018EA 51CB FFF8                  		dbf	d3,Kos_RLELoop
000018EE 6080                       		bra.s	Kos_Loop
000018F0                            ; ===========================================================================
000018F0                            
000018F0                            Kos_SeparateRLE2:
000018F0 1218                       		move.b	(a0)+,d1
000018F2 6700                       		beq.s	Kos_Done ; 0 indicates end of compressed data
000018F4 0C01 0001                  		cmpi.b	#1,d1
000018F8 6700 FF76                  		beq.w	Kos_Loop ; 1 indicates new description to be read
000018FC 1601                       		move.b	d1,d3	; otherwise, copy repeat count
000018FE 60E4                       		bra.s	Kos_RLELoop
00001900                            ; ===========================================================================
00001900                            
00001900                            Kos_Done:
00001900 548F                       		addq.l	#2,sp	; restore stack pointer
00001902 4E75                       		rts	
00001904                            ; End of function KosDec
00001904                            ; End of function KosDec
