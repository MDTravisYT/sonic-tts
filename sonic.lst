00006200 2C99                       		move.l	(a1)+,(a6)	; Write top two tiles
00006202 D087                       		add.l	d7,d0		; Next row
00006204 2A80                       		move.l	d0,(a5)
00006206 2C99                       		move.l	(a1)+,(a6)	; Write bottom two tiles
00006208 4E75                       		rts	
