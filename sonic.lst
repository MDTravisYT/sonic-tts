000011DE                            		include	"_inc\PauseGame.asm"
000011DE                            ; ---------------------------------------------------------------------------
000011DE                            ; Subroutine to	pause the game
000011DE                            ; ---------------------------------------------------------------------------
000011DE                            
000011DE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000011DE                            
000011DE                            
000011DE                            PauseGame:
000011DE 4E71                       		nop	
000011E0 4A38 FE12                  		tst.b	(v_lives).w	; do you have any lives	left?
000011E4 6700                       		beq.s	Unpause		; if not, branch
000011E6 4A78 F63A                  		tst.w	(f_pause).w	; is game already paused?
000011EA 6600                       		bne.s	Pause_StopGame	; if yes, branch
000011EC 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
000011F2 6700                       		beq.s	Pause_DoNothing	; if not, branch
000011F4                            
000011F4                            Pause_StopGame:
000011F4 31FC 0001 F63A             		move.w	#1,(f_pause).w	; freeze time
000011FA 11FC 0001 F003             		move.b	#1,(v_snddriver_ram+f_pausemusic).w ; pause music
00001200                            
00001200                            Pause_Loop:
00001200 11FC 0010 F62A             		move.b	#$10,(v_vbla_routine).w
00001206 6100 0000                  		bsr.w	WaitForVBla
0000120A 4A38 FFE1                  		tst.b	(f_slomocheat).w ; is slow-motion cheat on?
0000120E 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001210 0838 0006 F605             		btst	#bitA,(v_jpadpress1).w ; is button A pressed?
00001216 6700                       		beq.s	Pause_ChkBC	; if not, branch
00001218 11FC 0000 F600             		move.b	#id_Title,(v_gamemode).w ; set game mode to 4 (title screen)
0000121E 4E71                       		nop	
00001220 6000                       		bra.s	Pause_EndMusic
00001222                            ; ===========================================================================
00001222                            
00001222                            Pause_ChkBC:
00001222 0838 0004 F604             		btst	#bitB,(v_jpadhold1).w ; is button B pressed?
00001228 6600                       		bne.s	Pause_SlowMo	; if yes, branch
0000122A 0838 0005 F605             		btst	#bitC,(v_jpadpress1).w ; is button C pressed?
00001230 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001232                            
00001232                            Pause_ChkStart:
00001232 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
00001238 67C6                       		beq.s	Pause_Loop	; if not, branch
0000123A                            
0000123A                            Pause_EndMusic:
0000123A 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; unpause the music
00001240                            
00001240                            Unpause:
00001240 31FC 0000 F63A             		move.w	#0,(f_pause).w	; unpause the game
00001246                            
00001246                            Pause_DoNothing:
00001246 4E75                       		rts	
00001248                            ; ===========================================================================
00001248                            
00001248                            Pause_SlowMo:
00001248 31FC 0001 F63A             		move.w	#1,(f_pause).w
0000124E 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; Unpause the music
00001254 4E75                       		rts	
00001256                            ; End of function PauseGame
00001256                            ; End of function PauseGame
