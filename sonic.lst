0000196A 5278 F632                  		addq.w	#1,(v_pcyc_num).w ; increment cycle number
0000196E 0240 0003                  		andi.w	#3,d0		; if cycle > 3, reset to 0
00001972 E748                       		lsl.w	#3,d0
00001974 41F9 0000 0000             		lea	(Pal_LZCyc1).l,a0
0000197A 0C38 0003 FE11             		cmpi.b	#3,(v_act).w	; check if level is SBZ3
00001980 6600                       		bne.s	PCycLZ_NotSBZ3
