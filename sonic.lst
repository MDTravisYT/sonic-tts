0001B0D8                            ; Subroutine to	transfer graphics to VRAM
0001B0D8                            
0001B0D8                            ; input:
0001B0D8                            ;	a1 = source address
0001B0D8                            ;	a6 = vdp_data_port ($C00000)
0001B0D8                            ;	d1 = number of tiles to load (minus one)
0001B0D8                            ; ---------------------------------------------------------------------------
0001B0D8                            
0001B0D8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0001B0D8                            
0001B0D8                            
0001B0D8                            LoadTiles:
