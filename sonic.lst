00000100 4861 636B 2063 7265 6174+  Hack_Credits:	dc.b "Hack created by Lucaio Super and MCTravisYT     "
00000130 5345 4741 204D 4547 4120+  Console:	dc.b "SEGA MEGA DRIVE " ; Hardware system ID (Console name)
00000140 2843 2953 4547 4120 3139+  Date:		dc.b "(C)SEGA 1990.JUN" ; Copyright holder and release date (generally year)
00000150 534F 4E49 4320 5448 4520+  Title_Local:	dc.b "SONIC THE               HEDGEHOG                " ; Domestic name
00000180 534F 4E49 4320 5448 4520+  Title_Int:	dc.b "SONIC THE               HEDGEHOG                " ; International name
000001B0 474D 2030 3030 3031 3030+  		dc.b "GM 00001009-00"   ; Serial/version number (Rev 0)
