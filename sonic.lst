000011D2                            		include	"_inc\PauseGame.asm"
000011D2                            ; ---------------------------------------------------------------------------
000011D2                            ; Subroutine to	pause the game
000011D2                            ; ---------------------------------------------------------------------------
000011D2                            
000011D2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000011D2                            
000011D2                            
000011D2                            PauseGame:
000011D2 4E71                       		nop	
000011D4 4A38 FE12                  		tst.b	(v_lives).w	; do you have any lives	left?
000011D8 6700                       		beq.s	Unpause		; if not, branch
000011DA 4A78 F63A                  		tst.w	(f_pause).w	; is game already paused?
000011DE 6600                       		bne.s	Pause_StopGame	; if yes, branch
000011E0 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
000011E6 6700                       		beq.s	Pause_DoNothing	; if not, branch
000011E8                            
000011E8                            Pause_StopGame:
000011E8 31FC 0001 F63A             		move.w	#1,(f_pause).w	; freeze time
000011EE 11FC 0001 F003             		move.b	#1,(v_snddriver_ram+f_pausemusic).w ; pause music
000011F4                            
000011F4                            Pause_Loop:
000011F4 11FC 0010 F62A             		move.b	#$10,(v_vbla_routine).w
000011FA 6100 0000                  		bsr.w	WaitForVBla
000011FE 4A38 FFE1                  		tst.b	(f_slomocheat).w ; is slow-motion cheat on?
00001202 6700                       		beq.s	Pause_ChkStart	; if not, branch
00001204 0838 0006 F605             		btst	#bitA,(v_jpadpress1).w ; is button A pressed?
0000120A 6700                       		beq.s	Pause_ChkBC	; if not, branch
0000120C 11FC 0000 F600             		move.b	#id_Title,(v_gamemode).w ; set game mode to 4 (title screen)
00001212 4E71                       		nop	
00001214 6000                       		bra.s	Pause_EndMusic
00001216                            ; ===========================================================================
00001216                            
00001216                            Pause_ChkBC:
00001216 0838 0004 F604             		btst	#bitB,(v_jpadhold1).w ; is button B pressed?
0000121C 6600                       		bne.s	Pause_SlowMo	; if yes, branch
0000121E 0838 0005 F605             		btst	#bitC,(v_jpadpress1).w ; is button C pressed?
00001224 6600                       		bne.s	Pause_SlowMo	; if yes, branch
00001226                            
00001226                            Pause_ChkStart:
00001226 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
0000122C 67C6                       		beq.s	Pause_Loop	; if not, branch
0000122E                            
0000122E                            Pause_EndMusic:
0000122E 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; unpause the music
00001234                            
00001234                            Unpause:
00001234 31FC 0000 F63A             		move.w	#0,(f_pause).w	; unpause the game
0000123A                            
0000123A                            Pause_DoNothing:
0000123A 4E75                       		rts	
0000123C                            ; ===========================================================================
0000123C                            
0000123C                            Pause_SlowMo:
0000123C 31FC 0001 F63A             		move.w	#1,(f_pause).w
00001242 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; Unpause the music
00001248 4E75                       		rts	
0000124A                            ; End of function PauseGame
0000124A                            ; End of function PauseGame
