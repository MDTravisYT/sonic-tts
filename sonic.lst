0000124A                            ; ---------------------------------------------------------------------------
0000124A                            ; Subroutine to	copy a tile map from RAM to VRAM namespace
0000124A                            
0000124A                            ; input:
0000124A                            ;	a1 = tile map address
0000124A                            ;	d0 = VRAM address
0000124A                            ;	d1 = width (cells)
0000124A                            ;	d2 = height (cells)
0000124A                            ; ---------------------------------------------------------------------------
0000124A                            
0000124A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000124A                            
0000124A                            
0000124A                            TilemapToVRAM:
0000124A 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
00001250 283C 0080 0000             		move.l	#$800000,d4
00001256                            
00001256                            	Tilemap_Line:
00001256 2D40 0004                  		move.l	d0,4(a6)	; move d0 to VDP_control_port
0000125A 3601                       		move.w	d1,d3
0000125C                            
0000125C                            	Tilemap_Cell:
0000125C 3C99                       		move.w	(a1)+,(a6)	; write value to namespace
0000125E 51CB FFFC                  		dbf	d3,Tilemap_Cell	; next tile
00001262 D084                       		add.l	d4,d0		; goto next line
00001264 51CA FFF0                  		dbf	d2,Tilemap_Line	; next line
00001268 4E75                       		rts	
0000126A                            ; End of function TilemapToVRAM
0000126A                            
0000126A                            		include	"_inc\Nemesis Decompression.asm"
0000126A                            ; ---------------------------------------------------------------------------
0000126A                            ; Nemesis decompression	subroutine, decompresses art directly to VRAM
0000126A                            ; Inputs:
0000126A                            ; a0 = art address
0000126A                            
0000126A                            ; For format explanation see http://info.sonicretro.org/Nemesis_compression
0000126A                            ; ---------------------------------------------------------------------------
0000126A                            
0000126A                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000126A                            
0000126A                            ; Nemesis decompression to VRAM
0000126A                            NemDec:
0000126A 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
0000126E 47F9 0000 0000             		lea	(NemPCD_WriteRowToVDP).l,a3	; write all data to the same location
00001274 49F9 00C0 0000             		lea	(vdp_data_port).l,a4	; specifically, to the VDP data port
0000127A 6000                       		bra.s	NemDecMain
0000127C                            
0000127C                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000127C                            
0000127C                            ; Nemesis decompression subroutine, decompresses art to RAM
0000127C                            ; Inputs:
0000127C                            ; a0 = art address
0000127C                            ; a4 = destination RAM address
0000127C                            NemDecToRAM:
0000127C 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001280 47F9 0000 0000             		lea	(NemPCD_WriteRowToRAM).l,a3 ; advance to the next location after each write
00001286                            
00001286                            NemDecMain:
00001286 43F8 AA00                  		lea	(v_ngfx_buffer).w,a1
0000128A 3418                       		move.w	(a0)+,d2	; get number of patterns
0000128C E34A                       		lsl.w	#1,d2
0000128E 6400                       		bcc.s	loc_146A	; branch if the sign bit isn't set
00001290 D6FC 0000                  		adda.w	#NemPCD_WriteRowToVDP_XOR-NemPCD_WriteRowToVDP,a3	; otherwise the file uses XOR mode
00001294                            
00001294                            loc_146A:
00001294 E54A                       		lsl.w	#2,d2	; get number of 8-pixel rows in the uncompressed data
00001296 3A42                       		movea.w	d2,a5	; and store it in a5 because there aren't any spare data registers
00001298 7608                       		moveq	#8,d3	; 8 pixels in a pattern row
0000129A 7400                       		moveq	#0,d2
0000129C 7800                       		moveq	#0,d4
0000129E 6100 0000                  		bsr.w	NemDec_BuildCodeTable
000012A2 1A18                       		move.b	(a0)+,d5	; get first byte of compressed data
000012A4 E145                       		asl.w	#8,d5	; shift up by a byte
000012A6 1A18                       		move.b	(a0)+,d5	; get second byte of compressed data
000012A8 3C3C 0010                  		move.w	#$10,d6	; set initial shift value
000012AC 6100                       		bsr.s	NemDec_ProcessCompressedData
000012AE 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
000012B2 4E75                       		rts	
000012B4                            ; End of function NemDec
000012B4                            
000012B4                            ; ---------------------------------------------------------------------------
000012B4                            ; Part of the Nemesis decompressor, processes the actual compressed data
000012B4                            ; ---------------------------------------------------------------------------
000012B4                            
000012B4                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000012B4                            
000012B4                            
000012B4                            NemDec_ProcessCompressedData:
000012B4 3E06                       		move.w	d6,d7
000012B6 5147                       		subq.w	#8,d7	; get shift value
000012B8 3205                       		move.w	d5,d1
000012BA EE69                       		lsr.w	d7,d1	; shift so that high bit of the code is in bit position 7
000012BC 0C01 00FC                  		cmpi.b	#%11111100,d1	; are the high 6 bits set?
000012C0 6400                       		bcc.s	NemPCD_InlineData	; if they are, it signifies inline data
000012C2 0241 00FF                  		andi.w	#$FF,d1
000012C6 D241                       		add.w	d1,d1
000012C8 1031 1000                  		move.b	(a1,d1.w),d0	; get the length of the code in bits
000012CC 4880                       		ext.w	d0
000012CE 9C40                       		sub.w	d0,d6	; subtract from shift value so that the next code is read next time around
000012D0 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
000012D4 6400                       		bcc.s	loc_14B2	; if not, branch
000012D6 5046                       		addq.w	#8,d6
000012D8 E145                       		asl.w	#8,d5
000012DA 1A18                       		move.b	(a0)+,d5	; read next byte
000012DC                            
000012DC                            loc_14B2:
000012DC 1231 1001                  		move.b	1(a1,d1.w),d1
000012E0 3001                       		move.w	d1,d0
000012E2 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000012E6 0240 00F0                  		andi.w	#$F0,d0
000012EA                            
000012EA                            NemPCD_ProcessCompressedData:
000012EA E848                       		lsr.w	#4,d0	; get repeat count
000012EC                            
000012EC                            NemPCD_WritePixel:
000012EC E98C                       		lsl.l	#4,d4	; shift up by a nybble
000012EE 8801                       		or.b	d1,d4	; write pixel
000012F0 5343                       		subq.w	#1,d3	; has an entire 8-pixel row been written?
000012F2 6600                       		bne.s	NemPCD_WritePixel_Loop	; if not, loop
000012F4 4ED3                       		jmp	(a3)	; otherwise, write the row to its destination, by doing a dynamic jump to NemPCD_WriteRowToVDP, NemDec_WriteAndAdvance, NemPCD_WriteRowToVDP_XOR, or NemDec_WriteAndAdvance_XOR
000012F6                            ; End of function NemDec_ProcessCompressedData
000012F6                            
000012F6                            
000012F6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000012F6                            
000012F6                            
000012F6                            NemPCD_NewRow:
000012F6 7800                       		moveq	#0,d4	; reset row
000012F8 7608                       		moveq	#8,d3	; reset nybble counter
000012FA                            
000012FA                            NemPCD_WritePixel_Loop:
000012FA 51C8 FFF0                  		dbf	d0,NemPCD_WritePixel
000012FE 60B4                       		bra.s	NemDec_ProcessCompressedData
00001300                            ; ===========================================================================
00001300                            
00001300                            NemPCD_InlineData:
00001300 5D46                       		subq.w	#6,d6	; 6 bits needed to signal inline data
00001302 0C46 0009                  		cmpi.w	#9,d6
00001306 6400                       		bcc.s	loc_14E4
00001308 5046                       		addq.w	#8,d6
0000130A E145                       		asl.w	#8,d5
0000130C 1A18                       		move.b	(a0)+,d5
0000130E                            
0000130E                            loc_14E4:
0000130E 5F46                       		subq.w	#7,d6	; and 7 bits needed for the inline data itself
00001310 3205                       		move.w	d5,d1
00001312 EC69                       		lsr.w	d6,d1	; shift so that low bit of the code is in bit position 0
00001314 3001                       		move.w	d1,d0
00001316 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
0000131A 0240 0070                  		andi.w	#$70,d0	; high nybble is repeat count for pixel
0000131E 0C46 0009                  		cmpi.w	#9,d6
00001322 64C6                       		bcc.s	NemPCD_ProcessCompressedData
00001324 5046                       		addq.w	#8,d6
00001326 E145                       		asl.w	#8,d5
00001328 1A18                       		move.b	(a0)+,d5
0000132A 60BE                       		bra.s	NemPCD_ProcessCompressedData
0000132C                            ; End of function NemPCD_NewRow
0000132C                            
0000132C                            ; ===========================================================================
0000132C                            
0000132C                            NemPCD_WriteRowToVDP:
0000132C 2884                       		move.l	d4,(a4)	; write 8-pixel row
0000132E 534D                       		subq.w	#1,a5
00001330 380D                       		move.w	a5,d4	; have all the 8-pixel rows been written?
00001332 66C2                       		bne.s	NemPCD_NewRow	; if not, branch
00001334 4E75                       		rts		; otherwise the decompression is finished
00001336                            ; ===========================================================================
00001336                            NemPCD_WriteRowToVDP_XOR:
00001336 B982                       		eor.l	d4,d2	; XOR the previous row by the current row
00001338 2882                       		move.l	d2,(a4)	; and write the result
0000133A 534D                       		subq.w	#1,a5
0000133C 380D                       		move.w	a5,d4
0000133E 66B6                       		bne.s	NemPCD_NewRow
00001340 4E75                       		rts	
00001342                            ; ===========================================================================
00001342                            
00001342                            NemPCD_WriteRowToRAM:
00001342 28C4                       		move.l	d4,(a4)+
00001344 534D                       		subq.w	#1,a5
00001346 380D                       		move.w	a5,d4
00001348 66AC                       		bne.s	NemPCD_NewRow
0000134A 4E75                       		rts	
0000134C                            ; ===========================================================================
0000134C                            NemPCD_WriteRowToRAM_XOR:
0000134C B982                       		eor.l	d4,d2
0000134E 28C2                       		move.l	d2,(a4)+
00001350 534D                       		subq.w	#1,a5
00001352 380D                       		move.w	a5,d4
00001354 66A0                       		bne.s	NemPCD_NewRow
00001356 4E75                       		rts	
00001358                            
00001358                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001358                            ; ---------------------------------------------------------------------------
00001358                            ; Part of the Nemesis decompressor, builds the code table (in RAM)
00001358                            ; ---------------------------------------------------------------------------
00001358                            
00001358                            
00001358                            NemDec_BuildCodeTable:
00001358 1018                       		move.b	(a0)+,d0	; read first byte
0000135A                            
0000135A                            NemBCT_ChkEnd:
0000135A 0C00 00FF                  		cmpi.b	#$FF,d0	; has the end of the code table description been reached?
0000135E 6600                       		bne.s	NemBCT_NewPALIndex	; if not, branch
00001360 4E75                       		rts	; otherwise, this subroutine's work is done
00001362                            ; ===========================================================================
00001362                            
00001362                            NemBCT_NewPALIndex:
00001362 3E00                       		move.w	d0,d7
00001364                            
00001364                            NemBCT_Loop:
00001364 1018                       		move.b	(a0)+,d0	; read next byte
00001366 0C00 0080                  		cmpi.b	#$80,d0	; sign bit being set signifies a new palette index
0000136A 64EE                       		bcc.s	NemBCT_ChkEnd	; a bmi could have been used instead of a compare and bcc
0000136C                            		
0000136C 1200                       		move.b	d0,d1
0000136E 0247 000F                  		andi.w	#$F,d7	; get palette index
00001372 0241 0070                  		andi.w	#$70,d1	; get repeat count for palette index
00001376 8E41                       		or.w	d1,d7	; combine the two
00001378 0240 000F                  		andi.w	#$F,d0	; get the length of the code in bits
0000137C 1200                       		move.b	d0,d1
0000137E E149                       		lsl.w	#8,d1
00001380 8E41                       		or.w	d1,d7	; combine with palette index and repeat count to form code table entry
00001382 7208                       		moveq	#8,d1
00001384 9240                       		sub.w	d0,d1	; is the code 8 bits long?
00001386 6600                       		bne.s	NemBCT_ShortCode	; if not, a bit of extra processing is needed
00001388 1018                       		move.b	(a0)+,d0	; get code
0000138A D040                       		add.w	d0,d0	; each code gets a word-sized entry in the table
0000138C 3387 0000                  		move.w	d7,(a1,d0.w)	; store the entry for the code
00001390 60D2                       		bra.s	NemBCT_Loop	; repeat
00001392                            ; ===========================================================================
00001392                            
00001392                            ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
00001392                            ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
00001392                            ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
00001392                            ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
00001392                            ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
00001392                            ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
00001392                            NemBCT_ShortCode:
00001392 1018                       		move.b	(a0)+,d0	; get code
00001394 D040                       		add.w	d0,d0	; shift so that high bit is in bit position 7
00001396 E368                       		lsl.w	d1,d0	; get index into code table
00001398 7A01                       		moveq	#1,d5
0000139A E36D                       		lsl.w	d1,d5
0000139C 5345                       		subq.w	#1,d5	; d5 = 2^d1 - 1
0000139E                            
0000139E                            NemBCT_ShortCode_Loop:
0000139E 3387 0000                  		move.w	d7,(a1,d0.w)	; store entry
000013A2 5440                       		addq.w	#2,d0	; increment index
000013A4 51CD FFF8                  		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
000013A8 60BA                       		bra.s	NemBCT_Loop
000013AA                            ; End of function NemDec_BuildCodeTable
000013AA                            ; End of function NemDec_BuildCodeTable
000013AA                            
000013AA                            
000013AA                            ; ---------------------------------------------------------------------------
000013AA                            ; Subroutine to load pattern load cues (aka to queue pattern load requests)
000013AA                            ; ---------------------------------------------------------------------------
000013AA                            
000013AA                            ; ARGUMENTS
000013AA                            ; d0 = index of PLC list
000013AA                            ; ---------------------------------------------------------------------------
000013AA                            
000013AA                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000013AA                            
000013AA                            ; LoadPLC:
000013AA                            AddPLC:
000013AA 48E7 0060                  		movem.l	a1-a2,-(sp)
000013AE 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
000013B4 D040                       		add.w	d0,d0
000013B6 3031 0000                  		move.w	(a1,d0.w),d0
000013BA 43F1 0000                  		lea	(a1,d0.w),a1		; jump to relevant PLC
000013BE 45F8 F680                  		lea	(v_plc_buffer).w,a2 ; PLC buffer space
000013C2                            
000013C2                            	@findspace:
000013C2 4A92                       		tst.l	(a2)		; is space available in RAM?
000013C4 6700                       		beq.s	@copytoRAM	; if yes, branch
000013C6 5C4A                       		addq.w	#6,a2		; if not, try next space
000013C8 60F8                       		bra.s	@findspace
000013CA                            ; ===========================================================================
000013CA                            
000013CA                            @copytoRAM:
000013CA 3019                       		move.w	(a1)+,d0	; get length of PLC
000013CC 6B00                       		bmi.s	@skip
000013CE                            
000013CE                            	@loop:
000013CE 24D9                       		move.l	(a1)+,(a2)+
000013D0 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
000013D2 51C8 FFFA                  		dbf	d0,@loop	; repeat for length of PLC
000013D6                            
000013D6                            	@skip:
000013D6 4CDF 0600                  		movem.l	(sp)+,a1-a2 ; a1=object
000013DA 4E75                       		rts	
000013DC                            ; End of function AddPLC
