000012C4                            ; Subroutine to	clear the screen
000012C4                            ; ---------------------------------------------------------------------------
000012C4                            
000012C4                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000012C4                            
000012C4                            
000012C4                            ClearScreen:
000012C4 4BF9 00C0 0004 3ABC 8F01+  		fillVRAM	0,$FFF,vram_fg ; clear foreground namespace
000012E6                            
000012E6                            	@wait1:
000012E6 3215                       		move.w	(a5),d1
000012E8 0801 0001                  		btst	#1,d1
000012EC 66F8                       		bne.s	@wait1
000012EE                            
000012EE 3ABC 8F02                  		move.w	#$8F02,(a5)
000012F2 4BF9 00C0 0004 3ABC 8F01+  		fillVRAM	0,$FFF,vram_bg ; clear background namespace
00001314                            
00001314                            	@wait2:
00001314 3215                       		move.w	(a5),d1
00001316 0801 0001                  		btst	#1,d1
0000131A 66F8                       		bne.s	@wait2
0000131C                            
0000131C 3ABC 8F02                  		move.w	#$8F02,(a5)
00001320 21FC 0000 0000 F616        		move.l	#0,(v_scrposy_dup).w
00001328 21FC 0000 0000 F61A        		move.l	#0,(v_scrposx_dup).w
00001330                            
00001330 43F8 F800                  		lea	(v_spritetablebuffer).w,a1
00001334 7000                       		moveq	#0,d0
00001336 323C 00A0                  		move.w	#($280/4),d1	; This should be ($280/4)-1, leading to a slight bug (first bit of v_pal_water is cleared)
0000133A                            
0000133A                            	@clearsprites:
0000133A 22C0                       		move.l	d0,(a1)+
0000133C 51C9 FFFC                  		dbf	d1,@clearsprites ; clear sprite table (in RAM)
00001340                            
00001340 43F8 CC00                  		lea	(v_hscrolltablebuffer).w,a1
00001344 7000                       		moveq	#0,d0
00001346 323C 0100                  		move.w	#($400/4),d1	; This should be ($400/4)-1, leading to a slight bug (first bit of the Sonic object's RAM is cleared)
0000134A                            
0000134A                            	@clearhscroll:
0000134A 22C0                       		move.l	d0,(a1)+
0000134C 51C9 FFFC                  		dbf	d1,@clearhscroll ; clear hscroll table (in RAM)
00001350 4E75                       		rts	
00001352                            ; End of function ClearScreen
