000061F0 4840                       		swap	d0
000061F2 0810 0004                  		btst	#4,(a0)	; Check Y-flip bit
000061F6 6600                       		bne.s	DrawFlipY
000061F8 0810 0003                  		btst	#3,(a0)	; Check X-flip bit
000061FC 6600                       		bne.s	DrawFlipX
