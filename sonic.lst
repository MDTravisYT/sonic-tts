00013BAC D040                       		add.w	d0,d0
00013BAE 0240 01E0                  		andi.w	#$1E0,d0
00013BB2 D240                       		add.w	d0,d1
00013BB4 3003                       		move.w	d3,d0
00013BB6 E648                       		lsr.w	#3,d0
00013BB8 0240 001E                  		andi.w	#$1E,d0
00013BBC D240                       		add.w	d0,d1
00013BBE 2241                       		movea.l	d1,a1
00013BC0 4E75                       		rts	
