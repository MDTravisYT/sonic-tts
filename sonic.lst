00009952                            ; ---------------------------------------------------------------------------
00009952                            ; Subroutine to	animate	a sprite using an animation script
00009952                            ; ---------------------------------------------------------------------------
00009952                            
00009952                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00009952                            
00009952                            
00009952                            AnimateSprite:
00009952 7000                       		moveq	#0,d0
00009954 1028 001C                  		move.b	obAnim(a0),d0	; move animation number	to d0
00009958 B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
0000995C 6700                       		beq.s	Anim_Run	; if not, branch
0000995E                            
0000995E 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
00009962 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
00009968 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
0000996E                            
0000996E                            Anim_Run:
0000996E 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00009972 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
00009974 D040                       		add.w	d0,d0
00009976 D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000997A 1151 001E                  		move.b	(a1),obTimeFrame(a0) ; load frame duration
0000997E 7200                       		moveq	#0,d1
00009980 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
00009984 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00009988 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000998A                            
0000998A                            Anim_Next:
0000998A 1200                       		move.b	d0,d1
0000998C 0200 001F                  		andi.b	#$1F,d0
00009990 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
00009994 1028 0022                  		move.b	obStatus(a0),d0
00009998 E719                       		rol.b	#3,d1
0000999A B101                       		eor.b	d0,d1
0000999C 0201 0003                  		andi.b	#3,d1
000099A0 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
000099A6 8328 0001                  		or.b	d1,obRender(a0)
000099AA 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
000099AE                            
000099AE                            Anim_Wait:
000099AE 4E75                       		rts	
000099B0                            ; ===========================================================================
000099B0                            
000099B0                            Anim_End_FF:
000099B0 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000099B2 6600                       		bne.s	Anim_End_FE	; if not, branch
000099B4 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; restart the animation
000099BA 1029 0001                  		move.b	1(a1),d0	; read sprite number
000099BE 60CA                       		bra.s	Anim_Next
000099C0                            ; ===========================================================================
000099C0                            
000099C0                            Anim_End_FE:
000099C0 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000099C2 6600                       		bne.s	Anim_End_FD	; if not, branch
000099C4 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000099C8 9128 001B                  		sub.b	d0,obAniFrame(a0) ; jump back d0 bytes in the script
000099CC 9200                       		sub.b	d0,d1
000099CE 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
000099D2 60B6                       		bra.s	Anim_Next
000099D4                            ; ===========================================================================
000099D4                            
000099D4                            Anim_End_FD:
