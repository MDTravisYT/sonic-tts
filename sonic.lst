00019E0E                            ; Subroutine to	kill Sonic
00019E0E                            ; ---------------------------------------------------------------------------
00019E0E                            
00019E0E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00019E0E                            
00019E0E                            
00019E0E                            KillSonic:
00019E0E 4A78 FE08                  		tst.w	(v_debuguse).w	; is debug mode	active?
