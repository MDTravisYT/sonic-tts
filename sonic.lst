00014870                            ; ---------------------------------------------------------------------------
00014870                            ; Subroutine to	find the floor
00014870                            
00014870                            ; input:
00014870                            ;	d2 = y-position of object's bottom edge
00014870                            ;	d3 = x-position of object
00014870                            ;	d5 = bit to test for solidness
00014870                            
00014870                            ; output:
00014870                            ;	d1 = distance to the floor
00014870                            ;	a1 = address within 256x256 mappings where object is standing
00014870                            ;	     (refers to a 16x16 tile number)
00014870                            ;	(a4) = floor angle
00014870                            ; ---------------------------------------------------------------------------
00014870                            
00014870                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014870                            
00014870                            
00014870                            FindFloor:
00014870 618C                       		bsr.s	FindNearestTile
00014872 3011                       		move.w	(a1),d0		; get value for solidness, orientation and 16x16 tile number
00014874 3800                       		move.w	d0,d4
00014876 0240 07FF                  		andi.w	#$7FF,d0
0001487A 6700                       		beq.s	@isblank	; branch if tile is blank
0001487C 0B04                       		btst	d5,d4		; is the tile solid?
0001487E 6600                       		bne.s	@issolid	; if yes, branch
00014880                            
00014880                            @isblank:
00014880 D44B                       		add.w	a3,d2
00014882 6100 0000                  		bsr.w	FindFloor2	; try tile below the nearest
00014886 944B                       		sub.w	a3,d2
00014888 0641 0010                  		addi.w	#$10,d1		; return distance to floor
0001488C 4E75                       		rts	
0001488E                            ; ===========================================================================
0001488E                            
0001488E                            @issolid:
0001488E 2478 F796                  		movea.l	(v_collindex).w,a2
00014892 1032 0000                  		move.b	(a2,d0.w),d0	; get collision block number
00014896 0240 00FF                  		andi.w	#$FF,d0
0001489A 67E4                       		beq.s	@isblank	; branch if 0
0001489C 45F9 0000 0000             		lea	(AngleMap).l,a2
000148A2 18B2 0000                  		move.b	(a2,d0.w),(a4)	; get collision angle value
000148A6 E948                       		lsl.w	#4,d0
000148A8 3203                       		move.w	d3,d1		; get x-pos. of object
000148AA 0804 000B                  		btst	#$B,d4		; is block flipped horizontally?
000148AE 6700                       		beq.s	@noflip		; if not, branch
000148B0 4641                       		not.w	d1
000148B2 4414                       		neg.b	(a4)
000148B4                            
000148B4                            	@noflip:
000148B4 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
000148B8 6700                       		beq.s	@noflip2	; if not, branch
000148BA 0614 0040                  		addi.b	#$40,(a4)
000148BE 4414                       		neg.b	(a4)
000148C0 0414 0040                  		subi.b	#$40,(a4)
000148C4                            
000148C4                            	@noflip2:
000148C4 0241 000F                  		andi.w	#$F,d1
000148C8 D240                       		add.w	d0,d1		; (block num. * $10) + x-pos. = place in array
000148CA 45F9 0000 0000             		lea	(CollArray1).l,a2
000148D0 1032 1000                  		move.b	(a2,d1.w),d0	; get collision height
000148D4 4880                       		ext.w	d0
000148D6 BD44                       		eor.w	d6,d4
000148D8 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
000148DC 6700                       		beq.s	@noflip3	; if not, branch
000148DE 4440                       		neg.w	d0
000148E0                            
000148E0                            	@noflip3:
000148E0 4A40                       		tst.w	d0
000148E2 679C                       		beq.s	@isblank	; branch if height is 0
000148E4 6B00                       		bmi.s	@negfloor	; branch if height is negative
000148E6 0C00 0010                  		cmpi.b	#$10,d0
000148EA 6700                       		beq.s	@maxfloor	; branch if height is $10 (max)
000148EC 3202                       		move.w	d2,d1		; get y-pos. of object
000148EE 0241 000F                  		andi.w	#$F,d1
000148F2 D041                       		add.w	d1,d0
000148F4 323C 000F                  		move.w	#$F,d1
000148F8 9240                       		sub.w	d0,d1		; return distance to floor
000148FA 4E75                       		rts	
000148FC                            ; ===========================================================================
000148FC                            
000148FC                            @negfloor:
000148FC 3202                       		move.w	d2,d1
000148FE 0241 000F                  		andi.w	#$F,d1
00014902 D041                       		add.w	d1,d0
00014904 6A00 FF7A                  		bpl.w	@isblank
00014908                            
00014908                            @maxfloor:
00014908 944B                       		sub.w	a3,d2
0001490A 6100 0000                  		bsr.w	FindFloor2	; try tile above the nearest
0001490E D44B                       		add.w	a3,d2
00014910 0441 0010                  		subi.w	#$10,d1		; return distance to floor
00014914 4E75                       		rts	
00014916                            ; End of function FindFloor
