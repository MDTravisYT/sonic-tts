00053FEA 66F4                       		bne.s	WriteFMI	; Loop if so
00053FEC 13C0 00A0 4000             		move.b	d0,(ym2612_a0).l
00053FF2 4E71                       		nop	
00053FF4 4E71                       		nop	
00053FF6 4E71                       		nop	
