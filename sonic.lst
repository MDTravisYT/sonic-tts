00001420                            ; ---------------------------------------------------------------------------
00001420                            ; Subroutine to	copy a tile map from RAM to VRAM namespace
00001420                            
00001420                            ; input:
00001420                            ;	a1 = tile map address
00001420                            ;	d0 = VRAM address
00001420                            ;	d1 = width (cells)
00001420                            ;	d2 = height (cells)
00001420                            ; ---------------------------------------------------------------------------
00001420                            
00001420                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001420                            
00001420                            
00001420                            TilemapToVRAM:
00001420 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
00001426 283C 0080 0000             		move.l	#$800000,d4
0000142C                            
0000142C                            	Tilemap_Line:
0000142C 2D40 0004                  		move.l	d0,4(a6)	; move d0 to VDP_control_port
00001430 3601                       		move.w	d1,d3
00001432                            
00001432                            	Tilemap_Cell:
00001432 3C99                       		move.w	(a1)+,(a6)	; write value to namespace
00001434 51CB FFFC                  		dbf	d3,Tilemap_Cell	; next tile
00001438 D084                       		add.l	d4,d0		; goto next line
0000143A 51CA FFF0                  		dbf	d2,Tilemap_Line	; next line
0000143E 4E75                       		rts	
00001440                            ; End of function TilemapToVRAM
00001440                            
00001440                            		include	"_inc\Nemesis Decompression.asm"
00001440                            ; ---------------------------------------------------------------------------
00001440                            ; Nemesis decompression	subroutine, decompresses art directly to VRAM
00001440                            ; Inputs:
00001440                            ; a0 = art address
00001440                            
00001440                            ; For format explanation see http://info.sonicretro.org/Nemesis_compression
00001440                            ; ---------------------------------------------------------------------------
00001440                            
00001440                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001440                            
00001440                            ; Nemesis decompression to VRAM
00001440                            NemDec:
00001440 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001444 47F9 0000 0000             		lea	(NemPCD_WriteRowToVDP).l,a3	; write all data to the same location
0000144A 49F9 00C0 0000             		lea	(vdp_data_port).l,a4	; specifically, to the VDP data port
00001450 6000                       		bra.s	NemDecMain
00001452                            
00001452                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001452                            
00001452                            ; Nemesis decompression subroutine, decompresses art to RAM
00001452                            ; Inputs:
00001452                            ; a0 = art address
00001452                            ; a4 = destination RAM address
00001452                            NemDecToRAM:
00001452 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
00001456 47F9 0000 0000             		lea	(NemPCD_WriteRowToRAM).l,a3 ; advance to the next location after each write
0000145C                            
0000145C                            NemDecMain:
0000145C 43F8 AA00                  		lea	(v_ngfx_buffer).w,a1
00001460 3418                       		move.w	(a0)+,d2	; get number of patterns
00001462 E34A                       		lsl.w	#1,d2
00001464 6400                       		bcc.s	loc_146A	; branch if the sign bit isn't set
00001466 D6FC 0000                  		adda.w	#NemPCD_WriteRowToVDP_XOR-NemPCD_WriteRowToVDP,a3	; otherwise the file uses XOR mode
0000146A                            
0000146A                            loc_146A:
0000146A E54A                       		lsl.w	#2,d2	; get number of 8-pixel rows in the uncompressed data
0000146C 3A42                       		movea.w	d2,a5	; and store it in a5 because there aren't any spare data registers
0000146E 7608                       		moveq	#8,d3	; 8 pixels in a pattern row
00001470 7400                       		moveq	#0,d2
00001472 7800                       		moveq	#0,d4
00001474 6100 0000                  		bsr.w	NemDec_BuildCodeTable
00001478 1A18                       		move.b	(a0)+,d5	; get first byte of compressed data
0000147A E145                       		asl.w	#8,d5	; shift up by a byte
0000147C 1A18                       		move.b	(a0)+,d5	; get second byte of compressed data
0000147E 3C3C 0010                  		move.w	#$10,d6	; set initial shift value
00001482 6100                       		bsr.s	NemDec_ProcessCompressedData
00001484 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
00001488 4E75                       		rts	
0000148A                            ; End of function NemDec
0000148A                            
0000148A                            ; ---------------------------------------------------------------------------
0000148A                            ; Part of the Nemesis decompressor, processes the actual compressed data
0000148A                            ; ---------------------------------------------------------------------------
0000148A                            
0000148A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000148A                            
0000148A                            
0000148A                            NemDec_ProcessCompressedData:
0000148A 3E06                       		move.w	d6,d7
0000148C 5147                       		subq.w	#8,d7	; get shift value
0000148E 3205                       		move.w	d5,d1
00001490 EE69                       		lsr.w	d7,d1	; shift so that high bit of the code is in bit position 7
00001492 0C01 00FC                  		cmpi.b	#%11111100,d1	; are the high 6 bits set?
00001496 6400                       		bcc.s	NemPCD_InlineData	; if they are, it signifies inline data
00001498 0241 00FF                  		andi.w	#$FF,d1
0000149C D241                       		add.w	d1,d1
0000149E 1031 1000                  		move.b	(a1,d1.w),d0	; get the length of the code in bits
000014A2 4880                       		ext.w	d0
000014A4 9C40                       		sub.w	d0,d6	; subtract from shift value so that the next code is read next time around
000014A6 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
000014AA 6400                       		bcc.s	loc_14B2	; if not, branch
000014AC 5046                       		addq.w	#8,d6
000014AE E145                       		asl.w	#8,d5
000014B0 1A18                       		move.b	(a0)+,d5	; read next byte
000014B2                            
000014B2                            loc_14B2:
000014B2 1231 1001                  		move.b	1(a1,d1.w),d1
000014B6 3001                       		move.w	d1,d0
000014B8 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000014BC 0240 00F0                  		andi.w	#$F0,d0
000014C0                            
000014C0                            NemPCD_ProcessCompressedData:
000014C0 E848                       		lsr.w	#4,d0	; get repeat count
000014C2                            
000014C2                            NemPCD_WritePixel:
000014C2 E98C                       		lsl.l	#4,d4	; shift up by a nybble
000014C4 8801                       		or.b	d1,d4	; write pixel
000014C6 5343                       		subq.w	#1,d3	; has an entire 8-pixel row been written?
000014C8 6600                       		bne.s	NemPCD_WritePixel_Loop	; if not, loop
000014CA 4ED3                       		jmp	(a3)	; otherwise, write the row to its destination, by doing a dynamic jump to NemPCD_WriteRowToVDP, NemDec_WriteAndAdvance, NemPCD_WriteRowToVDP_XOR, or NemDec_WriteAndAdvance_XOR
000014CC                            ; End of function NemDec_ProcessCompressedData
000014CC                            
000014CC                            
000014CC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000014CC                            
000014CC                            
000014CC                            NemPCD_NewRow:
000014CC 7800                       		moveq	#0,d4	; reset row
000014CE 7608                       		moveq	#8,d3	; reset nybble counter
000014D0                            
000014D0                            NemPCD_WritePixel_Loop:
000014D0 51C8 FFF0                  		dbf	d0,NemPCD_WritePixel
000014D4 60B4                       		bra.s	NemDec_ProcessCompressedData
000014D6                            ; ===========================================================================
000014D6                            
000014D6                            NemPCD_InlineData:
000014D6 5D46                       		subq.w	#6,d6	; 6 bits needed to signal inline data
000014D8 0C46 0009                  		cmpi.w	#9,d6
000014DC 6400                       		bcc.s	loc_14E4
000014DE 5046                       		addq.w	#8,d6
000014E0 E145                       		asl.w	#8,d5
000014E2 1A18                       		move.b	(a0)+,d5
000014E4                            
000014E4                            loc_14E4:
000014E4 5F46                       		subq.w	#7,d6	; and 7 bits needed for the inline data itself
000014E6 3205                       		move.w	d5,d1
000014E8 EC69                       		lsr.w	d6,d1	; shift so that low bit of the code is in bit position 0
000014EA 3001                       		move.w	d1,d0
000014EC 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000014F0 0240 0070                  		andi.w	#$70,d0	; high nybble is repeat count for pixel
000014F4 0C46 0009                  		cmpi.w	#9,d6
000014F8 64C6                       		bcc.s	NemPCD_ProcessCompressedData
000014FA 5046                       		addq.w	#8,d6
000014FC E145                       		asl.w	#8,d5
000014FE 1A18                       		move.b	(a0)+,d5
00001500 60BE                       		bra.s	NemPCD_ProcessCompressedData
00001502                            ; End of function NemPCD_NewRow
00001502                            
00001502                            ; ===========================================================================
00001502                            
00001502                            NemPCD_WriteRowToVDP:
00001502 2884                       		move.l	d4,(a4)	; write 8-pixel row
00001504 534D                       		subq.w	#1,a5
00001506 380D                       		move.w	a5,d4	; have all the 8-pixel rows been written?
00001508 66C2                       		bne.s	NemPCD_NewRow	; if not, branch
0000150A 4E75                       		rts		; otherwise the decompression is finished
0000150C                            ; ===========================================================================
0000150C                            NemPCD_WriteRowToVDP_XOR:
0000150C B982                       		eor.l	d4,d2	; XOR the previous row by the current row
0000150E 2882                       		move.l	d2,(a4)	; and write the result
00001510 534D                       		subq.w	#1,a5
00001512 380D                       		move.w	a5,d4
00001514 66B6                       		bne.s	NemPCD_NewRow
00001516 4E75                       		rts	
00001518                            ; ===========================================================================
00001518                            
00001518                            NemPCD_WriteRowToRAM:
00001518 28C4                       		move.l	d4,(a4)+
0000151A 534D                       		subq.w	#1,a5
0000151C 380D                       		move.w	a5,d4
0000151E 66AC                       		bne.s	NemPCD_NewRow
00001520 4E75                       		rts	
00001522                            ; ===========================================================================
00001522                            NemPCD_WriteRowToRAM_XOR:
00001522 B982                       		eor.l	d4,d2
00001524 28C2                       		move.l	d2,(a4)+
00001526 534D                       		subq.w	#1,a5
00001528 380D                       		move.w	a5,d4
0000152A 66A0                       		bne.s	NemPCD_NewRow
0000152C 4E75                       		rts	
0000152E                            
0000152E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000152E                            ; ---------------------------------------------------------------------------
0000152E                            ; Part of the Nemesis decompressor, builds the code table (in RAM)
0000152E                            ; ---------------------------------------------------------------------------
0000152E                            
0000152E                            
0000152E                            NemDec_BuildCodeTable:
0000152E 1018                       		move.b	(a0)+,d0	; read first byte
00001530                            
00001530                            NemBCT_ChkEnd:
00001530 0C00 00FF                  		cmpi.b	#$FF,d0	; has the end of the code table description been reached?
00001534 6600                       		bne.s	NemBCT_NewPALIndex	; if not, branch
00001536 4E75                       		rts	; otherwise, this subroutine's work is done
00001538                            ; ===========================================================================
00001538                            
00001538                            NemBCT_NewPALIndex:
00001538 3E00                       		move.w	d0,d7
0000153A                            
0000153A                            NemBCT_Loop:
0000153A 1018                       		move.b	(a0)+,d0	; read next byte
0000153C 0C00 0080                  		cmpi.b	#$80,d0	; sign bit being set signifies a new palette index
00001540 64EE                       		bcc.s	NemBCT_ChkEnd	; a bmi could have been used instead of a compare and bcc
00001542                            		
00001542 1200                       		move.b	d0,d1
00001544 0247 000F                  		andi.w	#$F,d7	; get palette index
00001548 0241 0070                  		andi.w	#$70,d1	; get repeat count for palette index
0000154C 8E41                       		or.w	d1,d7	; combine the two
0000154E 0240 000F                  		andi.w	#$F,d0	; get the length of the code in bits
00001552 1200                       		move.b	d0,d1
00001554 E149                       		lsl.w	#8,d1
00001556 8E41                       		or.w	d1,d7	; combine with palette index and repeat count to form code table entry
00001558 7208                       		moveq	#8,d1
0000155A 9240                       		sub.w	d0,d1	; is the code 8 bits long?
0000155C 6600                       		bne.s	NemBCT_ShortCode	; if not, a bit of extra processing is needed
0000155E 1018                       		move.b	(a0)+,d0	; get code
00001560 D040                       		add.w	d0,d0	; each code gets a word-sized entry in the table
00001562 3387 0000                  		move.w	d7,(a1,d0.w)	; store the entry for the code
00001566 60D2                       		bra.s	NemBCT_Loop	; repeat
00001568                            ; ===========================================================================
00001568                            
00001568                            ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
00001568                            ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
00001568                            ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
00001568                            ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
00001568                            ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
00001568                            ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
00001568                            NemBCT_ShortCode:
00001568 1018                       		move.b	(a0)+,d0	; get code
0000156A D040                       		add.w	d0,d0	; shift so that high bit is in bit position 7
0000156C E368                       		lsl.w	d1,d0	; get index into code table
0000156E 7A01                       		moveq	#1,d5
00001570 E36D                       		lsl.w	d1,d5
00001572 5345                       		subq.w	#1,d5	; d5 = 2^d1 - 1
00001574                            
00001574                            NemBCT_ShortCode_Loop:
00001574 3387 0000                  		move.w	d7,(a1,d0.w)	; store entry
00001578 5440                       		addq.w	#2,d0	; increment index
0000157A 51CD FFF8                  		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
0000157E 60BA                       		bra.s	NemBCT_Loop
00001580                            ; End of function NemDec_BuildCodeTable
00001580                            ; End of function NemDec_BuildCodeTable
00001580                            
