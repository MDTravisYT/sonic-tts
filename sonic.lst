00053C7C                            ; sub_725CA:
00053C7C                            InitMusicPlayback:
00053C7C 204E                       		movea.l	a6,a0
00053C7E                            		; Save several values
00053C7E 122E 0000                  		move.b	v_sndprio(a6),d1
00053C82 142E 0027                  		move.b	f_1up_playing(a6),d2
00053C86 162E 002A                  		move.b	f_speedup(a6),d3
00053C8A 182E 0026                  		move.b	v_fadein_counter(a6),d4
00053C8E                            		; DANGER! Only v_soundqueue0 and v_soundqueue1 are backed up, once again breaking v_soundqueue2
00053C8E 3A2E 000A                  		move.w	v_soundqueue0(a6),d5
00053C92 303C 0087                  		move.w	#((v_music_track_ram_end-v_startofvariables)/4)-1,d0	; Clear $220 bytes: all variables and music track data
00053C96                            ; loc_725E4:
00053C96                            @clearramloop:
00053C96 4298                       		clr.l	(a0)+
00053C98 51C8 FFFC                  		dbf	d0,@clearramloop
00053C9C                            
00053C9C                            		; Restore the values saved above
00053C9C 1D41 0000                  		move.b	d1,v_sndprio(a6)
00053CA0 1D42 0027                  		move.b	d2,f_1up_playing(a6)
00053CA4 1D43 002A                  		move.b	d3,f_speedup(a6)
00053CA8 1D44 0026                  		move.b	d4,v_fadein_counter(a6)
00053CAC 3D45 000A                  		move.w	d5,v_soundqueue0(a6)
00053CB0 1D7C 0080 0009             		move.b	#$80,v_sound_id(a6)	; set music to $80 (silence)
00053CB6                            		; DANGER! This silences ALL channels, even the ones being used
00053CB6                            		; by SFX, and not music! @sendfmnoteoff does this already, and
00053CB6                            		; doesn't affect SFX channels, either.
00053CB6                            		; This should be replaced with an 'rts'.
00053CB6 4EBA FF64                  		jsr	FMSilenceAll(pc)
00053CBA 6000 0000                  		bra.w	PSGSilenceAll
00053CBE                            		; DANGER! InitMusicPlayback, and Sound_PlayBGM for that matter,
00053CBE                            		; don't do a very good job of setting up the music tracks.
00053CBE                            		; Tracks that aren't defined in a music file's header don't have
00053CBE                            		; their channels defined, meaning @sendfmnoteoff won't silence
00053CBE                            		; hardware properly. In combination with removing the above
00053CBE                            		; calls to FMSilenceAll/PSGSilenceAll, this will cause hanging
00053CBE                            		; notes.
00053CBE                            		; To fix this, I suggest using this code, instead of an 'rts':
00053CBE                            		;lea	v_music_track_ram+TrackVoiceControl(a6),a1
00053CBE                            		;lea	FMDACInitBytes(pc),a2
00053CBE                            		;moveq	#((v_music_fmdac_tracks_end-v_music_fmdac_tracks)/TrackSz)-1,d1		; 7 DAC/FM tracks
00053CBE                            		;bsr.s	@writeloop
00053CBE                            		;lea	PSGInitBytes(pc),a2
00053CBE                            		;moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d1	; 3 PSG tracks
00053CBE                            
00053CBE                            ;@writeloop:
00053CBE                            		;move.b	(a2)+,(a1)		; Write track's channel byte
00053CBE                            		;lea	TrackSz(a1),a1		; Next track
00053CBE                            		;dbf	d1,@writeloop		; Loop for all DAC/FM/PSG tracks
00053CBE                            
00053CBE                            		;rts
00053CBE                            	
00053CBE                            ; End of function InitMusicPlayback
