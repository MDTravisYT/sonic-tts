000031A4                            LevSelControls:
000031A4 1238 F605                  		move.b	(v_jpadpress1).w,d1
000031A8 0201 0003                  		andi.b	#btnUp+btnDn,d1	; is up/down pressed and held?
000031AC 6600                       		bne.s	LevSel_UpDown	; if yes, branch
000031AE 5378 FF80                  		subq.w	#1,(v_levseldelay).w ; subtract 1 from time to next move
000031B2 6A00                       		bpl.s	LevSel_SndTest	; if time remains, branch
000031B4                            
000031B4                            LevSel_UpDown:
000031B4 31FC 000B FF80             		move.w	#$B,(v_levseldelay).w ; reset time delay
000031BA 1238 F604                  		move.b	(v_jpadhold1).w,d1
000031BE 0201 0003                  		andi.b	#btnUp+btnDn,d1	; is up/down pressed?
000031C2 6700                       		beq.s	LevSel_SndTest	; if not, branch
000031C4 3038 FF82                  		move.w	(v_levselitem).w,d0
000031C8 0801 0000                  		btst	#bitUp,d1	; is up	pressed?
000031CC 6700                       		beq.s	LevSel_Down	; if not, branch
000031CE 5340                       		subq.w	#1,d0		; move up 1 selection
000031D0 6400                       		bhs.s	LevSel_Down
000031D2 7014                       		moveq	#$14,d0		; if selection moves below 0, jump to selection	$14
000031D4                            
000031D4                            LevSel_Down:
