0001C4CA                            ; loc_1C518:
0001C4CA                            @loadTiles:
0001C4CA 0478 01C0 F7BE             		subi.w	#@size*$20,(v_gfxbigring).w	; Count-down the 14 tiles we're going to load now
0001C4D0 43F9 0000 0000             		lea	(Art_BigRing).l,a1 ; load giant	ring patterns
0001C4D6 7000                       		moveq	#0,d0
0001C4D8 3038 F7BE                  		move.w	(v_gfxbigring).w,d0
0001C4DC 43F1 0000                  		lea	(a1,d0.w),a1
0001C4E0                            		; Turn VRAM address into VDP command
0001C4E0 0640 8000                  		addi.w	#$8000,d0
0001C4E4 E588                       		lsl.l	#2,d0
0001C4E6 E448                       		lsr.w	#2,d0
0001C4E8 0040 4000                  		ori.w	#$4000,d0
