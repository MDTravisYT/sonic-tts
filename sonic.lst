0000D4E0                            ; Subroutine to	make an	object fall downwards, increasingly fast
0000D4E0                            ; ---------------------------------------------------------------------------
0000D4E0                            
0000D4E0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D4E0                            
0000D4E0                            
0000D4E0                            ObjectFall:
0000D4E0 2428 0008                  		move.l	obX(a0),d2
0000D4E4 2628 000C                  		move.l	obY(a0),d3
0000D4E8 3028 0010                  		move.w	obVelX(a0),d0
0000D4EC 48C0                       		ext.l	d0
0000D4EE E180                       		asl.l	#8,d0
0000D4F0 D480                       		add.l	d0,d2
0000D4F2 3028 0012                  		move.w	obVelY(a0),d0
0000D4F6 0668 0038 0012             		addi.w	#$38,obVelY(a0)	; increase vertical speed
0000D4FC 48C0                       		ext.l	d0
0000D4FE E180                       		asl.l	#8,d0
0000D500 D680                       		add.l	d0,d3
0000D502 2142 0008                  		move.l	d2,obX(a0)
0000D506 2143 000C                  		move.l	d3,obY(a0)
0000D50A 4E75                       		rts	
0000D50C                            
0000D50C                            ; End of function ObjectFall
0000D50C                            ; End of function ObjectFall
