0000C7A8                            ; ---------------------------------------------------------------------------
0000C7A8                            ; Subroutine to	make an	object fall downwards, increasingly fast
0000C7A8                            ; ---------------------------------------------------------------------------
0000C7A8                            
0000C7A8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000C7A8                            
0000C7A8                            
0000C7A8                            ObjectFall:
0000C7A8 2428 0008                  		move.l	obX(a0),d2
0000C7AC 2628 000C                  		move.l	obY(a0),d3
0000C7B0 3028 0010                  		move.w	obVelX(a0),d0
0000C7B4 48C0                       		ext.l	d0
0000C7B6 E180                       		asl.l	#8,d0
0000C7B8 D480                       		add.l	d0,d2
0000C7BA 3028 0012                  		move.w	obVelY(a0),d0
0000C7BE 0668 0038 0012             		addi.w	#$38,obVelY(a0)	; increase vertical speed
0000C7C4 48C0                       		ext.l	d0
0000C7C6 E180                       		asl.l	#8,d0
0000C7C8 D680                       		add.l	d0,d3
0000C7CA 2142 0008                  		move.l	d2,obX(a0)
0000C7CE 2143 000C                  		move.l	d3,obY(a0)
0000C7D2 4E75                       		rts	
0000C7D4                            
0000C7D4                            ; End of function ObjectFall
0000C7D4                            ; End of function ObjectFall
