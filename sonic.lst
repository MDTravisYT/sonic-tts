0000157A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000157A                            ; Queue pattern load requests, but clear the PLQ first
0000157A                            
0000157A                            ; ARGUMENTS
0000157A                            ; d0 = index of PLC list (see ArtLoadCues)
0000157A                            
0000157A                            ; NOTICE: This subroutine does not check for buffer overruns. The programmer
0000157A                            ;	  (or hacker) is responsible for making sure that no more than
0000157A                            ;	  16 load requests are copied into the buffer.
0000157A                            ;	  _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
0000157A                            ;         (or if you change the size of Plc_Buffer, the limit becomes (Plc_Buffer_Only_End-Plc_Buffer)/6)
0000157A                            
0000157A                            ; LoadPLC2:
0000157A                            NewPLC:
0000157A 48E7 0060                  		movem.l	a1-a2,-(sp)
0000157E 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
00001584 D040                       		add.w	d0,d0
00001586 3031 0000                  		move.w	(a1,d0.w),d0
0000158A 43F1 0000                  		lea	(a1,d0.w),a1	; jump to relevant PLC
0000158E 6100                       		bsr.s	ClearPLC	; erase any data in PLC buffer space
00001590 45F8 F680                  		lea	(v_plc_buffer).w,a2
00001594 3019                       		move.w	(a1)+,d0	; get length of PLC
00001596 6B00                       		bmi.s	@skip		; if it's negative, skip the next loop
00001598                            
00001598                            	@loop:
00001598 24D9                       		move.l	(a1)+,(a2)+
0000159A 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
0000159C 51C8 FFFA                  		dbf	d0,@loop		; repeat for length of PLC
000015A0                            
000015A0                            	@skip:
000015A0 4CDF 0600                  		movem.l	(sp)+,a1-a2
000015A4 4E75                       		rts	
000015A6                            ; End of function NewPLC
000015A6                            
000015A6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
