0000D5B2                            		include	"_incObj\sub ObjectFall.asm"
0000D5B2                            ; ---------------------------------------------------------------------------
0000D5B2                            ; Subroutine to	make an	object fall downwards, increasingly fast
0000D5B2                            ; ---------------------------------------------------------------------------
0000D5B2                            
0000D5B2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D5B2                            
0000D5B2                            
0000D5B2                            ObjectFall:
0000D5B2 2428 0008                  		move.l	obX(a0),d2
0000D5B6 2628 000C                  		move.l	obY(a0),d3
0000D5BA 3028 0010                  		move.w	obVelX(a0),d0
0000D5BE 48C0                       		ext.l	d0
0000D5C0 E180                       		asl.l	#8,d0
0000D5C2 D480                       		add.l	d0,d2
0000D5C4 3028 0012                  		move.w	obVelY(a0),d0
0000D5C8 0668 0038 0012             		addi.w	#$38,obVelY(a0)	; increase vertical speed
0000D5CE 48C0                       		ext.l	d0
0000D5D0 E180                       		asl.l	#8,d0
0000D5D2 D680                       		add.l	d0,d3
0000D5D4 2142 0008                  		move.l	d2,obX(a0)
0000D5D8 2143 000C                  		move.l	d3,obY(a0)
0000D5DC 4E75                       		rts	
0000D5DE                            
0000D5DE                            ; End of function ObjectFall
0000D5DE                            ; End of function ObjectFall
0000D5DE                            		include	"_incObj\sub SpeedToPos.asm"
0000D5DE                            ; ---------------------------------------------------------------------------
0000D5DE                            ; Subroutine translating object	speed to update	object position
0000D5DE                            ; ---------------------------------------------------------------------------
0000D5DE                            
0000D5DE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D5DE                            
0000D5DE                            
0000D5DE                            SpeedToPos:
0000D5DE 2428 0008                  		move.l	obX(a0),d2
0000D5E2 2628 000C                  		move.l	obY(a0),d3
0000D5E6 3028 0010                  		move.w	obVelX(a0),d0	; load horizontal speed
0000D5EA 48C0                       		ext.l	d0
0000D5EC E180                       		asl.l	#8,d0		; multiply speed by $100
0000D5EE D480                       		add.l	d0,d2		; add to x-axis	position
0000D5F0 3028 0012                  		move.w	obVelY(a0),d0	; load vertical	speed
0000D5F4 48C0                       		ext.l	d0
0000D5F6 E180                       		asl.l	#8,d0		; multiply by $100
0000D5F8 D680                       		add.l	d0,d3		; add to y-axis	position
0000D5FA 2142 0008                  		move.l	d2,obX(a0)	; update x-axis	position
0000D5FE 2143 000C                  		move.l	d3,obY(a0)	; update y-axis	position
0000D602 4E75                       		rts	
0000D604                            
0000D604                            ; End of function SpeedToPos
0000D604                            ; End of function SpeedToPos
0000D604                            		include	"_incObj\sub DisplaySprite.asm"
0000D604                            ; ---------------------------------------------------------------------------
0000D604                            ; Subroutine to	display	a sprite/object, when a0 is the	object RAM
0000D604                            ; ---------------------------------------------------------------------------
0000D604                            
0000D604                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D604                            
0000D604                            
0000D604                            DisplaySprite:
0000D604 43F8 AC00                  		lea	(v_spritequeue).w,a1
0000D608 3028 0018                  		move.w	obPriority(a0),d0 ; get sprite priority
0000D60C E248                       		lsr.w	#1,d0
0000D60E 0240 0380                  		andi.w	#$380,d0
0000D612 D2C0                       		adda.w	d0,a1		; jump to position in queue
0000D614 0C51 007E                  		cmpi.w	#$7E,(a1)	; is this part of the queue full?
0000D618 6400                       		bcc.s	DSpr_Full	; if yes, branch
0000D61A 5451                       		addq.w	#2,(a1)		; increment sprite count
0000D61C D2D1                       		adda.w	(a1),a1		; jump to empty position
0000D61E 3288                       		move.w	a0,(a1)		; insert RAM address for object
0000D620                            
0000D620                            	DSpr_Full:
0000D620 4E75                       		rts	
0000D622                            
0000D622                            ; End of function DisplaySprite
0000D622                            
0000D622                            
0000D622                            ; ---------------------------------------------------------------------------
0000D622                            ; Subroutine to	display	a 2nd sprite/object, when a1 is	the object RAM
0000D622                            ; ---------------------------------------------------------------------------
0000D622                            
0000D622                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D622                            
0000D622                            
0000D622                            DisplaySprite1:
0000D622 45F8 AC00                  		lea	(v_spritequeue).w,a2
0000D626 3029 0018                  		move.w	obPriority(a1),d0
0000D62A E248                       		lsr.w	#1,d0
0000D62C 0240 0380                  		andi.w	#$380,d0
0000D630 D4C0                       		adda.w	d0,a2
0000D632 0C52 007E                  		cmpi.w	#$7E,(a2)
0000D636 6400                       		bcc.s	DSpr1_Full
0000D638 5452                       		addq.w	#2,(a2)
0000D63A D4D2                       		adda.w	(a2),a2
0000D63C 3489                       		move.w	a1,(a2)
0000D63E                            
0000D63E                            	DSpr1_Full:
0000D63E 4E75                       		rts	
0000D640                            
0000D640                            ; End of function DisplaySprite1
0000D640                            ; End of function DisplaySprite1
0000D640                            		include	"_incObj\sub DeleteObject.asm"
0000D640                            ; ---------------------------------------------------------------------------
0000D640                            ; Subroutine to	delete an object
0000D640                            ; ---------------------------------------------------------------------------
0000D640                            
0000D640                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000D640                            
0000D640                            
0000D640                            DeleteObject:
0000D640 2248                       		movea.l	a0,a1		; move object RAM address to (a1)
0000D642                            
0000D642                            DeleteChild:				; child objects are already in (a1)
0000D642 7200                       		moveq	#0,d1
0000D644 700F                       		moveq	#$F,d0
