00003CBE                            ; ---------------------------------------------------------------------------
00003CBE                            ; Labyrinth Zone "wind tunnels"	subroutine
00003CBE                            ; ---------------------------------------------------------------------------
00003CBE                            
00003CBE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00003CBE                            
00003CBE                            
00003CBE                            LZWindTunnels:
00003CBE 4A78 FE08                  		tst.w	(v_debuguse).w	; is debug mode	being used?
00003CC2 6600 0000                  		bne.w	@quit	; if yes, branch
00003CC6 45F9 0000 0000             		lea	(LZWind_Data+8).l,a2
00003CCC 7000                       		moveq	#0,d0
00003CCE 1038 FE11                  		move.b	(v_act).w,d0	; get act number
00003CD2 E748                       		lsl.w	#3,d0		; multiply by 8
00003CD4 D4C0                       		adda.w	d0,a2		; add to address for data
00003CD6 7200                       		moveq	#0,d1
00003CD8 4A38 FE11                  		tst.b	(v_act).w	; is act number 1?
00003CDC 6600                       		bne.s	@notact1	; if not, branch
00003CDE 7201                       		moveq	#1,d1
00003CE0 514A                       		subq.w	#8,a2		; use different data for act 1
00003CE2                            
00003CE2                            	@notact1:
00003CE2 43F8 D000                  		lea	(v_player).w,a1
00003CE6                            
00003CE6                            @chksonic:
00003CE6 3029 0008                  		move.w	obX(a1),d0
00003CEA B052                       		cmp.w	(a2),d0
00003CEC 6500 0000                  		bcs.w	@chknext
00003CF0 B06A 0004                  		cmp.w	4(a2),d0
00003CF4 6400 0000                  		bcc.w	@chknext
00003CF8 3429 000C                  		move.w	obY(a1),d2
00003CFC B46A 0002                  		cmp.w	2(a2),d2
00003D00 6500                       		bcs.s	@chknext
00003D02 B46A 0006                  		cmp.w	6(a2),d2
00003D06 6400                       		bcc.s	@chknext	; branch if Sonic is outside a range
00003D08 1038 FE0F                  		move.b	(v_vbla_byte).w,d0
00003D0C 0200 003F                  		andi.b	#$3F,d0		; does VInt counter fall on 0, $40, $80 or $C0?
00003D10 6600                       		bne.s	@skipsound	; if not, branch
00003D1C                            
00003D1C                            	@skipsound:
00003D1C 4A38 F7C9                  		tst.b	(f_wtunnelallow).w ; are wind tunnels disabled?
00003D20 6600 0000                  		bne.w	@quit	; if yes, branch
00003D24 0C29 0004 0024             		cmpi.b	#4,obRoutine(a1) ; is Sonic hurt/dying?
00003D2A 6400                       		bcc.s	@clrquit	; if yes, branch
00003D2C 11FC 0001 F7C7             		move.b	#1,(f_wtunnelmode).w
00003D32 0440 0080                  		subi.w	#$80,d0
00003D36 B052                       		cmp.w	(a2),d0
00003D38 6400                       		bcc.s	@movesonic
00003D3A 7002                       		moveq	#2,d0
00003D3C 0C38 0001 FE11             		cmpi.b	#1,(v_act).w	; is act number 2?
00003D42 6600                       		bne.s	@notact2	; if not, branch
00003D44 4440                       		neg.w	d0
00003D46                            
00003D46                            	@notact2:
00003D46 D169 000C                  		add.w	d0,obY(a1)	; adjust Sonic's y-axis for curve of tunnel
00003D4A                            
00003D4A                            @movesonic:
00003D4A 5869 0008                  		addq.w	#4,obX(a1)
00003D4E 337C 0400 0010             		move.w	#$400,obVelX(a1) ; move Sonic horizontally
00003D54 337C 0000 0012             		move.w	#0,obVelY(a1)
00003D5A 137C 0000 001C             		move.b	#id_Float2,obAnim(a1)	; use floating animation
00003D60 08E9 0001 0022             		bset	#1,obStatus(a1)
00003D66 0838 0000 F602             		btst	#0,(v_jpadhold2).w ; is up pressed?
00003D6C 6700                       		beq.s	@down		; if not, branch
00003D6E 5369 000C                  		subq.w	#1,obY(a1)	; move Sonic up on pole
00003D72                            
00003D72                            	@down:
00003D72 0838 0001 F602             		btst	#1,(v_jpadhold2).w ; is down being pressed?
00003D78 6700                       		beq.s	@end		; if not, branch
00003D7A 5269 000C                  		addq.w	#1,obY(a1)	; move Sonic down on pole
00003D7E                            
00003D7E                            	@end:
00003D7E 4E75                       		rts	
00003D80                            ; ===========================================================================
00003D80                            
00003D80                            @chknext:
00003D80 504A                       		addq.w	#8,a2		; use second set of values (act 1 only)
00003D82 51C9 FF62                  		dbf	d1,@chksonic	; on act 1, repeat for a second tunnel
00003D86 4A38 F7C7                  		tst.b	(f_wtunnelmode).w ; is Sonic still in a tunnel?
00003D8A 6700                       		beq.s	@quit		; if yes, branch
00003D8C 137C 0000 001C             		move.b	#id_Walk,obAnim(a1)	; use walking animation
00003D92                            
00003D92                            @clrquit:
00003D92 4238 F7C7                  		clr.b	(f_wtunnelmode).w ; finish tunnel
00003D96                            
00003D96                            @quit:
00003D96 4E75                       		rts	
00003D98                            ; End of function LZWindTunnels
00003D98                            
