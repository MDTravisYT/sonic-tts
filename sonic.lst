00053C5E 4EBA 0000                  		jsr	WriteFMI(pc)
00053C62 204E                       		movea.l	a6,a0
00053C64                            		; DANGER! This should be clearing all variables and track data, but misses the last $10 bytes of v_spcsfx_psg3_track.
