0000EBE2 08A8 0003 0022             		bclr	#3,obStatus(a0)	; clear object's standing flag
0000EBE8 4228 0025                  		clr.b	obSolid(a0)
0000EBEC 7800                       		moveq	#0,d4
0000EBEE 4E75                       		rts	
0000EBF0                            
0000EBF0                            	@stand:
0000EBF0 3404                       		move.w	d4,d2
0000EBF2 6100 84BE                  		bsr.w	MvSonicOnPtfm
0000EBF6 7800                       		moveq	#0,d4
0000EBF8 4E75                       		rts	
