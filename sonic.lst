00001488                            ProcessDPLC2:
00001488 4A78 F6F8                  		tst.w	(f_plc_execute).w
0000148C 6700                       		beq.s	locret_16DA
0000148E 31FC 0003 F6FA             		move.w	#3,($FFFFF6FA).w
00001494 7000                       		moveq	#0,d0
00001496 3038 F684                  		move.w	($FFFFF684).w,d0
0000149A 0678 0060 F684             		addi.w	#$60,($FFFFF684).w
000014A0                            
000014A0                            loc_1676:
000014A0 49F9 00C0 0004             		lea	(vdp_control_port).l,a4
