0001ADE4 6A00                       		bpl.s	@end
0001ADE6                            
0001ADE6 11FC 0007 F7B5             		move.b	#7,(v_lani2_time).w
0001ADEC 1038 F7B4                  		move.b	(v_lani2_frame).w,d0
0001ADF0 5238 F7B4                  		addq.b	#1,(v_lani2_frame).w ; increment frame counter
0001ADF4 0240 0003                  		andi.w	#3,d0		; there are 4 frames
0001ADF8 103B 0000                  		move.b	@sequence(pc,d0.w),d0
0001ADFC 0800 0000                  		btst	#0,d0		; is frame 0 or 2? (actual frame, not frame counter)
0001AE00 6600                       		bne.s	@isframe1	; if not, branch
0001AE02 11FC 007F F7B5             		move.b	#$7F,(v_lani2_time).w ; set longer duration for frames 0 and 2
0001AE08                            
0001AE08                            	@isframe1:
0001AE08 EF48                       		lsl.w	#7,d0		; multiply frame num by $80
0001AE0A 3200                       		move.w	d0,d1
0001AE0C D040                       		add.w	d0,d0
0001AE0E D041                       		add.w	d1,d0		; multiply that by 3 (i.e. frame num times 12 * $20)
0001AE1A 43F9 0000 0000             		lea	(Art_GhzFlower2).l,a1 ;	load small flower patterns
0001AE20 43F1 0000                  		lea	(a1,d0.w),a1	; jump to appropriate tile
0001AE24 323C 000B                  		move.w	#@size-1,d1
0001AE28 6100 0000                  		bsr.w	LoadTiles
0001AE2C                            
0001AE2C                            @end:
0001AE2C 4E75                       		rts	
