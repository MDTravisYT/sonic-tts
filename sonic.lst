00071A88                            ; ---------------------------------------------------------------------------
00071A88                            ; Priority of sound. New music or SFX must have a priority higher than or equal
00071A88                            ; to what is stored in v_sndprio or it won't play. If bit 7 of new priority is
00071A88                            ; set ($80 and up), the new music or SFX will not set its priority -- meaning
00071A88                            ; any music or SFX can override it (as long as it can override whatever was
00071A88                            ; playing before). Usually, SFX will only override SFX, special SFX ($D0-$DF)
00071A88                            ; will only override special SFX and music will only override music.
00071A88                            ; ---------------------------------------------------------------------------
00071A88                            ; SoundTypes:
00071A88                            SoundPriorities:
00071A88 9090 9090 9090 9090 9090+  		dc.b     $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $81
00071A97 9090 9090 9090 9090 9090+  		dc.b $90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90,$90	; $90
00071AA7 8070 7070 7070 7070 7070+  		dc.b $80,$70,$70,$70,$70,$70,$70,$70,$70,$70,$68,$70,$70,$70,$60,$70	; $A0
00071AB7 7060 7060 7070 7070 7070+  		dc.b $70,$60,$70,$60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$7F	; $B0
00071AC7 6070 7070 7070 7070 7070+  		dc.b $60,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70,$70	; $C0
00071AD7 8080 8080 8080 8080 8080+  		dc.b $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80	; $D0
00071AE7 9090 9090 90               		dc.b $90,$90,$90,$90,$90                                            	; $E0
