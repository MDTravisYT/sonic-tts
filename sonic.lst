00013B88                            		include	"_incObj\sub FindNearestTile.asm"
00013B88                            ; ---------------------------------------------------------------------------
00013B88                            ; Subroutine to	find which tile	the object is standing on
00013B88                            
00013B88                            ; input:
00013B88                            ;	d2 = y-position of object's bottom edge
00013B88                            ;	d3 = x-position of object
00013B88                            
00013B88                            ; output:
00013B88                            ;	a1 = address within 256x256 mappings where object is standing
00013B88                            ;	     (refers to a 16x16 tile number)
00013B88                            ; ---------------------------------------------------------------------------
00013B88                            
00013B88                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013B88                            
00013B88                            
00013B88                            FindNearestTile:
00013B88 3002                       		move.w	d2,d0		; get y-pos. of bottom edge of object
00013B8A E248                       		lsr.w	#1,d0
00013B8C 0240 0380                  		andi.w	#$380,d0
00013B90 3203                       		move.w	d3,d1		; get x-pos. of object
00013B92 E049                       		lsr.w	#8,d1
00013B94 0241 007F                  		andi.w	#$7F,d1
00013B98 D041                       		add.w	d1,d0		; combine
00013B9A 72FF                       		moveq	#-1,d1
00013B9C 43F8 A400                  		lea	(v_lvllayout).w,a1
00013BA0 1231 0000                  		move.b	(a1,d0.w),d1	; get 256x256 tile number
00013BA4 6700                       		beq.s	@blanktile	; branch if 0
00013BA6 6B00                       		bmi.s	@specialtile	; branch if >$7F
00013BA8 5301                       		subq.b	#1,d1
00013BAA 4881                       		ext.w	d1
00013BAC EE59                       		ror.w	#7,d1
00013BAE 3002                       		move.w	d2,d0
00013BB0 D040                       		add.w	d0,d0
00013BB2 0240 01E0                  		andi.w	#$1E0,d0
00013BB6 D240                       		add.w	d0,d1
00013BB8 3003                       		move.w	d3,d0
00013BBA E648                       		lsr.w	#3,d0
00013BBC 0240 001E                  		andi.w	#$1E,d0
00013BC0 D240                       		add.w	d0,d1
00013BC2                            
00013BC2                            @blanktile:
00013BC2 2241                       		movea.l	d1,a1
00013BC4 4E75                       		rts	
00013BC6                            ; ===========================================================================
00013BC6                            
00013BC6                            @specialtile:
00013BC6 0241 007F                  		andi.w	#$7F,d1
00013BCA 0828 0006 0001             		btst	#6,obRender(a0) ; is object "behind a loop"?
00013BD0 6700                       		beq.s	@treatasnormal	; if not, branch
00013BD2 5241                       		addq.w	#1,d1
00013BD4 0C41 0029                  		cmpi.w	#$29,d1
00013BD8 6600                       		bne.s	@treatasnormal
00013BDA 323C 0051                  		move.w	#$51,d1
00013BDE                            
00013BDE                            	@treatasnormal:
00013BDE 5301                       		subq.b	#1,d1
00013BE0 EE59                       		ror.w	#7,d1
00013BE2 3002                       		move.w	d2,d0
00013BE4 D040                       		add.w	d0,d0
00013BE6 0240 01E0                  		andi.w	#$1E0,d0
00013BEA D240                       		add.w	d0,d1
00013BEC 3003                       		move.w	d3,d0
00013BEE E648                       		lsr.w	#3,d0
00013BF0 0240 001E                  		andi.w	#$1E,d0
00013BF4 D240                       		add.w	d0,d1
00013BF6 2241                       		movea.l	d1,a1
00013BF8 4E75                       		rts	
00013BFA                            ; End of function FindNearestTile
00013BFA                            ; End of function FindNearestTile
00013BFA                            		include	"_incObj\sub FindFloor.asm"
00013BFA                            ; ---------------------------------------------------------------------------
00013BFA                            ; Subroutine to	find the floor
00013BFA                            
00013BFA                            ; input:
00013BFA                            ;	d2 = y-position of object's bottom edge
00013BFA                            ;	d3 = x-position of object
00013BFA                            ;	d5 = bit to test for solidness
00013BFA                            
00013BFA                            ; output:
00013BFA                            ;	d1 = distance to the floor
00013BFA                            ;	a1 = address within 256x256 mappings where object is standing
00013BFA                            ;	     (refers to a 16x16 tile number)
00013BFA                            ;	(a4) = floor angle
00013BFA                            ; ---------------------------------------------------------------------------
00013BFA                            
00013BFA                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013BFA                            
00013BFA                            
00013BFA                            FindFloor:
00013BFA 618C                       		bsr.s	FindNearestTile
00013BFC 3011                       		move.w	(a1),d0		; get value for solidness, orientation and 16x16 tile number
00013BFE 3800                       		move.w	d0,d4
00013C00 0240 07FF                  		andi.w	#$7FF,d0
00013C04 6700                       		beq.s	@isblank	; branch if tile is blank
00013C06 0B04                       		btst	d5,d4		; is the tile solid?
00013C08 6600                       		bne.s	@issolid	; if yes, branch
00013C0A                            
00013C0A                            @isblank:
00013C0A D44B                       		add.w	a3,d2
00013C0C 6100 0000                  		bsr.w	FindFloor2	; try tile below the nearest
00013C10 944B                       		sub.w	a3,d2
00013C12 0641 0010                  		addi.w	#$10,d1		; return distance to floor
00013C16 4E75                       		rts	
00013C18                            ; ===========================================================================
00013C18                            
00013C18                            @issolid:
00013C18 2478 F796                  		movea.l	(v_collindex).w,a2
00013C1C 1032 0000                  		move.b	(a2,d0.w),d0	; get collision block number
00013C20 0240 00FF                  		andi.w	#$FF,d0
00013C24 67E4                       		beq.s	@isblank	; branch if 0
00013C26 45F9 0000 0000             		lea	(AngleMap).l,a2
00013C2C 18B2 0000                  		move.b	(a2,d0.w),(a4)	; get collision angle value
00013C30 E948                       		lsl.w	#4,d0
00013C32 3203                       		move.w	d3,d1		; get x-pos. of object
00013C34 0804 000B                  		btst	#$B,d4		; is block flipped horizontally?
00013C38 6700                       		beq.s	@noflip		; if not, branch
00013C3A 4641                       		not.w	d1
00013C3C 4414                       		neg.b	(a4)
00013C3E                            
00013C3E                            	@noflip:
00013C3E 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
00013C42 6700                       		beq.s	@noflip2	; if not, branch
00013C44 0614 0040                  		addi.b	#$40,(a4)
00013C48 4414                       		neg.b	(a4)
00013C4A 0414 0040                  		subi.b	#$40,(a4)
00013C4E                            
00013C4E                            	@noflip2:
00013C4E 0241 000F                  		andi.w	#$F,d1
00013C52 D240                       		add.w	d0,d1		; (block num. * $10) + x-pos. = place in array
00013C54 45F9 0000 0000             		lea	(CollArray1).l,a2
00013C5A 1032 1000                  		move.b	(a2,d1.w),d0	; get collision height
00013C5E 4880                       		ext.w	d0
00013C60 BD44                       		eor.w	d6,d4
00013C62 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
00013C66 6700                       		beq.s	@noflip3	; if not, branch
00013C68 4440                       		neg.w	d0
00013C6A                            
00013C6A                            	@noflip3:
00013C6A 4A40                       		tst.w	d0
00013C6C 679C                       		beq.s	@isblank	; branch if height is 0
00013C6E 6B00                       		bmi.s	@negfloor	; branch if height is negative
00013C70 0C00 0010                  		cmpi.b	#$10,d0
00013C74 6700                       		beq.s	@maxfloor	; branch if height is $10 (max)
00013C76 3202                       		move.w	d2,d1		; get y-pos. of object
00013C78 0241 000F                  		andi.w	#$F,d1
00013C7C D041                       		add.w	d1,d0
00013C7E 323C 000F                  		move.w	#$F,d1
00013C82 9240                       		sub.w	d0,d1		; return distance to floor
00013C84 4E75                       		rts	
00013C86                            ; ===========================================================================
00013C86                            
00013C86                            @negfloor:
00013C86 3202                       		move.w	d2,d1
00013C88 0241 000F                  		andi.w	#$F,d1
00013C8C D041                       		add.w	d1,d0
00013C8E 6A00 FF7A                  		bpl.w	@isblank
00013C92                            
00013C92                            @maxfloor:
00013C92 944B                       		sub.w	a3,d2
00013C94 6100 0000                  		bsr.w	FindFloor2	; try tile above the nearest
00013C98 D44B                       		add.w	a3,d2
00013C9A 0441 0010                  		subi.w	#$10,d1		; return distance to floor
00013C9E 4E75                       		rts	
00013CA0                            ; End of function FindFloor
00013CA0                            
00013CA0                            
00013CA0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013CA0                            
00013CA0                            
00013CA0                            FindFloor2:
00013CA0 6100 FEE6                  		bsr.w	FindNearestTile
00013CA4 3011                       		move.w	(a1),d0
00013CA6 3800                       		move.w	d0,d4
00013CA8 0240 07FF                  		andi.w	#$7FF,d0
00013CAC 6700                       		beq.s	@isblank2
00013CAE 0B04                       		btst	d5,d4
00013CB0 6600                       		bne.s	@issolid
00013CB2                            
00013CB2                            @isblank2:
00013CB2 323C 000F                  		move.w	#$F,d1
00013CB6 3002                       		move.w	d2,d0
00013CB8 0240 000F                  		andi.w	#$F,d0
00013CBC 9240                       		sub.w	d0,d1
00013CBE 4E75                       		rts	
00013CC0                            ; ===========================================================================
00013CC0                            
00013CC0                            @issolid:
00013CC0 2478 F796                  		movea.l	(v_collindex).w,a2
00013CC4 1032 0000                  		move.b	(a2,d0.w),d0
00013CC8 0240 00FF                  		andi.w	#$FF,d0
00013CCC 67E4                       		beq.s	@isblank2
00013CCE 45F9 0000 0000             		lea	(AngleMap).l,a2
00013CD4 18B2 0000                  		move.b	(a2,d0.w),(a4)
00013CD8 E948                       		lsl.w	#4,d0
00013CDA 3203                       		move.w	d3,d1
00013CDC 0804 000B                  		btst	#$B,d4
00013CE0 6700                       		beq.s	@noflip
00013CE2 4641                       		not.w	d1
00013CE4 4414                       		neg.b	(a4)
00013CE6                            
00013CE6                            	@noflip:
00013CE6 0804 000C                  		btst	#$C,d4
00013CEA 6700                       		beq.s	@noflip2
00013CEC 0614 0040                  		addi.b	#$40,(a4)
00013CF0 4414                       		neg.b	(a4)
00013CF2 0414 0040                  		subi.b	#$40,(a4)
