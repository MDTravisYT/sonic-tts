00001938                            
00001938 31FC 0005 F634             		move.w	#5,(v_pcyc_time).w ; reset timer to 5 frames
0000193E 3038 F632                  		move.w	(v_pcyc_num).w,d0 ; get cycle number
00001942 5278 F632                  		addq.w	#1,(v_pcyc_num).w ; increment cycle number
00001946 0240 0003                  		andi.w	#3,d0		; if cycle > 3, reset to 0
0000194A E748                       		lsl.w	#3,d0
0000194C 43F8 FB50                  		lea	(v_pal_dry+$50).w,a1
00001950 22F0 0000                  		move.l	(a0,d0.w),(a1)+
00001954 22B0 0004                  		move.l	4(a0,d0.w),(a1)	; copy palette data to RAM
00001958                            
