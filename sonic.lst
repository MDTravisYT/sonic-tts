00013B50                            		include	"_incObj\sub FindNearestTile.asm"
00013B50                            ; ---------------------------------------------------------------------------
00013B50                            ; Subroutine to	find which tile	the object is standing on
00013B50                            
00013B50                            ; input:
00013B50                            ;	d2 = y-position of object's bottom edge
00013B50                            ;	d3 = x-position of object
00013B50                            
00013B50                            ; output:
00013B50                            ;	a1 = address within 256x256 mappings where object is standing
00013B50                            ;	     (refers to a 16x16 tile number)
00013B50                            ; ---------------------------------------------------------------------------
00013B50                            
00013B50                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013B50                            
00013B50                            
00013B50                            FindNearestTile:
00013B50 3002                       		move.w	d2,d0		; get y-pos. of bottom edge of object
00013B52 E248                       		lsr.w	#1,d0
00013B54 0240 0380                  		andi.w	#$380,d0
00013B58 3203                       		move.w	d3,d1		; get x-pos. of object
00013B5A E049                       		lsr.w	#8,d1
00013B5C 0241 007F                  		andi.w	#$7F,d1
00013B60 D041                       		add.w	d1,d0		; combine
00013B62 72FF                       		moveq	#-1,d1
00013B64 43F8 A400                  		lea	(v_lvllayout).w,a1
00013B68 1231 0000                  		move.b	(a1,d0.w),d1	; get 256x256 tile number
00013B6C 6700                       		beq.s	@blanktile	; branch if 0
00013B6E 6B00                       		bmi.s	@specialtile	; branch if >$7F
00013B70 5301                       		subq.b	#1,d1
00013B72 4881                       		ext.w	d1
00013B74 EE59                       		ror.w	#7,d1
00013B76 3002                       		move.w	d2,d0
00013B78 D040                       		add.w	d0,d0
00013B7A 0240 01E0                  		andi.w	#$1E0,d0
00013B7E D240                       		add.w	d0,d1
00013B80 3003                       		move.w	d3,d0
00013B82 E648                       		lsr.w	#3,d0
00013B84 0240 001E                  		andi.w	#$1E,d0
00013B88 D240                       		add.w	d0,d1
00013B8A                            
00013B8A                            @blanktile:
00013B8A 2241                       		movea.l	d1,a1
00013B8C 4E75                       		rts	
00013B8E                            ; ===========================================================================
00013B8E                            
00013B8E                            @specialtile:
00013B8E 0241 007F                  		andi.w	#$7F,d1
00013B92 0828 0006 0001             		btst	#6,obRender(a0) ; is object "behind a loop"?
00013B98 6700                       		beq.s	@treatasnormal	; if not, branch
00013B9A 5241                       		addq.w	#1,d1
00013B9C 0C41 0029                  		cmpi.w	#$29,d1
00013BA0 6600                       		bne.s	@treatasnormal
00013BA2 323C 0051                  		move.w	#$51,d1
00013BA6                            
00013BA6                            	@treatasnormal:
00013BA6 5301                       		subq.b	#1,d1
00013BA8 EE59                       		ror.w	#7,d1
