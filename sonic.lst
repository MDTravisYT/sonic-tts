00006BB2 2A80                       		move.l	d0,(a5)
00006BB4 3A3C 2000                  		move.w	#$2000,d5
00006BB8 3819                       		move.w	(a1)+,d4
00006BBA D845                       		add.w	d5,d4
00006BBC 3C84                       		move.w	d4,(a6)
00006BBE 3819                       		move.w	(a1)+,d4
00006BC0 D845                       		add.w	d5,d4
00006BC2 3C84                       		move.w	d4,(a6)
00006BC4 D087                       		add.l	d7,d0
00006BC6 2A80                       		move.l	d0,(a5)
00006BC8 3819                       		move.w	(a1)+,d4
00006BCA D845                       		add.w	d5,d4
00006BCC 3C84                       		move.w	d4,(a6)
00006BCE 3819                       		move.w	(a1)+,d4
00006BD0 D845                       		add.w	d5,d4
00006BD2 3C84                       		move.w	d4,(a6)
00006BD4 4E75                       		rts
