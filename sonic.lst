000016C6                            ; ---------------------------------------------------------------------------
000016C6                            ; Kosinski decompression algorithm
000016C6                            
000016C6                            ; input:
000016C6                            ;	a0 = source address
000016C6                            ;	a1 = destination address
000016C6                            
000016C6                            ; usage:
000016C6                            ;	lea	(source).l,a0
000016C6                            ;	lea	(destination).l,a1
000016C6                            ;	bsr.w	KosDec
000016C6                            ; ---------------------------------------------------------------------------
000016C6                            
000016C6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000016C6                            
000016C6                            
000016C6                            KosDec:
000016C6                            
000016C6 558F                       		subq.l	#2,sp	; make space for 2 bytes on the stack
000016C8 1F58 0001                  		move.b	(a0)+,1(sp)
000016CC 1E98                       		move.b	(a0)+,(sp)
000016CE 3A17                       		move.w	(sp),d5	; get first description field
000016D0 780F                       		moveq	#$F,d4	; set to loop for 16 bits
000016D2                            
000016D2                            Kos_Loop:
000016D2 E24D                       		lsr.w	#1,d5	; shift bit into the c flag
000016D4 40C6                       		move	sr,d6
000016D6 51CC 0000                  		dbf	d4,@chkbit
000016DA 1F58 0001                  		move.b	(a0)+,1(sp)
000016DE 1E98                       		move.b	(a0)+,(sp)
000016E0 3A17                       		move.w	(sp),d5
000016E2 780F                       		moveq	#$F,d4
000016E4                            
000016E4                            	@chkbit:
000016E4 44C6                       		move	d6,ccr	; was the bit set?
000016E6 6400                       		bcc.s	Kos_RLE	; if not, branch
000016E8                            
000016E8 12D8                       		move.b	(a0)+,(a1)+ ; copy byte as-is
000016EA 60E6                       		bra.s	Kos_Loop
000016EC                            ; ===========================================================================
000016EC                            
000016EC                            Kos_RLE:
000016EC 7600                       		moveq	#0,d3
000016EE E24D                       		lsr.w	#1,d5	; get next bit
000016F0 40C6                       		move	sr,d6
000016F2 51CC 0000                  		dbf	d4,@chkbit
000016F6 1F58 0001                  		move.b	(a0)+,1(sp)
000016FA 1E98                       		move.b	(a0)+,(sp)
000016FC 3A17                       		move.w	(sp),d5
000016FE 780F                       		moveq	#$F,d4
00001700                            
00001700                            	@chkbit:
00001700 44C6                       		move	d6,ccr	; was the bit set?
00001702 6500                       		bcs.s	Kos_SeparateRLE ; if yes, branch
00001704                            
00001704 E24D                       		lsr.w	#1,d5	; shift bit into the x flag
00001706 51CC 0000                  		dbf	d4,@loop1
0000170A 1F58 0001                  		move.b	(a0)+,1(sp)
0000170E 1E98                       		move.b	(a0)+,(sp)
00001710 3A17                       		move.w	(sp),d5
00001712 780F                       		moveq	#$F,d4
00001714                            
00001714                            	@loop1:
00001714 E353                       		roxl.w	#1,d3	; get high repeat count bit
00001716 E24D                       		lsr.w	#1,d5
00001718 51CC 0000                  		dbf	d4,@loop2
0000171C 1F58 0001                  		move.b	(a0)+,1(sp)
00001720 1E98                       		move.b	(a0)+,(sp)
00001722 3A17                       		move.w	(sp),d5
00001724 780F                       		moveq	#$F,d4
00001726                            
00001726                            	@loop2:
00001726 E353                       		roxl.w	#1,d3	; get low repeat count bit
00001728 5243                       		addq.w	#1,d3	; increment repeat count
0000172A 74FF                       		moveq	#-1,d2
0000172C 1418                       		move.b	(a0)+,d2 ; calculate offset
0000172E 6000                       		bra.s	Kos_RLELoop
00001730                            ; ===========================================================================
00001730                            
00001730                            Kos_SeparateRLE:
00001730 1018                       		move.b	(a0)+,d0 ; get first byte
00001732 1218                       		move.b	(a0)+,d1 ; get second byte
00001734 74FF                       		moveq	#-1,d2
00001736 1401                       		move.b	d1,d2
00001738 EB4A                       		lsl.w	#5,d2
0000173A 1400                       		move.b	d0,d2	; calculate offset
0000173C 0241 0007                  		andi.w	#7,d1	; does a third byte need to be read?
00001740 6700                       		beq.s	Kos_SeparateRLE2 ; if yes, branch
00001742 1601                       		move.b	d1,d3	; copy repeat count
00001744 5243                       		addq.w	#1,d3	; increment
00001746                            
00001746                            Kos_RLELoop:
00001746 1031 2000                  		move.b	(a1,d2.w),d0 ; copy appropriate byte
0000174A 12C0                       		move.b	d0,(a1)+ ; repeat
0000174C 51CB FFF8                  		dbf	d3,Kos_RLELoop
00001750 6080                       		bra.s	Kos_Loop
00001752                            ; ===========================================================================
00001752                            
00001752                            Kos_SeparateRLE2:
00001752 1218                       		move.b	(a0)+,d1
00001754 6700                       		beq.s	Kos_Done ; 0 indicates end of compressed data
00001756 0C01 0001                  		cmpi.b	#1,d1
0000175A 6700 FF76                  		beq.w	Kos_Loop ; 1 indicates new description to be read
0000175E 1601                       		move.b	d1,d3	; otherwise, copy repeat count
00001760 60E4                       		bra.s	Kos_RLELoop
00001762                            ; ===========================================================================
00001762                            
00001762                            Kos_Done:
00001762 548F                       		addq.l	#2,sp	; restore stack pointer
00001764 4E75                       		rts	
00001766                            ; End of function KosDec
00001766                            ; End of function KosDec
