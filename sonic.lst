00001548                            		include	"_inc\Enigma Decompression.asm"
00001548                            ; ---------------------------------------------------------------------------
00001548                            ; Enigma decompression algorithm
00001548                            
00001548                            ; input:
00001548                            ;	d0 = starting art tile (added to each 8x8 before writing to destination)
00001548                            ;	a0 = source address
00001548                            ;	a1 = destination address
00001548                            
00001548                            ; usage:
00001548                            ;	lea	(source).l,a0
00001548                            ;	lea	(destination).l,a1
00001548                            ;	move.w	#arttile,d0
00001548                            ;	bsr.w	EniDec
00001548                            
00001548                            ; See http://www.segaretro.org/Enigma_compression for format description
00001548                            ; ---------------------------------------------------------------------------
00001548                            
00001548                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001548                            
00001548                            
00001548                            EniDec:
00001548 48E7 FF7C                  		movem.l	d0-d7/a1-a5,-(sp)
0000154C 3640                       		movea.w	d0,a3		; store starting art tile
0000154E 1018                       		move.b	(a0)+,d0
00001550 4880                       		ext.w	d0
00001552 3A40                       		movea.w	d0,a5		; store number of bits in inline copy value
00001554 1818                       		move.b	(a0)+,d4
00001556 E70C                       		lsl.b	#3,d4		; store PCCVH flags bitfield
00001558 3458                       		movea.w	(a0)+,a2
0000155A D4CB                       		adda.w	a3,a2		; store incremental copy word
0000155C 3858                       		movea.w	(a0)+,a4
0000155E D8CB                       		adda.w	a3,a4		; store literal copy word
00001560 1A18                       		move.b	(a0)+,d5
00001562 E145                       		asl.w	#8,d5
00001564 1A18                       		move.b	(a0)+,d5	; get first word in format list
00001566 7C10                       		moveq	#16,d6		; initial shift value
00001568                            ; loc_173E:
00001568                            Eni_Loop:
00001568 7007                       		moveq	#7,d0		; assume a format list entry is 7 bits
0000156A 3E06                       		move.w	d6,d7
0000156C 9E40                       		sub.w	d0,d7
0000156E 3205                       		move.w	d5,d1
00001570 EE69                       		lsr.w	d7,d1
00001572 0241 007F                  		andi.w	#$7F,d1		; get format list entry
00001576 3401                       		move.w	d1,d2		; and copy it
00001578 0C41 0040                  		cmpi.w	#$40,d1		; is the high bit of the entry set?
0000157C 6400                       		bhs.s	@sevenbitentry
0000157E 7006                       		moveq	#6,d0		; if it isn't, the entry is actually 6 bits
00001580 E24A                       		lsr.w	#1,d2
00001582                            ; loc_1758:
00001582                            @sevenbitentry:
00001582 6100 0000                  		bsr.w	EniDec_FetchByte
00001586 0242 000F                  		andi.w	#$F,d2		; get repeat count
0000158A E849                       		lsr.w	#4,d1
0000158C D241                       		add.w	d1,d1
0000158E 4EFB 1000                  		jmp	EniDec_Index(pc,d1.w)
00001592                            ; End of function EniDec
00001592                            
00001592                            ; ===========================================================================
00001592                            ; loc_1768:
00001592                            EniDec_00:
00001592 32CA                       @loop:		move.w	a2,(a1)+	; copy incremental copy word
00001594 524A                       		addq.w	#1,a2		; increment it
00001596 51CA FFFA                  		dbf	d2,@loop	; repeat
0000159A 60CC                       		bra.s	Eni_Loop
0000159C                            ; ===========================================================================
0000159C                            ; loc_1772:
0000159C                            EniDec_01:
0000159C 32CC                       @loop:		move.w	a4,(a1)+	; copy literal copy word
0000159E 51CA FFFC                  		dbf	d2,@loop	; repeat
000015A2 60C4                       		bra.s	Eni_Loop
000015A4                            ; ===========================================================================
000015A4                            ; loc_177A:
000015A4                            EniDec_100:
000015A4 6100 0000                  		bsr.w	EniDec_FetchInlineValue
000015A8                            ; loc_177E:
000015A8 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
000015AA 51CA FFFC                  		dbf	d2,@loop	; repeat
000015AE                            
000015AE 60B8                       		bra.s	Eni_Loop
000015B0                            ; ===========================================================================
000015B0                            ; loc_1786:
000015B0                            EniDec_101:
000015B0 6100 0000                  		bsr.w	EniDec_FetchInlineValue
000015B4                            ; loc_178A:
000015B4 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
000015B6 5241                       		addq.w	#1,d1		; increment
000015B8 51CA FFFA                  		dbf	d2,@loop	; repeat
000015BC                            
000015BC 60AA                       		bra.s	Eni_Loop
000015BE                            ; ===========================================================================
000015BE                            ; loc_1794:
000015BE                            EniDec_110:
000015BE 6100 0000                  		bsr.w	EniDec_FetchInlineValue
000015C2                            ; loc_1798:
000015C2 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
000015C4 5341                       		subq.w	#1,d1		; decrement
000015C6 51CA FFFA                  		dbf	d2,@loop	; repeat
000015CA                            
000015CA 609C                       		bra.s	Eni_Loop
000015CC                            ; ===========================================================================
000015CC                            ; loc_17A2:
000015CC                            EniDec_111:
000015CC 0C42 000F                  		cmpi.w	#$F,d2
000015D0 6700                       		beq.s	EniDec_Done
000015D2                            ; loc_17A8:
000015D2 6100 0000                  @loop:		bsr.w	EniDec_FetchInlineValue	; fetch new inline value
000015D6 32C1                       		move.w	d1,(a1)+	; copy it
000015D8 51CA FFF8                  		dbf	d2,@loop	; and repeat
000015DC                            
000015DC 608A                       		bra.s	Eni_Loop
000015DE                            ; ===========================================================================
000015DE                            ; loc_17B4:
000015DE                            EniDec_Index:
000015DE 60B2                       		bra.s	EniDec_00
000015E0 60B0                       		bra.s	EniDec_00
000015E2 60B8                       		bra.s	EniDec_01
000015E4 60B6                       		bra.s	EniDec_01
000015E6 60BC                       		bra.s	EniDec_100
000015E8 60C6                       		bra.s	EniDec_101
000015EA 60D2                       		bra.s	EniDec_110
000015EC 60DE                       		bra.s	EniDec_111
000015EE                            ; ===========================================================================
000015EE                            ; loc_17C4:
000015EE                            EniDec_Done:
000015EE 5348                       		subq.w	#1,a0		; go back by one byte
000015F0 0C46 0010                  		cmpi.w	#16,d6		; were we going to start on a completely new byte?
000015F4 6600                       		bne.s	@notnewbyte	; if not, branch
000015F6 5348                       		subq.w	#1,a0		; and another one if needed
000015F8                            ; loc_17CE:
000015F8                            @notnewbyte:
000015F8 3008                       		move.w	a0,d0
000015FA E248                       		lsr.w	#1,d0		; are we on an odd byte?
000015FC 6400                       		bcc.s	@evenbyte	; if not, branch
000015FE 5248                       		addq.w	#1,a0		; ensure we're on an even byte
00001600                            ; loc_17D6:
00001600                            @evenbyte:
00001600 4CDF 3EFF                  		movem.l	(sp)+,d0-d7/a1-a5
00001604 4E75                       		rts	
00001606                            
00001606                            ; ---------------------------------------------------------------------------
00001606                            ; Part of the Enigma decompressor
00001606                            ; Fetches an inline copy value and stores it in d1
00001606                            ; ---------------------------------------------------------------------------
00001606                            
00001606                            ; =============== S U B R O U T I N E =======================================
00001606                            
00001606                            ; loc_17DC:
00001606                            EniDec_FetchInlineValue:
00001606 360B                       		move.w	a3,d3		; copy starting art tile
00001608 1204                       		move.b	d4,d1		; copy PCCVH bitfield
0000160A D201                       		add.b	d1,d1		; is the priority bit set?
0000160C 6400                       		bcc.s	@skippriority	; if not, branch
0000160E 5346                       		subq.w	#1,d6
00001610 0D05                       		btst	d6,d5		; is the priority bit set in the inline render flags?
00001612 6700                       		beq.s	@skippriority	; if not, branch
00001614 0043 8000                  		ori.w	#$8000,d3	; otherwise set priority bit in art tile
00001618                            ; loc_17EE:
00001618                            @skippriority:
00001618 D201                       		add.b	d1,d1		; is the high palette line bit set?
0000161A 6400                       		bcc.s	@skiphighpal	; if not, branch
0000161C 5346                       		subq.w	#1,d6
0000161E 0D05                       		btst	d6,d5
00001620 6700                       		beq.s	@skiphighpal
00001622 0643 4000                  		addi.w	#$4000,d3	; set second palette line bit
00001626                            ; loc_17FC:
00001626                            @skiphighpal:
00001626 D201                       		add.b	d1,d1		; is the low palette line bit set?
00001628 6400                       		bcc.s	@skiplowpal	; if not, branch
0000162A 5346                       		subq.w	#1,d6
0000162C 0D05                       		btst	d6,d5
0000162E 6700                       		beq.s	@skiplowpal
00001630 0643 2000                  		addi.w	#$2000,d3	; set first palette line bit
00001634                            ; loc_180A:
00001634                            @skiplowpal:
00001634 D201                       		add.b	d1,d1		; is the vertical flip flag set?
00001636 6400                       		bcc.s	@skipyflip	; if not, branch
00001638 5346                       		subq.w	#1,d6
0000163A 0D05                       		btst	d6,d5
0000163C 6700                       		beq.s	@skipyflip
