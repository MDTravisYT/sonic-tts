00053B66 6A00                       		bpl.s	@fadedpsg		; Branch if not
00053B68 0895 0007                  		bclr	#7,(a5)			; Stop track (TrackPlaybackControl)
00053B6C 0815 0002                  		btst	#2,(a5)			; Is SFX overriding? (TrackPlaybackControl)
