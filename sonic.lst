00001352                            
00001352                            
00001352                            SoundDriverLoad:
00001352 4E71                       		nop	
00001354 33FC 0100 00A1 1100        		stopZ80
0000135C 33FC 0100 00A1 1200        		resetZ80
00001364 41F9 0000 0000             		lea	(Kos_Z80).l,a0	; load sound driver
0000136A 43F9 00A0 0000             		lea	(z80_ram).l,a1	; target Z80 RAM
00001370 6100 0000                  		bsr.w	KosDec		; decompress
00001374 33FC 0000 00A1 1200        		resetZ80a
0000137C 4E71                       		nop	
0000137E 4E71                       		nop	
00001380 4E71                       		nop	
00001382 4E71                       		nop	
00001384 33FC 0100 00A1 1200        		resetZ80
0000138C 33FC 0000 00A1 1100        		startZ80
00001394 4E75                       		rts	
00001396                            ; End of function SoundDriverLoad
