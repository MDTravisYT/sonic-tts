0001400C                            ;	d1 = distance to the floor
0001400C                            ;	d3 = floor angle
0001400C                            ;	a1 = address within 256x256 mappings where object is standing
0001400C                            ;	     (refers to a 16x16 tile number)
0001400C                            ;	(a4) = floor angle
0001400C                            ; ---------------------------------------------------------------------------
