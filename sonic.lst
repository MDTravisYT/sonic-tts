0000627C D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate to relative coordinate
00006280 DA53                       		add.w	(a3),d5		; Add camera X coordinate to relative coordinate
00006282                            		; Turn Y coordinate into index into level layout
00006282 3604                       		move.w	d4,d3
00006284 E24B                       		lsr.w	#1,d3
00006286 0243 0380                  		andi.w	#$380,d3
0000628A                            		; Turn X coordinate into index into level layout
