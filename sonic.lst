00019C3A 6700 0000                  		beq.w	React_Enemy	; if not, branch
00019C3E 0C01 00C0                  		cmpi.b	#$C0,d1		; is obColType $C0 or higher?
00019C42 6700 0000                  		beq.w	React_Special	; if yes, branch
