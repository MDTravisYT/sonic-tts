000001D4 0000 0000                  RomEndLoc:	dc.l EndOfRom-1		; End address of ROM
000001D8 00FF 0000                  RamStartLoc:	dc.l $FF0000		; Start address of RAM
000001DC 00FF FFFF                  RamEndLoc:	dc.l $FFFFFF		; End address of RAM
000001E0 2020 2020                  		dc.l $20202020
000001E4 2020 2020                  		dc.l $20202020		; SRAM start ($200001)
000001E8 2020 2020                  		dc.l $20202020		; SRAM end ($20xxxx)
000001EC 2020 2020 2020 2020 2020+  Notes:		dc.b "                                                    " ; Notes (unused, anything can be put in this space, but it has to be 52 bytes.)
