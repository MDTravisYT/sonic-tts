00053ACA E50B                       		lsl.b	#2,d3
00053ACC 41FA FEB0                  		lea	SFX_BGMChannelRAM(pc),a0
00053AD0 264D                       		movea.l	a5,a3
00053AD2 2A70 3000                  		movea.l	(a0,d3.w),a5
00053AD6 226E 0018                  		movea.l	v_voice_ptr(a6),a1	; Get music voice pointer
00053ADA                            ; loc_72428:
