0001B3F0 43F8 FE22                  		lea	(v_time).w,a1
0001B3F4 0C99 0009 3B3B             		cmpi.l	#(9*$10000)+(59*$100)+59,(a1)+ ; is the time 9:59:59?
0001B3FA 6700                       		beq.s	TimeOver	; if yes, branch
0001B3FC                            
0001B3FC 5221                       		addq.b	#1,-(a1)	; increment 1/60s counter
0001B3FE 0C11 003C                  		cmpi.b	#60,(a1)	; check if passed 60
0001B402 6500                       		bcs.s	@chklives
0001B404 12BC 0000                  		move.b	#0,(a1)
0001B408 5221                       		addq.b	#1,-(a1)	; increment second counter
0001B40A 0C11 003C                  		cmpi.b	#60,(a1)	; check if passed 60
0001B40E 6500                       		bcs.s	@updatetime
0001B410 12BC 0000                  		move.b	#0,(a1)
0001B414 5221                       		addq.b	#1,-(a1)	; increment minute counter
0001B416 0C11 0009                  		cmpi.b	#9,(a1)		; check if passed 9
0001B41A 6500                       		bcs.s	@updatetime
0001B41C 12BC 0009                  		move.b	#9,(a1)		; keep as 9
