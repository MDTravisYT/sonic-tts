00013B64                            		include	"_incObj\sub FindNearestTile.asm"
00013B64                            ; ---------------------------------------------------------------------------
00013B64                            ; Subroutine to	find which tile	the object is standing on
00013B64                            
00013B64                            ; input:
00013B64                            ;	d2 = y-position of object's bottom edge
00013B64                            ;	d3 = x-position of object
00013B64                            
00013B64                            ; output:
00013B64                            ;	a1 = address within 256x256 mappings where object is standing
00013B64                            ;	     (refers to a 16x16 tile number)
00013B64                            ; ---------------------------------------------------------------------------
00013B64                            
00013B64                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013B64                            
00013B64                            
00013B64                            FindNearestTile:
00013B64 3002                       		move.w	d2,d0		; get y-pos. of bottom edge of object
00013B66 E248                       		lsr.w	#1,d0
00013B68 0240 0380                  		andi.w	#$380,d0
00013B6C 3203                       		move.w	d3,d1		; get x-pos. of object
00013B6E E049                       		lsr.w	#8,d1
00013B70 0241 007F                  		andi.w	#$7F,d1
00013B74 D041                       		add.w	d1,d0		; combine
00013B76 72FF                       		moveq	#-1,d1
00013B78 43F8 A400                  		lea	(v_lvllayout).w,a1
00013B7C 1231 0000                  		move.b	(a1,d0.w),d1	; get 256x256 tile number
00013B80 6700                       		beq.s	@blanktile	; branch if 0
00013B82 6B00                       		bmi.s	@specialtile	; branch if >$7F
00013B84 5301                       		subq.b	#1,d1
00013B86 4881                       		ext.w	d1
00013B88 EE59                       		ror.w	#7,d1
00013B8A 3002                       		move.w	d2,d0
00013B8C D040                       		add.w	d0,d0
00013B8E 0240 01E0                  		andi.w	#$1E0,d0
00013B92 D240                       		add.w	d0,d1
00013B94 3003                       		move.w	d3,d0
00013B96 E648                       		lsr.w	#3,d0
00013B98 0240 001E                  		andi.w	#$1E,d0
00013B9C D240                       		add.w	d0,d1
00013B9E                            
00013B9E                            @blanktile:
00013B9E 2241                       		movea.l	d1,a1
00013BA0 4E75                       		rts	
00013BA2                            ; ===========================================================================
00013BA2                            
00013BA2                            @specialtile:
00013BA2 0241 007F                  		andi.w	#$7F,d1
00013BA6 0828 0006 0001             		btst	#6,obRender(a0) ; is object "behind a loop"?
00013BAC 6700                       		beq.s	@treatasnormal	; if not, branch
00013BAE 5241                       		addq.w	#1,d1
00013BB0 0C41 0029                  		cmpi.w	#$29,d1
00013BB4 6600                       		bne.s	@treatasnormal
00013BB6 323C 0051                  		move.w	#$51,d1
00013BBA                            
00013BBA                            	@treatasnormal:
00013BBA 5301                       		subq.b	#1,d1
00013BBC EE59                       		ror.w	#7,d1
00013BBE 3002                       		move.w	d2,d0
00013BC0 D040                       		add.w	d0,d0
00013BC2 0240 01E0                  		andi.w	#$1E0,d0
00013BC6 D240                       		add.w	d0,d1
00013BC8 3003                       		move.w	d3,d0
00013BCA E648                       		lsr.w	#3,d0
00013BCC 0240 001E                  		andi.w	#$1E,d0
00013BD0 D240                       		add.w	d0,d1
00013BD2 2241                       		movea.l	d1,a1
00013BD4 4E75                       		rts	
00013BD6                            ; End of function FindNearestTile
00013BD6                            ; End of function FindNearestTile
00013BD6                            		include	"_incObj\sub FindFloor.asm"
00013BD6                            ; ---------------------------------------------------------------------------
00013BD6                            ; Subroutine to	find the floor
00013BD6                            
00013BD6                            ; input:
00013BD6                            ;	d2 = y-position of object's bottom edge
00013BD6                            ;	d3 = x-position of object
00013BD6                            ;	d5 = bit to test for solidness
00013BD6                            
00013BD6                            ; output:
00013BD6                            ;	d1 = distance to the floor
00013BD6                            ;	a1 = address within 256x256 mappings where object is standing
00013BD6                            ;	     (refers to a 16x16 tile number)
00013BD6                            ;	(a4) = floor angle
00013BD6                            ; ---------------------------------------------------------------------------
00013BD6                            
00013BD6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013BD6                            
00013BD6                            
00013BD6                            FindFloor:
00013BD6 618C                       		bsr.s	FindNearestTile
00013BD8 3011                       		move.w	(a1),d0		; get value for solidness, orientation and 16x16 tile number
00013BDA 3800                       		move.w	d0,d4
00013BDC 0240 07FF                  		andi.w	#$7FF,d0
00013BE0 6700                       		beq.s	@isblank	; branch if tile is blank
00013BE2 0B04                       		btst	d5,d4		; is the tile solid?
00013BE4 6600                       		bne.s	@issolid	; if yes, branch
00013BE6                            
00013BE6                            @isblank:
00013BE6 D44B                       		add.w	a3,d2
00013BE8 6100 0000                  		bsr.w	FindFloor2	; try tile below the nearest
00013BEC 944B                       		sub.w	a3,d2
00013BEE 0641 0010                  		addi.w	#$10,d1		; return distance to floor
00013BF2 4E75                       		rts	
00013BF4                            ; ===========================================================================
00013BF4                            
00013BF4                            @issolid:
00013BF4 2478 F796                  		movea.l	(v_collindex).w,a2
00013BF8 1032 0000                  		move.b	(a2,d0.w),d0	; get collision block number
00013BFC 0240 00FF                  		andi.w	#$FF,d0
00013C00 67E4                       		beq.s	@isblank	; branch if 0
00013C02 45F9 0000 0000             		lea	(AngleMap).l,a2
00013C08 18B2 0000                  		move.b	(a2,d0.w),(a4)	; get collision angle value
00013C0C E948                       		lsl.w	#4,d0
00013C0E 3203                       		move.w	d3,d1		; get x-pos. of object
00013C10 0804 000B                  		btst	#$B,d4		; is block flipped horizontally?
00013C14 6700                       		beq.s	@noflip		; if not, branch
00013C16 4641                       		not.w	d1
00013C18 4414                       		neg.b	(a4)
00013C1A                            
00013C1A                            	@noflip:
00013C1A 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
00013C1E 6700                       		beq.s	@noflip2	; if not, branch
00013C20 0614 0040                  		addi.b	#$40,(a4)
00013C24 4414                       		neg.b	(a4)
00013C26 0414 0040                  		subi.b	#$40,(a4)
00013C2A                            
00013C2A                            	@noflip2:
00013C2A 0241 000F                  		andi.w	#$F,d1
00013C2E D240                       		add.w	d0,d1		; (block num. * $10) + x-pos. = place in array
00013C30 45F9 0000 0000             		lea	(CollArray1).l,a2
00013C36 1032 1000                  		move.b	(a2,d1.w),d0	; get collision height
00013C3A 4880                       		ext.w	d0
00013C3C BD44                       		eor.w	d6,d4
00013C3E 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
00013C42 6700                       		beq.s	@noflip3	; if not, branch
00013C44 4440                       		neg.w	d0
00013C46                            
00013C46                            	@noflip3:
00013C46 4A40                       		tst.w	d0
00013C48 679C                       		beq.s	@isblank	; branch if height is 0
00013C4A 6B00                       		bmi.s	@negfloor	; branch if height is negative
00013C4C 0C00 0010                  		cmpi.b	#$10,d0
00013C50 6700                       		beq.s	@maxfloor	; branch if height is $10 (max)
00013C52 3202                       		move.w	d2,d1		; get y-pos. of object
00013C54 0241 000F                  		andi.w	#$F,d1
00013C58 D041                       		add.w	d1,d0
00013C5A 323C 000F                  		move.w	#$F,d1
00013C5E 9240                       		sub.w	d0,d1		; return distance to floor
00013C60 4E75                       		rts	
00013C62                            ; ===========================================================================
00013C62                            
00013C62                            @negfloor:
00013C62 3202                       		move.w	d2,d1
00013C64 0241 000F                  		andi.w	#$F,d1
00013C68 D041                       		add.w	d1,d0
00013C6A 6A00 FF7A                  		bpl.w	@isblank
00013C6E                            
00013C6E                            @maxfloor:
00013C6E 944B                       		sub.w	a3,d2
00013C70 6100 0000                  		bsr.w	FindFloor2	; try tile above the nearest
00013C74 D44B                       		add.w	a3,d2
00013C76 0441 0010                  		subi.w	#$10,d1		; return distance to floor
00013C7A 4E75                       		rts	
00013C7C                            ; End of function FindFloor
00013C7C                            
00013C7C                            
00013C7C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013C7C                            
00013C7C                            
00013C7C                            FindFloor2:
00013C7C 6100 FEE6                  		bsr.w	FindNearestTile
00013C80 3011                       		move.w	(a1),d0
00013C82 3800                       		move.w	d0,d4
00013C84 0240 07FF                  		andi.w	#$7FF,d0
00013C88 6700                       		beq.s	@isblank2
00013C8A 0B04                       		btst	d5,d4
00013C8C 6600                       		bne.s	@issolid
00013C8E                            
00013C8E                            @isblank2:
00013C8E 323C 000F                  		move.w	#$F,d1
00013C92 3002                       		move.w	d2,d0
00013C94 0240 000F                  		andi.w	#$F,d0
00013C98 9240                       		sub.w	d0,d1
00013C9A 4E75                       		rts	
00013C9C                            ; ===========================================================================
00013C9C                            
00013C9C                            @issolid:
00013C9C 2478 F796                  		movea.l	(v_collindex).w,a2
00013CA0 1032 0000                  		move.b	(a2,d0.w),d0
00013CA4 0240 00FF                  		andi.w	#$FF,d0
00013CA8 67E4                       		beq.s	@isblank2
00013CAA 45F9 0000 0000             		lea	(AngleMap).l,a2
00013CB0 18B2 0000                  		move.b	(a2,d0.w),(a4)
00013CB4 E948                       		lsl.w	#4,d0
00013CB6 3203                       		move.w	d3,d1
00013CB8 0804 000B                  		btst	#$B,d4
00013CBC 6700                       		beq.s	@noflip
00013CBE 4641                       		not.w	d1
00013CC0 4414                       		neg.b	(a4)
00013CC2                            
00013CC2                            	@noflip:
00013CC2 0804 000C                  		btst	#$C,d4
00013CC6 6700                       		beq.s	@noflip2
00013CC8 0614 0040                  		addi.b	#$40,(a4)
00013CCC 4414                       		neg.b	(a4)
00013CCE 0414 0040                  		subi.b	#$40,(a4)
00013CD2                            
00013CD2                            	@noflip2:
00013CD2 0241 000F                  		andi.w	#$F,d1
00013CD6 D240                       		add.w	d0,d1
00013CD8 45F9 0000 0000             		lea	(CollArray1).l,a2
00013CDE 1032 1000                  		move.b	(a2,d1.w),d0
00013CE2 4880                       		ext.w	d0
00013CE4 BD44                       		eor.w	d6,d4
00013CE6 0804 000C                  		btst	#$C,d4
00013CEA 6700                       		beq.s	@noflip3
00013CEC 4440                       		neg.w	d0
00013CEE                            
00013CEE                            	@noflip3:
00013CEE 4A40                       		tst.w	d0
00013CF0 679C                       		beq.s	@isblank2
00013CF2 6B00                       		bmi.s	@negfloor
00013CF4 3202                       		move.w	d2,d1
00013CF6 0241 000F                  		andi.w	#$F,d1
00013CFA D041                       		add.w	d1,d0
00013CFC 323C 000F                  		move.w	#$F,d1
00013D00 9240                       		sub.w	d0,d1
00013D02 4E75                       		rts	
00013D04                            ; ===========================================================================
00013D04                            
00013D04                            @negfloor:
00013D04 3202                       		move.w	d2,d1
00013D06 0241 000F                  		andi.w	#$F,d1
00013D0A D041                       		add.w	d1,d0
00013D0C 6A00 FF80                  		bpl.w	@isblank2
00013D10 4641                       		not.w	d1
00013D12 4E75                       		rts	
00013D14                            ; End of function FindFloor2
