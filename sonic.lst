00019D9E 6100 8C32                  		bsr.w	Sonic_ResetOnFloor
00019DA2 08E8 0001 0022             		bset	#1,obStatus(a0)
00019DA8 317C FC00 0012             		move.w	#-$400,obVelY(a0) ; make Sonic bounce away from the object
00019DAE 317C FE00 0010             		move.w	#-$200,obVelX(a0)
00019DB4 0828 0006 0022             		btst	#6,obStatus(a0)	; is Sonic underwater?
00019DBA 6700                       		beq.s	@isdry		; if not, branch
00019DBC                            
