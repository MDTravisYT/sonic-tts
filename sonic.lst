00012B28                            ; ---------------------------------------------------------------------------
00012B28                            
00012B28                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00012B28                            
00012B28                            
00012B28                            Sonic_Loops:
00012B28 0C38 0003 FE10             		cmpi.b	#id_SLZ,(v_zone).w ; is level SLZ ?
00012B2E 6700                       		beq.s	@isstarlight	; if yes, branch
00012B30 4A38 FE10                  		tst.b	(v_zone).w	; is level GHZ ?
00012B34 6600 0000                  		bne.w	@noloops	; if not, branch
00012B38                            
00012B38                            	@isstarlight:
00012B38 3028 000C                  		move.w	obY(a0),d0
00012B3C E248                       		lsr.w	#1,d0
00012B3E 0240 0380                  		andi.w	#$380,d0
00012B42 1228 0008                  		move.b	obX(a0),d1
00012B46 0241 007F                  		andi.w	#$7F,d1
00012B4A D041                       		add.w	d1,d0
00012B4C 43F8 A400                  		lea	(v_lvllayout).w,a1
00012B50 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00012B54                            
00012B54 B238 F7AE                  		cmp.b	(v_256roll1).w,d1 ; is Sonic on a "roll tunnel" tile?
00012B58 6700 FA7C                  		beq.w	Sonic_ChkRoll	; if yes, branch
00012B5C B238 F7AF                  		cmp.b	(v_256roll2).w,d1
00012B60 6700 FA74                  		beq.w	Sonic_ChkRoll
00012B64                            
00012B64 B238 F7AC                  		cmp.b	(v_256loop1).w,d1 ; is Sonic on a loop tile?
00012B68 6700                       		beq.s	@chkifleft	; if yes, branch
00012B6A B238 F7AD                  		cmp.b	(v_256loop2).w,d1
00012B6E 6700                       		beq.s	@chkifinair
00012B70 08A8 0006 0001             		bclr	#6,obRender(a0) ; return Sonic to high plane
00012B76 4E75                       		rts	
00012B78                            ; ===========================================================================
00012B78                            
00012B78                            @chkifinair:
00012B78 0828 0001 0022             		btst	#1,obStatus(a0)	; is Sonic in the air?
00012B7E 6700                       		beq.s	@chkifleft	; if not, branch
00012B80                            
00012B80 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00012B86 4E75                       		rts	
00012B88                            ; ===========================================================================
00012B88                            
00012B88                            @chkifleft:
00012B88 3428 0008                  		move.w	obX(a0),d2
00012B8C 0C02 002C                  		cmpi.b	#$2C,d2
00012B90 6400                       		bcc.s	@chkifright
00012B92                            
00012B92 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00012B98 4E75                       		rts	
00012B9A                            ; ===========================================================================
00012B9A                            
00012B9A                            @chkifright:
00012B9A 0C02 00E0                  		cmpi.b	#$E0,d2
00012B9E 6500                       		bcs.s	@chkangle1
00012BA0                            
00012BA0 08E8 0006 0001             		bset	#6,obRender(a0)	; send Sonic to	low plane
00012BA6 4E75                       		rts	
00012BA8                            ; ===========================================================================
00012BA8                            
00012BA8                            @chkangle1:
00012BA8 0828 0006 0001             		btst	#6,obRender(a0) ; is Sonic on low plane?
00012BAE 6600                       		bne.s	@chkangle2	; if yes, branch
00012BB0                            
00012BB0 1228 0026                  		move.b	obAngle(a0),d1
00012BB4 6700                       		beq.s	@done
00012BB6 0C01 0080                  		cmpi.b	#$80,d1		; is Sonic upside-down?
00012BBA 6200                       		bhi.s	@done		; if yes, branch
00012BBC 08E8 0006 0001             		bset	#6,obRender(a0)	; send Sonic to	low plane
00012BC2 4E75                       		rts	
00012BC4                            ; ===========================================================================
00012BC4                            
00012BC4                            @chkangle2:
00012BC4 1228 0026                  		move.b	obAngle(a0),d1
00012BC8 0C01 0080                  		cmpi.b	#$80,d1		; is Sonic upright?
00012BCC 6300                       		bls.s	@done		; if yes, branch
00012BCE 08A8 0006 0001             		bclr	#6,obRender(a0)	; send Sonic to	high plane
00012BD4                            
00012BD4                            @noloops:
00012BD4                            @done:
00012BD4 4E75                       		rts	
00012BD6                            ; End of function Sonic_Loops
00012BD6                            ; End of function Sonic_Loops
00012BD6                            		include	"_incObj\Sonic Animate.asm"
00012BD6                            ; ---------------------------------------------------------------------------
00012BD6                            ; Subroutine to	animate	Sonic's sprites
00012BD6                            ; ---------------------------------------------------------------------------
00012BD6                            
00012BD6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00012BD6                            
00012BD6                            
00012BD6                            Sonic_Animate:
00012BD6 43F9 0000 0000             		lea	(Ani_Sonic).l,a1
00012BDC 7000                       		moveq	#0,d0
00012BDE 1028 001C                  		move.b	obAnim(a0),d0
00012BE2 B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
00012BE6 6700                       		beq.s	@do		; if not, branch
00012BE8 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
00012BEC 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
00012BF2 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
00012BF8                            
00012BF8                            	@do:
00012BF8 D040                       		add.w	d0,d0
00012BFA D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
00012BFE 1011                       		move.b	(a1),d0
00012C00 6B00                       		bmi.s	@walkrunroll	; if animation is walk/run/roll/jump, branch
00012C02 1228 0022                  		move.b	obStatus(a0),d1
00012C06 0201 0001                  		andi.b	#1,d1
00012C0A 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012C10 8328 0001                  		or.b	d1,obRender(a0)
00012C14 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00012C18 6A00                       		bpl.s	@delay		; if time remains, branch
00012C1A 1140 001E                  		move.b	d0,obTimeFrame(a0) ; load frame duration
00012C1E                            
00012C1E                            @loadframe:
00012C1E 7200                       		moveq	#0,d1
00012C20 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
00012C24 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
00012C28 6B00                       		bmi.s	@end_FF		; if animation is complete, branch
00012C2A                            
00012C2A                            	@next:
00012C2A 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
00012C2E 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
00012C32                            
00012C32                            	@delay:
00012C32 4E75                       		rts	
00012C34                            ; ===========================================================================
00012C34                            
00012C34                            @end_FF:
00012C34 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
00012C36 6600                       		bne.s	@end_FE		; if not, branch
00012C38 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; restart the animation
00012C3E 1029 0001                  		move.b	1(a1),d0	; read sprite number
00012C42 60E6                       		bra.s	@next
00012C44                            ; ===========================================================================
00012C44                            
00012C44                            @end_FE:
00012C44 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
00012C46 6600                       		bne.s	@end_FD		; if not, branch
00012C48 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
00012C4C 9128 001B                  		sub.b	d0,obAniFrame(a0) ; jump back d0 bytes in the script
00012C50 9200                       		sub.b	d0,d1
00012C52 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00012C56 60D2                       		bra.s	@next
00012C58                            ; ===========================================================================
00012C58                            
00012C58                            @end_FD:
00012C58 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00012C5A 6600                       		bne.s	@end		; if not, branch
00012C5C 1171 1002 001C             		move.b	2(a1,d1.w),obAnim(a0) ; read next byte, run that animation
00012C62                            
00012C62                            	@end:
00012C62 4E75                       		rts	
00012C64                            ; ===========================================================================
00012C64                            
00012C64                            @walkrunroll:
00012C64 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00012C68 6AC8                       		bpl.s	@delay		; if time remains, branch
00012C6A 5200                       		addq.b	#1,d0		; is animation walking/running?
00012C6C 6600 0000                  		bne.w	@rolljump	; if not, branch
00012C70 7200                       		moveq	#0,d1
00012C72 1028 0026                  		move.b	obAngle(a0),d0	; get Sonic's angle
00012C76 1428 0022                  		move.b	obStatus(a0),d2
00012C7A 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00012C7E 6600                       		bne.s	@flip		; if yes, branch
00012C80 4600                       		not.b	d0		; reverse angle
00012C82                            
00012C82                            	@flip:
00012C82 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00012C86 6A00                       		bpl.s	@noinvert	; if angle is $0-$7F, branch
00012C88 7203                       		moveq	#3,d1
00012C8A                            
00012C8A                            	@noinvert:
00012C8A 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012C90 B302                       		eor.b	d1,d2
00012C92 8528 0001                  		or.b	d2,obRender(a0)
00012C96 0828 0005 0022             		btst	#5,obStatus(a0)	; is Sonic pushing something?
00012C9C 6600 0000                  		bne.w	@push		; if yes, branch
00012CA0                            
00012CA0 E808                       		lsr.b	#4,d0		; divide angle by $10
00012CA2 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
00012CA6 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012CAA 6A00                       		bpl.s	@nomodspeed
00012CAC 4442                       		neg.w	d2		; modulus speed
00012CAE                            
00012CAE                            	@nomodspeed:
00012CAE 43F9 0000 0000             		lea	(SonAni_Run).l,a1 ; use	running	animation
00012CB4 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic at running speed?
00012CB8 6400                       		bcc.s	@running	; if yes, branch
00012CBA                            
00012CBA 43F9 0000 0000             		lea	(SonAni_Walk).l,a1 ; use walking animation
00012CC0 1200                       		move.b	d0,d1
00012CC2 E209                       		lsr.b	#1,d1
00012CC4 D001                       		add.b	d1,d0
00012CC6                            
00012CC6                            	@running:
00012CC6 D000                       		add.b	d0,d0
00012CC8 1600                       		move.b	d0,d3
00012CCA 4442                       		neg.w	d2
00012CCC 0642 0800                  		addi.w	#$800,d2
00012CD0 6A00                       		bpl.s	@belowmax
00012CD2 7400                       		moveq	#0,d2		; max animation speed
00012CD4                            
00012CD4                            	@belowmax:
00012CD4 E04A                       		lsr.w	#8,d2
00012CD6 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012CDA 6100 FF42                  		bsr.w	@loadframe
00012CDE D728 001A                  		add.b	d3,obFrame(a0)	; modify frame number
00012CE2 4E75                       		rts	
00012CE4                            ; ===========================================================================
00012CE4                            
00012CE4                            @rolljump:
00012CE4 5200                       		addq.b	#1,d0		; is animation rolling/jumping?
00012CE6 6600                       		bne.s	@push		; if not, branch
00012CE8 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012CEC 6A00                       		bpl.s	@nomodspeed2
00012CEE 4442                       		neg.w	d2
00012CF0                            
00012CF0                            	@nomodspeed2:
00012CF0 43F9 0000 0000             		lea	(SonAni_Roll2).l,a1 ; use fast animation
00012CF6 0C42 0600                  		cmpi.w	#$600,d2	; is Sonic moving fast?
00012CFA 6400                       		bcc.s	@rollfast	; if yes, branch
00012CFC 43F9 0000 0000             		lea	(SonAni_Roll).l,a1 ; use slower	animation
00012D02                            
00012D02                            	@rollfast:
00012D02 4442                       		neg.w	d2
00012D04 0642 0400                  		addi.w	#$400,d2
00012D08 6A00                       		bpl.s	@belowmax2
00012D0A 7400                       		moveq	#0,d2
00012D0C                            
00012D0C                            	@belowmax2:
00012D0C E04A                       		lsr.w	#8,d2
00012D0E 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D12 1228 0022                  		move.b	obStatus(a0),d1
00012D16 0201 0001                  		andi.b	#1,d1
00012D1A 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012D20 8328 0001                  		or.b	d1,obRender(a0)
00012D24 6000 FEF8                  		bra.w	@loadframe
00012D28                            ; ===========================================================================
00012D28                            
00012D28                            @push:
00012D28 3428 0014                  		move.w	obInertia(a0),d2 ; get Sonic's speed
00012D2C 6B00                       		bmi.s	@negspeed
00012D2E 4442                       		neg.w	d2
00012D30                            
00012D30                            	@negspeed:
00012D30 0642 0800                  		addi.w	#$800,d2
00012D34 6A00                       		bpl.s	@belowmax3	
00012D36 7400                       		moveq	#0,d2
00012D38                            
00012D38                            	@belowmax3:
00012D38 EC4A                       		lsr.w	#6,d2
00012D3A 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D3E 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00012D44 1228 0022                  		move.b	obStatus(a0),d1
00012D48 0201 0001                  		andi.b	#1,d1
00012D4C 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012D52 8328 0001                  		or.b	d1,obRender(a0)
00012D56 6000 FEC6                  		bra.w	@loadframe
00012D5A                            
00012D5A                            ; End of function Sonic_Animate
00012D5A                            ; End of function Sonic_Animate
