0000ED52 0C41 0004                  		cmpi.w	#4,d1
0000ED56 6300                       		bls.s	Solid_SideAir
0000ED58 4A40                       		tst.w	d0		; where is Sonic?
0000ED5A 6700                       		beq.s	Solid_Centre	; if inside the object, branch
0000ED5C 6B00                       		bmi.s	Solid_Right	; if right of the object, branch
0000ED5E 4A69 0010                  		tst.w	obVelX(a1)	; is Sonic moving left?
