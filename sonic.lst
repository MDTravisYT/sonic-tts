00003286 D241                       		add.w	d1,d1
00003288 D240                       		add.w	d0,d1
0000328A D2C1                       		adda.w	d1,a1
0000328C 363C C680                  		move.w	#$C680,d3	; VRAM setting (3rd palette, $680th tile)
