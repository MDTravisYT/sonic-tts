0000EC10 08A8 0003 0022             		bclr	#3,obStatus(a0)	; clear object's standing flag
0000EC16 4228 0025                  		clr.b	obSolid(a0)
0000EC1A 7800                       		moveq	#0,d4
0000EC1C 4E75                       		rts	
0000EC1E                            
0000EC1E                            	@stand:
0000EC1E 3404                       		move.w	d4,d2
0000EC20 6100 84AA                  		bsr.w	MvSonicOnPtfm
0000EC24 7800                       		moveq	#0,d4
0000EC26 4E75                       		rts	
