0000131A                            
0000131A                            
0000131A                            SoundDriverLoad:
0000131A 4E71                       		nop	
0000131C 33FC 0100 00A1 1100        		stopZ80
00001324 33FC 0100 00A1 1200        		resetZ80
0000132C 41F9 0000 0000             		lea	(Kos_Z80).l,a0	; load sound driver
00001332 43F9 00A0 0000             		lea	(z80_ram).l,a1	; target Z80 RAM
00001338 6100 0000                  		bsr.w	KosDec		; decompress
0000133C 33FC 0000 00A1 1200        		resetZ80a
00001344 4E71                       		nop	
00001346 4E71                       		nop	
00001348 4E71                       		nop	
0000134A 4E71                       		nop	
0000134C 33FC 0100 00A1 1200        		resetZ80
00001354 33FC 0000 00A1 1100        		startZ80
0000135C 4E75                       		rts	
0000135E                            ; End of function SoundDriverLoad
