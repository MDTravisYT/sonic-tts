0000193C 7400                       		moveq	#0,d2
0000193E 7000                       		moveq	#0,d0
00001940 1038 FE10                  		move.b	(v_zone).w,d0	; get level number
00001944 D040                       		add.w	d0,d0
00001946 303B 0000                  		move.w	PCycle_Index(pc,d0.w),d0
0000194A 4EFB 0000                  		jmp	PCycle_Index(pc,d0.w) ; jump to relevant palette routine
