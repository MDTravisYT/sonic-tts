00001554                            		include	"_inc\Enigma Decompression.asm"
00001554                            ; ---------------------------------------------------------------------------
00001554                            ; Enigma decompression algorithm
00001554                            
00001554                            ; input:
00001554                            ;	d0 = starting art tile (added to each 8x8 before writing to destination)
00001554                            ;	a0 = source address
00001554                            ;	a1 = destination address
00001554                            
00001554                            ; usage:
00001554                            ;	lea	(source).l,a0
00001554                            ;	lea	(destination).l,a1
00001554                            ;	move.w	#arttile,d0
00001554                            ;	bsr.w	EniDec
00001554                            
00001554                            ; See http://www.segaretro.org/Enigma_compression for format description
00001554                            ; ---------------------------------------------------------------------------
00001554                            
00001554                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001554                            
00001554                            
00001554                            EniDec:
00001554 48E7 FF7C                  		movem.l	d0-d7/a1-a5,-(sp)
00001558 3640                       		movea.w	d0,a3		; store starting art tile
0000155A 1018                       		move.b	(a0)+,d0
0000155C 4880                       		ext.w	d0
0000155E 3A40                       		movea.w	d0,a5		; store number of bits in inline copy value
00001560 1818                       		move.b	(a0)+,d4
00001562 E70C                       		lsl.b	#3,d4		; store PCCVH flags bitfield
00001564 3458                       		movea.w	(a0)+,a2
00001566 D4CB                       		adda.w	a3,a2		; store incremental copy word
00001568 3858                       		movea.w	(a0)+,a4
0000156A D8CB                       		adda.w	a3,a4		; store literal copy word
0000156C 1A18                       		move.b	(a0)+,d5
0000156E E145                       		asl.w	#8,d5
00001570 1A18                       		move.b	(a0)+,d5	; get first word in format list
00001572 7C10                       		moveq	#16,d6		; initial shift value
00001574                            ; loc_173E:
00001574                            Eni_Loop:
00001574 7007                       		moveq	#7,d0		; assume a format list entry is 7 bits
00001576 3E06                       		move.w	d6,d7
00001578 9E40                       		sub.w	d0,d7
0000157A 3205                       		move.w	d5,d1
0000157C EE69                       		lsr.w	d7,d1
0000157E 0241 007F                  		andi.w	#$7F,d1		; get format list entry
00001582 3401                       		move.w	d1,d2		; and copy it
00001584 0C41 0040                  		cmpi.w	#$40,d1		; is the high bit of the entry set?
00001588 6400                       		bhs.s	@sevenbitentry
0000158A 7006                       		moveq	#6,d0		; if it isn't, the entry is actually 6 bits
0000158C E24A                       		lsr.w	#1,d2
0000158E                            ; loc_1758:
0000158E                            @sevenbitentry:
0000158E 6100 0000                  		bsr.w	EniDec_FetchByte
00001592 0242 000F                  		andi.w	#$F,d2		; get repeat count
00001596 E849                       		lsr.w	#4,d1
00001598 D241                       		add.w	d1,d1
0000159A 4EFB 1000                  		jmp	EniDec_Index(pc,d1.w)
0000159E                            ; End of function EniDec
0000159E                            
0000159E                            ; ===========================================================================
0000159E                            ; loc_1768:
0000159E                            EniDec_00:
0000159E 32CA                       @loop:		move.w	a2,(a1)+	; copy incremental copy word
000015A0 524A                       		addq.w	#1,a2		; increment it
000015A2 51CA FFFA                  		dbf	d2,@loop	; repeat
000015A6 60CC                       		bra.s	Eni_Loop
000015A8                            ; ===========================================================================
000015A8                            ; loc_1772:
000015A8                            EniDec_01:
000015A8 32CC                       @loop:		move.w	a4,(a1)+	; copy literal copy word
000015AA 51CA FFFC                  		dbf	d2,@loop	; repeat
000015AE 60C4                       		bra.s	Eni_Loop
000015B0                            ; ===========================================================================
000015B0                            ; loc_177A:
000015B0                            EniDec_100:
000015B0 6100 0000                  		bsr.w	EniDec_FetchInlineValue
000015B4                            ; loc_177E:
000015B4 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
000015B6 51CA FFFC                  		dbf	d2,@loop	; repeat
000015BA                            
000015BA 60B8                       		bra.s	Eni_Loop
000015BC                            ; ===========================================================================
000015BC                            ; loc_1786:
000015BC                            EniDec_101:
000015BC 6100 0000                  		bsr.w	EniDec_FetchInlineValue
000015C0                            ; loc_178A:
000015C0 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
000015C2 5241                       		addq.w	#1,d1		; increment
000015C4 51CA FFFA                  		dbf	d2,@loop	; repeat
000015C8                            
000015C8 60AA                       		bra.s	Eni_Loop
000015CA                            ; ===========================================================================
000015CA                            ; loc_1794:
000015CA                            EniDec_110:
000015CA 6100 0000                  		bsr.w	EniDec_FetchInlineValue
000015CE                            ; loc_1798:
000015CE 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
000015D0 5341                       		subq.w	#1,d1		; decrement
000015D2 51CA FFFA                  		dbf	d2,@loop	; repeat
000015D6                            
000015D6 609C                       		bra.s	Eni_Loop
000015D8                            ; ===========================================================================
000015D8                            ; loc_17A2:
000015D8                            EniDec_111:
000015D8 0C42 000F                  		cmpi.w	#$F,d2
000015DC 6700                       		beq.s	EniDec_Done
000015DE                            ; loc_17A8:
000015DE 6100 0000                  @loop:		bsr.w	EniDec_FetchInlineValue	; fetch new inline value
000015E2 32C1                       		move.w	d1,(a1)+	; copy it
000015E4 51CA FFF8                  		dbf	d2,@loop	; and repeat
000015E8                            
000015E8 608A                       		bra.s	Eni_Loop
000015EA                            ; ===========================================================================
000015EA                            ; loc_17B4:
000015EA                            EniDec_Index:
000015EA 60B2                       		bra.s	EniDec_00
000015EC 60B0                       		bra.s	EniDec_00
000015EE 60B8                       		bra.s	EniDec_01
000015F0 60B6                       		bra.s	EniDec_01
000015F2 60BC                       		bra.s	EniDec_100
000015F4 60C6                       		bra.s	EniDec_101
000015F6 60D2                       		bra.s	EniDec_110
000015F8 60DE                       		bra.s	EniDec_111
000015FA                            ; ===========================================================================
000015FA                            ; loc_17C4:
000015FA                            EniDec_Done:
000015FA 5348                       		subq.w	#1,a0		; go back by one byte
000015FC 0C46 0010                  		cmpi.w	#16,d6		; were we going to start on a completely new byte?
00001600 6600                       		bne.s	@notnewbyte	; if not, branch
00001602 5348                       		subq.w	#1,a0		; and another one if needed
00001604                            ; loc_17CE:
00001604                            @notnewbyte:
00001604 3008                       		move.w	a0,d0
00001606 E248                       		lsr.w	#1,d0		; are we on an odd byte?
00001608 6400                       		bcc.s	@evenbyte	; if not, branch
0000160A 5248                       		addq.w	#1,a0		; ensure we're on an even byte
0000160C                            ; loc_17D6:
0000160C                            @evenbyte:
0000160C 4CDF 3EFF                  		movem.l	(sp)+,d0-d7/a1-a5
00001610 4E75                       		rts	
00001612                            
00001612                            ; ---------------------------------------------------------------------------
00001612                            ; Part of the Enigma decompressor
00001612                            ; Fetches an inline copy value and stores it in d1
00001612                            ; ---------------------------------------------------------------------------
00001612                            
00001612                            ; =============== S U B R O U T I N E =======================================
00001612                            
00001612                            ; loc_17DC:
00001612                            EniDec_FetchInlineValue:
00001612 360B                       		move.w	a3,d3		; copy starting art tile
00001614 1204                       		move.b	d4,d1		; copy PCCVH bitfield
00001616 D201                       		add.b	d1,d1		; is the priority bit set?
00001618 6400                       		bcc.s	@skippriority	; if not, branch
0000161A 5346                       		subq.w	#1,d6
0000161C 0D05                       		btst	d6,d5		; is the priority bit set in the inline render flags?
0000161E 6700                       		beq.s	@skippriority	; if not, branch
00001620 0043 8000                  		ori.w	#$8000,d3	; otherwise set priority bit in art tile
00001624                            ; loc_17EE:
00001624                            @skippriority:
00001624 D201                       		add.b	d1,d1		; is the high palette line bit set?
00001626 6400                       		bcc.s	@skiphighpal	; if not, branch
00001628 5346                       		subq.w	#1,d6
0000162A 0D05                       		btst	d6,d5
0000162C 6700                       		beq.s	@skiphighpal
0000162E 0643 4000                  		addi.w	#$4000,d3	; set second palette line bit
00001632                            ; loc_17FC:
00001632                            @skiphighpal:
00001632 D201                       		add.b	d1,d1		; is the low palette line bit set?
00001634 6400                       		bcc.s	@skiplowpal	; if not, branch
00001636 5346                       		subq.w	#1,d6
00001638 0D05                       		btst	d6,d5
0000163A 6700                       		beq.s	@skiplowpal
0000163C 0643 2000                  		addi.w	#$2000,d3	; set first palette line bit
00001640                            ; loc_180A:
00001640                            @skiplowpal:
00001640 D201                       		add.b	d1,d1		; is the vertical flip flag set?
00001642 6400                       		bcc.s	@skipyflip	; if not, branch
00001644 5346                       		subq.w	#1,d6
