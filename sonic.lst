00053ADE 08D5 0001                  		bset	#1,(a5)			; Set 'track at rest' bit (TrackPlaybackControl)
00053AE2 102D 000B                  		move.b	TrackVoiceIndex(a5),d0	; Current voice
00053AE6 4EBA 0000                  		jsr	SetVoice(pc)
00053AEA 2A4B                       		movea.l	a3,a5
00053AEC 6000                       		bra.s	@nexttrack
