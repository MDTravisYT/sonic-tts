00001952 0000                       		dc.w PCycle_MZ-PCycle_Index
00001954 0000                       		dc.w PalCycle_SLZ-PCycle_Index
00001956 0000                       		dc.w PalCycle_SYZ-PCycle_Index
00001958 0000                       		dc.w PalCycle_SBZ-PCycle_Index
0000195A 0000                       		dc.w PCycle_GHZ-PCycle_Index	; Ending
0000195C                            
0000195C                            
0000195C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000195C                            
0000195C                            
0000195C                            PCycle_Title:
0000195C 41F9 0000 0000             		lea	(Pal_TitleCyc).l,a0
00001962 6000                       		bra.s	PCycGHZ_Go
00001964                            ; ===========================================================================
00001964                            
00001964                            PCycle_GHZ:
00001964 41F9 0000 0000             		lea	(Pal_GHZCyc).l,a0
0000196A                            
0000196A                            PCycGHZ_Go:
0000196A 5378 F634                  		subq.w	#1,(v_pcyc_time).w ; decrement timer
0000196E 6A00                       		bpl.s	PCycGHZ_Skip	; if time remains, branch
00001970                            
00001970 31FC 0005 F634             		move.w	#5,(v_pcyc_time).w ; reset timer to 5 frames
00001976 3038 F632                  		move.w	(v_pcyc_num).w,d0 ; get cycle number
0000197A 5278 F632                  		addq.w	#1,(v_pcyc_num).w ; increment cycle number
0000197E 0240 0003                  		andi.w	#3,d0		; if cycle > 3, reset to 0
00001982 E748                       		lsl.w	#3,d0
00001984 43F8 FB50                  		lea	(v_pal_dry+$50).w,a1
00001988 22F0 0000                  		move.l	(a0,d0.w),(a1)+
0000198C 22B0 0004                  		move.l	4(a0,d0.w),(a1)	; copy palette data to RAM
00001990                            
00001990                            PCycGHZ_Skip:
00001990 4E75                       		rts	
00001992                            ; End of function PCycle_GHZ
00001992                            
00001992                            
00001992                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001992                            
00001992                            
00001992                            PCycle_LZ:
00001992                            ; Waterfalls
00001992 5378 F634                  		subq.w	#1,(v_pcyc_time).w ; decrement timer
00001996 6A00                       		bpl.s	PCycLZ_Skip1	; if time remains, branch
00001998                            
00001998 31FC 0002 F634             		move.w	#2,(v_pcyc_time).w ; reset timer to 2 frames
0000199E 3038 F632                  		move.w	(v_pcyc_num).w,d0
000019A2 5278 F632                  		addq.w	#1,(v_pcyc_num).w ; increment cycle number
000019A6 0240 0003                  		andi.w	#3,d0		; if cycle > 3, reset to 0
000019AA E748                       		lsl.w	#3,d0
000019AC 41F9 0000 0000             		lea	(Pal_LZCyc1).l,a0
000019B2 0C38 0003 FE11             		cmpi.b	#3,(v_act).w	; check if level is SBZ3
000019B8 6600                       		bne.s	PCycLZ_NotSBZ3
000019BA 41F9 0000 0000             		lea	(Pal_SBZ3Cyc1).l,a0 ; load SBZ3	palette instead
000019C0                            
000019C0                            	PCycLZ_NotSBZ3:
000019C0 43F8 FB56                  		lea	(v_pal_dry+$56).w,a1
000019C4 22F0 0000                  		move.l	(a0,d0.w),(a1)+
000019C8 22B0 0004                  		move.l	4(a0,d0.w),(a1)
000019CC 43F8 FAD6                  		lea	(v_pal_water+$56).w,a1
000019D0 22F0 0000                  		move.l	(a0,d0.w),(a1)+
000019D4 22B0 0004                  		move.l	4(a0,d0.w),(a1)
000019D8                            
000019D8                            PCycLZ_Skip1:
000019D8                            ; Conveyor belts
000019D8 3038 FE04                  		move.w	(v_framecount).w,d0
000019DC 0240 0007                  		andi.w	#7,d0
000019E0 103B 0000                  		move.b	PCycLZ_Seq(pc,d0.w),d0 ; get byte from palette sequence
000019E4 6700                       		beq.s	PCycLZ_Skip2	; if byte is 0, branch
000019E6 7201                       		moveq	#1,d1
000019E8 4A38 F7C0                  		tst.b	(f_conveyrev).w	; have conveyor belts been reversed?
000019EC 6700                       		beq.s	PCycLZ_NoRev	; if not, branch
000019EE 4441                       		neg.w	d1
000019F0                            
000019F0                            	PCycLZ_NoRev:
000019F0 3038 F650                  		move.w	(v_pal_buffer).w,d0
000019F4 0240 0003                  		andi.w	#3,d0
