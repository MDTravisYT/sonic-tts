0000EBE2                            ; Solid	object subroutine (includes spikes, blocks, rocks etc)
0000EBE2                            ;
0000EBE2                            ; input:
0000EBE2                            ;	d1 = width
0000EBE2                            ;	d2 = height / 2 (when jumping)
0000EBE2                            ;	d3 = height / 2 (when walking)
0000EBE2                            ;	d4 = x-axis position
0000EBE2                            ; ---------------------------------------------------------------------------
