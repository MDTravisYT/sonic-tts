0000AB9A 0440 00C0                  		subi.w	#$C0,d0
0000AB9E B068 000C                  		cmp.w	obY(a0),d0
0000ABA2 6400                       		bcc.s	@nochg
0000ABA4 117C 0000 001C             		move.b	#0,obAnim(a0)	; use slow animation
0000ABAA 4A68 0012                  		tst.w	obVelY(a0)	; is Chopper at	its highest point?
0000ABAE 6B00                       		bmi.s	@nochg		; if not, branch
0000ABB0 117C 0002 001C             		move.b	#2,obAnim(a0)	; use stationary animation
