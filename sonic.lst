0000274E                            
0000274E                            CalcSine:
0000274E 0240 00FF                  		andi.w	#$FF,d0
00002752 D040                       		add.w	d0,d0
00002754 0640 0080                  		addi.w	#$80,d0
00002758 323B 0000                  		move.w	Sine_Data(pc,d0.w),d1
0000275C 0440 0080                  		subi.w	#$80,d0
00002760 303B 0000                  		move.w	Sine_Data(pc,d0.w),d0
00002764 4E75                       		rts	
00002766                            ; End of function CalcSine
