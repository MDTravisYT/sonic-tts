00050DFE 6B00                       		bmi.s	@trackpsg			; Branch if PSG
00050E00 4EBA 0000                  		jsr	FMNoteOff(pc)
00050E04 0C03 0004                  		cmpi.b	#4,d3						; Is this FM4?
00050E08 6600                       		bne.s	@getfmpointer					; Branch if not
