000014A8 E448                       		lsr.w	#2,d0
000014AA 0040 4000                  		ori.w	#$4000,d0
000014AE 4840                       		swap	d0
000014B0 2880                       		move.l	d0,(a4)
000014B2 594C                       		subq.w	#4,a4
000014B4 2078 F680                  		movea.l	(v_plc_buffer).w,a0
000014B8 2678 F6E0                  		movea.l	(v_ptrnemcode).w,a3
000014BC 2038 F6E4                  		move.l	($FFFFF6E4).w,d0
000014C0 2238 F6E8                  		move.l	($FFFFF6E8).w,d1
000014C4 2438 F6EC                  		move.l	($FFFFF6EC).w,d2
000014C8 2A38 F6F0                  		move.l	($FFFFF6F0).w,d5
000014CC 2C38 F6F4                  		move.l	($FFFFF6F4).w,d6
