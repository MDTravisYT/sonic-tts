0001ADAE 6A00                       		bpl.s	AniArt_GHZ_Smallflower
0001ADB0                            
0001ADB0 11FC 000F F7B3             		move.b	#$F,(v_lani1_time).w
0001ADB6 43F9 0000 0000             		lea	(Art_GhzFlower1).l,a1 ;	load big flower	patterns
0001ADBC 1038 F7B2                  		move.b	(v_lani1_frame).w,d0
0001ADC0 5238 F7B2                  		addq.b	#1,(v_lani1_frame).w
0001ADC4 0240 0001                  		andi.w	#1,d0
0001ADC8 6700                       		beq.s	@isframe0
0001ADCA 43E9 0200                  		lea	@size*$20(a1),a1
0001ADCE                            
0001ADCE                            	@isframe0:
0001ADD8 323C 000F                  		move.w	#@size-1,d1
0001ADDC 6000 0000                  		bra.w	LoadTiles
