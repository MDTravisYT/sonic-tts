00071AEC                            ; ---------------------------------------------------------------------------
00071AEC                            ; Subroutine to update music more than once per frame
00071AEC                            ; (Called by horizontal & vert. interrupts)
00071AEC                            ; ---------------------------------------------------------------------------
00071AEC                            
00071AEC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00071AEC                            
00071AEC                            ; sub_71B4C:
00071AEC                            UpdateMusic:
00071AEC 33FC 0100 00A1 1100        		stopZ80
00071AF4 4E71                       		nop	
00071AF6 4E71                       		nop	
00071AF8 4E71                       		nop	
00071AFA                            ; loc_71B5A:
00071AFA                            @updateloop:
00071AFA 0839 0000 00A1 1100        		btst	#0,(z80_bus_request).l		; Is the z80 busy?
00071B02 66F6                       		bne.s	@updateloop			; If so, wait
00071B04                            
00071B04 0839 0007 00A0 1FFD        		btst	#7,(z80_dac_status).l		; Is DAC accepting new samples?
00071B0C 6700                       		beq.s	@driverinput			; Branch if yes
00071B0E 33FC 0000 00A1 1100        		startZ80
00071B16 4E71                       		nop	
00071B18 4E71                       		nop	
00071B1A 4E71                       		nop	
00071B1C 4E71                       		nop	
00071B1E 4E71                       		nop	
00071B20 60CA                       		bra.s	UpdateMusic
00071B22                            ; ===========================================================================
00071B22                            ; loc_71B82:
00071B22                            @driverinput:
00071B22 4DF9 00FF F000             		lea	(v_snddriver_ram&$FFFFFF).l,a6
00071B28 422E 000E                  		clr.b	f_voice_selector(a6)
00071B2C 4A2E 0003                  		tst.b	f_pausemusic(a6)		; is music paused?
00071B30 6600 0000                  		bne.w	PauseMusic			; if yes, branch
00071B34 532E 0001                  		subq.b	#1,v_main_tempo_timeout(a6)	; Has main tempo timer expired?
00071B38 6600                       		bne.s	@skipdelay
00071B3A 4EBA 0000                  		jsr	TempoWait(pc)
00071B3E                            ; loc_71B9E:
00071B3E                            @skipdelay:
00071B3E 102E 0004                  		move.b	v_fadeout_counter(a6),d0
00071B42 6700                       		beq.s	@skipfadeout
00071B44 4EBA 0000                  		jsr	DoFadeOut(pc)
00071B48                            ; loc_71BA8:
00071B48                            @skipfadeout:
00071B48 4A2E 0024                  		tst.b	f_fadein_flag(a6)
00071B4C 6700                       		beq.s	@skipfadein
00071B4E 4EBA 0000                  		jsr	DoFadeIn(pc)
00071B52                            ; loc_71BB2:
00071B52                            @skipfadein:
00071B52                            		; DANGER! The following line only checks v_soundqueue0 and v_soundqueue1, breaking v_soundqueue2.
00071B52 4A6E 000A                  		tst.w	v_soundqueue0(a6)	; is a music or sound queued for played?
00071B56 6700                       		beq.s	@nosndinput		; if not, branch
00071B58 4EBA 0000                  		jsr	CycleSoundQueue(pc)
00071B5C                            ; loc_71BBC:
00071B5C                            @nosndinput:
00071B5C 0C2E 0080 0009             		cmpi.b	#$80,v_sound_id(a6)	; is song queue set for silence (empty)?
00071B62 6700                       		beq.s	@nonewsound		; If yes, branch
00071B64 4EBA 0000                  		jsr	PlaySoundID(pc)
00071B68                            ; loc_71BC8:
00071B68                            @nonewsound:
00071B68 4BEE 0040                  		lea	v_music_dac_track(a6),a5
00071B6C 4A15                       		tst.b	(a5)			; Is DAC track playing? (TrackPlaybackControl)
00071B6E 6A00                       		bpl.s	@dacdone		; Branch if not
00071B70 4EBA 0000                  		jsr	DACUpdateTrack(pc)
00071B74                            ; loc_71BD4:
00071B74                            @dacdone:
00071B74 422E 0008                  		clr.b	f_updating_dac(a6)
00071B78 7E05                       		moveq	#((v_music_fm_tracks_end-v_music_fm_tracks)/TrackSz)-1,d7	; 6 FM tracks
00071B7A                            ; loc_71BDA:
00071B7A                            @bgmfmloop:
00071B7A DAFC 0030                  		adda.w	#TrackSz,a5
00071B7E 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00071B80 6A00                       		bpl.s	@bgmfmnext		; Branch if not
00071B82 4EBA 0000                  		jsr	FMUpdateTrack(pc)
00071B86                            ; loc_71BE6:
00071B86                            @bgmfmnext:
00071B86 51CF FFF2                  		dbf	d7,@bgmfmloop
00071B8A                            
00071B8A 7E02                       		moveq	#((v_music_psg_tracks_end-v_music_psg_tracks)/TrackSz)-1,d7 ; 3 PSG tracks
00071B8C                            ; loc_71BEC:
00071B8C                            @bgmpsgloop:
00071B8C DAFC 0030                  		adda.w	#TrackSz,a5
00071B90 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00071B92 6A00                       		bpl.s	@bgmpsgnext		; Branch if not
00071B94 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
00071B98                            ; loc_71BF8:
00071B98                            @bgmpsgnext:
00071B98 51CF FFF2                  		dbf	d7,@bgmpsgloop
00071B9C                            
00071B9C 1D7C 0080 000E             		move.b	#$80,f_voice_selector(a6)			; Now at SFX tracks
00071BA2 7E02                       		moveq	#((v_sfx_fm_tracks_end-v_sfx_fm_tracks)/TrackSz)-1,d7	; 3 FM tracks (SFX)
00071BA4                            ; loc_71C04:
00071BA4                            @sfxfmloop:
00071BA4 DAFC 0030                  		adda.w	#TrackSz,a5
00071BA8 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00071BAA 6A00                       		bpl.s	@sfxfmnext		; Branch if not
00071BAC 4EBA 0000                  		jsr	FMUpdateTrack(pc)
00071BB0                            ; loc_71C10:
00071BB0                            @sfxfmnext:
00071BB0 51CF FFF2                  		dbf	d7,@sfxfmloop
00071BB4                            
00071BB4 7E02                       		moveq	#((v_sfx_psg_tracks_end-v_sfx_psg_tracks)/TrackSz)-1,d7 ; 3 PSG tracks (SFX)
00071BB6                            ; loc_71C16:
00071BB6                            @sfxpsgloop:
00071BB6 DAFC 0030                  		adda.w	#TrackSz,a5
00071BBA 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00071BBC 6A00                       		bpl.s	@sfxpsgnext		; Branch of not
00071BBE 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
00071BC2                            ; loc_71C22:
00071BC2                            @sfxpsgnext:
00071BC2 51CF FFF2                  		dbf	d7,@sfxpsgloop
00071BC6                            		
00071BC6 1D7C 0040 000E             		move.b	#$40,f_voice_selector(a6) ; Now at special SFX tracks
00071BCC DAFC 0030                  		adda.w	#TrackSz,a5
00071BD0 4A15                       		tst.b	(a5)			; Is track playing? (TrackPlaybackControl)
00071BD2 6A00                       		bpl.s	@specfmdone		; Branch if not
00071BD4 4EBA 0000                  		jsr	FMUpdateTrack(pc)
00071BD8                            ; loc_71C38:
00071BD8                            @specfmdone:
00071BD8 DAFC 0030                  		adda.w	#TrackSz,a5
00071BDC 4A15                       		tst.b	(a5)			; Is track playing (TrackPlaybackControl)
00071BDE 6A00                       		bpl.s	DoStartZ80		; Branch if not
00071BE0 4EBA 0000                  		jsr	PSGUpdateTrack(pc)
00071BE4                            ; loc_71C44:
00071BE4                            DoStartZ80:
00071BE4 33FC 0000 00A1 1100        		startZ80
00071BEC 4E75                       		rts	
00071BEE                            ; End of function UpdateMusic
00071BEE                            
00071BEE                            
00071BEE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00071BEE                            
00071BEE                            ; sub_71C4E: UpdateDAC:
00071BEE                            DACUpdateTrack:
00071BEE 532D 000E                  		subq.b	#1,TrackDurationTimeout(a5)	; Has DAC sample timeout expired?
00071BF2 6600                       		bne.s	@locret				; Return if not
00071BF4 1D7C 0080 0008             		move.b	#$80,f_updating_dac(a6)		; Set flag to indicate this is the DAC
00071BFA                            ;DACDoNext:
00071BFA 286D 0004                  		movea.l	TrackDataPointer(a5),a4	; DAC track data pointer
00071BFE                            ; loc_71C5E:
00071BFE                            @sampleloop:
00071BFE 7A00                       		moveq	#0,d5
00071C00 1A1C                       		move.b	(a4)+,d5	; Get next SMPS unit
00071C02 0C05 00E0                  		cmpi.b	#$E0,d5		; Is it a coord. flag?
00071C06 6500                       		blo.s	@notcoord	; Branch if not
00071C08 4EBA 0000                  		jsr	CoordFlag(pc)
00071C0C 60F0                       		bra.s	@sampleloop
00071C0E                            ; ===========================================================================
00071C0E                            ; loc_71C6E:
00071C0E                            @notcoord:
00071C0E 4A05                       		tst.b	d5			; Is it a sample?
00071C10 6A00                       		bpl.s	@gotduration		; Branch if not (duration)
00071C12 1B45 0010                  		move.b	d5,TrackSavedDAC(a5)	; Store new sample
00071C16 1A1C                       		move.b	(a4)+,d5		; Get another byte
00071C18 6A00                       		bpl.s	@gotduration		; Branch if it is a duration
00071C1A 534C                       		subq.w	#1,a4			; Put byte back
00071C1C 1B6D 000F 000E             		move.b	TrackSavedDuration(a5),TrackDurationTimeout(a5) ; Use last duration
00071C22 6000                       		bra.s	@gotsampleduration
00071C24                            ; ===========================================================================
00071C24                            ; loc_71C84:
00071C24                            @gotduration:
00071C24 4EBA 0000                  		jsr	SetDuration(pc)
00071C28                            ; loc_71C88:
00071C28                            @gotsampleduration:
00071C28 2B4C 0004                  		move.l	a4,TrackDataPointer(a5) ; Save pointer
00071C2C 0815 0002                  		btst	#2,(a5)			; Is track being overridden? (TrackPlaybackControl)
00071C30 6600                       		bne.s	@locret			; Return if yes
00071C32 7000                       		moveq	#0,d0
00071C34 102D 0010                  		move.b	TrackSavedDAC(a5),d0	; Get sample
00071C38 0C00 0080                  		cmpi.b	#$80,d0			; Is it a rest?
00071C3C 6700                       		beq.s	@locret			; Return if yes
00071C3E 0800 0003                  		btst	#3,d0			; Is bit 3 set (samples between $88-$8F)?
00071C42 6600                       		bne.s	@timpani		; Various timpani
00071C44 13C0 00A0 1FFF             		move.b	d0,(z80_dac_sample).l
00071C4A                            ; locret_71CAA:
00071C4A                            @locret:
00071C4A 4E75                       		rts	
00071C4C                            ; ===========================================================================
00071C4C                            ; loc_71CAC:
00071C4C                            @timpani:
00071C4C 0400 0088                  		subi.b	#$88,d0		; Convert into an index
00071C50 103B 0000                  		move.b	DAC_sample_rate(pc,d0.w),d0
00071C54                            		; Warning: this affects the raw pitch of sample $83, meaning it will
00071C54                            		; use this value from then on.
00071C54 13C0 00A0 00EA             		move.b	d0,(z80_dac3_pitch).l
00071C5A 13FC 0083 00A0 1FFF        		move.b	#$83,(z80_dac_sample).l	; Use timpani
00071C62 4E75                       		rts	
00071C64                            ; End of function DACUpdateTrack
00071C64                            
00071C64                            ; ===========================================================================
00071C64                            ; Note: this only defines rates for samples $88-$8D, meaning $8E-$8F are invalid.
00071C64                            ; Also, $8C-$8D are so slow you may want to skip them.
00071C64                            ; byte_71CC4:
