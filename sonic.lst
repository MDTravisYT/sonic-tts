000062DC                            ; d5 = Relative X coordinate
000062DC                            ; Returns VDP command in d0
000062DC                            Calc_VRAM_Pos:
000062DC D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate
000062E0 DA53                       		add.w	(a3),d5		; Add camera X coordinate
000062E2                            		; Floor the coordinates to the nearest pair of tiles (the size of a block).
000062E2                            		; Also note that this wraps the value to the size of the plane:
000062E2                            		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
000062E2 0244 00F0                  		andi.w	#$F0,d4
000062E6 0245 01F0                  		andi.w	#$1F0,d5
