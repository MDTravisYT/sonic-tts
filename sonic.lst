00001516                            
00001516                            
00001516                            QuickPLC:
00001516 43F9 0000 0000             		lea	(ArtLoadCues).l,a1 ; load the PLC index
0000151C D040                       		add.w	d0,d0
0000151E 3031 0000                  		move.w	(a1,d0.w),d0
00001522 43F1 0000                  		lea	(a1,d0.w),a1
00001526 3219                       		move.w	(a1)+,d1	; get length of PLC
00001528                            
00001528                            	Qplc_Loop:
00001528 2059                       		movea.l	(a1)+,a0	; get art pointer
0000152A 7000                       		moveq	#0,d0
0000152C 3019                       		move.w	(a1)+,d0	; get VRAM address
0000152E E588                       		lsl.l	#2,d0
00001530 E448                       		lsr.w	#2,d0
00001532 0040 4000                  		ori.w	#$4000,d0
00001536 4840                       		swap	d0
00001538 23C0 00C0 0004             		move.l	d0,(vdp_control_port).l ; converted VRAM address to VDP format
0000153E 6100 FD2A                  		bsr.w	NemDec		; decompress
