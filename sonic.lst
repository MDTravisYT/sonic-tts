00006BD6                            
00006BD6                            ; Gets address of block at a certain coordinate
00006BD6                            ; Parameters:
00006BD6                            ; a4 = Pointer to level layout
00006BD6                            ; d4 = Relative Y coordinate
00006BD6                            ; d5 = Relative X coordinate
00006BD6                            ; Returns:
00006BD6                            ; a0 = Address of block metadata
00006BD6                            ; a1 = Address of block
00006BD6                            ; DrawBlocks:
00006BD6                            GetBlockData:
00006BD6 43F8 B000                  		lea	(v_16x16).w,a1
00006BDA D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate to relative coordinate
00006BDE DA53                       		add.w	(a3),d5		; Add camera X coordinate to relative coordinate
00006BE0                            		; Turn Y coordinate into index into level layout
00006BE0 3604                       		move.w	d4,d3
00006BE2 E24B                       		lsr.w	#1,d3
00006BE4 0243 0380                  		andi.w	#$380,d3
00006BE8                            		; Turn X coordinate into index into level layout
00006BE8 E64D                       		lsr.w	#3,d5
00006BEA 3005                       		move.w	d5,d0
00006BEC EA48                       		lsr.w	#5,d0
00006BEE 0240 007F                  		andi.w	#$7F,d0
00006BF2                            		; Get chunk from level layout
00006BF2 D043                       		add.w	d3,d0
00006BF4 76FF                       		moveq	#-1,d3
00006BF6 1634 0000                  		move.b	(a4,d0.w),d3
00006BFA 6700                       		beq.s	locret_6C1E	; If chunk 00, just return a pointer to the first block (expected to be empty)
00006BFC                            		; Turn chunk ID into index into chunk table
00006BFC 5303                       		subq.b	#1,d3
00006BFE 0243 007F                  		andi.w	#$7F,d3
00006C02 EE5B                       		ror.w	#7,d3
00006C04                            		; Turn Y coordinate into index into chunk
00006C04 D844                       		add.w	d4,d4
00006C06 0244 01E0                  		andi.w	#$1E0,d4
00006C0A                            		; Turn X coordinate into index into chunk
00006C0A 0245 001E                  		andi.w	#$1E,d5
00006C0E                            		; Get block metadata from chunk
00006C0E D644                       		add.w	d4,d3
00006C10 D645                       		add.w	d5,d3
00006C12 2043                       		movea.l	d3,a0
00006C14 3610                       		move.w	(a0),d3
00006C16                            		; Turn block ID into address
00006C16 0243 03FF                  		andi.w	#$3FF,d3
00006C1A E74B                       		lsl.w	#3,d3
00006C1C D2C3                       		adda.w	d3,a1
00006C1E                            
00006C1E                            locret_6C1E:
00006C1E 4E75                       		rts	
