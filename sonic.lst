0000EBB4                            ; Solid	object subroutine (includes spikes, blocks, rocks etc)
0000EBB4                            ;
0000EBB4                            ; input:
0000EBB4                            ;	d1 = width
0000EBB4                            ;	d2 = height / 2 (when jumping)
0000EBB4                            ;	d3 = height / 2 (when walking)
0000EBB4                            ;	d4 = x-axis position
0000EBB4                            ; ---------------------------------------------------------------------------
0000EBB4                            
0000EBB4                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
