000013A8                            		include	"_inc\PauseGame.asm"
000013A8                            ; ---------------------------------------------------------------------------
000013A8                            ; Subroutine to	pause the game
000013A8                            ; ---------------------------------------------------------------------------
000013A8                            
000013A8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000013A8                            
000013A8                            
000013A8                            PauseGame:
000013A8 4E71                       		nop	
000013AA 4A38 FE12                  		tst.b	(v_lives).w	; do you have any lives	left?
000013AE 6700                       		beq.s	Unpause		; if not, branch
000013B0 4A78 F63A                  		tst.w	(f_pause).w	; is game already paused?
000013B4 6600                       		bne.s	Pause_StopGame	; if yes, branch
000013B6 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
000013BC 6700                       		beq.s	Pause_DoNothing	; if not, branch
000013BE                            
000013BE                            Pause_StopGame:
000013BE 31FC 0001 F63A             		move.w	#1,(f_pause).w	; freeze time
000013C4 11FC 0001 F003             		move.b	#1,(v_snddriver_ram+f_pausemusic).w ; pause music
000013CA                            
000013CA                            Pause_Loop:
000013CA 11FC 0010 F62A             		move.b	#$10,(v_vbla_routine).w
000013D0 6100 0000                  		bsr.w	WaitForVBla
000013D4 4A38 FFE1                  		tst.b	(f_slomocheat).w ; is slow-motion cheat on?
000013D8 6700                       		beq.s	Pause_ChkStart	; if not, branch
000013DA 0838 0006 F605             		btst	#bitA,(v_jpadpress1).w ; is button A pressed?
000013E0 6700                       		beq.s	Pause_ChkBC	; if not, branch
000013E2 11FC 0000 F600             		move.b	#id_Title,(v_gamemode).w ; set game mode to 4 (title screen)
000013E8 4E71                       		nop	
000013EA 6000                       		bra.s	Pause_EndMusic
000013EC                            ; ===========================================================================
000013EC                            
000013EC                            Pause_ChkBC:
000013EC 0838 0004 F604             		btst	#bitB,(v_jpadhold1).w ; is button B pressed?
000013F2 6600                       		bne.s	Pause_SlowMo	; if yes, branch
000013F4 0838 0005 F605             		btst	#bitC,(v_jpadpress1).w ; is button C pressed?
000013FA 6600                       		bne.s	Pause_SlowMo	; if yes, branch
000013FC                            
000013FC                            Pause_ChkStart:
000013FC 0838 0007 F605             		btst	#bitStart,(v_jpadpress1).w ; is Start button pressed?
00001402 67C6                       		beq.s	Pause_Loop	; if not, branch
00001404                            
00001404                            Pause_EndMusic:
00001404 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; unpause the music
0000140A                            
0000140A                            Unpause:
0000140A 31FC 0000 F63A             		move.w	#0,(f_pause).w	; unpause the game
00001410                            
00001410                            Pause_DoNothing:
00001410 4E75                       		rts	
00001412                            ; ===========================================================================
00001412                            
00001412                            Pause_SlowMo:
00001412 31FC 0001 F63A             		move.w	#1,(f_pause).w
00001418 11FC 0080 F003             		move.b	#$80,(v_snddriver_ram+f_pausemusic).w	; Unpause the music
0000141E 4E75                       		rts	
00001420                            ; End of function PauseGame
00001420                            ; End of function PauseGame
