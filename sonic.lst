00053C7A                            ; ===========================================================================
00053C7A                            ; ---------------------------------------------------------------------------
00053C7A                            ; Unused RAM addresses for FM and PSG channel variables used by the Special SFX
00053C7A                            ; ---------------------------------------------------------------------------
00053C7A                            ; The first block would have been used for overriding the music tracks
00053C7A                            ; as they have a lower priority, just as they are in Sound_PlaySFX
00053C7A                            ; The third block would be used to set up the Special SFX
00053C7A                            ; The second block, however, is for the SFX tracks, which have a higher priority
00053C7A                            ; and would be checked for if they're currently playing
00053C7A                            ; If they are, then the third block would be used again, this time to mark
00053C7A                            ; the new tracks as 'currently playing'
00053C7A                            
00053C7A                            ; These were actually used in Moonwalker's driver (and other SMPS 68k Type 1a drivers)
00053C7A                            
00053C7A                            ; BGMFM4PSG3RAM:
00053C7A                            ;SpecSFX_BGMChannelRAM:
00053C7A 00FF F100                  		dc.l (v_snddriver_ram+v_music_fm4_track)&$FFFFFF
00053C7E 00FF F1F0                  		dc.l (v_snddriver_ram+v_music_psg3_track)&$FFFFFF
00053C82                            ; SFXFM4PSG3RAM:
00053C82                            ;SpecSFX_SFXChannelRAM:
00053C82 00FF F250                  		dc.l (v_snddriver_ram+v_sfx_fm4_track)&$FFFFFF
00053C86 00FF F310                  		dc.l (v_snddriver_ram+v_sfx_psg3_track)&$FFFFFF
00053C8A                            ; SpecialSFXFM4PSG3RAM:
00053C8A                            ;SpecSFX_SpecSFXChannelRAM:
00053C8A 00FF F340                  		dc.l (v_snddriver_ram+v_spcsfx_fm4_track)&$FFFFFF
00053C8E 00FF F370                  		dc.l (v_snddriver_ram+v_spcsfx_psg3_track)&$FFFFFF
00053C92                            
00053C92                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
