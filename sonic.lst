00054002 66F4                       		bne.s	@waitloop	; Loop if so
00054004                            
00054004 13C1 00A0 4001             		move.b	d1,(ym2612_d0).l
0005400A 4E75                       		rts	
0005400C                            ; End of function WriteFMI
