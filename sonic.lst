0000EBE2                            SolidObject:
0000EBE2 4A28 0025                  		tst.b	obSolid(a0)	; is Sonic standing on the object?
0000EBE6 6700 0000                  		beq.w	Solid_ChkEnter	; if not, branch
0000EBEA 3401                       		move.w	d1,d2
0000EBEC D442                       		add.w	d2,d2
0000EBEE 43F8 D000                  		lea	(v_player).w,a1
0000EBF2 0829 0001 0022             		btst	#1,obStatus(a1)	; is Sonic in the air?
0000EBF8 6600                       		bne.s	@leave		; if yes, branch
0000EBFA 3029 0008                  		move.w	obX(a1),d0
0000EBFE 9068 0008                  		sub.w	obX(a0),d0
0000EC02 D041                       		add.w	d1,d0
0000EC04 6B00                       		bmi.s	@leave		; if Sonic moves off the left, branch
0000EC06 B042                       		cmp.w	d2,d0		; has Sonic moved off the right?
0000EC08 6500                       		bcs.s	@stand		; if not, branch
0000EC0A                            
0000EC0A                            	@leave:
