00019D6A                            ; Hurting Sonic	subroutine
00019D6A                            ; ---------------------------------------------------------------------------
00019D6A                            
00019D6A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00019D6A                            
00019D6A                            
00019D6A                            HurtSonic:
00019D6A 4A38 FE2C                  		tst.b	(v_shield).w	; does Sonic have a shield?
00019D6E 6600                       		bne.s	@hasshield	; if yes, branch
00019D70 4A78 FE20                  		tst.w	(v_rings).w	; does Sonic have any rings?
00019D74 6700 0000                  		beq.w	@norings	; if not, branch
00019D78                            
00019D78 4EB9 0000 CC96             		jsr	(FindFreeObj).l
00019D7E 6600                       		bne.s	@hasshield
00019D80 137C 0037 0000             		move.b	#id_RingLoss,0(a1) ; load bouncing multi rings object
00019D86 3368 0008 0008             		move.w	obX(a0),obX(a1)
00019D8C 3368 000C 000C             		move.w	obY(a0),obY(a1)
00019D92                            
00019D92                            	@hasshield:
