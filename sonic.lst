00008754                            ; Subroutine to	check if Sonic touches the object
00008754                            ; ---------------------------------------------------------------------------
00008754                            
00008754                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00008754                            
00008754                            
00008754                            Swi_ChkTouch:
00008754 43F8 D000                  		lea	(v_player).w,a1
00008758 3029 0008                  		move.w	obX(a1),d0
0000875C 9068 0008                  		sub.w	obX(a0),d0
00008760 D041                       		add.w	d1,d0
00008762 6B00                       		bmi.s	Swi_NoTouch
00008764 D241                       		add.w	d1,d1
00008766 B041                       		cmp.w	d1,d0
00008768 6400                       		bcc.s	Swi_NoTouch
0000876A 3429 000C                  		move.w	obY(a1),d2
0000876E 1229 0016                  		move.b	obHeight(a1),d1
00008772 4881                       		ext.w	d1
00008774 D242                       		add.w	d2,d1
00008776 3028 000C                  		move.w	obY(a0),d0
0000877A 0440 0010                  		subi.w	#$10,d0
0000877E 9041                       		sub.w	d1,d0
00008780 6200                       		bhi.s	Swi_NoTouch
00008782 0C40 FFF0                  		cmpi.w	#-$10,d0
00008786 6500                       		bcs.s	Swi_NoTouch
00008788 70FF                       		moveq	#-1,d0		; Sonic has touched it
0000878A 4E75                       		rts	
