00006C20                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00006C20                            
00006C20                            ; Produces a VRAM plane access command from coordinates
00006C20                            ; Parameters:
00006C20                            ; d4 = Relative Y coordinate
00006C20                            ; d5 = Relative X coordinate
00006C20                            ; Returns VDP command in d0
00006C20                            Calc_VRAM_Pos:
00006C20 D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate
00006C24 DA53                       		add.w	(a3),d5		; Add camera X coordinate
00006C26                            		; Floor the coordinates to the nearest pair of tiles (the size of a block).
00006C26                            		; Also note that this wraps the value to the size of the plane:
00006C26                            		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
00006C26 0244 00F0                  		andi.w	#$F0,d4
00006C2A 0245 01F0                  		andi.w	#$1F0,d5
00006C2E                            		; Transform the adjusted coordinates into a VDP command
00006C2E E94C                       		lsl.w	#4,d4
00006C30 E44D                       		lsr.w	#2,d5
00006C32 D845                       		add.w	d5,d4
00006C34 7003                       		moveq	#3,d0	; Highest bits of plane VRAM address
00006C36 4840                       		swap	d0
00006C38 3004                       		move.w	d4,d0
00006C3A 4E75                       		rts	
00006C3C                            ; End of function Calc_VRAM_Pos
00006C3C                            
00006C3C                            
00006C3C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00006C3C                            ; not used
00006C3C                            
00006C3C                            ; This is just like Calc_VRAM_Pos, but seemingly for an earlier
00006C3C                            ; VRAM layout: the only difference is the high bits of the
00006C3C                            ; plane's VRAM address, which are 10 instead of 11.
00006C3C                            ; Both the foreground and background are at $C000 and $E000
00006C3C                            ; respectively, so this one starting at $8000 makes no sense.
00006C3C                            ; sub_6C3C:
00006C3C                            Calc_VRAM_Pos_Unknown:
00006C3C D86B 0004                  		add.w	4(a3),d4
00006C40 DA53                       		add.w	(a3),d5
00006C42 0244 00F0                  		andi.w	#$F0,d4
00006C46 0245 01F0                  		andi.w	#$1F0,d5
00006C4A E94C                       		lsl.w	#4,d4
00006C4C E44D                       		lsr.w	#2,d5
00006C4E D845                       		add.w	d5,d4
00006C50 7002                       		moveq	#2,d0
00006C52 4840                       		swap	d0
00006C54 3004                       		move.w	d4,d0
00006C56 4E75                       		rts	
00006C58                            ; End of function Calc_VRAM_Pos_Unknown
