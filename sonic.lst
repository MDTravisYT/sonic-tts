00005FB8 7AF0                       		moveq	#-16,d5
00005FBA 6100 0000                  		bsr.w	Calc_VRAM_Pos
00005FBE 383C 00E0                  		move.w	#224,d4
00005FC2 7AF0                       		moveq	#-16,d5
00005FC4 6100 0000                  		bsr.w	DrawBlocks_LR
