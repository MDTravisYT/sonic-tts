00002CAE 0EC0                       @cycle:     dc.w    $EC0
00002CB0 0EA0 0E80 0E60 0E40 0E20+          dc.w    $EA0, $E80, $E60, $E40, $E20, $E00
00002CBC 0C00                               dc.w    $C00
00002CBE 0E00 0E20 0E40 0E60 0E80+          dc.w    $E00, $E20, $E40, $E60, $E80, $EA0
00002CCA                            @cycle_end: ; remaining half copy before loop. Making it CPU-friendly
00002CCA 0EC0                               dc.w    $EC0
00002CCC 0EA0 0E80 0E60 0E40 0E20+          dc.w    $EA0, $E80, $E60, $E40, $E20, $E00
00002CD8 0C00                               dc.w    $C00
00002CDA =0000001C                  @cycle_size:=   @cycle_end-@cycle
