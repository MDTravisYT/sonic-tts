0000CAA0 6B00                       		bmi.s	@offscreen
0000CAA2 0C40 0140                  		cmpi.w	#320,d0		; is object on the screen?
0000CAA6 6C00                       		bge.s	@offscreen	; if not, branch
0000CAA8                            
0000CAA8 3228 000C                  		move.w	obY(a0),d1	; get object y-position
0000CAAC 9278 F704                  		sub.w	(v_screenposy).w,d1 ; subtract screen y-position
0000CAB0 6B00                       		bmi.s	@offscreen
0000CAB2 0C41 00E0                  		cmpi.w	#224,d1		; is object on the screen?
0000CAB6 6C00                       		bge.s	@offscreen	; if not, branch
