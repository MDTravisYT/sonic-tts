0000AB5A 117C 0010 0019             		move.b	#$10,obActWid(a0)
0000AB60 317C F900 0012             		move.w	#-$700,obVelY(a0) ; set vertical speed
0000AB66 3168 000C 0030             		move.w	obY(a0),chop_origY(a0) ; save original position
0000AB6C                            
0000AB6C                            Chop_ChgSpeed:	; Routine 2
0000AB6C 43F9 0000 0000             		lea	(Ani_Chop).l,a1
0000AB72 6100 FBA4                  		bsr.w	AnimateSprite
0000AB76 6100 0000                  		bsr.w	SpeedToPos
0000AB7A 0668 0018 0012             		addi.w	#$18,obVelY(a0)	; reduce speed
0000AB80 3028 0030                  		move.w	chop_origY(a0),d0
0000AB84 B068 000C                  		cmp.w	obY(a0),d0	; has Chopper returned to its original position?
0000AB88 6400                       		bcc.s	@chganimation	; if not, branch
0000AB8A 3140 000C                  		move.w	d0,obY(a0)
0000AB8E 317C F900 0012             		move.w	#-$700,obVelY(a0) ; set vertical speed
0000AB94                            
