00013CC4 45F9 0000 0000             		lea	(CollArray1).l,a2
00013CCA 1032 1000                  		move.b	(a2,d1.w),d0
00013CCE 4880                       		ext.w	d0
00013CD0 BD44                       		eor.w	d6,d4
