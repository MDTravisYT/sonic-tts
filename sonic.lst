00006A24                            ; ===========================================================================
00006A24                            ; unused garbage
00006A24                            ; This is interesting. It draws a block, but not before
00006A24                            ; incrementing its palette lines by 1. This may have been
00006A24                            ; a debug function to discolour mirrored tiles, to test
00006A24                            ; if they're loading properly.
00006A24 4E75                       		rts	
00006A26 2A80                       		move.l	d0,(a5)
00006A28 3A3C 2000                  		move.w	#$2000,d5
00006A2C 3819                       		move.w	(a1)+,d4
00006A2E D845                       		add.w	d5,d4
00006A30 3C84                       		move.w	d4,(a6)
00006A32 3819                       		move.w	(a1)+,d4
00006A34 D845                       		add.w	d5,d4
00006A36 3C84                       		move.w	d4,(a6)
00006A38 D087                       		add.l	d7,d0
00006A3A 2A80                       		move.l	d0,(a5)
00006A3C 3819                       		move.w	(a1)+,d4
00006A3E D845                       		add.w	d5,d4
00006A40 3C84                       		move.w	d4,(a6)
00006A42 3819                       		move.w	(a1)+,d4
00006A44 D845                       		add.w	d5,d4
00006A46 3C84                       		move.w	d4,(a6)
00006A48 4E75                       		rts
00006A4A                            
00006A4A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00006A4A                            
00006A4A                            ; Gets address of block at a certain coordinate
00006A4A                            ; Parameters:
00006A4A                            ; a4 = Pointer to level layout
00006A4A                            ; d4 = Relative Y coordinate
00006A4A                            ; d5 = Relative X coordinate
00006A4A                            ; Returns:
00006A4A                            ; a0 = Address of block metadata
00006A4A                            ; a1 = Address of block
00006A4A                            ; DrawBlocks:
00006A4A                            GetBlockData:
00006A4A 43F8 B000                  		lea	(v_16x16).w,a1
00006A4E D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate to relative coordinate
00006A52 DA53                       		add.w	(a3),d5		; Add camera X coordinate to relative coordinate
00006A54                            		; Turn Y coordinate into index into level layout
00006A54 3604                       		move.w	d4,d3
00006A56 E24B                       		lsr.w	#1,d3
00006A58 0243 0380                  		andi.w	#$380,d3
00006A5C                            		; Turn X coordinate into index into level layout
00006A5C E64D                       		lsr.w	#3,d5
00006A5E 3005                       		move.w	d5,d0
00006A60 EA48                       		lsr.w	#5,d0
00006A62 0240 007F                  		andi.w	#$7F,d0
00006A66                            		; Get chunk from level layout
00006A66 D043                       		add.w	d3,d0
00006A68 76FF                       		moveq	#-1,d3
00006A6A 1634 0000                  		move.b	(a4,d0.w),d3
00006A6E 6700                       		beq.s	locret_6C1E	; If chunk 00, just return a pointer to the first block (expected to be empty)
00006A70                            		; Turn chunk ID into index into chunk table
00006A70 5303                       		subq.b	#1,d3
00006A72 0243 007F                  		andi.w	#$7F,d3
00006A76 EE5B                       		ror.w	#7,d3
00006A78                            		; Turn Y coordinate into index into chunk
00006A78 D844                       		add.w	d4,d4
00006A7A 0244 01E0                  		andi.w	#$1E0,d4
00006A7E                            		; Turn X coordinate into index into chunk
00006A7E 0245 001E                  		andi.w	#$1E,d5
00006A82                            		; Get block metadata from chunk
00006A82 D644                       		add.w	d4,d3
00006A84 D645                       		add.w	d5,d3
00006A86 2043                       		movea.l	d3,a0
00006A88 3610                       		move.w	(a0),d3
00006A8A                            		; Turn block ID into address
00006A8A 0243 03FF                  		andi.w	#$3FF,d3
00006A8E E74B                       		lsl.w	#3,d3
00006A90 D2C3                       		adda.w	d3,a1
00006A92                            
00006A92                            locret_6C1E:
00006A92 4E75                       		rts	
00006A94                            ; End of function GetBlockData
00006A94                            
00006A94                            
00006A94                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00006A94                            
00006A94                            ; Produces a VRAM plane access command from coordinates
00006A94                            ; Parameters:
00006A94                            ; d4 = Relative Y coordinate
00006A94                            ; d5 = Relative X coordinate
00006A94                            ; Returns VDP command in d0
00006A94                            Calc_VRAM_Pos:
00006A94 D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate
00006A98 DA53                       		add.w	(a3),d5		; Add camera X coordinate
00006A9A                            		; Floor the coordinates to the nearest pair of tiles (the size of a block).
00006A9A                            		; Also note that this wraps the value to the size of the plane:
00006A9A                            		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
00006A9A 0244 00F0                  		andi.w	#$F0,d4
00006A9E 0245 01F0                  		andi.w	#$1F0,d5
00006AA2                            		; Transform the adjusted coordinates into a VDP command
00006AA2 E94C                       		lsl.w	#4,d4
00006AA4 E44D                       		lsr.w	#2,d5
00006AA6 D845                       		add.w	d5,d4
00006AA8 7003                       		moveq	#3,d0	; Highest bits of plane VRAM address
00006AAA 4840                       		swap	d0
00006AAC 3004                       		move.w	d4,d0
00006AAE 4E75                       		rts	
00006AB0                            ; End of function Calc_VRAM_Pos
00006AB0                            
00006AB0                            
00006AB0                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00006AB0                            ; not used
00006AB0                            
00006AB0                            ; This is just like Calc_VRAM_Pos, but seemingly for an earlier
00006AB0                            ; VRAM layout: the only difference is the high bits of the
00006AB0                            ; plane's VRAM address, which are 10 instead of 11.
00006AB0                            ; Both the foreground and background are at $C000 and $E000
00006AB0                            ; respectively, so this one starting at $8000 makes no sense.
00006AB0                            ; sub_6C3C:
00006AB0                            Calc_VRAM_Pos_Unknown:
00006AB0 D86B 0004                  		add.w	4(a3),d4
00006AB4 DA53                       		add.w	(a3),d5
00006AB6 0244 00F0                  		andi.w	#$F0,d4
00006ABA 0245 01F0                  		andi.w	#$1F0,d5
00006ABE E94C                       		lsl.w	#4,d4
00006AC0 E44D                       		lsr.w	#2,d5
00006AC2 D845                       		add.w	d5,d4
00006AC4 7002                       		moveq	#2,d0
00006AC6 4840                       		swap	d0
00006AC8 3004                       		move.w	d4,d0
00006ACA 4E75                       		rts	
00006ACC                            ; End of function Calc_VRAM_Pos_Unknown
