000013DC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000013DC                            ; Queue pattern load requests, but clear the PLQ first
000013DC                            
000013DC                            ; ARGUMENTS
000013DC                            ; d0 = index of PLC list (see ArtLoadCues)
000013DC                            
000013DC                            ; NOTICE: This subroutine does not check for buffer overruns. The programmer
000013DC                            ;	  (or hacker) is responsible for making sure that no more than
000013DC                            ;	  16 load requests are copied into the buffer.
000013DC                            ;	  _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
000013DC                            ;         (or if you change the size of Plc_Buffer, the limit becomes (Plc_Buffer_Only_End-Plc_Buffer)/6)
000013DC                            
000013DC                            ; LoadPLC2:
000013DC                            NewPLC:
000013DC 48E7 0060                  		movem.l	a1-a2,-(sp)
000013E0 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
000013E6 D040                       		add.w	d0,d0
000013E8 3031 0000                  		move.w	(a1,d0.w),d0
000013EC 43F1 0000                  		lea	(a1,d0.w),a1	; jump to relevant PLC
000013F0 6100                       		bsr.s	ClearPLC	; erase any data in PLC buffer space
000013F2 45F8 F680                  		lea	(v_plc_buffer).w,a2
000013F6 3019                       		move.w	(a1)+,d0	; get length of PLC
000013F8 6B00                       		bmi.s	@skip		; if it's negative, skip the next loop
000013FA                            
000013FA                            	@loop:
000013FA 24D9                       		move.l	(a1)+,(a2)+
000013FC 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
000013FE 51C8 FFFA                  		dbf	d0,@loop		; repeat for length of PLC
00001402                            
00001402                            	@skip:
00001402 4CDF 0600                  		movem.l	(sp)+,a1-a2
00001406 4E75                       		rts	
00001408                            ; End of function NewPLC
00001408                            
00001408                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
