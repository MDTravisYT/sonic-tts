000013E8                            ; ---------------------------------------------------------------------------
000013E8                            ; Subroutine to	copy a tile map from RAM to VRAM namespace
000013E8                            
000013E8                            ; input:
000013E8                            ;	a1 = tile map address
000013E8                            ;	d0 = VRAM address
000013E8                            ;	d1 = width (cells)
000013E8                            ;	d2 = height (cells)
000013E8                            ; ---------------------------------------------------------------------------
000013E8                            
000013E8                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000013E8                            
000013E8                            
000013E8                            TilemapToVRAM:
000013E8 4DF9 00C0 0000             		lea	(vdp_data_port).l,a6
000013EE 283C 0080 0000             		move.l	#$800000,d4
000013F4                            
000013F4                            	Tilemap_Line:
000013F4 2D40 0004                  		move.l	d0,4(a6)	; move d0 to VDP_control_port
000013F8 3601                       		move.w	d1,d3
000013FA                            
000013FA                            	Tilemap_Cell:
000013FA 3C99                       		move.w	(a1)+,(a6)	; write value to namespace
000013FC 51CB FFFC                  		dbf	d3,Tilemap_Cell	; next tile
00001400 D084                       		add.l	d4,d0		; goto next line
00001402 51CA FFF0                  		dbf	d2,Tilemap_Line	; next line
00001406 4E75                       		rts	
00001408                            ; End of function TilemapToVRAM
00001408                            
00001408                            		include	"_inc\Nemesis Decompression.asm"
00001408                            ; ---------------------------------------------------------------------------
00001408                            ; Nemesis decompression	subroutine, decompresses art directly to VRAM
00001408                            ; Inputs:
00001408                            ; a0 = art address
00001408                            
00001408                            ; For format explanation see http://info.sonicretro.org/Nemesis_compression
00001408                            ; ---------------------------------------------------------------------------
00001408                            
00001408                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
00001408                            
00001408                            ; Nemesis decompression to VRAM
00001408                            NemDec:
00001408 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
0000140C 47F9 0000 0000             		lea	(NemPCD_WriteRowToVDP).l,a3	; write all data to the same location
00001412 49F9 00C0 0000             		lea	(vdp_data_port).l,a4	; specifically, to the VDP data port
00001418 6000                       		bra.s	NemDecMain
0000141A                            
0000141A                            ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
0000141A                            
0000141A                            ; Nemesis decompression subroutine, decompresses art to RAM
0000141A                            ; Inputs:
0000141A                            ; a0 = art address
0000141A                            ; a4 = destination RAM address
0000141A                            NemDecToRAM:
0000141A 48E7 FFDC                  		movem.l	d0-a1/a3-a5,-(sp)
0000141E 47F9 0000 0000             		lea	(NemPCD_WriteRowToRAM).l,a3 ; advance to the next location after each write
00001424                            
00001424                            NemDecMain:
00001424 43F8 AA00                  		lea	(v_ngfx_buffer).w,a1
00001428 3418                       		move.w	(a0)+,d2	; get number of patterns
0000142A E34A                       		lsl.w	#1,d2
0000142C 6400                       		bcc.s	loc_146A	; branch if the sign bit isn't set
0000142E D6FC 0000                  		adda.w	#NemPCD_WriteRowToVDP_XOR-NemPCD_WriteRowToVDP,a3	; otherwise the file uses XOR mode
00001432                            
00001432                            loc_146A:
00001432 E54A                       		lsl.w	#2,d2	; get number of 8-pixel rows in the uncompressed data
00001434 3A42                       		movea.w	d2,a5	; and store it in a5 because there aren't any spare data registers
00001436 7608                       		moveq	#8,d3	; 8 pixels in a pattern row
00001438 7400                       		moveq	#0,d2
0000143A 7800                       		moveq	#0,d4
0000143C 6100 0000                  		bsr.w	NemDec_BuildCodeTable
00001440 1A18                       		move.b	(a0)+,d5	; get first byte of compressed data
00001442 E145                       		asl.w	#8,d5	; shift up by a byte
00001444 1A18                       		move.b	(a0)+,d5	; get second byte of compressed data
00001446 3C3C 0010                  		move.w	#$10,d6	; set initial shift value
0000144A 6100                       		bsr.s	NemDec_ProcessCompressedData
0000144C 4CDF 3BFF                  		movem.l	(sp)+,d0-a1/a3-a5
00001450 4E75                       		rts	
00001452                            ; End of function NemDec
00001452                            
00001452                            ; ---------------------------------------------------------------------------
00001452                            ; Part of the Nemesis decompressor, processes the actual compressed data
00001452                            ; ---------------------------------------------------------------------------
00001452                            
00001452                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001452                            
00001452                            
00001452                            NemDec_ProcessCompressedData:
00001452 3E06                       		move.w	d6,d7
00001454 5147                       		subq.w	#8,d7	; get shift value
00001456 3205                       		move.w	d5,d1
00001458 EE69                       		lsr.w	d7,d1	; shift so that high bit of the code is in bit position 7
0000145A 0C01 00FC                  		cmpi.b	#%11111100,d1	; are the high 6 bits set?
0000145E 6400                       		bcc.s	NemPCD_InlineData	; if they are, it signifies inline data
00001460 0241 00FF                  		andi.w	#$FF,d1
00001464 D241                       		add.w	d1,d1
00001466 1031 1000                  		move.b	(a1,d1.w),d0	; get the length of the code in bits
0000146A 4880                       		ext.w	d0
0000146C 9C40                       		sub.w	d0,d6	; subtract from shift value so that the next code is read next time around
0000146E 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
00001472 6400                       		bcc.s	loc_14B2	; if not, branch
00001474 5046                       		addq.w	#8,d6
00001476 E145                       		asl.w	#8,d5
00001478 1A18                       		move.b	(a0)+,d5	; read next byte
0000147A                            
0000147A                            loc_14B2:
0000147A 1231 1001                  		move.b	1(a1,d1.w),d1
0000147E 3001                       		move.w	d1,d0
00001480 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
00001484 0240 00F0                  		andi.w	#$F0,d0
00001488                            
00001488                            NemPCD_ProcessCompressedData:
00001488 E848                       		lsr.w	#4,d0	; get repeat count
0000148A                            
0000148A                            NemPCD_WritePixel:
0000148A E98C                       		lsl.l	#4,d4	; shift up by a nybble
0000148C 8801                       		or.b	d1,d4	; write pixel
0000148E 5343                       		subq.w	#1,d3	; has an entire 8-pixel row been written?
00001490 6600                       		bne.s	NemPCD_WritePixel_Loop	; if not, loop
00001492 4ED3                       		jmp	(a3)	; otherwise, write the row to its destination, by doing a dynamic jump to NemPCD_WriteRowToVDP, NemDec_WriteAndAdvance, NemPCD_WriteRowToVDP_XOR, or NemDec_WriteAndAdvance_XOR
00001494                            ; End of function NemDec_ProcessCompressedData
00001494                            
00001494                            
00001494                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001494                            
00001494                            
00001494                            NemPCD_NewRow:
00001494 7800                       		moveq	#0,d4	; reset row
00001496 7608                       		moveq	#8,d3	; reset nybble counter
00001498                            
00001498                            NemPCD_WritePixel_Loop:
00001498 51C8 FFF0                  		dbf	d0,NemPCD_WritePixel
0000149C 60B4                       		bra.s	NemDec_ProcessCompressedData
0000149E                            ; ===========================================================================
0000149E                            
0000149E                            NemPCD_InlineData:
0000149E 5D46                       		subq.w	#6,d6	; 6 bits needed to signal inline data
000014A0 0C46 0009                  		cmpi.w	#9,d6
000014A4 6400                       		bcc.s	loc_14E4
000014A6 5046                       		addq.w	#8,d6
000014A8 E145                       		asl.w	#8,d5
000014AA 1A18                       		move.b	(a0)+,d5
000014AC                            
000014AC                            loc_14E4:
000014AC 5F46                       		subq.w	#7,d6	; and 7 bits needed for the inline data itself
000014AE 3205                       		move.w	d5,d1
000014B0 EC69                       		lsr.w	d6,d1	; shift so that low bit of the code is in bit position 0
000014B2 3001                       		move.w	d1,d0
000014B4 0241 000F                  		andi.w	#$F,d1	; get palette index for pixel
000014B8 0240 0070                  		andi.w	#$70,d0	; high nybble is repeat count for pixel
000014BC 0C46 0009                  		cmpi.w	#9,d6
000014C0 64C6                       		bcc.s	NemPCD_ProcessCompressedData
000014C2 5046                       		addq.w	#8,d6
000014C4 E145                       		asl.w	#8,d5
000014C6 1A18                       		move.b	(a0)+,d5
000014C8 60BE                       		bra.s	NemPCD_ProcessCompressedData
000014CA                            ; End of function NemPCD_NewRow
000014CA                            
000014CA                            ; ===========================================================================
000014CA                            
000014CA                            NemPCD_WriteRowToVDP:
000014CA 2884                       		move.l	d4,(a4)	; write 8-pixel row
000014CC 534D                       		subq.w	#1,a5
000014CE 380D                       		move.w	a5,d4	; have all the 8-pixel rows been written?
000014D0 66C2                       		bne.s	NemPCD_NewRow	; if not, branch
000014D2 4E75                       		rts		; otherwise the decompression is finished
000014D4                            ; ===========================================================================
000014D4                            NemPCD_WriteRowToVDP_XOR:
000014D4 B982                       		eor.l	d4,d2	; XOR the previous row by the current row
000014D6 2882                       		move.l	d2,(a4)	; and write the result
000014D8 534D                       		subq.w	#1,a5
000014DA 380D                       		move.w	a5,d4
000014DC 66B6                       		bne.s	NemPCD_NewRow
000014DE 4E75                       		rts	
000014E0                            ; ===========================================================================
000014E0                            
000014E0                            NemPCD_WriteRowToRAM:
000014E0 28C4                       		move.l	d4,(a4)+
000014E2 534D                       		subq.w	#1,a5
000014E4 380D                       		move.w	a5,d4
000014E6 66AC                       		bne.s	NemPCD_NewRow
000014E8 4E75                       		rts	
000014EA                            ; ===========================================================================
000014EA                            NemPCD_WriteRowToRAM_XOR:
000014EA B982                       		eor.l	d4,d2
000014EC 28C2                       		move.l	d2,(a4)+
000014EE 534D                       		subq.w	#1,a5
000014F0 380D                       		move.w	a5,d4
000014F2 66A0                       		bne.s	NemPCD_NewRow
000014F4 4E75                       		rts	
000014F6                            
000014F6                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000014F6                            ; ---------------------------------------------------------------------------
000014F6                            ; Part of the Nemesis decompressor, builds the code table (in RAM)
000014F6                            ; ---------------------------------------------------------------------------
000014F6                            
000014F6                            
000014F6                            NemDec_BuildCodeTable:
000014F6 1018                       		move.b	(a0)+,d0	; read first byte
000014F8                            
000014F8                            NemBCT_ChkEnd:
000014F8 0C00 00FF                  		cmpi.b	#$FF,d0	; has the end of the code table description been reached?
000014FC 6600                       		bne.s	NemBCT_NewPALIndex	; if not, branch
000014FE 4E75                       		rts	; otherwise, this subroutine's work is done
00001500                            ; ===========================================================================
00001500                            
00001500                            NemBCT_NewPALIndex:
00001500 3E00                       		move.w	d0,d7
00001502                            
00001502                            NemBCT_Loop:
00001502 1018                       		move.b	(a0)+,d0	; read next byte
00001504 0C00 0080                  		cmpi.b	#$80,d0	; sign bit being set signifies a new palette index
00001508 64EE                       		bcc.s	NemBCT_ChkEnd	; a bmi could have been used instead of a compare and bcc
0000150A                            		
0000150A 1200                       		move.b	d0,d1
0000150C 0247 000F                  		andi.w	#$F,d7	; get palette index
00001510 0241 0070                  		andi.w	#$70,d1	; get repeat count for palette index
00001514 8E41                       		or.w	d1,d7	; combine the two
00001516 0240 000F                  		andi.w	#$F,d0	; get the length of the code in bits
0000151A 1200                       		move.b	d0,d1
0000151C E149                       		lsl.w	#8,d1
0000151E 8E41                       		or.w	d1,d7	; combine with palette index and repeat count to form code table entry
00001520 7208                       		moveq	#8,d1
00001522 9240                       		sub.w	d0,d1	; is the code 8 bits long?
00001524 6600                       		bne.s	NemBCT_ShortCode	; if not, a bit of extra processing is needed
00001526 1018                       		move.b	(a0)+,d0	; get code
00001528 D040                       		add.w	d0,d0	; each code gets a word-sized entry in the table
0000152A 3387 0000                  		move.w	d7,(a1,d0.w)	; store the entry for the code
0000152E 60D2                       		bra.s	NemBCT_Loop	; repeat
00001530                            ; ===========================================================================
00001530                            
00001530                            ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
00001530                            ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
00001530                            ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
00001530                            ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
00001530                            ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
00001530                            ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
00001530                            NemBCT_ShortCode:
00001530 1018                       		move.b	(a0)+,d0	; get code
00001532 D040                       		add.w	d0,d0	; shift so that high bit is in bit position 7
00001534 E368                       		lsl.w	d1,d0	; get index into code table
00001536 7A01                       		moveq	#1,d5
00001538 E36D                       		lsl.w	d1,d5
0000153A 5345                       		subq.w	#1,d5	; d5 = 2^d1 - 1
0000153C                            
0000153C                            NemBCT_ShortCode_Loop:
0000153C 3387 0000                  		move.w	d7,(a1,d0.w)	; store entry
00001540 5440                       		addq.w	#2,d0	; increment index
00001542 51CD FFF8                  		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
00001546 60BA                       		bra.s	NemBCT_Loop
00001548                            ; End of function NemDec_BuildCodeTable
00001548                            ; End of function NemDec_BuildCodeTable
