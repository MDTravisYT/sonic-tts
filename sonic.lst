00072574 162E 002A                  		move.b	f_speedup(a6),d3
00072578 182E 0026                  		move.b	v_fadein_counter(a6),d4
0007257C                            		; DANGER! Only v_soundqueue0 and v_soundqueue1 are backed up, once again breaking v_soundqueue2
0007257C 3A2E 000A                  		move.w	v_soundqueue0(a6),d5
