00001580                            ; ---------------------------------------------------------------------------
00001580                            ; Subroutine to load pattern load cues (aka to queue pattern load requests)
00001580                            ; ---------------------------------------------------------------------------
00001580                            
00001580                            ; ARGUMENTS
00001580                            ; d0 = index of PLC list
00001580                            ; ---------------------------------------------------------------------------
00001580                            
00001580                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001580                            
00001580                            ; LoadPLC:
00001580                            AddPLC:
00001580 48E7 0060                  		movem.l	a1-a2,-(sp)
00001584 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
0000158A D040                       		add.w	d0,d0
0000158C 3031 0000                  		move.w	(a1,d0.w),d0
00001590 43F1 0000                  		lea	(a1,d0.w),a1		; jump to relevant PLC
00001594 45F8 F680                  		lea	(v_plc_buffer).w,a2 ; PLC buffer space
00001598                            
00001598                            	@findspace:
00001598 4A92                       		tst.l	(a2)		; is space available in RAM?
0000159A 6700                       		beq.s	@copytoRAM	; if yes, branch
0000159C 5C4A                       		addq.w	#6,a2		; if not, try next space
0000159E 60F8                       		bra.s	@findspace
000015A0                            ; ===========================================================================
000015A0                            
000015A0                            @copytoRAM:
000015A0 3019                       		move.w	(a1)+,d0	; get length of PLC
000015A2 6B00                       		bmi.s	@skip
000015A4                            
000015A4                            	@loop:
000015A4 24D9                       		move.l	(a1)+,(a2)+
000015A6 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
000015A8 51C8 FFFA                  		dbf	d0,@loop	; repeat for length of PLC
000015AC                            
000015AC                            	@skip:
000015AC 4CDF 0600                  		movem.l	(sp)+,a1-a2 ; a1=object
000015B0 4E75                       		rts	
000015B2                            ; End of function AddPLC
000015B2                            
000015B2                            
000015B2                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000015B2                            ; Queue pattern load requests, but clear the PLQ first
000015B2                            
000015B2                            ; ARGUMENTS
000015B2                            ; d0 = index of PLC list (see ArtLoadCues)
000015B2                            
000015B2                            ; NOTICE: This subroutine does not check for buffer overruns. The programmer
000015B2                            ;	  (or hacker) is responsible for making sure that no more than
000015B2                            ;	  16 load requests are copied into the buffer.
000015B2                            ;	  _________DO NOT PUT MORE THAN 16 LOAD REQUESTS IN A LIST!__________
000015B2                            ;         (or if you change the size of Plc_Buffer, the limit becomes (Plc_Buffer_Only_End-Plc_Buffer)/6)
000015B2                            
000015B2                            ; LoadPLC2:
000015B2                            NewPLC:
000015B2 48E7 0060                  		movem.l	a1-a2,-(sp)
000015B6 43F9 0000 0000             		lea	(ArtLoadCues).l,a1
000015BC D040                       		add.w	d0,d0
000015BE 3031 0000                  		move.w	(a1,d0.w),d0
000015C2 43F1 0000                  		lea	(a1,d0.w),a1	; jump to relevant PLC
000015C6 6100                       		bsr.s	ClearPLC	; erase any data in PLC buffer space
000015C8 45F8 F680                  		lea	(v_plc_buffer).w,a2
000015CC 3019                       		move.w	(a1)+,d0	; get length of PLC
000015CE 6B00                       		bmi.s	@skip		; if it's negative, skip the next loop
000015D0                            
000015D0                            	@loop:
000015D0 24D9                       		move.l	(a1)+,(a2)+
000015D2 34D9                       		move.w	(a1)+,(a2)+	; copy PLC to RAM
000015D4 51C8 FFFA                  		dbf	d0,@loop		; repeat for length of PLC
000015D8                            
000015D8                            	@skip:
000015D8 4CDF 0600                  		movem.l	(sp)+,a1-a2
000015DC 4E75                       		rts	
000015DE                            ; End of function NewPLC
000015DE                            
000015DE                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000015DE                            
000015DE                            ; ---------------------------------------------------------------------------
000015DE                            ; Subroutine to	clear the pattern load cues
000015DE                            ; ---------------------------------------------------------------------------
000015DE                            
000015DE                            ; Clear the pattern load queue ($FFF680 - $FFF700)
000015DE                            
000015DE                            
000015DE                            ClearPLC:
000015DE 45F8 F680                  		lea	(v_plc_buffer).w,a2 ; PLC buffer space in RAM
000015E2 701F                       		moveq	#$1F,d0	; bytesToLcnt(v_plc_buffer_end-v_plc_buffer)
000015E4                            
000015E4                            	@loop:
000015E4 429A                       		clr.l	(a2)+
000015E6 51C8 FFFC                  		dbf	d0,@loop
000015EA 4E75                       		rts	
000015EC                            ; End of function ClearPLC
000015EC                            
000015EC                            ; ---------------------------------------------------------------------------
000015EC                            ; Subroutine to	use graphics listed in a pattern load cue
000015EC                            ; ---------------------------------------------------------------------------
000015EC                            
000015EC                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
000015EC                            
000015EC                            
000015EC                            RunPLC:
000015EC 4AB8 F680                  		tst.l	(v_plc_buffer).w
000015F0 6700                       		beq.s	Rplc_Exit
000015F2 4A78 F6F8                  		tst.w	(f_plc_execute).w
000015F6 6600                       		bne.s	Rplc_Exit
000015F8 2078 F680                  		movea.l	(v_plc_buffer).w,a0
000015FC 47F9 0000 1502             		lea	(NemPCD_WriteRowToVDP).l,a3
00001602 43F8 AA00                  		lea	(v_ngfx_buffer).w,a1
00001606 3418                       		move.w	(a0)+,d2
00001608 6A00                       		bpl.s	loc_160E
0000160A D6FC 000A                  		adda.w	#$A,a3
0000160E                            
0000160E                            loc_160E:
0000160E 0242 7FFF                  		andi.w	#$7FFF,d2
00001612 31C2 F6F8                  		move.w	d2,(f_plc_execute).w
00001616 6100 FF16                  		bsr.w	NemDec_BuildCodeTable
0000161A 1A18                       		move.b	(a0)+,d5
0000161C E145                       		asl.w	#8,d5
0000161E 1A18                       		move.b	(a0)+,d5
00001620 7C10                       		moveq	#$10,d6
00001622 7000                       		moveq	#0,d0
00001624 21C8 F680                  		move.l	a0,(v_plc_buffer).w
00001628 21CB F6E0                  		move.l	a3,(v_ptrnemcode).w
0000162C 21C0 F6E4                  		move.l	d0,($FFFFF6E4).w
00001630 21C0 F6E8                  		move.l	d0,($FFFFF6E8).w
00001634 21C0 F6EC                  		move.l	d0,($FFFFF6EC).w
00001638 21C5 F6F0                  		move.l	d5,($FFFFF6F0).w
0000163C 21C6 F6F4                  		move.l	d6,($FFFFF6F4).w
00001640                            
00001640                            Rplc_Exit:
00001640 4E75                       		rts	
00001642                            ; End of function RunPLC
00001642                            
00001642                            
00001642                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00001642                            
00001642                            
00001642                            sub_1642:
00001642 4A78 F6F8                  		tst.w	(f_plc_execute).w
00001646 6700 0000                  		beq.w	locret_16DA
0000164A 31FC 0009 F6FA             		move.w	#9,($FFFFF6FA).w
00001650 7000                       		moveq	#0,d0
00001652 3038 F684                  		move.w	($FFFFF684).w,d0
00001656 0678 0120 F684             		addi.w	#$120,($FFFFF684).w
0000165C 6000                       		bra.s	loc_1676
0000165E                            ; End of function sub_1642
0000165E                            
0000165E                            
0000165E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000165E                            
0000165E                            
0000165E                            ; sub_165E:
0000165E                            ProcessDPLC2:
0000165E 4A78 F6F8                  		tst.w	(f_plc_execute).w
00001662 6700                       		beq.s	locret_16DA
00001664 31FC 0003 F6FA             		move.w	#3,($FFFFF6FA).w
0000166A 7000                       		moveq	#0,d0
0000166C 3038 F684                  		move.w	($FFFFF684).w,d0
00001670 0678 0060 F684             		addi.w	#$60,($FFFFF684).w
00001676                            
00001676                            loc_1676:
00001676 49F9 00C0 0004             		lea	(vdp_control_port).l,a4
0000167C E588                       		lsl.l	#2,d0
0000167E E448                       		lsr.w	#2,d0
00001680 0040 4000                  		ori.w	#$4000,d0
00001684 4840                       		swap	d0
00001686 2880                       		move.l	d0,(a4)
00001688 594C                       		subq.w	#4,a4
0000168A 2078 F680                  		movea.l	(v_plc_buffer).w,a0
0000168E 2678 F6E0                  		movea.l	(v_ptrnemcode).w,a3
00001692 2038 F6E4                  		move.l	($FFFFF6E4).w,d0
00001696 2238 F6E8                  		move.l	($FFFFF6E8).w,d1
0000169A 2438 F6EC                  		move.l	($FFFFF6EC).w,d2
0000169E 2A38 F6F0                  		move.l	($FFFFF6F0).w,d5
000016A2 2C38 F6F4                  		move.l	($FFFFF6F4).w,d6
000016A6 43F8 AA00                  		lea	(v_ngfx_buffer).w,a1
000016AA                            
000016AA                            loc_16AA:
000016AA 3A7C 0008                  		movea.w	#8,a5
000016AE 6100 FE1C                  		bsr.w	NemPCD_NewRow
000016B2 5378 F6F8                  		subq.w	#1,(f_plc_execute).w
000016B6 6700                       		beq.s	loc_16DC
000016B8 5378 F6FA                  		subq.w	#1,($FFFFF6FA).w
000016BC 66EC                       		bne.s	loc_16AA
000016BE 21C8 F680                  		move.l	a0,(v_plc_buffer).w
000016C2 21CB F6E0                  		move.l	a3,(v_ptrnemcode).w
000016C6 21C0 F6E4                  		move.l	d0,($FFFFF6E4).w
000016CA 21C1 F6E8                  		move.l	d1,($FFFFF6E8).w
000016CE 21C2 F6EC                  		move.l	d2,($FFFFF6EC).w
000016D2 21C5 F6F0                  		move.l	d5,($FFFFF6F0).w
000016D6 21C6 F6F4                  		move.l	d6,($FFFFF6F4).w
000016DA                            
000016DA                            locret_16DA:
