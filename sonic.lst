00013986                            ; Subroutine to	animate	Sonic's sprites
00013986                            ; ---------------------------------------------------------------------------
00013986                            
00013986                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00013986                            
00013986                            
00013986                            Sonic_Animate:
00013986 43F9 0000 0000             		lea	(Ani_Sonic).l,a1
0001398C 7000                       		moveq	#0,d0
0001398E 1028 001C                  		move.b	obAnim(a0),d0
00013992 B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
00013996 6700                       		beq.s	@do		; if not, branch
00013998 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
0001399C 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
000139A2 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
000139A8                            
000139A8                            	@do:
000139A8 D040                       		add.w	d0,d0
000139AA D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
000139AE 1011                       		move.b	(a1),d0
000139B0 6B00                       		bmi.s	@walkrunroll	; if animation is walk/run/roll/jump, branch
000139B2 1228 0022                  		move.b	obStatus(a0),d1
000139B6 0201 0001                  		andi.b	#1,d1
000139BA 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
000139C0 8328 0001                  		or.b	d1,obRender(a0)
000139C4 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
000139C8 6A00                       		bpl.s	@delay		; if time remains, branch
000139CA 1140 001E                  		move.b	d0,obTimeFrame(a0) ; load frame duration
000139CE                            
000139CE                            @loadframe:
000139CE 7200                       		moveq	#0,d1
000139D0 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
000139D4 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
000139D8 6B00                       		bmi.s	@end_FF		; if animation is complete, branch
000139DA                            
000139DA                            	@next:
000139DA 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
000139DE 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
000139E2                            
000139E2                            	@delay:
000139E2 4E75                       		rts	
000139E4                            ; ===========================================================================
000139E4                            
000139E4                            @end_FF:
000139E4 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
000139E6 6600                       		bne.s	@end_FE		; if not, branch
000139E8 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; restart the animation
000139EE 1029 0001                  		move.b	1(a1),d0	; read sprite number
000139F2 60E6                       		bra.s	@next
000139F4                            ; ===========================================================================
000139F4                            
000139F4                            @end_FE:
000139F4 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
000139F6 6600                       		bne.s	@end_FD		; if not, branch
000139F8 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
000139FC 9128 001B                  		sub.b	d0,obAniFrame(a0) ; jump back d0 bytes in the script
00013A00 9200                       		sub.b	d0,d1
00013A02 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
00013A06 60D2                       		bra.s	@next
00013A08                            ; ===========================================================================
00013A08                            
00013A08                            @end_FD:
00013A08 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
00013A0A 6600                       		bne.s	@end		; if not, branch
00013A0C 1171 1002 001C             		move.b	2(a1,d1.w),obAnim(a0) ; read next byte, run that animation
00013A12                            
00013A12                            	@end:
00013A12 4E75                       		rts	
00013A14                            ; ===========================================================================
00013A14                            
00013A14                            @walkrunroll:
00013A14 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
00013A18 6AC8                       		bpl.s	@delay		; if time remains, branch
00013A1A 5200                       		addq.b	#1,d0		; is animation walking/running?
00013A1C 6600 0000                  		bne.w	@rolljump	; if not, branch
00013A20 7200                       		moveq	#0,d1
00013A22 1028 0026                  		move.b	obAngle(a0),d0	; get Sonic's angle
00013A26 1428 0022                  		move.b	obStatus(a0),d2
00013A2A 0202 0001                  		andi.b	#1,d2		; is Sonic mirrored horizontally?
00013A2E 6600                       		bne.s	@flip		; if yes, branch
00013A30 4600                       		not.b	d0		; reverse angle
00013A32                            
00013A32                            	@flip:
00013A32 0600 0010                  		addi.b	#$10,d0		; add $10 to angle
00013A36 6A00                       		bpl.s	@noinvert	; if angle is $0-$7F, branch
00013A38 7203                       		moveq	#3,d1
00013A3A                            
00013A3A                            	@noinvert:
00013A3A 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00013A40 B302                       		eor.b	d1,d2
00013A42 8528 0001                  		or.b	d2,obRender(a0)
00013A46 0828 0005 0022             		btst	#5,obStatus(a0)	; is Sonic pushing something?
00013A4C 6600 0000                  		bne.w	@push		; if yes, branch
00013A50                            
00013A50 E808                       		lsr.b	#4,d0		; divide angle by $10
00013A52 0200 0006                  		andi.b	#6,d0		; angle	must be	0, 2, 4	or 6
