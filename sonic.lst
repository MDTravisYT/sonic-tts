0001C66A 4A78 FFFA                  		tst.w	(f_debugmode).w	; is debug mode	on?
0001C66E 6600 0000                  		bne.w	HudDebug	; if yes, branch
0001C672 4A38 FE1F                  		tst.b	(f_scorecount).w ; does the score need updating?
0001C676 6700                       		beq.s	@chkrings	; if not, branch
0001C678                            
