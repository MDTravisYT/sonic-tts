0000A718                            		include	"_incObj\sub AnimateSprite.asm"
0000A718                            ; ---------------------------------------------------------------------------
0000A718                            ; Subroutine to	animate	a sprite using an animation script
0000A718                            ; ---------------------------------------------------------------------------
0000A718                            
0000A718                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000A718                            
0000A718                            
0000A718                            AnimateSprite:
0000A718 7000                       		moveq	#0,d0
0000A71A 1028 001C                  		move.b	obAnim(a0),d0	; move animation number	to d0
0000A71E B028 001D                  		cmp.b	obNextAni(a0),d0 ; is animation set to restart?
0000A722 6700                       		beq.s	Anim_Run	; if not, branch
0000A724                            
0000A724 1140 001D                  		move.b	d0,obNextAni(a0) ; set to "no restart"
0000A728 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
0000A72E 117C 0000 001E             		move.b	#0,obTimeFrame(a0) ; reset frame duration
0000A734                            
0000A734                            Anim_Run:
0000A734 5328 001E                  		subq.b	#1,obTimeFrame(a0) ; subtract 1 from frame duration
0000A738 6A00                       		bpl.s	Anim_Wait	; if time remains, branch
0000A73A D040                       		add.w	d0,d0
0000A73C D2F1 0000                  		adda.w	(a1,d0.w),a1	; jump to appropriate animation	script
0000A740 1151 001E                  		move.b	(a1),obTimeFrame(a0) ; load frame duration
0000A744 7200                       		moveq	#0,d1
0000A746 1228 001B                  		move.b	obAniFrame(a0),d1 ; load current frame number
0000A74A 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number from script
0000A74E 6B00                       		bmi.s	Anim_End_FF	; if animation is complete, branch
0000A750                            
0000A750                            Anim_Next:
0000A750 1200                       		move.b	d0,d1
0000A752 0200 001F                  		andi.b	#$1F,d0
0000A756 1140 001A                  		move.b	d0,obFrame(a0)	; load sprite number
0000A75A 1028 0022                  		move.b	obStatus(a0),d0
0000A75E E719                       		rol.b	#3,d1
0000A760 B101                       		eor.b	d0,d1
0000A762 0201 0003                  		andi.b	#3,d1
0000A766 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
0000A76C 8328 0001                  		or.b	d1,obRender(a0)
0000A770 5228 001B                  		addq.b	#1,obAniFrame(a0) ; next frame number
0000A774                            
0000A774                            Anim_Wait:
0000A774 4E75                       		rts	
0000A776                            ; ===========================================================================
0000A776                            
0000A776                            Anim_End_FF:
0000A776 5200                       		addq.b	#1,d0		; is the end flag = $FF	?
0000A778 6600                       		bne.s	Anim_End_FE	; if not, branch
0000A77A 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; restart the animation
0000A780 1029 0001                  		move.b	1(a1),d0	; read sprite number
0000A784 60CA                       		bra.s	Anim_Next
0000A786                            ; ===========================================================================
0000A786                            
0000A786                            Anim_End_FE:
0000A786 5200                       		addq.b	#1,d0		; is the end flag = $FE	?
0000A788 6600                       		bne.s	Anim_End_FD	; if not, branch
0000A78A 1031 1002                  		move.b	2(a1,d1.w),d0	; read the next	byte in	the script
0000A78E 9128 001B                  		sub.b	d0,obAniFrame(a0) ; jump back d0 bytes in the script
0000A792 9200                       		sub.b	d0,d1
0000A794 1031 1001                  		move.b	1(a1,d1.w),d0	; read sprite number
0000A798 60B6                       		bra.s	Anim_Next
0000A79A                            ; ===========================================================================
0000A79A                            
0000A79A                            Anim_End_FD:
0000A79A 5200                       		addq.b	#1,d0		; is the end flag = $FD	?
0000A79C 6600                       		bne.s	Anim_End_FC	; if not, branch
0000A79E 1171 1002 001C             		move.b	2(a1,d1.w),obAnim(a0) ; read next byte, run that animation
0000A7A4                            
0000A7A4                            Anim_End_FC:
0000A7A4 5200                       		addq.b	#1,d0		; is the end flag = $FC	?
0000A7A6 6600                       		bne.s	Anim_End_FB	; if not, branch
0000A7A8 5428 0024                  		addq.b	#2,obRoutine(a0) ; jump to next routine
0000A7AC                            
0000A7AC                            Anim_End_FB:
0000A7AC 5200                       		addq.b	#1,d0		; is the end flag = $FB	?
0000A7AE 6600                       		bne.s	Anim_End_FA	; if not, branch
0000A7B0 117C 0000 001B             		move.b	#0,obAniFrame(a0) ; reset animation
0000A7B6 4228 0025                  		clr.b	ob2ndRout(a0)	; reset	2nd routine counter
0000A7BA                            
0000A7BA                            Anim_End_FA:
0000A7BA 5200                       		addq.b	#1,d0		; is the end flag = $FA	?
0000A7BC 6600                       		bne.s	Anim_End	; if not, branch
0000A7BE 5428 0025                  		addq.b	#2,ob2ndRout(a0) ; jump to next routine
0000A7C2                            
0000A7C2                            Anim_End:
0000A7C2 4E75                       		rts	
0000A7C4                            ; End of function AnimateSprite
0000A7C4                            ; End of function AnimateSprite
