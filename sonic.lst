00014990                            ; ---------------------------------------------------------------------------
00014990                            ; Subroutine to	find the floor
00014990                            
00014990                            ; input:
00014990                            ;	d2 = y-position of object's bottom edge
00014990                            ;	d3 = x-position of object
00014990                            ;	d5 = bit to test for solidness
00014990                            
00014990                            ; output:
00014990                            ;	d1 = distance to the floor
00014990                            ;	a1 = address within 256x256 mappings where object is standing
00014990                            ;	     (refers to a 16x16 tile number)
00014990                            ;	(a4) = floor angle
00014990                            ; ---------------------------------------------------------------------------
00014990                            
00014990                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00014990                            
00014990                            
00014990                            FindFloor:
00014990 618C                       		bsr.s	FindNearestTile
00014992 3011                       		move.w	(a1),d0		; get value for solidness, orientation and 16x16 tile number
00014994 3800                       		move.w	d0,d4
00014996 0240 07FF                  		andi.w	#$7FF,d0
0001499A 6700                       		beq.s	@isblank	; branch if tile is blank
0001499C 0B04                       		btst	d5,d4		; is the tile solid?
0001499E 6600                       		bne.s	@issolid	; if yes, branch
000149A0                            
000149A0                            @isblank:
000149A0 D44B                       		add.w	a3,d2
000149A2 6100 0000                  		bsr.w	FindFloor2	; try tile below the nearest
000149A6 944B                       		sub.w	a3,d2
000149A8 0641 0010                  		addi.w	#$10,d1		; return distance to floor
000149AC 4E75                       		rts	
000149AE                            ; ===========================================================================
000149AE                            
000149AE                            @issolid:
000149AE 2478 F796                  		movea.l	(v_collindex).w,a2
000149B2 1032 0000                  		move.b	(a2,d0.w),d0	; get collision block number
000149B6 0240 00FF                  		andi.w	#$FF,d0
000149BA 67E4                       		beq.s	@isblank	; branch if 0
000149BC 45F9 0000 0000             		lea	(AngleMap).l,a2
000149C2 18B2 0000                  		move.b	(a2,d0.w),(a4)	; get collision angle value
000149C6 E948                       		lsl.w	#4,d0
000149C8 3203                       		move.w	d3,d1		; get x-pos. of object
000149CA 0804 000B                  		btst	#$B,d4		; is block flipped horizontally?
000149CE 6700                       		beq.s	@noflip		; if not, branch
000149D0 4641                       		not.w	d1
000149D2 4414                       		neg.b	(a4)
000149D4                            
000149D4                            	@noflip:
000149D4 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
000149D8 6700                       		beq.s	@noflip2	; if not, branch
000149DA 0614 0040                  		addi.b	#$40,(a4)
000149DE 4414                       		neg.b	(a4)
000149E0 0414 0040                  		subi.b	#$40,(a4)
000149E4                            
000149E4                            	@noflip2:
000149E4 0241 000F                  		andi.w	#$F,d1
000149E8 D240                       		add.w	d0,d1		; (block num. * $10) + x-pos. = place in array
000149EA 45F9 0000 0000             		lea	(CollArray1).l,a2
000149F0 1032 1000                  		move.b	(a2,d1.w),d0	; get collision height
000149F4 4880                       		ext.w	d0
000149F6 BD44                       		eor.w	d6,d4
000149F8 0804 000C                  		btst	#$C,d4		; is block flipped vertically?
000149FC 6700                       		beq.s	@noflip3	; if not, branch
000149FE 4440                       		neg.w	d0
00014A00                            
00014A00                            	@noflip3:
00014A00 4A40                       		tst.w	d0
00014A02 679C                       		beq.s	@isblank	; branch if height is 0
00014A04 6B00                       		bmi.s	@negfloor	; branch if height is negative
00014A06 0C00 0010                  		cmpi.b	#$10,d0
00014A0A 6700                       		beq.s	@maxfloor	; branch if height is $10 (max)
00014A0C 3202                       		move.w	d2,d1		; get y-pos. of object
00014A0E 0241 000F                  		andi.w	#$F,d1
00014A12 D041                       		add.w	d1,d0
00014A14 323C 000F                  		move.w	#$F,d1
00014A18 9240                       		sub.w	d0,d1		; return distance to floor
00014A1A 4E75                       		rts	
00014A1C                            ; ===========================================================================
00014A1C                            
00014A1C                            @negfloor:
00014A1C 3202                       		move.w	d2,d1
