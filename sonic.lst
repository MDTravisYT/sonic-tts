0001C6B6 43F8 FE22                  		lea	(v_time).w,a1
0001C6BA 0C99 0009 3B3B             		cmpi.l	#(9*$10000)+(59*$100)+59,(a1)+ ; is the time 9:59:59?
0001C6C0 6700                       		beq.s	TimeOver	; if yes, branch
0001C6C2                            
0001C6C2 5221                       		addq.b	#1,-(a1)	; increment 1/60s counter
0001C6C4 0C11 003C                  		cmpi.b	#60,(a1)	; check if passed 60
0001C6C8 6500                       		bcs.s	@chklives
0001C6CA 12BC 0000                  		move.b	#0,(a1)
0001C6CE 5221                       		addq.b	#1,-(a1)	; increment second counter
0001C6D0 0C11 003C                  		cmpi.b	#60,(a1)	; check if passed 60
0001C6D4 6500                       		bcs.s	@updatetime
