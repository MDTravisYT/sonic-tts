00006AF2                            
00006AF2                            
00006AF2                            DrawChunks:
00006AF2 78F0                       		moveq	#-16,d4
00006AF4 7C0F                       		moveq	#((224+16+16)/16)-1,d6
00006AF6                            
00006AF6                            	@loop:
00006AF6 48E7 0E00                  		movem.l	d4-d6,-(sp)
00006AFA 7A00                       		moveq	#0,d5
00006AFC 3204                       		move.w	d4,d1
00006AFE 6100 FF94                  		bsr.w	Calc_VRAM_Pos
00006B02 3801                       		move.w	d1,d4
00006B04 7A00                       		moveq	#0,d5
00006B06 7C1F                       		moveq	#(512/16)-1,d6
00006B08 6100 FE44                  		bsr.w	DrawBlocks_LR_2
00006B0C 4CDF 0070                  		movem.l	(sp)+,d4-d6
00006B10 0644 0010                  		addi.w	#16,d4
00006B14 51CE FFE0                  		dbf	d6,@loop
00006B18 4E75                       		rts	
