0000CA74 3028 0008                  		move.w	obX(a0),d0	; get object x-position
0000CA78 9078 F700                  		sub.w	(v_screenposx).w,d0 ; subtract screen x-position
0000CA7C 6B00                       		bmi.s	@offscreen
0000CA7E 0C40 0140                  		cmpi.w	#320,d0		; is object on the screen?
0000CA82 6C00                       		bge.s	@offscreen	; if not, branch
0000CA84                            
