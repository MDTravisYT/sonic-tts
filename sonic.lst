0000128C                            ; Subroutine to	clear the screen
0000128C                            ; ---------------------------------------------------------------------------
0000128C                            
0000128C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000128C                            
0000128C                            
0000128C                            ClearScreen:
0000128C 4BF9 00C0 0004 3ABC 8F01+  		fillVRAM	0,$FFF,vram_fg ; clear foreground namespace
000012AE                            
000012AE                            	@wait1:
000012AE 3215                       		move.w	(a5),d1
000012B0 0801 0001                  		btst	#1,d1
000012B4 66F8                       		bne.s	@wait1
000012B6                            
000012B6 3ABC 8F02                  		move.w	#$8F02,(a5)
000012BA 4BF9 00C0 0004 3ABC 8F01+  		fillVRAM	0,$FFF,vram_bg ; clear background namespace
000012DC                            
000012DC                            	@wait2:
000012DC 3215                       		move.w	(a5),d1
000012DE 0801 0001                  		btst	#1,d1
000012E2 66F8                       		bne.s	@wait2
000012E4                            
000012E4 3ABC 8F02                  		move.w	#$8F02,(a5)
000012E8 21FC 0000 0000 F616        		move.l	#0,(v_scrposy_dup).w
000012F0 21FC 0000 0000 F61A        		move.l	#0,(v_scrposx_dup).w
000012F8                            
000012F8 43F8 F800                  		lea	(v_spritetablebuffer).w,a1
000012FC 7000                       		moveq	#0,d0
000012FE 323C 00A0                  		move.w	#($280/4),d1	; This should be ($280/4)-1, leading to a slight bug (first bit of v_pal_water is cleared)
00001302                            
00001302                            	@clearsprites:
00001302 22C0                       		move.l	d0,(a1)+
00001304 51C9 FFFC                  		dbf	d1,@clearsprites ; clear sprite table (in RAM)
00001308                            
00001308 43F8 CC00                  		lea	(v_hscrolltablebuffer).w,a1
0000130C 7000                       		moveq	#0,d0
0000130E 323C 0100                  		move.w	#($400/4),d1	; This should be ($400/4)-1, leading to a slight bug (first bit of the Sonic object's RAM is cleared)
00001312                            
00001312                            	@clearhscroll:
00001312 22C0                       		move.l	d0,(a1)+
00001314 51C9 FFFC                  		dbf	d1,@clearhscroll ; clear hscroll table (in RAM)
00001318 4E75                       		rts	
0000131A                            ; End of function ClearScreen
