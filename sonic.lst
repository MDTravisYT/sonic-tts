00012D64 6B00                       		bmi.s	@negspeed
00012D66 4442                       		neg.w	d2
00012D68                            
00012D68                            	@negspeed:
00012D68 0642 0800                  		addi.w	#$800,d2
00012D6C 6A00                       		bpl.s	@belowmax3	
00012D6E 7400                       		moveq	#0,d2
00012D70                            
00012D70                            	@belowmax3:
00012D70 EC4A                       		lsr.w	#6,d2
00012D72 1142 001E                  		move.b	d2,obTimeFrame(a0) ; modify frame duration
00012D76 43F9 0000 0000             		lea	(SonAni_Push).l,a1
00012D7C 1228 0022                  		move.b	obStatus(a0),d1
00012D80 0201 0001                  		andi.b	#1,d1
00012D84 0228 00FC 0001             		andi.b	#$FC,obRender(a0)
00012D8A 8328 0001                  		or.b	d1,obRender(a0)
00012D8E 6000 FEC6                  		bra.w	@loadframe
