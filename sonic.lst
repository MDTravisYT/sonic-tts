0000275A                            ; ---------------------------------------------------------------------------
0000275A                            ; Subroutine calculate a sine
0000275A                            
0000275A                            ; input:
0000275A                            ;	d0 = angle
0000275A                            
0000275A                            ; output:
0000275A                            ;	d0 = sine
0000275A                            ;	d1 = cosine
0000275A                            ; ---------------------------------------------------------------------------
0000275A                            
0000275A                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000275A                            
0000275A                            
0000275A                            CalcSine:
0000275A 0240 00FF                  		andi.w	#$FF,d0
0000275E D040                       		add.w	d0,d0
00002760 0640 0080                  		addi.w	#$80,d0
00002764 323B 0000                  		move.w	Sine_Data(pc,d0.w),d1
00002768 0440 0080                  		subi.w	#$80,d0
0000276C 303B 0000                  		move.w	Sine_Data(pc,d0.w),d0
00002770 4E75                       		rts	
00002772                            ; End of function CalcSine
