0000FA04 08A8 0003 0022             		bclr	#3,obStatus(a0)	; clear object's standing flag
0000FA0A 4228 0025                  		clr.b	obSolid(a0)
0000FA0E 7800                       		moveq	#0,d4
0000FA10 4E75                       		rts	
0000FA12                            
