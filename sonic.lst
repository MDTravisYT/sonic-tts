0000628C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000628C                            
0000628C                            ; Gets address of block at a certain coordinate
0000628C                            ; Parameters:
0000628C                            ; a4 = Pointer to level layout
0000628C                            ; d4 = Relative Y coordinate
0000628C                            ; d5 = Relative X coordinate
0000628C                            ; Returns:
0000628C                            ; a0 = Address of block metadata
0000628C                            ; a1 = Address of block
0000628C                            ; DrawBlocks:
0000628C                            GetBlockData:
0000628C 43F8 B000                  		lea	(v_16x16).w,a1
00006290 D86B 0004                  		add.w	4(a3),d4	; Add camera Y coordinate to relative coordinate
00006294 DA53                       		add.w	(a3),d5		; Add camera X coordinate to relative coordinate
00006296                            		; Turn Y coordinate into index into level layout
00006296 3604                       		move.w	d4,d3
00006298 E24B                       		lsr.w	#1,d3
0000629A 0243 0380                  		andi.w	#$380,d3
0000629E                            		; Turn X coordinate into index into level layout
0000629E E64D                       		lsr.w	#3,d5
000062A0 3005                       		move.w	d5,d0
000062A2 EA48                       		lsr.w	#5,d0
000062A4 0240 007F                  		andi.w	#$7F,d0
000062A8                            		; Get chunk from level layout
000062A8 D043                       		add.w	d3,d0
000062AA 76FF                       		moveq	#-1,d3
000062AC 1634 0000                  		move.b	(a4,d0.w),d3
000062B0 6700                       		beq.s	locret_6C1E	; If chunk 00, just return a pointer to the first block (expected to be empty)
000062B2                            		; Turn chunk ID into index into chunk table
000062B2 5303                       		subq.b	#1,d3
000062B4 0243 007F                  		andi.w	#$7F,d3
000062B8 EE5B                       		ror.w	#7,d3
000062BA                            		; Turn Y coordinate into index into chunk
000062BA D844                       		add.w	d4,d4
000062BC 0244 01E0                  		andi.w	#$1E0,d4
000062C0                            		; Turn X coordinate into index into chunk
000062C0 0245 001E                  		andi.w	#$1E,d5
000062C4                            		; Get block metadata from chunk
000062C4 D644                       		add.w	d4,d3
000062C6 D645                       		add.w	d5,d3
000062C8 2043                       		movea.l	d3,a0
000062CA 3610                       		move.w	(a0),d3
000062CC                            		; Turn block ID into address
000062CC 0243 03FF                  		andi.w	#$3FF,d3
000062D0 E74B                       		lsl.w	#3,d3
000062D2 D2C3                       		adda.w	d3,a1
