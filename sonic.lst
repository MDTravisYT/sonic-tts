000726CE                            
000726CE                            ; The reason I think this is an *early* SMPS 68k Type 1b
000726CE                            ; is because this subroutine is the one from Type 1a:
000726CE                            ; other Type 1b drivers have a newer, optimised version.
000726CE                            ; The driver itself is Type 1b, with this odd exception.
000726CE                            
000726CE                            ; sub_7272E:
000726CE                            WriteFMI:
000726CE 1439 00A0 4000             		move.b	(ym2612_a0).l,d2
000726D4 0802 0007                  		btst	#7,d2		; Is FM busy?
000726D8 66F4                       		bne.s	WriteFMI	; Loop if so
000726DA 13C0 00A0 4000             		move.b	d0,(ym2612_a0).l
000726E0 4E71                       		nop	
000726E2 4E71                       		nop	
000726E4 4E71                       		nop	
