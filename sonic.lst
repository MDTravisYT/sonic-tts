00012B60                            ; ---------------------------------------------------------------------------
00012B60                            ; Subroutine to	make Sonic run around loops (GHZ/SLZ)
00012B60                            ; ---------------------------------------------------------------------------
00012B60                            
00012B60                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
00012B60                            
00012B60                            
00012B60                            Sonic_Loops:
00012B60 0C38 0003 FE10             		cmpi.b	#id_SLZ,(v_zone).w ; is level SLZ ?
00012B66 6700                       		beq.s	@isstarlight	; if yes, branch
00012B68 4A38 FE10                  		tst.b	(v_zone).w	; is level GHZ ?
00012B6C 6600 0000                  		bne.w	@noloops	; if not, branch
00012B70                            
00012B70                            	@isstarlight:
00012B70 3028 000C                  		move.w	obY(a0),d0
00012B74 E248                       		lsr.w	#1,d0
00012B76 0240 0380                  		andi.w	#$380,d0
00012B7A 1228 0008                  		move.b	obX(a0),d1
00012B7E 0241 007F                  		andi.w	#$7F,d1
00012B82 D041                       		add.w	d1,d0
00012B84 43F8 A400                  		lea	(v_lvllayout).w,a1
00012B88 1231 0000                  		move.b	(a1,d0.w),d1	; d1 is	the 256x256 tile Sonic is currently on
00012B8C                            
00012B8C B238 F7AE                  		cmp.b	(v_256roll1).w,d1 ; is Sonic on a "roll tunnel" tile?
00012B90 6700 FA72                  		beq.w	Sonic_ChkRoll	; if yes, branch
00012B94 B238 F7AF                  		cmp.b	(v_256roll2).w,d1
00012B98 6700 FA6A                  		beq.w	Sonic_ChkRoll
00012B9C                            
00012B9C B238 F7AC                  		cmp.b	(v_256loop1).w,d1 ; is Sonic on a loop tile?
00012BA0 6700                       		beq.s	@chkifleft	; if yes, branch
00012BA2 B238 F7AD                  		cmp.b	(v_256loop2).w,d1
00012BA6 6700                       		beq.s	@chkifinair
00012BA8 08A8 0006 0001             		bclr	#6,obRender(a0) ; return Sonic to high plane
00012BAE 4E75                       		rts	
00012BB0                            ; ===========================================================================
00012BB0                            
00012BB0                            @chkifinair:
00012BB0 0828 0001 0022             		btst	#1,obStatus(a0)	; is Sonic in the air?
00012BB6 6700                       		beq.s	@chkifleft	; if not, branch
00012BB8                            
00012BB8 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00012BBE 4E75                       		rts	
00012BC0                            ; ===========================================================================
00012BC0                            
00012BC0                            @chkifleft:
00012BC0 3428 0008                  		move.w	obX(a0),d2
00012BC4 0C02 002C                  		cmpi.b	#$2C,d2
00012BC8 6400                       		bcc.s	@chkifright
00012BCA                            
00012BCA 08A8 0006 0001             		bclr	#6,obRender(a0)	; return Sonic to high plane
00012BD0 4E75                       		rts	
00012BD2                            ; ===========================================================================
00012BD2                            
00012BD2                            @chkifright:
00012BD2 0C02 00E0                  		cmpi.b	#$E0,d2
00012BD6 6500                       		bcs.s	@chkangle1
00012BD8                            
00012BD8 08E8 0006 0001             		bset	#6,obRender(a0)	; send Sonic to	low plane
00012BDE 4E75                       		rts	
00012BE0                            ; ===========================================================================
00012BE0                            
00012BE0                            @chkangle1:
00012BE0 0828 0006 0001             		btst	#6,obRender(a0) ; is Sonic on low plane?
00012BE6 6600                       		bne.s	@chkangle2	; if yes, branch
00012BE8                            
00012BE8 1228 0026                  		move.b	obAngle(a0),d1
00012BEC 6700                       		beq.s	@done
00012BEE 0C01 0080                  		cmpi.b	#$80,d1		; is Sonic upside-down?
00012BF2 6200                       		bhi.s	@done		; if yes, branch
00012BF4 08E8 0006 0001             		bset	#6,obRender(a0)	; send Sonic to	low plane
00012BFA 4E75                       		rts	
00012BFC                            ; ===========================================================================
00012BFC                            
00012BFC                            @chkangle2:
00012BFC 1228 0026                  		move.b	obAngle(a0),d1
00012C00 0C01 0080                  		cmpi.b	#$80,d1		; is Sonic upright?
00012C04 6300                       		bls.s	@done		; if yes, branch
00012C06 08A8 0006 0001             		bclr	#6,obRender(a0)	; send Sonic to	high plane
00012C0C                            
00012C0C                            @noloops:
00012C0C                            @done:
00012C0C 4E75                       		rts	
00012C0E                            ; End of function Sonic_Loops
