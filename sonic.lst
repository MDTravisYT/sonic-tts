0000171E                            		include	"_inc\Enigma Decompression.asm"
0000171E                            ; ---------------------------------------------------------------------------
0000171E                            ; Enigma decompression algorithm
0000171E                            
0000171E                            ; input:
0000171E                            ;	d0 = starting art tile (added to each 8x8 before writing to destination)
0000171E                            ;	a0 = source address
0000171E                            ;	a1 = destination address
0000171E                            
0000171E                            ; usage:
0000171E                            ;	lea	(source).l,a0
0000171E                            ;	lea	(destination).l,a1
0000171E                            ;	move.w	#arttile,d0
0000171E                            ;	bsr.w	EniDec
0000171E                            
0000171E                            ; See http://www.segaretro.org/Enigma_compression for format description
0000171E                            ; ---------------------------------------------------------------------------
0000171E                            
0000171E                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000171E                            
0000171E                            
0000171E                            EniDec:
0000171E 48E7 FF7C                  		movem.l	d0-d7/a1-a5,-(sp)
00001722 3640                       		movea.w	d0,a3		; store starting art tile
00001724 1018                       		move.b	(a0)+,d0
00001726 4880                       		ext.w	d0
00001728 3A40                       		movea.w	d0,a5		; store number of bits in inline copy value
0000172A 1818                       		move.b	(a0)+,d4
0000172C E70C                       		lsl.b	#3,d4		; store PCCVH flags bitfield
0000172E 3458                       		movea.w	(a0)+,a2
00001730 D4CB                       		adda.w	a3,a2		; store incremental copy word
00001732 3858                       		movea.w	(a0)+,a4
00001734 D8CB                       		adda.w	a3,a4		; store literal copy word
00001736 1A18                       		move.b	(a0)+,d5
00001738 E145                       		asl.w	#8,d5
0000173A 1A18                       		move.b	(a0)+,d5	; get first word in format list
0000173C 7C10                       		moveq	#16,d6		; initial shift value
0000173E                            ; loc_173E:
0000173E                            Eni_Loop:
0000173E 7007                       		moveq	#7,d0		; assume a format list entry is 7 bits
00001740 3E06                       		move.w	d6,d7
00001742 9E40                       		sub.w	d0,d7
00001744 3205                       		move.w	d5,d1
00001746 EE69                       		lsr.w	d7,d1
00001748 0241 007F                  		andi.w	#$7F,d1		; get format list entry
0000174C 3401                       		move.w	d1,d2		; and copy it
0000174E 0C41 0040                  		cmpi.w	#$40,d1		; is the high bit of the entry set?
00001752 6400                       		bhs.s	@sevenbitentry
00001754 7006                       		moveq	#6,d0		; if it isn't, the entry is actually 6 bits
00001756 E24A                       		lsr.w	#1,d2
00001758                            ; loc_1758:
00001758                            @sevenbitentry:
00001758 6100 0000                  		bsr.w	EniDec_FetchByte
0000175C 0242 000F                  		andi.w	#$F,d2		; get repeat count
00001760 E849                       		lsr.w	#4,d1
00001762 D241                       		add.w	d1,d1
00001764 4EFB 1000                  		jmp	EniDec_Index(pc,d1.w)
00001768                            ; End of function EniDec
00001768                            
00001768                            ; ===========================================================================
00001768                            ; loc_1768:
00001768                            EniDec_00:
00001768 32CA                       @loop:		move.w	a2,(a1)+	; copy incremental copy word
0000176A 524A                       		addq.w	#1,a2		; increment it
0000176C 51CA FFFA                  		dbf	d2,@loop	; repeat
00001770 60CC                       		bra.s	Eni_Loop
00001772                            ; ===========================================================================
00001772                            ; loc_1772:
00001772                            EniDec_01:
00001772 32CC                       @loop:		move.w	a4,(a1)+	; copy literal copy word
00001774 51CA FFFC                  		dbf	d2,@loop	; repeat
00001778 60C4                       		bra.s	Eni_Loop
0000177A                            ; ===========================================================================
0000177A                            ; loc_177A:
0000177A                            EniDec_100:
0000177A 6100 0000                  		bsr.w	EniDec_FetchInlineValue
0000177E                            ; loc_177E:
0000177E 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
00001780 51CA FFFC                  		dbf	d2,@loop	; repeat
00001784                            
00001784 60B8                       		bra.s	Eni_Loop
00001786                            ; ===========================================================================
00001786                            ; loc_1786:
00001786                            EniDec_101:
00001786 6100 0000                  		bsr.w	EniDec_FetchInlineValue
0000178A                            ; loc_178A:
0000178A 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
0000178C 5241                       		addq.w	#1,d1		; increment
0000178E 51CA FFFA                  		dbf	d2,@loop	; repeat
00001792                            
00001792 60AA                       		bra.s	Eni_Loop
00001794                            ; ===========================================================================
00001794                            ; loc_1794:
00001794                            EniDec_110:
00001794 6100 0000                  		bsr.w	EniDec_FetchInlineValue
00001798                            ; loc_1798:
00001798 32C1                       @loop:		move.w	d1,(a1)+	; copy inline value
0000179A 5341                       		subq.w	#1,d1		; decrement
0000179C 51CA FFFA                  		dbf	d2,@loop	; repeat
000017A0                            
000017A0 609C                       		bra.s	Eni_Loop
000017A2                            ; ===========================================================================
000017A2                            ; loc_17A2:
000017A2                            EniDec_111:
000017A2 0C42 000F                  		cmpi.w	#$F,d2
000017A6 6700                       		beq.s	EniDec_Done
000017A8                            ; loc_17A8:
000017A8 6100 0000                  @loop:		bsr.w	EniDec_FetchInlineValue	; fetch new inline value
000017AC 32C1                       		move.w	d1,(a1)+	; copy it
000017AE 51CA FFF8                  		dbf	d2,@loop	; and repeat
000017B2                            
000017B2 608A                       		bra.s	Eni_Loop
000017B4                            ; ===========================================================================
000017B4                            ; loc_17B4:
000017B4                            EniDec_Index:
000017B4 60B2                       		bra.s	EniDec_00
000017B6 60B0                       		bra.s	EniDec_00
000017B8 60B8                       		bra.s	EniDec_01
000017BA 60B6                       		bra.s	EniDec_01
000017BC 60BC                       		bra.s	EniDec_100
000017BE 60C6                       		bra.s	EniDec_101
000017C0 60D2                       		bra.s	EniDec_110
000017C2 60DE                       		bra.s	EniDec_111
000017C4                            ; ===========================================================================
000017C4                            ; loc_17C4:
000017C4                            EniDec_Done:
000017C4 5348                       		subq.w	#1,a0		; go back by one byte
000017C6 0C46 0010                  		cmpi.w	#16,d6		; were we going to start on a completely new byte?
000017CA 6600                       		bne.s	@notnewbyte	; if not, branch
000017CC 5348                       		subq.w	#1,a0		; and another one if needed
000017CE                            ; loc_17CE:
000017CE                            @notnewbyte:
000017CE 3008                       		move.w	a0,d0
000017D0 E248                       		lsr.w	#1,d0		; are we on an odd byte?
000017D2 6400                       		bcc.s	@evenbyte	; if not, branch
000017D4 5248                       		addq.w	#1,a0		; ensure we're on an even byte
000017D6                            ; loc_17D6:
000017D6                            @evenbyte:
000017D6 4CDF 3EFF                  		movem.l	(sp)+,d0-d7/a1-a5
000017DA 4E75                       		rts	
000017DC                            
000017DC                            ; ---------------------------------------------------------------------------
000017DC                            ; Part of the Enigma decompressor
000017DC                            ; Fetches an inline copy value and stores it in d1
000017DC                            ; ---------------------------------------------------------------------------
000017DC                            
000017DC                            ; =============== S U B R O U T I N E =======================================
000017DC                            
000017DC                            ; loc_17DC:
000017DC                            EniDec_FetchInlineValue:
000017DC 360B                       		move.w	a3,d3		; copy starting art tile
000017DE 1204                       		move.b	d4,d1		; copy PCCVH bitfield
000017E0 D201                       		add.b	d1,d1		; is the priority bit set?
000017E2 6400                       		bcc.s	@skippriority	; if not, branch
000017E4 5346                       		subq.w	#1,d6
000017E6 0D05                       		btst	d6,d5		; is the priority bit set in the inline render flags?
000017E8 6700                       		beq.s	@skippriority	; if not, branch
000017EA 0043 8000                  		ori.w	#$8000,d3	; otherwise set priority bit in art tile
000017EE                            ; loc_17EE:
000017EE                            @skippriority:
000017EE D201                       		add.b	d1,d1		; is the high palette line bit set?
000017F0 6400                       		bcc.s	@skiphighpal	; if not, branch
000017F2 5346                       		subq.w	#1,d6
000017F4 0D05                       		btst	d6,d5
000017F6 6700                       		beq.s	@skiphighpal
000017F8 0643 4000                  		addi.w	#$4000,d3	; set second palette line bit
000017FC                            ; loc_17FC:
000017FC                            @skiphighpal:
000017FC D201                       		add.b	d1,d1		; is the low palette line bit set?
000017FE 6400                       		bcc.s	@skiplowpal	; if not, branch
00001800 5346                       		subq.w	#1,d6
00001802 0D05                       		btst	d6,d5
00001804 6700                       		beq.s	@skiplowpal
00001806 0643 2000                  		addi.w	#$2000,d3	; set first palette line bit
0000180A                            ; loc_180A:
0000180A                            @skiplowpal:
0000180A D201                       		add.b	d1,d1		; is the vertical flip flag set?
0000180C 6400                       		bcc.s	@skipyflip	; if not, branch
0000180E 5346                       		subq.w	#1,d6
00001810 0D05                       		btst	d6,d5
00001812 6700                       		beq.s	@skipyflip
00001814 0043 1000                  		ori.w	#$1000,d3	; set Y-flip bit
00001818                            ; loc_1818:
00001818                            @skipyflip:
00001818 D201                       		add.b	d1,d1		; is the horizontal flip flag set?
0000181A 6400                       		bcc.s	@skipxflip	; if not, branch
0000181C 5346                       		subq.w	#1,d6
0000181E 0D05                       		btst	d6,d5
00001820 6700                       		beq.s	@skipxflip
00001822 0043 0800                  		ori.w	#$800,d3	; set X-flip bit
00001826                            ; loc_1826:
00001826                            @skipxflip:
00001826 3205                       		move.w	d5,d1
00001828 3E06                       		move.w	d6,d7
0000182A 9E4D                       		sub.w	a5,d7		; subtract length in bits of inline copy value
0000182C 6400                       		bcc.s	@enoughbits	; branch if a new word doesn't need to be read
0000182E 3C07                       		move.w	d7,d6
00001830 0646 0010                  		addi.w	#16,d6
00001834 4447                       		neg.w	d7		; calculate bit deficit
00001836 EF69                       		lsl.w	d7,d1		; and make space for that many bits
00001838 1A10                       		move.b	(a0),d5		; get next byte
0000183A EF3D                       		rol.b	d7,d5		; and rotate the required bits into the lowest positions
0000183C DE47                       		add.w	d7,d7
0000183E CA7B 7000                  		and.w	EniDec_Masks-2(pc,d7.w),d5
00001842 D245                       		add.w	d5,d1		; combine upper bits with lower bits
00001844                            ; loc_1844:
00001844                            @maskvalue:
00001844 300D                       		move.w	a5,d0		; get length in bits of inline copy value
00001846 D040                       		add.w	d0,d0
00001848 C27B 0000                  		and.w	EniDec_Masks-2(pc,d0.w),d1	; mask value appropriately
0000184C D243                       		add.w	d3,d1		; add starting art tile
0000184E 1A18                       		move.b	(a0)+,d5
00001850 E14D                       		lsl.w	#8,d5
00001852 1A18                       		move.b	(a0)+,d5	; get next word
00001854 4E75                       		rts	
00001856                            ; ===========================================================================
00001856                            ; loc_1856:
00001856                            @enoughbits:
00001856 6700                       		beq.s	@justenough	; if the word has been exactly exhausted, branch
00001858 EE69                       		lsr.w	d7,d1	; get inline copy value
0000185A 300D                       		move.w	a5,d0
0000185C D040                       		add.w	d0,d0
0000185E C27B 0000                  		and.w	EniDec_Masks-2(pc,d0.w),d1	; and mask it appropriately
00001862 D243                       		add.w	d3,d1	; add starting art tile
00001864 300D                       		move.w	a5,d0
00001866 6000                       		bra.s	EniDec_FetchByte
00001868                            ; ===========================================================================
00001868                            ; loc_1868:
00001868                            @justenough:
00001868 7C10                       		moveq	#16,d6	; reset shift value
0000186A 60D8                       		bra.s	@maskvalue
0000186C                            ; ===========================================================================
0000186C                            ; word_186C:
0000186C                            EniDec_Masks:
0000186C 0001 0003 0007 000F        		dc.w	 1,    3,    7,   $F
00001874 001F 003F 007F 00FF        		dc.w   $1F,  $3F,  $7F,  $FF
0000187C 01FF 03FF 07FF 0FFF        		dc.w  $1FF, $3FF, $7FF, $FFF
00001884 1FFF 3FFF 7FFF FFFF        		dc.w $1FFF,$3FFF,$7FFF,$FFFF
0000188C                            
0000188C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000188C                            
0000188C                            ; sub_188C:
0000188C                            EniDec_FetchByte:
0000188C 9C40                       		sub.w	d0,d6	; subtract length of current entry from shift value so that next entry is read next time around
0000188E 0C46 0009                  		cmpi.w	#9,d6	; does a new byte need to be read?
00001892 6400                       		bhs.s	@locret	; if not, branch
00001894 5046                       		addq.w	#8,d6
00001896 E145                       		asl.w	#8,d5
00001898 1A18                       		move.b	(a0)+,d5
0000189A                            @locret:
0000189A 4E75                       		rts	
0000189C                            ; End of function EniDec_FetchByte
0000189C                            ; End of function EniDec_FetchByte
0000189C                            		include	"_inc\Kosinski Decompression.asm"
0000189C                            ; ---------------------------------------------------------------------------
0000189C                            ; Kosinski decompression algorithm
0000189C                            
0000189C                            ; input:
0000189C                            ;	a0 = source address
0000189C                            ;	a1 = destination address
0000189C                            
0000189C                            ; usage:
0000189C                            ;	lea	(source).l,a0
0000189C                            ;	lea	(destination).l,a1
0000189C                            ;	bsr.w	KosDec
0000189C                            ; ---------------------------------------------------------------------------
0000189C                            
0000189C                            ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
0000189C                            
0000189C                            
0000189C                            KosDec:
0000189C                            
0000189C 558F                       		subq.l	#2,sp	; make space for 2 bytes on the stack
0000189E 1F58 0001                  		move.b	(a0)+,1(sp)
000018A2 1E98                       		move.b	(a0)+,(sp)
000018A4 3A17                       		move.w	(sp),d5	; get first description field
000018A6 780F                       		moveq	#$F,d4	; set to loop for 16 bits
000018A8                            
000018A8                            Kos_Loop:
000018A8 E24D                       		lsr.w	#1,d5	; shift bit into the c flag
000018AA 40C6                       		move	sr,d6
000018AC 51CC 0000                  		dbf	d4,@chkbit
000018B0 1F58 0001                  		move.b	(a0)+,1(sp)
000018B4 1E98                       		move.b	(a0)+,(sp)
000018B6 3A17                       		move.w	(sp),d5
000018B8 780F                       		moveq	#$F,d4
000018BA                            
000018BA                            	@chkbit:
000018BA 44C6                       		move	d6,ccr	; was the bit set?
000018BC 6400                       		bcc.s	Kos_RLE	; if not, branch
000018BE                            
000018BE 12D8                       		move.b	(a0)+,(a1)+ ; copy byte as-is
000018C0 60E6                       		bra.s	Kos_Loop
000018C2                            ; ===========================================================================
000018C2                            
000018C2                            Kos_RLE:
000018C2 7600                       		moveq	#0,d3
000018C4 E24D                       		lsr.w	#1,d5	; get next bit
000018C6 40C6                       		move	sr,d6
000018C8 51CC 0000                  		dbf	d4,@chkbit
000018CC 1F58 0001                  		move.b	(a0)+,1(sp)
000018D0 1E98                       		move.b	(a0)+,(sp)
000018D2 3A17                       		move.w	(sp),d5
000018D4 780F                       		moveq	#$F,d4
000018D6                            
000018D6                            	@chkbit:
000018D6 44C6                       		move	d6,ccr	; was the bit set?
000018D8 6500                       		bcs.s	Kos_SeparateRLE ; if yes, branch
000018DA                            
000018DA E24D                       		lsr.w	#1,d5	; shift bit into the x flag
000018DC 51CC 0000                  		dbf	d4,@loop1
000018E0 1F58 0001                  		move.b	(a0)+,1(sp)
000018E4 1E98                       		move.b	(a0)+,(sp)
000018E6 3A17                       		move.w	(sp),d5
000018E8 780F                       		moveq	#$F,d4
000018EA                            
000018EA                            	@loop1:
000018EA E353                       		roxl.w	#1,d3	; get high repeat count bit
000018EC E24D                       		lsr.w	#1,d5
000018EE 51CC 0000                  		dbf	d4,@loop2
000018F2 1F58 0001                  		move.b	(a0)+,1(sp)
000018F6 1E98                       		move.b	(a0)+,(sp)
000018F8 3A17                       		move.w	(sp),d5
000018FA 780F                       		moveq	#$F,d4
000018FC                            
000018FC                            	@loop2:
000018FC E353                       		roxl.w	#1,d3	; get low repeat count bit
000018FE 5243                       		addq.w	#1,d3	; increment repeat count
00001900 74FF                       		moveq	#-1,d2
00001902 1418                       		move.b	(a0)+,d2 ; calculate offset
00001904 6000                       		bra.s	Kos_RLELoop
00001906                            ; ===========================================================================
00001906                            
00001906                            Kos_SeparateRLE:
00001906 1018                       		move.b	(a0)+,d0 ; get first byte
00001908 1218                       		move.b	(a0)+,d1 ; get second byte
0000190A 74FF                       		moveq	#-1,d2
0000190C 1401                       		move.b	d1,d2
0000190E EB4A                       		lsl.w	#5,d2
00001910 1400                       		move.b	d0,d2	; calculate offset
00001912 0241 0007                  		andi.w	#7,d1	; does a third byte need to be read?
00001916 6700                       		beq.s	Kos_SeparateRLE2 ; if yes, branch
00001918 1601                       		move.b	d1,d3	; copy repeat count
0000191A 5243                       		addq.w	#1,d3	; increment
0000191C                            
0000191C                            Kos_RLELoop:
0000191C 1031 2000                  		move.b	(a1,d2.w),d0 ; copy appropriate byte
00001920 12C0                       		move.b	d0,(a1)+ ; repeat
00001922 51CB FFF8                  		dbf	d3,Kos_RLELoop
00001926 6080                       		bra.s	Kos_Loop
00001928                            ; ===========================================================================
00001928                            
00001928                            Kos_SeparateRLE2:
00001928 1218                       		move.b	(a0)+,d1
0000192A 6700                       		beq.s	Kos_Done ; 0 indicates end of compressed data
0000192C 0C01 0001                  		cmpi.b	#1,d1
00001930 6700 FF76                  		beq.w	Kos_Loop ; 1 indicates new description to be read
00001934 1601                       		move.b	d1,d3	; otherwise, copy repeat count
00001936 60E4                       		bra.s	Kos_RLELoop
00001938                            ; ===========================================================================
00001938                            
00001938                            Kos_Done:
00001938 548F                       		addq.l	#2,sp	; restore stack pointer
0000193A 4E75                       		rts	
0000193C                            ; End of function KosDec
0000193C                            ; End of function KosDec
0000193C                            
