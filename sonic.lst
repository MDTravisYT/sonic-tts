00019B6C 5705                       		subq.b	#3,d5
00019B6E 9645                       		sub.w	d5,d3
00019B70 0C28 0039 001A             		cmpi.b	#fr_Duck,obFrame(a0) ; is Sonic ducking?
00019B76 6600                       		bne.s	@notducking	; if not, branch
