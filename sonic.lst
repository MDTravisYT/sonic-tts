00000236                            EntryPoint:
00000236 4AB9 00A1 0008             		tst.l	(z80_port_1_control).l ; test port A & B control registers
0000023C 6600                       		bne.s	PortA_Ok
0000023E 4A79 00A1 000C             		tst.w	(z80_expansion_control).l ; test port C control register
00000244                            
00000244                            PortA_Ok:
00000244 6600                       		bne.s	SkipSetup ; Skip the VDP and Z80 setup code if port A, B or C is ok...?
00000246 4BFA 0000                  		lea	SetupValues(pc),a5	; Load setup values array address.
0000024A 4C9D 00E0                  		movem.w	(a5)+,d5-d7
