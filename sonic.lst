00002728                            RandomNumber:
00002728 2238 F636                  		move.l	(v_random).w,d1
0000272C 6600                       		bne.s	@scramble	; if d0 is not 0, branch
0000272E 223C 2A6D 365A             		move.l	#$2A6D365A,d1	; if do is 0, use seed number
00002734                            
00002734                            	@scramble:
00002734 2001                       		move.l	d1,d0
00002736 E581                       		asl.l	#2,d1
00002738 D280                       		add.l	d0,d1
0000273A E781                       		asl.l	#3,d1
0000273C D280                       		add.l	d0,d1
0000273E 3001                       		move.w	d1,d0
00002740 4841                       		swap	d1
00002742 D041                       		add.w	d1,d0
00002744 3200                       		move.w	d0,d1
00002746 4841                       		swap	d1
00002748 21C1 F636                  		move.l	d1,(v_random).w
0000274C 4E75                       		rts	
