000061FC 2C84                       		move.l	d4,(a6)		; Write top two tiles
000061FE D087                       		add.l	d7,d0		; Next row
00006200 2A80                       		move.l	d0,(a5)
00006202 2819                       		move.l	(a1)+,d4
00006204 0A84 0800 0800             		eori.l	#$8000800,d4
0000620A 4844                       		swap	d4
0000620C 2C84                       		move.l	d4,(a6)		; Write bottom two tiles
0000620E 4E75                       		rts	
