0000EBB4                            SolidObject:
0000EBB4 4A28 0025                  		tst.b	obSolid(a0)	; is Sonic standing on the object?
0000EBB8 6700 0000                  		beq.w	Solid_ChkEnter	; if not, branch
0000EBBC 3401                       		move.w	d1,d2
0000EBBE D442                       		add.w	d2,d2
0000EBC0 43F8 D000                  		lea	(v_player).w,a1
0000EBC4 0829 0001 0022             		btst	#1,obStatus(a1)	; is Sonic in the air?
0000EBCA 6600                       		bne.s	@leave		; if yes, branch
0000EBCC 3029 0008                  		move.w	obX(a1),d0
0000EBD0 9068 0008                  		sub.w	obX(a0),d0
0000EBD4 D041                       		add.w	d1,d0
0000EBD6 6B00                       		bmi.s	@leave		; if Sonic moves off the left, branch
0000EBD8 B042                       		cmp.w	d2,d0		; has Sonic moved off the right?
0000EBDA 6500                       		bcs.s	@stand		; if not, branch
