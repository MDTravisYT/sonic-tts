00002734                            RandomNumber:
00002734 2238 F636                  		move.l	(v_random).w,d1
00002738 6600                       		bne.s	@scramble	; if d0 is not 0, branch
0000273A 223C 2A6D 365A             		move.l	#$2A6D365A,d1	; if do is 0, use seed number
00002740                            
00002740                            	@scramble:
00002740 2001                       		move.l	d1,d0
00002742 E581                       		asl.l	#2,d1
00002744 D280                       		add.l	d0,d1
00002746 E781                       		asl.l	#3,d1
00002748 D280                       		add.l	d0,d1
0000274A 3001                       		move.w	d1,d0
0000274C 4841                       		swap	d1
0000274E D041                       		add.w	d1,d0
00002750 3200                       		move.w	d0,d1
00002752 4841                       		swap	d1
00002754 21C1 F636                  		move.l	d1,(v_random).w
00002758 4E75                       		rts	
00002758 4E75                       		rts	
