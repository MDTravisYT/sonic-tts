000031C8                            LevSel_UpDown:
000031C8 31FC 000B FF80             		move.w	#$B,(v_levseldelay).w ; reset time delay
000031CE 1238 F604                  		move.b	(v_jpadhold1).w,d1
000031D2 0201 0003                  		andi.b	#btnUp+btnDn,d1	; is up/down pressed?
000031D6 6700                       		beq.s	LevSel_SndTest	; if not, branch
000031D8 3038 FF82                  		move.w	(v_levselitem).w,d0
