00053CA6 7600                       		moveq	#0,d3
00053CA8 162D 0001                  		move.b	TrackVoiceControl(a5),d3	; Get voice control bits
00053CAC 6B00                       		bmi.s	@trackpsg			; Branch if PSG
00053CAE 4EBA 0000                  		jsr	FMNoteOff(pc)
00053CB2 0C03 0004                  		cmpi.b	#4,d3						; Is this FM4?
00053CB6 6600                       		bne.s	@getfmpointer					; Branch if not
00053CB8 4A2E 0340                  		tst.b	v_spcsfx_fm4_track+TrackPlaybackControl(a6)	; Is special SFX playing?
00053CBC 6A00                       		bpl.s	@getfmpointer					; Branch if not
00053CBE                            		; DANGER! there is a missing 'movea.l	a5,a3' here, without which the
00053CBE                            		; code is broken. It is dangerous to do a fade out when a GHZ waterfall
00053CBE                            		; is playing its sound!
00053CBE 4BEE 0340                  		lea	v_spcsfx_fm4_track(a6),a5
00053CC2 226E 0020                  		movea.l	v_special_voice_ptr(a6),a1	; Get special voice pointer
